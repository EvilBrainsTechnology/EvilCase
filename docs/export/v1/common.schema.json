{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvilCase export v1, shared definitions",
  "definitions": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "moment": {
      "description": "ISO 8601 date and time in UTC.",
      "type": "string",
      "format": "date-time"
    },
    "optionalMoment": {
      "description": "ISO 8601 date and time in UTC; null where the record was never changed.",
      "type": ["string", "null"],
      "format": "date-time"
    },
    "optionalText": {
      "type": ["string", "null"]
    },
    "contactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contactId", "name"],
      "properties": {
        "contactId": { "$ref": "#/definitions/id" },
        "name": { "type": "string" }
      }
    },
    "labelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelId", "name"],
      "properties": {
        "labelId": { "$ref": "#/definitions/id" },
        "name": { "type": "string" }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commentId", "body", "authorEmail", "created", "updated"],
      "properties": {
        "commentId": { "$ref": "#/definitions/id" },
        "body": { "description": "Markdown.", "type": "string" },
        "authorEmail": { "type": "string" },
        "created": { "$ref": "#/definitions/moment" },
        "updated": { "$ref": "#/definitions/optionalMoment" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "fileName", "versions"],
      "properties": {
        "fileId": { "$ref": "#/definitions/id" },
        "fileName": { "description": "The name the file carries in the application.", "type": "string" },
        "versions": {
          "description": "By number; the last is the current version.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/fileVersion" }
        }
      }
    },
    "fileVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "sizeBytes", "mediaType", "sha256", "created", "uploaderEmail", "path", "missing"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "$ref": "#/definitions/optionalText" },
        "sha256": { "description": "SHA-256 of the content, lower-case hex.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created": { "description": "When the version was uploaded.", "$ref": "#/definitions/moment" },
        "uploaderEmail": { "type": "string" },
        "path": { "description": "The version's entry in the archive; null where the content was missing.", "$ref": "#/definitions/optionalText" },
        "missing": { "description": "The content was not on disk and is not in the archive.", "type": "boolean" }
      }
    }
  }
}
