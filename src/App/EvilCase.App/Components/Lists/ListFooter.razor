<div class="card-footer ec-listfoot">
    <span class="text-secondary">@(this.Skip + 1)–@Math.Min(this.Skip + this.Take, this.Total) z @this.Total</span>
    <button type="button" class="btn ms-auto" disabled="@(this.Skip == 0)" @onclick="this.Previous">Předchozí</button>
    <button type="button" class="btn" disabled="@(this.Skip + this.Take >= this.Total)" @onclick="this.Next">Další</button>
</div>

@code {
    [Parameter, EditorRequired]
    public required int Skip { get; set; }

    [Parameter, EditorRequired]
    public required int Take { get; set; }

    [Parameter, EditorRequired]
    public required int Total { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback Previous { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback Next { get; set; }
}
