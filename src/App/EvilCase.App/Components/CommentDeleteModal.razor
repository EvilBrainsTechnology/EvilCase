@using System.Net
@using EvilBrains.ApiClient
@using TabBlazor.Services
@inject IModalService ModalService
@inject ILogger<CommentDeleteModal> Logger

<p>Opravdu smazat komentář? Akci nelze vrátit zpět.</p>
<blockquote class="comment-body text-secondary">@this.Body</blockquote>

@if (this.error is not null)
{
    <div class="alert alert-danger" role="alert">@this.error</div>
}

<div class="d-flex justify-content-end gap-2 mt-3">
    <button type="button" class="btn" @onclick="() => this.ModalService.Close()">Zrušit</button>
    <button type="button" class="btn btn-danger" disabled="@this.busy" @onclick="this.ConfirmDelete">
        @if (this.busy)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
        }
        Smazat
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Body { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task> DeleteComment { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private string? error;

    private bool busy;

    private async Task ConfirmDelete()
    {
        this.busy = true;
        this.error = null;

        try
        {
            await this.DeleteComment(CancellationToken.None);

            this.ModalService.Close();
            await this.OnDeleted.InvokeAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            this.Logger.LogWarning(exception, "Deleting the comment failed: not the author");

            this.error = "Komentář smí smazat jen jeho autor.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.Logger.LogWarning(exception, "Deleting the comment failed: it is already gone");

            this.error = "Komentář už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Deleting the comment failed");

            this.error = "Komentář se nepodařilo smazat. Zkuste to za chvíli znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
