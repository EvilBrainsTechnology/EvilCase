@inject IOffcanvasService OffcanvasService

<header class="navbar navbar-expand-lg d-print-none">
    <div class="container-xl">
        <button type="button" class="navbar-toggler" aria-label="Otevřít navigaci" @onclick="ShowNavigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand navbar-brand-autodark pe-0 pe-lg-3" href="/">
            <Icon IconType="AppIcons.Scale" Size="28" CssClass="me-2" TextColor="TablerColor.Primary" />
            EvilCase
        </a>

        <div class="navbar-nav flex-row order-lg-last">
            <div class="nav-item">
                <ThemeSwitch />
            </div>

            <UserMenu />
        </div>

        <div class="navbar-collapse d-none d-lg-flex">
            <NavLinks />
        </div>
    </div>
</header>

@code {
    private Task ShowNavigation()
    {
        return this.OffcanvasService.ShowAsync(
            "Navigace",
            new RenderComponent<NavOffcanvas>(),
            new OffcanvasOptions
            {
                WrapperCssClass = "offcanvas-nav",
                CloseOnClickOutside = true,
                CloseOnEsc = true,
            });
    }
}
