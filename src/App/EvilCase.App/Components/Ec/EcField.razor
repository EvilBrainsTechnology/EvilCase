<div class="ec-field">
    @if (this.ControlId is null)
    {
        <span class="ec-field-name">@this.Name()</span>
    }
    else
    {
        <label class="ec-field-name" for="@this.ControlId">@this.Name()</label>
    }
    @this.ChildContent
    @if (!string.IsNullOrEmpty(this.Hint))
    {
        <span class="ec-field-hint">@this.Hint</span>
    }
    @if (this.Error is not null)
    {
        <div class="ec-field-error">@this.Error</div>
    }
</div>

@code {
    private RenderFragment Name()
    {
        return @<text>
            @this.Label
            @if (this.Detail is not null)
            {
                @(" ")<span class="ec-sep" aria-hidden="true">·</span> <span class="ec-field-detail">@this.Detail</span>
            }
            @if (this.Required)
            {
                <span class="ec-field-mark" aria-hidden="true">*</span>
                <span class="ec-visually-hidden"> povinné</span>
            }
        </text>;
    }

    [Parameter, EditorRequired]
    public required string Label { get; set; }

    /// <summary>
    /// The id of the control the name labels; unset where the control is a group of elements.
    /// </summary>
    [Parameter]
    public string? ControlId { get; set; }

    /// <summary>
    /// A value the name shows after a separator, such as the chosen colour.
    /// </summary>
    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Error { get; set; }
}
