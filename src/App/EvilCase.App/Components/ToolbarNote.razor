@* A note on a preview or editor toolbar; a narrow toolbar cuts it short and its tooltip carries the whole wording. *@
<span class="@(this.Warning ? "ec-toolbar-note ec-toolbar-note-warning" : "ec-toolbar-note")" role="note">
    @if (this.Warning)
    {
        <EcIcon Paths="@AppIcons.AlertTriangle" />
    }
    <span class="ec-toolbar-note-text" data-tooltip-overflow>@this.Text</span>
</span>

@code {
    [Parameter, EditorRequired]
    public required string Text { get; set; }

    [Parameter]
    public bool Warning { get; set; }
}
