@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Labels
@inject ILabelsClient LabelsClient
@inject ILogger<LabelFormModal> Logger

<EcModal Title="@this.Title" Open="this.Open" OpenChanged="this.OpenChanged">
    <ChildContent>
        <CascadingValue Value="this.editContext">
            <DataAnnotationsValidator />
            <div class="ec-form">
                <EcField Label="Název" Required ControlId="label-name" Hint="Nejvýše 64 znaků">
                    <ChildContent>
                        <InputText id="label-name" class="ec-input" @bind-Value="this.model.Name" />
                    </ChildContent>
                    <Error><ValidationMessage For="() => this.model.Name" /></Error>
                </EcField>

                <EcField Label="Barva" ControlId="label-color">
                    <ChildContent>
                        <div id="label-color" class="ec-swatches" role="group" aria-label="Barva štítku">
                            @foreach (var color in LabelColorDisplay.Palette)
                            {
                                var picked = this.model.Color == color;

                                <button type="button" class="@($"ec-swatch ec-chip-{LabelColorDisplay.Css(color)}")"
                                        aria-label="@LabelColorDisplay.Text(color)" aria-pressed="@picked"
                                        @onclick="() => this.model.Color = color"></button>
                            }
                        </div>
                    </ChildContent>
                </EcField>

                @if (this.error is not null)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
                }
            </div>
        </CascadingValue>
    </ChildContent>
    <Footer>
        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Form" Icon="@AppIcons.X" OnClick="this.Cancel">Zrušit</EcButton>
        <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Form" Icon="@AppIcons.Check"
                  Disabled="@this.busy" OnClick="this.SaveLabel">@this.SaveText</EcButton>
    </Footer>
</EcModal>

@code {
    [Parameter]
    public LabelItem? Label { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private readonly LabelEditModel model = new();

    private EditContext editContext = null!;

    private string? error;

    private bool busy;

    private string Title => this.Label is null ? "Nový štítek" : "Upravit štítek";

    private string SaveText => this.Label is null ? "Založit štítek" : "Uložit";

    protected override void OnInitialized()
    {
        if (this.Label is { } label)
        {
            this.model.Name = label.Name;
            this.model.Color = label.Color;
        }

        this.editContext = new EditContext(this.model);
    }

    private async Task Cancel()
    {
        await this.OpenChanged.InvokeAsync(false);
    }

    private async Task SaveLabel()
    {
        if (!this.editContext.Validate())
            return;

        this.busy = true;
        this.error = null;

        try
        {
            var request = new LabelEditRequest { Name = this.model.Name, Color = this.model.Color };

            if (this.Label is { } label)
            {
                await this.LabelsClient.EditLabel(label.LabelId, request, CancellationToken.None);
            }
            else
            {
                _ = await this.LabelsClient.CreateLabel(request, CancellationToken.None);
            }

            await this.OnSaved.InvokeAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            this.error = "Štítek s tímto názvem už existuje. Zvolte jiný.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.error = "Štítek už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the label failed");

            this.error = this.Label is null
                ? "Štítek se nepodařilo založit. Zkontrolujte zadané údaje a zkuste to znovu."
                : "Štítek se nepodařilo uložit. Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
