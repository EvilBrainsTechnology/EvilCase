@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@inject ICasesClient CasesClient

<ConfirmDeleteModal Delete="this.DeleteCase" GoneError="Spis už neexistuje." FailedError="Spis se nepodařilo smazat. Zkuste to za chvíli znovu." OnDeleted="this.OnDeleted">
    <p>Opravdu smazat spis <strong>@Case.CaseNumber</strong> — @Case.Title? Akci nelze vrátit zpět.</p>

    <p class="text-secondary">Se spisem zaniknou jeho úkony i s externími čísly jednacími, komentáře spisu i úkonů, externí značky spisu a soubory spisu i úkonů.</p>

    @if (Case.ChildCases.Count > 0)
    {
        <p class="text-secondary">Podřízené spisy (@Case.ChildCases.Count) se smažou spolu se spisem, a s nimi i vše, co je pod nimi.</p>
    }
</ConfirmDeleteModal>

@code {
    [Parameter, EditorRequired]
    public required CaseDetail Case { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private Task DeleteCase(CancellationToken cancellationToken)
    {
        return this.CasesClient.DeleteCase(this.Case.CaseId, cancellationToken);
    }
}
