@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<dialog class="@this.CssClass" @ref="this.dialog" aria-label="@this.Title" data-ec-guarded="@this.OnCloseRequest.HasDelegate"
        data-ec-maximizable="@this.Maximizable" @onpointerdown="this.PressBackdrop" @onclick="this.ClickBackdrop">
    @* Events from the content stop here, so the dialog only sees presses and clicks on its backdrop. *@
    <div class="ec-modal-frame" @onpointerdown:stopPropagation @onclick:stopPropagation>
        <div class="ec-modal-header">
            @if (this.Heading is null)
            {
                <h2 class="ec-modal-title">@this.Title</h2>
            }
            else
            {
                @this.Heading
            }
            @if (this.Maximizable)
            {
                var label = this.maximized ? "Obnovit velikost" : "Maximalizovat";

                <span class="ec-modal-maximize">
                    <EcButton Variant="EcButtonVariant.Ghost" Size="EcButtonSize.Compact" Icon="@(this.maximized ? AppIcons.Restore : AppIcons.Maximize)"
                              AriaLabel="@label" data-tooltip="@label" aria-pressed="@(this.maximized ? "true" : "false")" OnClick="this.ToggleMaximized" />
                </span>
            }
            <EcButton Variant="EcButtonVariant.Ghost" Size="EcButtonSize.Compact" Icon="@AppIcons.X"
                      AriaLabel="Zavřít" OnClick="this.Close" />
        </div>
        <div class="ec-modal-body">@this.ChildContent</div>
        @if (this.Footer is not null)
        {
            <div class="ec-modal-footer">@this.Footer</div>
        }
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    /// <summary>
    /// Replaces the title in the header; <see cref="Title"/> still names the dialog.
    /// </summary>
    [Parameter]
    public RenderFragment? Heading { get; set; }

    /// <summary>
    /// Fills most of the window, for a preview.
    /// </summary>
    [Parameter]
    public bool Large { get; set; }

    /// <summary>
    /// A list in a window: 680 px wide on desktop, docked to the bottom edge as a sheet below lg.
    /// </summary>
    [Parameter]
    public bool Sheet { get; set; }

    /// <summary>
    /// A <see cref="Large"/> dialog offers on desktop to fill the whole window; every opening starts at the normal size.
    /// </summary>
    [Parameter]
    public bool Maximizable { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// When set, a close by the X, a click outside or Escape raises this instead of closing; the owner closes the dialog
    /// through <see cref="Open"/>.
    /// </summary>
    [Parameter]
    public EventCallback OnCloseRequest { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    private ElementReference dialog;

    private IJSObjectReference? module;

    private DotNetObjectReference<EcModal>? self;

    private IJSObjectReference? scrollLock;

    private bool shown;

    private bool disposed;

    private bool backdropPressed;

    private bool maximized;

    private string CssClass
    {
        get
        {
            var size = this.Large ? " ec-modal-large" : this.Sheet ? " ec-modal-sheet" : "";

            return this.maximized ? $"ec-modal{size} ec-modal-maximized" : $"ec-modal{size}";
        }
    }

    // A double-click on the header outside its controls toggles too.
    [JSInvokable]
    public void ToggleMaximized()
    {
        this.maximized = !this.maximized;
        this.StateHasChanged();
    }

    [JSInvokable]
    public async Task NotifyCloseRequested()
    {
        if (this.Open)
            await this.Close();
    }

    [JSInvokable]
    public async Task NotifyClosed()
    {
        if (!this.Open)
            return;

        this.shown = false;

        // A guarded dialog the browser closed anyway opens again on the next render and asks its owner.
        if (this.OnCloseRequest.HasDelegate)
        {
            await this.OnCloseRequest.InvokeAsync();
            this.StateHasChanged();

            return;
        }

        await this.OpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        this.disposed = true;

        if (this.scrollLock is not null)
        {
            await this.scrollLock.InvokeVoidAsync("release");
            await this.scrollLock.DisposeAsync();
        }

        if (this.module is not null)
            await this.module.DisposeAsync();

        this.self?.Dispose();
    }

    protected override void OnParametersSet()
    {
        if (!this.Open)
            this.maximized = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this.Open == this.shown)
            return;

        this.module ??= await this.JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/ec-modal.js");

        if (this.Open)
        {
            this.self ??= DotNetObjectReference.Create(this);

            var scrollLock = await this.module.InvokeAsync<IJSObjectReference>("openModal", this.dialog, this.self);

            // Disposed while opening: the lock that came back has no one left to release it.
            if (this.disposed)
            {
                await scrollLock.InvokeVoidAsync("release");
                await scrollLock.DisposeAsync();

                return;
            }

            if (this.scrollLock is not null)
                await this.scrollLock.DisposeAsync();

            this.scrollLock = scrollLock;
        }
        else
        {
            await this.module.InvokeVoidAsync("closeModal", this.dialog);
        }

        this.shown = this.Open;
    }

    private void PressBackdrop()
    {
        this.backdropPressed = true;
    }

    // A drag that starts in the content and ends on the backdrop is no click outside.
    private async Task ClickBackdrop()
    {
        var pressed = this.backdropPressed;
        this.backdropPressed = false;

        if (pressed)
            await this.Close();
    }

    private async Task Close()
    {
        if (this.OnCloseRequest.HasDelegate)
        {
            await this.OnCloseRequest.InvokeAsync();
        }
        else
        {
            await this.OpenChanged.InvokeAsync(false);
        }
    }
}
