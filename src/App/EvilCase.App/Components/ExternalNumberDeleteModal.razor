@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Numbers
@using EvilBrains.EvilCase.App.Models
@using TabBlazor.Services
@inject IModalService ModalService
@inject ILogger<ExternalNumberDeleteModal> Logger

<p>@this.Text.DeleteQuestion <strong>@this.Number.Value</strong>? Akci nelze vrátit zpět.</p>

@if (this.error is not null)
{
    <div class="alert alert-danger" role="alert">@this.error</div>
}

<div class="d-flex justify-content-end gap-2 mt-3">
    <button type="button" class="btn" @onclick="() => this.ModalService.Close()">Zrušit</button>
    <button type="button" class="btn btn-danger" disabled="@this.busy" @onclick="this.DeleteNumberClick">
        @if (this.busy)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
        }
        Smazat
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public required ExternalNumberText Text { get; set; }

    [Parameter, EditorRequired]
    public required ExternalNumberItem Number { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task> DeleteNumber { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private string? error;

    private bool busy;

    private async Task DeleteNumberClick()
    {
        this.busy = true;
        this.error = null;

        try
        {
            await this.DeleteNumber(CancellationToken.None);

            this.ModalService.Close();
            await this.OnDeleted.InvokeAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.Logger.LogWarning(exception, "Deleting the external number failed: it is already gone");

            this.error = this.Text.DeleteGoneError;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Deleting the external number failed");

            this.error = this.Text.DeleteFailedError;
        }
        finally
        {
            this.busy = false;
        }
    }
}
