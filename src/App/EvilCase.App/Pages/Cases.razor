@page "/cases"
@using EvilBrains.EvilCase.Api.Contract.Cases

<PageTitle>Spisy – EvilCase</PageTitle>

<div class="ec-page">
    <EcPageHeader Title="Spisy">
        <Status><span class="ec-page-note">@RecordCountDisplay.Text(this.total)</span></Status>
        <Actions>
            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" Href="/cases/new">Nový spis</EcButton>
        </Actions>
    </EcPageHeader>

    <CaseList Columns="Columns" Filter="Filter"
              ShowSearch="true" ShowDates="true" ShowLabelFilter="true"
              ShowStatusFilter="true" ShowScopeFilter="true" ShowPaging="true"
              TotalChanged="this.OnTotalChanged">
        <EmptyAction>
            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" Href="/cases/new">Založit spis</EcButton>
        </EmptyAction>
    </CaseList>
</div>

@code {
    private const int PageItems = 20;

    private static readonly CaseColumn[] Columns =
    [
        CaseColumn.Date,
        CaseColumn.Case,
        CaseColumn.Status,
        CaseColumn.Labels,
        CaseColumn.CaseNumber,
    ];

    [Parameter]
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private int total;

    // A record, so a render that hands over the same values reloads nothing (CaseListRenderTests).
    private CaseListRequest Filter => new()
    {
        Scope = CaseListScope.RootOnly,
        Search = string.IsNullOrWhiteSpace(this.Query) ? null : this.Query,
        Take = PageItems,
    };

    private void OnTotalChanged(int count)
    {
        this.total = count;
    }
}
