@using EvilBrains.EvilCase.Api.Contract.Acts

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><Icon CssClass="icon me-2" IconType="AppIcons.FileText" />Poslední úkony</h3>
    </div>

    @if (this.Items.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><Icon IconType="AppIcons.FileText" /></div>
            <p class="empty-title">Žádné úkony</p>
            <p class="empty-subtitle text-secondary">Zatím tu není žádný úkon.</p>
        </div>
    }
    else
    {
        <div class="d-none d-lg-block">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Číslo jednací</th>
                        <th>Název</th>
                        <th>Spis</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in this.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@DateDisplay.Text(item.Date)</td>
                            <td class="text-nowrap">@item.ActNumber</td>
                            <td><a href="@($"/cases/{item.CaseId}/act/{item.ActId}")">@item.Title</a></td>
                            <td class="text-nowrap"><a href="@($"/cases/{item.CaseId}")">@item.CaseNumber</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-body d-lg-none">
            @foreach (var item in this.Items)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="font-weight-medium"><a href="@($"/cases/{item.CaseId}/act/{item.ActId}")">@item.Title</a></div>
                        <div class="text-secondary">@item.ActNumber</div>
                        <div><a href="@($"/cases/{item.CaseId}")">@item.CaseNumber</a></div>
                        <div class="text-secondary">@DateDisplay.Text(item.Date)</div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<ActListItem> Items { get; set; }
}
