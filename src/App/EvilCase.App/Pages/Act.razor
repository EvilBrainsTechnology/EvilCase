@page "/cases/{CaseId:guid}/act/{ActId:guid}"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Files
@using EvilBrains.EvilCase.Api.Contract.Labels
@using EvilBrains.EvilCase.Domain.Acts
@using EvilBrains.EvilCase.Domain.Cases
@inject IActsClient ActsClient
@inject IActLabelsClient ActLabelsClient
@inject IActCommentsClient ActCommentsClient
@inject IActFilesClient ActFilesClient
@inject IFileTransferClient FileTransfer
@inject IFileDownloader Downloader
@inject NavigationManager Navigation
@inject ILogger<Act> Logger

<PageTitle>@(this.act is null ? "Úkon" : this.act.ActNumber) – EvilCase</PageTitle>

<div class="ec-page">
    @if (this.notFound)
    {
        <EcCard><p class="ec-state">Úkon nenalezen.</p></EcCard>
    }
    else if (this.failure is not null)
    {
        <EcCard>
            <div class="ec-card-error">
                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.failure</div>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                          OnClick="this.LoadAct">Zkusit znovu</EcButton>
            </div>
        </EcCard>
    }
    else if (this.act is null)
    {
        <EcCard><p class="ec-state">Načítám…</p></EcCard>
    }
    else
    {
        <EcCard>
            <div class="ec-detail">
                <EcPageHeader Title="@this.act.Title" Breadcrumbs="this.Crumbs">
                    <Status>
                        @if (this.act.Direction is { } direction)
                        {
                            <EcBadge Text="@ActDirectionDisplay.Text(direction)" Tone="DirectionTone(direction)" />
                        }
                    </Status>
                    <Actions>
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" OnClick="this.EditAct">Upravit úkon</EcButton>
                        <EcButton Variant="EcButtonVariant.Danger" Icon="@AppIcons.Trash" OnClick="this.StartDeleting">Smazat úkon</EcButton>
                    </Actions>
                </EcPageHeader>

                <p class="ec-detail-text">@(string.IsNullOrWhiteSpace(this.act.Description) ? "—" : this.act.Description)</p>

                <div class="ec-detail-facts">
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Datum úkonu</span>
                        <span class="ec-detail-fact-value">@DateDisplay.Text(this.act.Date)</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Číslo jednací</span>
                        <span class="ec-detail-fact-mono">@this.act.ActNumber</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Externí číslo jednací</span>
                        <span class="ec-detail-fact-mono">@(string.IsNullOrWhiteSpace(this.act.ExternalActNumber) ? "—" : this.act.ExternalActNumber)</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Kontakt</span>
                        @if (this.act.Contact is { } contact)
                        {
                            <a class="ec-detail-fact-link" href="@($"/contacts/{contact.ContactId}")">@contact.Name</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-grow">
                        <span class="ec-detail-fact-name">Štítky</span>
                        @if (this.picking)
                        {
                            <LabelField InputId="act-labels" Selected="this.act.Labels" SelectedChanged="this.SaveLabels" />
                        }
                        else if (this.act.Labels.Count > 0)
                        {
                            <div class="ec-chips">
                                @foreach (var label in this.act.Labels)
                                {
                                    <span class="@($"ec-chip ec-chip-{LabelColorDisplay.Css(label.Color)}")">
                                        <span class="ec-chip-dot" aria-hidden="true"></span>@label.Name
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value">—</span>
                        }
                        @if (this.labelsError is not null)
                        {
                            <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.labelsError</div>
                        }
                        <div class="ec-detail-fact-actions">
                            <EcButton Variant="EcButtonVariant.Ghost" Size="EcButtonSize.Compact"
                                      Icon="@(this.picking ? AppIcons.X : AppIcons.Plus)"
                                      AriaLabel="@(this.picking ? "Zavřít výběr štítků" : "Přidat štítek")"
                                      OnClick="this.ToggleLabelPicker" />
                        </div>
                    </div>
                </div>
            </div>
        </EcCard>

        @if (ActContactRules.DifferingCaseContact(this.act.Contact, this.act.CaseContact) is { } differing)
        {
            <div class="ec-warning" role="alert">
                <EcIcon Paths="@AppIcons.AlertTriangle" Size="EcIconSize.Large" />
                <p class="ec-warning-text">Kontakt úkonu se liší od kontaktu spisu (<strong>@differing.Name</strong>).</p>
            </div>
        }

        <div class="ec-detail-layout">
            <div class="ec-detail-main">
                <FilesCard @key="(nameof(FilesCard), this.ActId)"
                           Title="Soubory úkonu"
                           OwnerGoneError="úkon už neexistuje."
                           LoadFiles="this.LoadFiles"
                           UploadFile="this.UploadFile"
                           DownloadFile="this.DownloadFile"
                           DeleteFile="this.DeleteFile" />

                <CommentsCard @key="(nameof(CommentsCard), this.ActId)"
                              Title="Komentáře úkonu"
                              Placeholder="Poznámka k tomuto úkonu…"
                              LoadComments="this.LoadComments"
                              AddComment="this.AddComment"
                              SaveComment="this.SaveComment"
                              DeleteComment="this.DeleteComment" />
            </div>

            <aside class="ec-detail-aside">
                <EcCard Title="Spis">
                    <a class="ec-case-link" href="@($"/cases/{this.act.CaseId}")">
                        <span class="ec-case-link-title">@this.act.CaseTitle</span>
                        <span class="ec-case-link-number">@this.act.CaseNumber</span>
                    </a>
                    <p class="ec-case-meta">
                        <span class="@($"ec-status-dot {CaseStatusDot(this.act.CaseStatus)}")" aria-hidden="true"></span>
                        @CaseStatusDisplay.Text(this.act.CaseStatus) · @DateDisplay.Text(this.act.CaseDate)
                    </p>
                </EcCard>
            </aside>
        </div>
    }
</div>

@if (this.deleting && this.act is not null)
{
    <ActDeleteModal Act="this.act" Open OpenChanged="this.CloseDelete" OnDeleted="this.ActDeleted" />
}

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    [Parameter]
    public Guid ActId { get; set; }

    private ActDetail? act;

    private bool notFound;

    private string? failure;

    private string? labelsError;

    private bool picking;

    private bool deleting;

    private IReadOnlyList<EcCrumb> Crumbs => this.act is null
        ? [new EcCrumb("Spisy", "/cases")]
        : [
            new EcCrumb("Spisy", "/cases"),
            new EcCrumb(this.act.CaseTitle, $"/cases/{this.CaseId}"),
            new EcCrumb(this.act.ActNumber, null),
        ];

    protected override Task OnParametersSetAsync()
    {
        return this.LoadAct();
    }

    private static EcBadgeTone DirectionTone(ActDirection direction)
    {
        return direction switch
        {
            ActDirection.Incoming => EcBadgeTone.Incoming,
            ActDirection.Outgoing => EcBadgeTone.Outgoing,
            _ => throw new InvalidOperationException($"unknown ActDirection {direction}"),
        };
    }

    private static string CaseStatusDot(CaseStatus status)
    {
        return status switch
        {
            CaseStatus.Active => "ec-status-dot-active",
            CaseStatus.WaitingOnAuthority => "ec-status-dot-waiting",
            CaseStatus.Closed => "ec-status-dot-closed",
            _ => throw new InvalidOperationException($"unknown CaseStatus {status}"),
        };
    }

    private async Task LoadAct()
    {
        this.notFound = false;
        this.failure = null;
        this.labelsError = null;
        this.picking = false;
        this.act = null;

        try
        {
            this.act = await this.ActsClient.GetAct(this.CaseId, this.ActId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the act detail failed");

            this.failure = "Úkon se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void ToggleLabelPicker()
    {
        this.picking = !this.picking;
        this.labelsError = null;
    }

    private async Task SaveLabels(IReadOnlyList<LabelItem> labels)
    {
        this.labelsError = null;

        try
        {
            var request = new LabelAssignmentRequest { LabelIds = [.. labels.Select(static label => label.LabelId)] };

            await this.ActLabelsClient.SetActLabels(this.CaseId, this.ActId, request, CancellationToken.None);

            this.act = await this.ActsClient.GetAct(this.CaseId, this.ActId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.labelsError = "Úkon už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the act labels failed");

            this.labelsError = "Štítky se nepodařilo uložit. Zkuste to za chvíli znovu.";
        }
    }

    private void EditAct()
    {
        this.Navigation.NavigateTo($"/cases/{this.CaseId}/act/{this.ActId}/edit");
    }

    private void StartDeleting()
    {
        this.deleting = true;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = false;
    }

    private void ActDeleted()
    {
        this.deleting = false;

        this.Navigation.NavigateTo($"/cases/{this.CaseId}");
    }

    private async Task<IReadOnlyList<FileListItem>> LoadFiles(CancellationToken token)
    {
        return (await this.ActFilesClient.ListActFiles(this.CaseId, this.ActId, token)).Items;
    }

    private Task UploadFile(IBrowserFile file, CancellationToken token)
    {
        return this.FileTransfer.UploadActFile(this.CaseId, this.ActId, file, token);
    }

    private async Task DownloadFile(FileListItem file, CancellationToken token)
    {
        var content = await this.FileTransfer.DownloadFileContent(file.FileId, token);
        await this.Downloader.SaveFile(file.FileName, content, token);
    }

    private Task DeleteFile(FileListItem file, CancellationToken token)
    {
        return this.ActFilesClient.DeleteActFile(this.CaseId, this.ActId, file.FileId, token);
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.ActCommentsClient.ListActComments(this.CaseId, this.ActId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.AddActComment(this.CaseId, this.ActId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.EditActComment(this.CaseId, this.ActId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.ActCommentsClient.DeleteActComment(this.CaseId, this.ActId, commentId, token);
    }
}
