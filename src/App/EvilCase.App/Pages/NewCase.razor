@page "/cases/new"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Labels
@inject ICasesClient CasesClient
@inject NavigationManager Navigation
@inject ILogger<NewCase> Logger

<PageTitle>@(this.ParentCaseId is null ? "Nový spis" : "Nový podřízený spis") – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">@(this.ParentCaseId is null ? "Nový spis" : "Nový podřízený spis")</h2>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (this.parentNotFound)
        {
            <div class="empty">
                <div class="empty-icon"><Icon IconType="TablerIcons.AlertTriangle" /></div>
                <p class="empty-title">Nadřízený spis nenalezen</p>
            </div>
        }
        else if (this.failure is not null)
        {
            <div class="empty">
                <div class="empty-icon"><Icon IconType="TablerIcons.AlertTriangle" /></div>
                <p class="empty-title">Nadřízený spis se nepodařilo načíst</p>
                <p class="empty-subtitle text-secondary">@this.failure</p>
            </div>
        }
        else
        {
            <EditForm Model="this.model" OnValidSubmit="this.SubmitCase">
                <DataAnnotationsValidator />

                <div class="ec-layout">
                    <div class="ec-main">
                        <div>
                            <label class="visually-hidden" for="case-title">Název</label>
                            <input id="case-title" class="form-control ec-title-input" placeholder="Název spisu" autofocus @bind="this.model.Title" />
                            <ValidationMessage For="() => this.model.Title" class="invalid-feedback d-block" />
                        </div>

                        <div class="card">
                            <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.FileText" />Popis</h3></div>
                            <div class="card-body">
                                <label class="visually-hidden" for="case-description">Popis</label>
                                <InputTextArea id="case-description" class="form-control" rows="8" @bind-Value="this.model.Description" />
                                <ValidationMessage For="() => this.model.Description" class="invalid-feedback d-block" />
                            </div>
                        </div>
                    </div>

                    <aside class="ec-sidebar d-flex flex-column gap-3">
                        <div class="card">
                            <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.ListDetails" />Údaje</h3></div>
                            <div class="card-body d-flex flex-column gap-3">
                                <div>
                                    <span class="ec-field-label">Spisová značka</span>
                                    <div class="text-secondary">Přidělí se po založení.</div>
                                </div>
                                <div>
                                    <label class="ec-field-label" for="case-date">Datum spisu</label>
                                    <InputDate id="case-date" class="form-control" @bind-Value="this.model.Date" />
                                    <ValidationMessage For="() => this.model.Date" class="invalid-feedback d-block" />
                                </div>
                                <div>
                                    <label class="ec-field-label" for="case-contact">Kontakt</label>
                                    <ContactPicker InputId="case-contact" @bind-Selected="this.model.Contact" />
                                    <ValidationMessage For="() => this.model.Contact" class="invalid-feedback d-block" />
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.Tag" />Štítky</h3></div>
                            <div class="card-body">
                                <label class="visually-hidden" for="case-labels">Štítky</label>
                                <LabelPicker InputId="case-labels" @bind-Selected="this.model.Labels" />
                            </div>
                        </div>

                        @if (this.parentCase is not null)
                        {
                            <div class="card">
                                <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.Folders" />Hierarchie</h3></div>
                                <div class="card-body">
                                    <div class="ec-field-label">Nadřízený spis</div>
                                    <a href="@($"/cases/{this.parentCase.CaseId}")">@this.parentCase.CaseNumber — @this.parentCase.Title</a>
                                </div>
                            </div>
                        }
                    </aside>

                    <div class="ec-savebar">
                        <div class="ec-savebar-actions">
                            <a href="@(this.ParentCaseId is { } parentId ? $"/cases/{parentId}" : "/cases")" class="btn"><Icon CssClass="icon" IconType="TablerIcons.X" />Zrušit</a>
                            <button id="case-submit" type="submit" class="btn btn-primary" disabled="@this.busy">
                                @if (this.busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                else
                                {
                                    <Icon CssClass="icon" IconType="TablerIcons.Plus" />
                                }
                                Založit spis
                            </button>
                        </div>
                    </div>

                    @if (this.error is not null)
                    {
                        <div class="ec-savebar-error">
                            <div class="alert alert-danger mb-0" role="alert"><Icon CssClass="icon me-2" IconType="TablerIcons.AlertTriangle" />@this.error</div>
                        </div>
                    }
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentCaseId { get; set; }

    private readonly NewCaseModel model = new() { Date = DateOnly.FromDateTime(DateTime.Now) };

    private CaseDetail? parentCase;

    private bool parentNotFound;

    private string? failure;

    private string? error;

    private bool busy;

    protected override async Task OnParametersSetAsync()
    {
        this.parentCase = null;
        this.parentNotFound = false;
        this.failure = null;

        if (this.ParentCaseId is not { } parentCaseId)
            return;

        try
        {
            this.parentCase = await this.CasesClient.GetCase(parentCaseId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.parentNotFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the parent case failed");

            this.failure = "Nadřízený spis se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task SubmitCase()
    {
        this.busy = true;
        this.error = null;

        try
        {
            var request = new CreateCaseRequest
            {
                ParentCaseId = this.ParentCaseId,
                Date = this.model.Date,
                Title = this.model.Title,
                Description = this.model.Description,
                ContactId = this.model.Contact?.ContactId,
                LabelIds = [.. this.model.Labels.Select(static label => label.LabelId)],
            };

            _ = await this.CasesClient.CreateCase(request, CancellationToken.None);

            this.Navigation.NavigateTo(this.ParentCaseId is { } parent ? $"/cases/{parent}" : "/cases");
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            this.error = "Nadřízený spis neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Filing a new case failed");

            this.error = "Spis se nepodařilo založit. Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
