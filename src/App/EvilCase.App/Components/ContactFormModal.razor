@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.App.Models
@using EvilBrains.EvilCase.Domain.Contacts
@using EvilBrains.ApiClient
@using TabBlazor.Services
@inject IContactsClient ContactsClient
@inject IModalService ModalService
@inject ILogger<ContactFormModal> Logger

<EditForm Model="this.model" OnValidSubmit="this.SaveContact">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="@($"{this.idPrefix}-name")">Název</label>
        <InputText id="@($"{this.idPrefix}-name")" class="form-control" @bind-Value="this.model.Name" />
        <ValidationMessage For="() => this.model.Name" class="invalid-feedback d-block" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="@($"{this.idPrefix}-kind")">Typ</label>
        <InputSelect id="@($"{this.idPrefix}-kind")" class="form-select" @bind-Value="this.model.Kind">
            @foreach (var kind in Enum.GetValues<ContactKind>())
            {
                <option value="@kind">@ContactKindDisplay.Text(kind)</option>
            }
        </InputSelect>
        <ValidationMessage For="() => this.model.Kind" class="invalid-feedback d-block" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="@($"{this.idPrefix}-databox")">ID datové schránky</label>
        <InputText id="@($"{this.idPrefix}-databox")" class="form-control" @bind-Value="this.model.DataBoxId" />
        <ValidationMessage For="() => this.model.DataBoxId" class="invalid-feedback d-block" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="@($"{this.idPrefix}-address")">Adresa</label>
        <InputTextArea id="@($"{this.idPrefix}-address")" class="form-control" rows="4" @bind-Value="this.model.Address" />
        <ValidationMessage For="() => this.model.Address" class="invalid-feedback d-block" />
    </div>

    @if (this.error is not null)
    {
        <div class="alert alert-danger" role="alert"><Icon CssClass="icon me-2" IconType="AppIcons.AlertTriangle" />@this.error</div>
    }

    <div class="form-actions-sticky d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn" @onclick="() => this.ModalService.Close()"><Icon CssClass="icon" IconType="AppIcons.X" />Zrušit</button>
        <button type="submit" class="btn btn-primary" disabled="@this.busy">
            @if (this.busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            else
            {
                <Icon CssClass="icon" IconType="AppIcons.DeviceFloppy" />
            }
            @(this.Contact is null ? "Založit kontakt" : "Uložit")
        </button>
    </div>
</EditForm>

@code {
    /// <summary>Editing an existing contact when set; creating a new one when null.</summary>
    [Parameter]
    public ContactDetail? Contact { get; set; }

    [Parameter]
    public EventCallback<ContactListItem> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private readonly ContactEditModel model = new();

    private string? error;

    private bool busy;

    private string idPrefix => this.Contact is null ? "contact-create" : "contact-edit";

    protected override void OnInitialized()
    {
        if (this.Contact is { } contact)
        {
            this.model.Name = contact.Name;
            this.model.Kind = contact.Kind;
            this.model.DataBoxId = contact.DataBoxId;
            this.model.Address = contact.Address;
        }
    }

    private async Task SaveContact()
    {
        this.busy = true;
        this.error = null;

        try
        {
            var request = new ContactEditRequest
            {
                Name = this.model.Name,
                Kind = this.model.Kind,
                DataBoxId = this.model.DataBoxId,
                Address = this.model.Address,
            };

            if (this.Contact is { } contact)
            {
                await this.ContactsClient.EditContact(contact.ContactId, request, CancellationToken.None);

                this.ModalService.Close();
                await this.OnSaved.InvokeAsync();
            }
            else
            {
                var created = await this.ContactsClient.CreateContact(request, CancellationToken.None);

                this.ModalService.Close();
                await this.OnCreated.InvokeAsync(created);
            }
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the contact failed");

            this.error = this.Contact is null
                ? "Kontakt se nepodařilo založit. Zkontrolujte zadané údaje a zkuste to znovu."
                : "Kontakt se nepodařilo uložit. Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
