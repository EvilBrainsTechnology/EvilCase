@using EvilBrains.EvilCase.Api.Contract.Cases

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><Icon CssClass="icon me-2" IconType="AppIcons.Folders" />Spisy</h3>
    </div>

    @if (Items.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><Icon IconType="AppIcons.Folders" /></div>
            <p class="empty-title">Žádné spisy</p>
            <p class="empty-subtitle text-secondary">Kontakt nefiguruje v žádném spisu.</p>
        </div>
    }
    else
    {
        <div class="d-none d-lg-block">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th>Spisová značka</th>
                        <th>Název</th>
                        <th>Stav</th>
                        <th>Datum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td class="text-nowrap">@item.CaseNumber</td>
                            <td><a href="@($"/cases/{item.CaseId}")">@item.Title</a></td>
                            <td class="text-nowrap">
                                <Status BackgroundColor="CaseStatusDisplay.Color(item.Status)" Lite="true">@CaseStatusDisplay.Text(item.Status)</Status>
                            </td>
                            <td class="text-nowrap">@DateDisplay.Text(item.Date)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-body d-lg-none">
            @foreach (var item in Items)
            {
                <CaseListCard Case="item" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<CaseListItem> Items { get; set; }
}
