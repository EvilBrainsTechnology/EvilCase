# Compose variables for the deployment. Copy to .env next to the compose files (.env is never
# committed). The overlay docker-compose.local.yml supplies its own database, so only EVILCASE_JWT_KEY
# is needed there.

# Image tag to run: a release version (1.2.3), latest, or edge for the current master.
EVILCASE_TAG=latest

# Host port the application is published on.
EVILCASE_PORT=8080

EVILCASE_CONNECTION_STRING=Host=db.example.com;Port=5432;Database=evilcase;Username=evilcase;Password=
EVILCASE_JWT_KEY=

# Where more than one instance starts at once, roll the schema out separately and add
# EvilBrains__EvilCase__Database__MigrateOnStartup=false to the service environment: nothing
# serialises concurrent migrators. CI publishes an idempotent database.sql artifact for that.
