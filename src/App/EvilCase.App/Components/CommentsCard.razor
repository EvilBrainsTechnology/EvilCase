@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Comments
@using TabBlazor.Services
@inject IModalService ModalService
@inject ILogger<CommentsCard> Logger

<div id="comments-card" class="card">
    <div class="card-header">
        <h3 class="card-title"><Icon CssClass="icon me-2" IconType="AppIcons.Message" />Komentáře</h3>
        <div class="card-actions">
            <button id="comment-add" type="button" class="btn btn-primary" @onclick="this.OpenComposer">
                <Icon CssClass="icon" IconType="AppIcons.Plus" />Přidat komentář
            </button>
        </div>
    </div>

    @if (this.composing)
    {
        <div class="card-body border-bottom">
            <EditForm Model="this.newModel" OnValidSubmit="this.AddNewComment">
                <DataAnnotationsValidator />

                <label class="visually-hidden" for="comment-new-body">Nový komentář</label>
                <InputTextArea id="comment-new-body" class="form-control" rows="3" @bind-Value="this.newModel.Body" />
                <ValidationMessage For="() => this.newModel.Body" class="invalid-feedback d-block" />

                @if (this.addError is not null)
                {
                    <div class="alert alert-danger mt-2" role="alert"><Icon CssClass="icon me-2" IconType="AppIcons.AlertTriangle" />@this.addError</div>
                }

                <div class="d-flex justify-content-end gap-2 mt-2">
                    <button type="button" class="btn" @onclick="this.CloseComposer"><Icon CssClass="icon" IconType="AppIcons.X" />Zrušit</button>
                    <button type="submit" class="btn btn-primary" disabled="@this.busy">
                        @if (this.busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <Icon CssClass="icon" IconType="AppIcons.DeviceFloppy" />
                        }
                        Uložit komentář
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @if (this.loading)
    {
        <div class="card-body text-center text-secondary">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (this.listFailure is not null)
    {
        <div class="empty">
            <div class="empty-icon"><Icon IconType="AppIcons.AlertTriangle" /></div>
            <p class="empty-title">Komentáře se nepodařilo načíst</p>
            <p class="empty-subtitle text-secondary">@this.listFailure</p>
        </div>
    }
    else if (this.items.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><Icon IconType="AppIcons.Message" /></div>
            <p class="empty-title">Žádné komentáře</p>
        </div>
    }
    else
    {
        <div class="card-body">
            @foreach (var item in this.items)
            {
                <div class="comment-item border-bottom pb-3 mb-3">
                    <div class="d-flex align-items-start gap-2">
                        <div class="text-secondary small flex-fill">
                            @item.AuthorEmail · @MomentDisplay.Text(item.Created)@(item.Updated is null ? "" : $" · upraveno {MomentDisplay.Text(item.Updated.Value)}")
                        </div>
                        @if (item.IsAuthor && this.editingCommentId != item.CommentId)
                        {
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-icon btn-sm comment-edit" aria-label="Upravit komentář" @onclick="() => this.StartEditing(item)"><Icon IconType="AppIcons.Pencil" /></button>
                                <button type="button" class="btn btn-icon btn-sm comment-delete" aria-label="Smazat komentář" @onclick="() => this.ConfirmDelete(item)"><Icon IconType="AppIcons.Trash" /></button>
                            </div>
                        }
                    </div>

                    @if (this.editingCommentId == item.CommentId)
                    {
                        <EditForm Model="this.editModel" OnValidSubmit="this.SaveEditedComment">
                            <DataAnnotationsValidator />

                            <div class="mb-2 mt-2">
                                <InputTextArea id="comment-edit-body" class="form-control" rows="4" @bind-Value="this.editModel.Body" />
                                <ValidationMessage For="() => this.editModel.Body" class="invalid-feedback d-block" />
                            </div>

                            @if (this.editError is not null)
                            {
                                <div class="alert alert-danger" role="alert"><Icon CssClass="icon me-2" IconType="AppIcons.AlertTriangle" />@this.editError</div>
                            }

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm" @onclick="this.CancelEditing"><Icon CssClass="icon" IconType="AppIcons.X" />Zrušit</button>
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@this.busy">
                                    @if (this.busy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    else
                                    {
                                        <Icon CssClass="icon" IconType="AppIcons.DeviceFloppy" />
                                    }
                                    Uložit
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="comment-body">@item.Body</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task<IReadOnlyList<CommentItem>>> LoadComments { get; set; }

    [Parameter, EditorRequired]
    public required Func<CommentEditRequest, CancellationToken, Task> AddComment { get; set; }

    [Parameter, EditorRequired]
    public required Func<Guid, CommentEditRequest, CancellationToken, Task> SaveComment { get; set; }

    [Parameter, EditorRequired]
    public required Func<Guid, CancellationToken, Task> DeleteComment { get; set; }

    private readonly CommentEditModel newModel = new();

    private readonly CommentEditModel editModel = new();

    private IReadOnlyList<CommentItem> items = [];

    private Guid? editingCommentId;

    private bool composing;

    private bool loading = true;

    private bool busy;

    private string? listFailure;

    private string? addError;

    private string? editError;

    protected override async Task OnInitializedAsync()
    {
        await this.ReloadComments();
        this.loading = false;
    }

    private async Task ReloadComments()
    {
        this.listFailure = null;

        try
        {
            this.items = await this.LoadComments(CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the comments failed");

            this.items = [];
            this.listFailure = "Komentáře se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void OpenComposer()
    {
        this.composing = true;
        this.addError = null;
        this.newModel.Body = "";
    }

    private void CloseComposer()
    {
        this.composing = false;
        this.addError = null;
    }

    private async Task AddNewComment()
    {
        this.busy = true;
        this.addError = null;

        try
        {
            await this.AddComment(new CommentEditRequest { Body = this.newModel.Body }, CancellationToken.None);

            this.newModel.Body = "";
            this.composing = false;

            await this.ReloadComments();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.addError = "Komentář se nepodařilo přidat, záznam už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Adding the comment failed");

            this.addError = "Komentář se nepodařilo přidat. Zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }

    private void StartEditing(CommentItem comment)
    {
        this.editingCommentId = comment.CommentId;
        this.editModel.Body = comment.Body;
        this.editError = null;
    }

    private void CancelEditing()
    {
        this.editingCommentId = null;
        this.editError = null;
    }

    private async Task SaveEditedComment()
    {
        if (this.editingCommentId is not { } commentId)
            return;

        this.busy = true;
        this.editError = null;

        try
        {
            await this.SaveComment(commentId, new CommentEditRequest { Body = this.editModel.Body }, CancellationToken.None);

            this.editingCommentId = null;

            await this.ReloadComments();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            this.editError = "Komentář smí upravit jen jeho autor.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.editError = "Komentář už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the comment failed");

            this.editError = "Komentář se nepodařilo uložit. Zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }

    private async Task ConfirmDelete(CommentItem comment)
    {
        await this.ModalService.ShowAsync(
            "Smazat komentář",
            new RenderComponent<CommentDeleteModal>()
                .Set(component => component.Body, comment.Body)
                .Set(component => component.DeleteComment, (CancellationToken token) => this.DeleteComment(comment.CommentId, token))
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, this.ReloadComments)),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
