@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ITextCompares Compares
@inject ILogger<MarkdownCompare> Logger

@* The read-only compare of two Markdown texts formatted: side by side or in one column, below a toolbar with the layout,
   the modes, the steps between the changes, their summary in blocks and the search, above a legend of its marks.
   Versions stands above the texts. *@
<div class="@(this.Unified ? "ec-preview-view ec-text-compare-view ec-text-compare-view-unified" : "ec-preview-view ec-text-compare-view")">
    <div class="ec-preview-toolbar ec-text-compare-toolbar" role="toolbar" aria-label="Ovládání porovnání">
        <div class="ec-segmented ec-segmented-compact ec-text-compare-layout" role="group" aria-label="Rozložení">
            <button type="button" class="ec-segment" aria-pressed="@Pressed(!this.Unified)" @onclick="() => this.UnifiedChanged.InvokeAsync(false)">Vedle sebe</button>
            <button type="button" class="ec-segment" aria-pressed="@Pressed(this.Unified)" @onclick="() => this.UnifiedChanged.InvokeAsync(true)">V jednom sloupci</button>
        </div>
        <span class="ec-preview-toolbar-separator ec-text-compare-layout" aria-hidden="true"></span>
        @this.Modes
        <span class="ec-preview-toolbar-separator" aria-hidden="true"></span>
        <div class="ec-text-compare-changes" role="group" aria-label="Změny">
            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ArrowUp" AriaLabel="Předchozí změna"
                      Disabled="@(this.view.Changes == 0)" OnClick="() => this.Step(previous: true)"><span class="ec-preview-toolbar-label">Předchozí změna</span></EcButton>
            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ArrowDown" AriaLabel="Další změna"
                      Disabled="@(this.view.Changes == 0)" OnClick="() => this.Step(previous: false)"><span class="ec-preview-toolbar-label">Další změna</span></EcButton>
            @if (this.ready)
            {
                <span class="ec-text-compare-summary"><span class="ec-text-compare-summary-added">+@this.view.Added</span> <span class="ec-text-compare-summary-removed">−@this.view.Removed</span><span class="ec-text-compare-summary-unit">@(" " + BlocksWord(this.view.Removed))</span></span>
            }
        </div>
        <ToolbarSearch @ref="this.search" Label="Hledat v dokumentu" Disabled="@(!this.ready)" Collapsible OnSearch="this.Search" />
    </div>
    <div class="ec-preview-stage ec-text-editor-stage ec-text-compare-stage">
        <div class="ec-text-compare-card">
            @this.Versions
            <div @ref="this.host" class="ec-markdown-compare"></div>
            <div class="ec-markdown-compare-legend" role="note" aria-label="Legenda">
                <span class="ec-markdown-compare-legend-item"><ins class="ec-markdown-compare-inserted">text</ins>vloženo</span>
                <span class="ec-markdown-compare-legend-item"><del class="ec-markdown-compare-deleted">text</del>smazáno</span>
                <span class="ec-markdown-compare-legend-item"><span class="ec-markdown-compare-format">text</span>změna formátu</span>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource cancel = new();

    private ElementReference host;

    private DotNetObjectReference<MarkdownCompare>? self;

    private ToolbarSearch? search;

    private bool ready;

    private bool opened;

    private CompareView view = new(Formatted: true, Formattable: true, Added: 0, Removed: 0, Changes: 0);

    /// <summary>
    /// The older text, the left one side by side.
    /// </summary>
    [Parameter, EditorRequired]
    public required string Older { get; set; }

    [Parameter, EditorRequired]
    public required string Newer { get; set; }

    /// <summary>
    /// The names of the older, the newer and the one-column text for assistive technology. Fixed for the compare's life.
    /// </summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<string> Labels { get; set; }

    /// <summary>
    /// Whether the texts show in one column; a narrow screen always shows them so.
    /// </summary>
    [Parameter]
    public bool Unified { get; set; }

    [Parameter]
    public EventCallback<bool> UnifiedChanged { get; set; }

    /// <summary>
    /// The switch between the formatted texts and their source, after the layout.
    /// </summary>
    [Parameter]
    public RenderFragment? Modes { get; set; }

    /// <summary>
    /// What stands above the texts, such as the choice of the versions.
    /// </summary>
    [Parameter]
    public RenderFragment? Versions { get; set; }

    /// <summary>
    /// Raised when the texts formatted do not differ.
    /// </summary>
    [Parameter]
    public EventCallback OnSame { get; set; }

    /// <summary>
    /// Raised when the compare's script did not start.
    /// </summary>
    [Parameter]
    public EventCallback OnUnavailable { get; set; }

    [JSInvokable]
    public void NotifyMatches(int current, int total)
    {
        this.search?.MatchesChanged(current, total, pending: false);
    }

    /// <summary>
    /// Ctrl+F or Cmd+F in a text.
    /// </summary>
    [JSInvokable]
    public async Task NotifyFind()
    {
        if (this.search is not null)
            await this.search.Focus();
    }

    public async ValueTask DisposeAsync()
    {
        await this.cancel.CancelAsync();

        if (this.opened)
        {
            try
            {
                await this.Compares.CloseCompare(this.host);
            }
            catch (JSException exception)
            {
                this.Logger.LogInformation(exception, "The compare was already gone");
            }
        }

        this.self?.Dispose();
        this.cancel.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        this.self = DotNetObjectReference.Create(this);
        this.opened = true;

        try
        {
            var shown = await this.Compares.OpenMarkdownCompare(this.host, this.Older, this.Newer, this.Labels, this.self);

            if (this.cancel.IsCancellationRequested)
            {
                await this.Compares.CloseCompare(this.host);

                return;
            }

            (this.view, this.ready) = (shown, true);
            this.StateHasChanged();

            if (shown.Changes == 0)
                await this.OnSame.InvokeAsync();
        }
        catch (JSException exception)
        {
            this.Logger.LogWarning(exception, "The Markdown compare did not start");

            if (!this.cancel.IsCancellationRequested)
                await this.OnUnavailable.InvokeAsync();
        }
    }

    private async Task Step(bool previous)
    {
        await this.Compares.StepCompareChange(this.host, previous);
    }

    private async Task Search(PreviewSearch search)
    {
        await this.Compares.FindInCompare(this.host, search.Query, search.Find);
    }

    private static string Pressed(bool value)
    {
        return value ? "true" : "false";
    }

    // 1 blok, 2 až 4 bloky, 0 a 5 a více bloků.
    private static string BlocksWord(int count)
    {
        return count switch
        {
            1 => "blok",
            >= 2 and <= 4 => "bloky",
            _ => "bloků",
        };
    }
}
