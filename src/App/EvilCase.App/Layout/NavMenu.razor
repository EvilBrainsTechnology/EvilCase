@inject IOffcanvasService OffcanvasService

<aside class="navbar navbar-vertical navbar-expand-lg d-none d-lg-flex">
    <div class="container-fluid">
        <a class="navbar-brand navbar-brand-autodark" href="">EvilCase</a>

        @* flex-grow-0 keeps the row from stretching in the vertical navbar's column layout. *@
        <div class="navbar-nav flex-row flex-grow-0">
            <ThemeSwitch />
        </div>

        <div class="navbar-collapse">
            <NavLinks />
        </div>
    </div>
</aside>

<header class="navbar navbar-expand-lg d-lg-none">
    <div class="container-fluid">
        <button type="button" class="navbar-toggler" aria-label="Otevřít navigaci" @onclick="ShowNavigationAsync">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand navbar-brand-autodark" href="">EvilCase</a>

        <div class="navbar-nav flex-row">
            <ThemeSwitch />
        </div>
    </div>
</header>

@code {
    private Task ShowNavigationAsync() => this.OffcanvasService.ShowAsync(
        "Navigace",
        new RenderComponent<NavOffcanvas>(),
        new OffcanvasOptions
        {
            WrapperCssClass = "offcanvas-nav",
            CloseOnClickOutside = true,
            CloseOnEsc = true,
        });
}
