@inject IOffcanvasService OffcanvasService

<header class="navbar navbar-expand-lg d-print-none">
    <div class="container-xl">
        <button type="button" class="navbar-toggler" aria-label="Otevřít navigaci" @onclick="ShowNavigationAsync">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand navbar-brand-autodark pe-0 pe-lg-3" href="">EvilCase</a>

        <div class="navbar-nav flex-row order-lg-last">
            <div class="nav-item">
                <ThemeSwitch />
            </div>
        </div>
    </div>
</header>

@* The menu row exists on desktop only; below lg the toggler above opens it as an offcanvas. *@
<div class="navbar navbar-expand-lg d-none d-lg-flex d-print-none">
    <div class="container-xl">
        <NavLinks />
    </div>
</div>

@code {
    private Task ShowNavigationAsync() => this.OffcanvasService.ShowAsync(
        "Navigace",
        new RenderComponent<NavOffcanvas>(),
        new OffcanvasOptions
        {
            WrapperCssClass = "offcanvas-nav",
            CloseOnClickOutside = true,
            CloseOnEsc = true,
        });
}
