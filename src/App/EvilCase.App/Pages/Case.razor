@page "/cases/{CaseId:guid}"
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Files
@using EvilBrains.EvilCase.Api.Contract.Labels
@inherits DetailPage<CaseDetail>
@inject ICasesClient CasesClient
@inject ICaseLabelsClient CaseLabelsClient
@inject ICaseCommentsClient CaseCommentsClient
@inject ICaseFilesClient CaseFilesClient

<PageTitle>@(this.Detail is null ? "Spis" : this.Detail.CaseNumber) – EvilCase</PageTitle>

<div class="ec-page">
    <span class="ec-visually-hidden" role="status">@this.Announcement</span>

    @if (this.Detail is null)
    {
        <DetailStatus NotFound="this.NotFound" NotFoundText="Spis nenalezen." Failure="@this.Failure" Retry="this.Load" />
    }
    else
    {
        <EcCard>
            <div class="ec-detail">
                <EcPageHeader Title="@this.Detail.Title" Breadcrumbs="this.Crumbs">
                    <Status>
                        <EcBadge Text="@CaseStatusDisplay.Text(this.Detail.Status)" Tone="CaseStatusDisplay.Tone(this.Detail.Status)" ShowDot="true" />
                    </Status>
                    <Actions>
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" OnClick="this.EditCase">Upravit spis</EcButton>
                        <EcMenu AriaLabel="Další akce se spisem" Items="this.CaseActions" />
                    </Actions>
                </EcPageHeader>

                @if (!string.IsNullOrWhiteSpace(this.Detail.Description))
                {
                    <p class="ec-detail-text">@CzechTypography.Text(this.Detail.Description)</p>
                }

                <div class="ec-detail-facts">
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Datum spisu</span>
                        <span class="ec-detail-fact-value">@DateDisplay.Text(this.Detail.Date)</span>
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-copyable">
                        <span class="ec-detail-fact-name">Spisová značka</span>
                        <span class="ec-detail-fact-copy">
                            <span class="ec-detail-fact-mono">@this.Detail.CaseNumber</span>
                            <CopyButton Value="@this.Detail.CaseNumber" AriaLabel="Zkopírovat spisovou značku" />
                        </span>
                    </div>
                    @if (string.IsNullOrWhiteSpace(this.Detail.ExternalCaseNumber))
                    {
                        <div class="ec-detail-fact">
                            <span class="ec-detail-fact-name">Externí spisová značka</span>
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        </div>
                    }
                    else
                    {
                        <div class="ec-detail-fact ec-detail-fact-copyable">
                            <span class="ec-detail-fact-name">Externí spisová značka</span>
                            <span class="ec-detail-fact-copy">
                                <span class="ec-detail-fact-mono">@this.Detail.ExternalCaseNumber</span>
                                <CopyButton Value="@this.Detail.ExternalCaseNumber" AriaLabel="Zkopírovat externí spisovou značku" />
                            </span>
                        </div>
                    }
                    <div class="ec-detail-fact ec-detail-fact-wide">
                        <span class="ec-detail-fact-name">Protistrana</span>
                        @if (this.Detail.Contact is { } contact)
                        {
                            <a class="ec-detail-fact-link" href="@($"/contacts/{contact.ContactId}")">@contact.Name</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Nadřízený spis</span>
                        @if (this.Detail.ParentCase is { } parent)
                        {
                            <a class="ec-detail-fact-link" href="@($"/cases/{parent.CaseId}")">@CzechTypography.Text(parent.Title)</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-labels">
                        <span class="ec-detail-fact-name">Štítky<kbd class="ec-kbd" aria-hidden="true">L</kbd></span>
                        <LabelField Inline InputId="case-labels" Selected="this.Detail.Labels" SelectedChanged="this.SaveLabels" />
                        @if (this.LabelsError is not null)
                        {
                            <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.LabelsError</div>
                        }
                    </div>
                </div>
            </div>
        </EcCard>

        <div class="ec-detail-layout">
            <div class="ec-detail-main ec-case-acts">
                <ActList @key="(nameof(ActList), this.CaseId)"
                         Columns="ActColumns"
                         Filter="this.ActFilter"
                         Title="Úkony"
                         CaseContactId="this.Detail.Contact?.ContactId"
                         ShowSearch="true"
                         ShowDates="true"
                         ShowLabelFilter="true"
                         ShowDirectionFilter="true"
                         ShowPaging="true"
                         EmptyText="Zatím tu není žádný úkon.">
                    <Actions>
                        <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Compact" Icon="@AppIcons.Plus"
                                  Href="@(ActRoutes.New(this.CaseId))">Nový úkon</EcButton>
                    </Actions>
                    <EmptyAction>
                        <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus"
                                  Href="@(ActRoutes.New(this.CaseId))">Založit úkon</EcButton>
                    </EmptyAction>
                </ActList>
            </div>

            <aside class="ec-detail-aside">
                <CaseChildrenCard ParentCaseId="this.CaseId" />

                <FilesCard @key="(nameof(FilesCard), this.CaseId)"
                           Title="Soubory spisu"
                           OwnerGoneError="spis už neexistuje."
                           LoadFiles="this.LoadFiles"
                           UploadFile="this.UploadFile"
                           DownloadFile="this.DownloadFile"
                           LoadContent="this.LoadFileContent"
                           RenameFile="this.RenameFile"
                           DeleteFile="this.DeleteFile"
                           UploadTarget="k spisu"
                           Compact="true" />

                <CommentsCard @key="(nameof(CommentsCard), this.CaseId)"
                              Title="Komentáře spisu"
                              Placeholder="Poznámka ke spisu…"
                              LoadComments="this.LoadComments"
                              AddComment="this.AddComment"
                              SaveComment="this.SaveComment"
                              DeleteComment="this.DeleteComment"
                              Compact="true" />
            </aside>
        </div>
    }
</div>

@if (this.deleting && this.Detail is not null)
{
    <CaseDeleteModal Case="this.Detail" Open OpenChanged="this.CloseDelete" OnDeleted="this.CaseDeleted" />
}

@code {
    private const int ActItems = 20;

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Date,
        ActColumn.ActWithLabels,
        ActColumn.Direction,
        ActColumn.Contact,
        ActColumn.ActNumberInCase,
    ];

    [Parameter]
    public Guid CaseId { get; set; }

    private bool deleting;

    protected override string LoadFailedText => "Spis se nepodařilo načíst. Zkuste to za chvíli znovu.";

    protected override string GoneText => "Spis už neexistuje.";

    protected override string LinkCopiedText => "Odkaz na spis zkopírován.";

    protected override string LinkPath => $"/cases/{this.CaseId}";

    private ActListRequest ActFilter => new() { CaseId = this.CaseId, Take = ActItems };

    private IReadOnlyList<EcCrumb> Crumbs => this.Detail is null
        ? [new EcCrumb("Spisy", "/cases")]
        : [new EcCrumb("Spisy", "/cases"), new EcCrumb(this.Detail.CaseNumber, null, Mono: true)];

    private IReadOnlyList<EcMenuItem> CaseActions
    {
        get
        {
            return
            [
                new EcMenuItem { Text = "Nový úkon", Icon = AppIcons.Plus, OnSelect = EventCallback.Factory.Create(this, this.OpenNewAct) },
                new EcMenuItem { Text = "Nový podřízený spis", Icon = AppIcons.FolderPlus, OnSelect = EventCallback.Factory.Create(this, this.OpenNewChildCase) },
                new EcMenuItem { Text = "Zkopírovat odkaz na spis", Icon = AppIcons.Link, OnSelect = EventCallback.Factory.Create(this, this.CopyLink) },
                new EcMenuItem { Text = "Smazat spis…", Icon = AppIcons.Trash, OnSelect = EventCallback.Factory.Create(this, this.StartDeleting), Danger = true, DividerBefore = true },
            ];
        }
    }

    protected override Task<CaseDetail> Fetch()
    {
        return this.CasesClient.GetCase(this.CaseId, CancellationToken.None);
    }

    protected override Task StoreLabels(LabelAssignmentRequest request)
    {
        return this.CaseLabelsClient.SetCaseLabels(this.CaseId, request, CancellationToken.None);
    }

    private void EditCase()
    {
        this.Navigation.NavigateTo($"/cases/{this.CaseId}/edit");
    }

    private void OpenNewAct()
    {
        this.Navigation.NavigateTo(ActRoutes.New(this.CaseId));
    }

    private void OpenNewChildCase()
    {
        this.Navigation.NavigateTo($"/cases/new?parent={this.CaseId}");
    }

    private void StartDeleting()
    {
        this.deleting = true;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = false;
    }

    private void CaseDeleted()
    {
        this.deleting = false;

        this.Navigation.NavigateTo("/cases");
    }

    private async Task<IReadOnlyList<FileListItem>> LoadFiles(CancellationToken token)
    {
        return (await this.CaseFilesClient.ListCaseFiles(this.CaseId, token)).Items;
    }

    private Task UploadFile(IBrowserFile file, CancellationToken token)
    {
        return this.FileTransfer.UploadCaseFile(this.CaseId, file, token);
    }

    private Task RenameFile(FileListItem file, string fileName, CancellationToken token)
    {
        return this.CaseFilesClient.RenameCaseFile(this.CaseId, file.FileId, new FileRenameRequest { FileName = fileName }, token);
    }

    private Task DeleteFile(FileListItem file, CancellationToken token)
    {
        return this.CaseFilesClient.DeleteCaseFile(this.CaseId, file.FileId, token);
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.CaseCommentsClient.ListCaseComments(this.CaseId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.CaseCommentsClient.AddCaseComment(this.CaseId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.CaseCommentsClient.EditCaseComment(this.CaseId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.CaseCommentsClient.DeleteCaseComment(this.CaseId, commentId, token);
    }
}
