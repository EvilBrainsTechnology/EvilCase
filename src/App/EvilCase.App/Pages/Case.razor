@page "/cases/{CaseId:guid}"
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Labels
@inherits DetailPage<CaseDetail>
@inject ICasesClient CasesClient
@inject ICaseLabelsClient CaseLabelsClient
@inject ICaseCommentsClient CaseCommentsClient
@inject ILogger<Case> FilesLogger

<PageTitle>@(this.Detail is null ? "Spis" : this.Detail.Title) – EvilCase</PageTitle>

<div class="ec-page">
    <span class="ec-visually-hidden" role="status">@this.Announcement</span>

    @if (this.Detail is null)
    {
        <DetailStatus NotFound="this.NotFound" NotFoundText="Spis nenalezen." BackHref="/cases" BackText="Zpět na spisy" Failure="@this.Failure" Retry="this.Load" />
    }
    else
    {
        <EcCard>
            <div class="ec-detail">
                <EcPageHeader Title="@this.Detail.Title" Breadcrumbs="this.Crumbs">
                    <Status>
                        <EcBadge Text="@CaseStatusDisplay.Text(this.Detail.Status)" Tone="CaseStatusDisplay.Tone(this.Detail.Status)" ShowDot="true" />
                    </Status>
                    <Actions>
                        @if (this.Detail.FileCount > 0)
                        {
                            <span class="ec-case-files-button">
                                <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Files" OnClick="this.OpenFiles">Soubory<span class="ec-case-files-count">@this.Detail.FileCount</span></EcButton>
                            </span>
                        }
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" OnClick="this.EditCase">Upravit<span class="ec-text-wide"> spis</span></EcButton>
                        <EcMenu AriaLabel="Další akce se spisem" Title="@this.Detail.Title" Items="this.CaseActions" />
                    </Actions>
                </EcPageHeader>

                @if (!string.IsNullOrWhiteSpace(this.Detail.Description))
                {
                    <p class="ec-detail-text"><LinkedText Text="@this.Detail.Description" /></p>
                }

                <div class="ec-detail-facts">
                    <div class="ec-detail-fact ec-detail-fact-fixed">
                        <span class="ec-detail-fact-name">Datum spisu</span>
                        <span class="ec-detail-fact-value">@DateDisplay.Text(this.Detail.Date)</span>
                    </div>
                    @if (this.Detail.FileCount > 0)
                    {
                        @* Below lg the header's Soubory button gives way to this row. *@
                        <div class="ec-detail-fact ec-case-files-fact">
                            <span class="ec-detail-fact-name">Soubory</span>
                            <button type="button" class="ec-case-files-fact-button" @onclick="this.OpenFiles">
                                <EcIcon Paths="@AppIcons.Files" />
                                <span class="ec-case-files-fact-text">@CaseFileTreeDisplay.TreeText(this.Detail.FileCount, this.Detail.FileActCount)</span>
                                <EcIcon Paths="@AppIcons.ChevronRight" />
                            </button>
                        </div>
                    }
                    <div class="ec-detail-fact ec-detail-fact-copyable ec-detail-fact-fixed">
                        <span class="ec-detail-fact-name">Spisová značka</span>
                        <span class="ec-detail-fact-copy">
                            <span class="ec-detail-fact-mono">@this.Detail.CaseNumber</span>
                            <CopyButton Value="@this.Detail.CaseNumber" AriaLabel="Zkopírovat spisovou značku" />
                        </span>
                    </div>
                    @if (string.IsNullOrWhiteSpace(this.Detail.ExternalCaseNumber))
                    {
                        <div class="ec-detail-fact ec-detail-fact-fixed">
                            <span class="ec-detail-fact-name">Externí spisová značka</span>
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        </div>
                    }
                    else
                    {
                        <div class="ec-detail-fact ec-detail-fact-copyable ec-detail-fact-fixed">
                            <span class="ec-detail-fact-name">Externí spisová značka</span>
                            <span class="ec-detail-fact-copy">
                                <span class="ec-detail-fact-mono">@this.Detail.ExternalCaseNumber</span>
                                <CopyButton Value="@this.Detail.ExternalCaseNumber" AriaLabel="Zkopírovat externí spisovou značku" />
                            </span>
                        </div>
                    }
                    <div class="ec-detail-fact ec-detail-fact-wide">
                        <span class="ec-detail-fact-name">Protistrana</span>
                        @if (this.Detail.Contact is { } contact)
                        {
                            <a class="ec-detail-fact-link" href="@($"/contacts/{contact.ContactId}")">@contact.Name</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Nadřízený spis</span>
                        @if (this.Detail.ParentCase is { } parent)
                        {
                            <a class="ec-detail-fact-link" href="@($"/cases/{parent.CaseId}")">@parent.Title</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-labels">
                        <span class="ec-detail-fact-name">Štítky<kbd class="ec-kbd" aria-hidden="true">L</kbd></span>
                        <LabelField Inline InputId="case-labels" SheetTitle="Štítky spisu" Selected="this.Detail.Labels" SelectedChanged="this.SaveLabels" />
                        @if (this.LabelsError is not null)
                        {
                            <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.LabelsError</div>
                        }
                    </div>
                </div>
            </div>
        </EcCard>

        <DetailAnchors Path="@this.LinkPath" Anchors="this.Anchors" />

        <div class="ec-detail-halves">
            <ActList @key="(nameof(ActList), this.CaseId)"
                     Id="acts"
                     TotalChanged="count => this.actCount = count"
                     Columns="ActColumns"
                     Filter="this.ActFilter"
                     Title="Úkony"
                     CaseContactId="this.Detail.Contact?.ContactId"
                     ShowSearch="true"
                     ShowDates="true"
                     ShowLabelFilter="true"
                     ShowDirectionFilter="true"
                     ShowPaging="true"
                     EmptyText="Zatím tu není žádný úkon.">
                <Actions>
                    <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Compact" Icon="@AppIcons.Plus"
                              Href="@($"/acts/new?case={this.CaseId}")">Nový úkon</EcButton>
                </Actions>
                <EmptyAction>
                    <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus"
                              Href="@($"/acts/new?case={this.CaseId}")">Založit úkon</EcButton>
                </EmptyAction>
            </ActList>

            <CaseList @key="(nameof(CaseList), this.CaseId)"
                      Id="children"
                      TotalChanged="count => this.childCount = count"
                      Columns="ChildColumns"
                      Filter="this.ChildFilter"
                      Title="Podřízené spisy"
                      DateHeader="Datum"
                      InputPrefix="children"
                      ShowSearch="true"
                      ShowStatusFilter="true"
                      HideToolbarWhenEmpty="true"
                      ShowPaging="true"
                      EmptyText="Zatím tu není žádný podřízený spis.">
                <Actions>
                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Plus"
                              Href="@($"/cases/new?parent={this.CaseId}")" AriaLabel="Nový podřízený spis"><span class="ec-text-wide">Nový podřízený spis</span></EcButton>
                </Actions>
            </CaseList>
        </div>

        <CommentsCard @key="(nameof(CommentsCard), this.CaseId)"
                      Id="comments"
                      CountChanged="count => this.commentCount = count"
                      Title="Komentáře spisu"
                      Placeholder="Poznámka ke spisu…"
                      LoadComments="this.LoadComments"
                      AddComment="this.AddComment"
                      SaveComment="this.SaveComment"
                      DeleteComment="this.DeleteComment" />
    }
</div>

@if (this.filesOpen && this.Detail is { } filesCase)
{
    <CaseFilesModal @key="filesCase.CaseId" CaseId="filesCase.CaseId" CaseTitle="@filesCase.Title" OnClosed="this.CloseFiles" />
}

@if (this.deleting && this.Detail is { } deletedCase)
{
    <ConfirmModal Title="Smazat spis" ConfirmText="Smazat spis" Action="token => this.CasesClient.DeleteCase(deletedCase.CaseId, token)"
                  NotFoundText="Spis už neexistuje." FailureText="Spis se nepodařilo smazat. Zkuste to za chvíli znovu."
                  Open OpenChanged="this.CloseDelete" OnDone="this.CaseDeleted">
        <p class="ec-confirm-text">
            Opravdu smazat spis <strong>@deletedCase.CaseNumber</strong> – @deletedCase.Title? Se spisem zaniknou
            jeho podřízené spisy, úkony, komentáře a soubory. Akci nelze vrátit zpět.
        </p>
    </ConfirmModal>
}

@code {
    private const int PageItems = 20;

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Date,
        ActColumn.ActWithContact,
        ActColumn.MainFile,
        ActColumn.Direction,
        ActColumn.Status,
        ActColumn.Changed,
    ];

    private static readonly CaseColumn[] ChildColumns =
    [
        CaseColumn.Date,
        CaseColumn.Case,
        CaseColumn.Files,
        CaseColumn.Status,
        CaseColumn.Changed,
    ];

    [Parameter]
    public Guid CaseId { get; set; }

    private bool deleting;

    private bool filesOpen;

    private Guid countedCaseId;

    private int? childCount;

    private int? actCount;

    private int? commentCount;

    private IReadOnlyList<DetailAnchor> Anchors =>
    [
        new DetailAnchor("Úkony", "acts", () => this.actCount),
        new DetailAnchor("Podřízené spisy", "children", () => this.childCount),
        new DetailAnchor("Komentáře", "comments", () => this.commentCount),
    ];

    protected override string LoadFailedText => "Spis se nepodařilo načíst. Zkuste to za chvíli znovu.";

    protected override string GoneText => "Spis už neexistuje.";

    protected override string LinkCopiedText => "Odkaz na spis zkopírován.";

    protected override string LinkPath => $"/cases/{this.CaseId}";

    private ActListRequest ActFilter => new() { CaseId = this.CaseId, Take = PageItems };

    private CaseListRequest ChildFilter => new() { ParentCaseId = this.CaseId, Take = PageItems };

    private IReadOnlyList<EcCrumb> Crumbs => this.Detail is null
        ? [new EcCrumb("Spisy", "/cases")]
        : [
            .. CaseCrumbs.Through(this.Detail.Ancestors),
            new EcCrumb(this.Detail.Title, null),
        ];

    private IReadOnlyList<EcMenuItem> CaseActions
    {
        get
        {
            return
            [
                new EcMenuItem { Text = "Nový úkon", Icon = AppIcons.Plus, OnSelect = EventCallback.Factory.Create(this, this.OpenNewAct) },
                new EcMenuItem { Text = "Nový podřízený spis", Icon = AppIcons.FolderPlus, OnSelect = EventCallback.Factory.Create(this, this.OpenNewChildCase) },
                new EcMenuItem { Text = "Zkopírovat odkaz na spis", Icon = AppIcons.Link, OnSelect = EventCallback.Factory.Create(this, this.CopyLink) },
                new EcMenuItem { Text = "Smazat spis", Icon = AppIcons.Trash, OnSelect = EventCallback.Factory.Create(this, this.StartDeleting), Danger = true, DividerBefore = true },
            ];
        }
    }

    protected override void OnParametersSet()
    {
        // Another case starts without the counts of the last one.
        if (this.countedCaseId == this.CaseId)
            return;

        this.countedCaseId = this.CaseId;
        this.childCount = null;
        this.actCount = null;
        this.commentCount = null;
    }

    protected override Task<CaseDetail> Fetch()
    {
        return this.CasesClient.GetCase(this.CaseId, CancellationToken.None);
    }

    protected override Task StoreLabels(CaseDetail detail, LabelAssignmentRequest request)
    {
        return this.CaseLabelsClient.SetCaseLabels(detail.CaseId, request, CancellationToken.None);
    }

    protected override CaseDetail WithLabels(CaseDetail detail, IReadOnlyList<LabelItem> labels)
    {
        return detail with { Labels = labels };
    }

    private void EditCase()
    {
        this.Navigation.NavigateTo($"/cases/{this.CaseId}/edit");
    }

    private void OpenNewAct()
    {
        this.Navigation.NavigateTo($"/acts/new?case={this.CaseId}");
    }

    private void OpenNewChildCase()
    {
        this.Navigation.NavigateTo($"/cases/new?parent={this.CaseId}");
    }

    private void OpenFiles()
    {
        this.filesOpen = true;
    }

    // The tree's preview may have changed the files; the page takes their new counts.
    private async Task CloseFiles()
    {
        this.filesOpen = false;

        try
        {
            var fresh = await this.Fetch();

            if (this.Detail?.CaseId == fresh.CaseId)
                this.Detail = this.Detail with { FileCount = fresh.FileCount, FileActCount = fresh.FileActCount };
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.FilesLogger.LogWarning(exception, "Counting the files of case {CaseId} failed", this.CaseId);
        }
    }

    private void StartDeleting()
    {
        this.deleting = true;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = false;
    }

    private void CaseDeleted()
    {
        this.deleting = false;

        this.Navigation.NavigateTo("/cases");
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.CaseCommentsClient.ListCaseComments(this.CaseId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.CaseCommentsClient.AddCaseComment(this.CaseId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.CaseCommentsClient.EditCaseComment(this.CaseId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.CaseCommentsClient.DeleteCaseComment(this.CaseId, commentId, token);
    }
}
