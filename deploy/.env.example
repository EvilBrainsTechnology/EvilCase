# Compose variables for the deployment. Copy to .env next to docker-compose.yml (.env is never
# committed). The database is not part of the stack; the connection string points at an existing one.

# Image tag to run: a release version (1.2.3), latest, or edge for the current master.
EVILCASE_TAG=latest

# Host port the application is published on. It is bound to 127.0.0.1: the container trusts the
# forwarded headers of the reverse proxy in front, so nothing else may reach it.
EVILCASE_PORT=8080

EVILCASE_CONNECTION_STRING=Host=db.example.com;Port=5432;Database=evilcase;Username=evilcase;Password=

# Signing key for the JWT tokens, at least 32 characters. Startup fails on an empty or shorter one.
EVILCASE_JWT_KEY=

# Seq server of this environment. Empty means no Seq logging at all.
# An empty API key ships anonymously, which a Seq requiring one rejects.
EVILCASE_SEQ_URL=
EVILCASE_SEQ_API_KEY=

# Where more than one instance starts at once, roll the schema out separately and add
# EvilBrains__EvilCase__Database__MigrateOnStartup=false to the service environment: nothing
# serialises concurrent migrators. CI publishes an idempotent database.sql artifact for that.
