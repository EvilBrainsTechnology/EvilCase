@using System.Diagnostics
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Lists
@using EvilBrains.EvilCase.Domain.Acts
@inherits FilteredListComponent<ActListRequest>
@inject IActsClient ActsClient

@{
    var columns = new List<EcColumn<ActListItem>>();

    foreach (var column in this.Columns)
    {
        columns.Add(column switch
        {
            ActColumn.Changed => new EcColumn<ActListItem>
            {
                Header = "Změněno",
                Width = "var(--ec-list-col-moment)",
                SortKey = nameof(ActSortKey.Changed),
                CellClass = "ec-cell-num",
                Cell = item =>@<span data-tooltip="@MomentDisplay.Text(item.Changed)"><span aria-hidden="true">@MomentDisplay.Relative(item.Changed, DateTime.Now)</span><span class="ec-visually-hidden">@MomentDisplay.Text(item.Changed)</span></span>,
            },
            ActColumn.Date => new EcColumn<ActListItem>
            {
                Header = this.DateHeader,
                Width = "var(--ec-list-col-date)",
                SortKey = nameof(ActSortKey.Date),
                CellClass = "ec-cell-num ec-cell-date",
                Cell = item =>@<text>@DateDisplay.Text(item.Date)</text>,
            },
            ActColumn.Direction => new EcColumn<ActListItem>
            {
                Header = "Směr",
                Width = "var(--ec-list-col-status)",
                Cell = item =>@<text>
                    @if (item.Direction is { } direction)
                    {
                        <EcBadge Text="@ActDirectionDisplay.Text(direction)" Tone="ActDirectionDisplay.Tone(direction)" Icon="@ActDirectionDisplay.Icon(direction)" />
                    }
                    else
                    {
                        <span class="ec-cell-empty">—</span>
                    }
                </text>,
            },
            ActColumn.Status => new EcColumn<ActListItem>
            {
                Header = "Stav",
                Width = "var(--ec-list-col-act-status)",
                Cell = item =>@<text>
                    @if (item.Status is { } status)
                    {
                        <EcBadge Text="@ActStatusDisplay.Text(status)" Tone="ActStatusDisplay.Tone(status)" ShowDot="true" />
                    }
                    else
                    {
                        <span class="ec-cell-empty">—</span>
                    }
                </text>,
            },
            ActColumn.Contact => new EcColumn<ActListItem>
            {
                Header = "Kontakt",
                Width = "var(--ec-list-col-contact)",
                CellClass = "ec-cell-contact",
                Cell = item =>@<text>
                    @if (string.IsNullOrEmpty(item.ContactName))
                    {
                        <span class="ec-cell-empty">—</span>
                    }
                    else
                    {
                        <span class="@this.ContactClass(item)">@item.ContactName</span>
                    }
                </text>,
            },
            ActColumn.ActWithLabels => new EcColumn<ActListItem>
            {
                Header = "Úkon",
                Width = "minmax(0, 1fr)",
                SortKey = nameof(ActSortKey.Title),
                Primary = true,
                Cell = item =>@<text>
                    <span class="ec-cell-text" data-tooltip-overflow>@item.Title</span>
                    <LabelChips Labels="item.Labels" />
                </text>,
            },
            ActColumn.ActAndCase => new EcColumn<ActListItem>
            {
                Header = "Úkon a spis",
                Width = "minmax(0, 1fr)",
                SortKey = nameof(ActSortKey.Title),
                Primary = true,
                CellClass = "ec-cell-stack",
                Cell = item =>@<text>
                    <span class="ec-cell-line">
                        <span class="ec-cell-text" data-tooltip-overflow>@item.Title</span>
                        <LabelChips Labels="item.Labels" />
                    </span>
                    <span class="ec-cell-text ec-cell-sub" data-tooltip-overflow>@item.CaseTitle</span>
                </text>,
            },
            ActColumn.MainFile => new EcColumn<ActListItem>
            {
                Header = "Soubor",
                Width = "var(--ec-list-col-main-file)",
                CellClass = "ec-cell-main-file",
                Cell = item =>@<text>
                    @if (item.MainFile is { } main)
                    {
                        @* Inside the row's link: the click opens the preview and never follows the row. *@
                        <button type="button" class="ec-main-file" aria-label="@main.FileName" data-tooltip="@main.FileName"
                                @onclick="() => this.OpenMainFile(item.ActId, main.FileId)" @onclick:preventDefault @onclick:stopPropagation>
                            <EcFileIcon FileName="@main.FileName" Size="EcFileIconSize.Compact" />
                        </button>
                    }
                </text>,
            },
            _ => throw new UnreachableException(),
        });
    }
}

<EcTable TItem="ActListItem" Id="@this.Id"
         Title="@this.Title" Actions="this.Actions"
         ShowToolbar="this.ToolbarShown"
         Columns="columns" Items="this.items" RowHref="RowHref"
         SortKey="@this.sort.ToString()"
         SortDescending="@(this.Direction == ListSortDirection.Descending)"
         SortChanged="this.OnSortChanged" AllowSorting="!this.HideSorting"
         Loading="this.Loading" Failure="@this.Failure" Retry="this.ReloadFirstPage"
         Skip="this.Skip" Take="this.Filter.Take" Total="this.Total"
         ShowPaging="this.ShowPaging" Previous="this.ToPreviousPage" Next="this.ToNextPage">
    <Toolbar>
        @if (this.ShowSearch)
        {
            <label class="ec-search ec-search-grow" for="@($"{this.InputPrefix}-search")">
                <EcIcon Paths="@AppIcons.Search" Size="EcIconSize.Small" />
                <input id="@($"{this.InputPrefix}-search")" type="search" class="ec-search-input" aria-label="Hledat v úkonech"
                       placeholder="Hledat v názvu, popisu a čísle" value="@this.SearchText" @oninput="this.OnSearchInput" />
            </label>
        }

        @if (this.ShowDirectionFilter)
        {
            @* Below lg a select takes the switch's place. *@
            <label class="ec-select-labeled ec-select-narrow" for="@($"{this.InputPrefix}-direction")">
                <span class="ec-select-labeled-name">Směr</span>
                <select id="@($"{this.InputPrefix}-direction")" class="ec-select" @onchange="this.OnDirectionSelected">
                    @foreach (var value in DirectionFilters)
                    {
                        <option value="@(value?.ToString() ?? "")" selected="@(this.direction == value)">@(value is null ? "Vše" : ActDirectionDisplay.Text(value))</option>
                    }
                </select>
            </label>
            <div class="ec-segmented ec-segmented-compact" role="group" aria-label="Směr úkonu">
                @foreach (var value in DirectionFilters)
                {
                    var suffix = value is null ? "all" : ActDirectionDisplay.Css(value.Value);

                    <button id="@($"{this.InputPrefix}-direction-{suffix}")" type="button" class="ec-segment"
                            aria-pressed="@(this.direction == value ? "true" : "false")" @onclick="() => this.SetDirection(value)">
                        @if (value is not null)
                        {
                            <EcIcon Paths="@ActDirectionDisplay.Icon(value.Value)" Size="EcIconSize.Small" />
                        }
                        @(value is null ? "Vše" : ActDirectionDisplay.Text(value))
                    </button>
                }
            </div>
        }

        @if (this.ShowStatusFilter)
        {
            <label class="ec-select-labeled" for="@($"{this.InputPrefix}-status")">
                <span class="ec-select-labeled-name">Stav</span>
                <select id="@($"{this.InputPrefix}-status")" class="ec-select" @onchange="this.OnStatusSelected">
                    @foreach (var value in Enum.GetValues<ActStatusFilter>())
                    {
                        <option value="@value" selected="@(value == this.status)">@ActStatusDisplay.FilterText(value)</option>
                    }
                </select>
            </label>
        }

        @if (this.ShowDates || this.ShowLabelFilter)
        {
            <ListFilters InputPrefix="@this.InputPrefix" ShowDates="this.ShowDates" ShowLabelFilter="this.ShowLabelFilter"
                         From="this.From" To="this.To" SelectedLabels="this.SelectedLabels" ActiveCount="this.ActiveFilterCount"
                         FromChanged="this.OnFromInput" ToChanged="this.OnToInput" LabelsChanged="this.OnLabelsChanged"
                         Cleared="this.ClearFilters" ShowText="@($"Zobrazit {Plural.Text(this.Total, "úkon", "úkony", "úkonů")}")">
                @if (this.ShowCaseStatusFilter)
                {
                    <label class="ec-check" for="@($"{this.InputPrefix}-open-cases-sheet")">
                        <input id="@($"{this.InputPrefix}-open-cases-sheet")" type="checkbox" class="ec-check-box"
                               checked="@(this.caseStatus == CaseStatusFilter.Open)" @onchange="this.OnCaseStatusChanged" />
                        Jen z otevřených spisů
                    </label>
                }
            </ListFilters>
        }

        @if (this.ShowCaseStatusFilter)
        {
            <label class="ec-check" for="@($"{this.InputPrefix}-open-cases")">
                <input id="@($"{this.InputPrefix}-open-cases")" type="checkbox" class="ec-check-box"
                       checked="@(this.caseStatus == CaseStatusFilter.Open)" @onchange="this.OnCaseStatusChanged" />
                Jen z otevřených spisů
            </label>
        }
    </Toolbar>
    <Empty>
        <EcEmptyState Icon="@AppIcons.FileText" Text="@(this.IsFiltered ? FilteredEmptyText : this.EmptyText)" Action="this.EmptyAction" />
    </Empty>
</EcTable>

@if (this.previewed is { } previewed)
{
    <ActFilePreview @key="previewed" ActId="previewed.ActId" FileId="previewed.FileId" OnChanged="this.ReloadPage" OnClosed="this.CloseMainFile" />
}

@code {
    private const string FilteredEmptyText = "Filtru neodpovídá žádný úkon.";

    private static readonly ActDirection?[] DirectionFilters = [null, ActDirection.Incoming, ActDirection.Outgoing];

    [Parameter, EditorRequired]
    public required IReadOnlyList<ActColumn> Columns { get; set; }

    [Parameter, EditorRequired]
    public required ActListRequest Filter { get; set; }

    /// <summary>
    /// Heads the date column; a list outside one case names the act.
    /// </summary>
    [Parameter]
    public string DateHeader { get; set; } = "Datum";

    [Parameter]
    public string? Title { get; set; }

    /// <summary>The target of a section anchor.</summary>
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = FilteredEmptyText;

    [Parameter]
    public RenderFragment? EmptyAction { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public bool ShowDates { get; set; }

    [Parameter]
    public bool ShowLabelFilter { get; set; }

    [Parameter]
    public bool ShowDirectionFilter { get; set; }

    [Parameter]
    public bool ShowStatusFilter { get; set; }

    [Parameter]
    public bool ShowCaseStatusFilter { get; set; }

    [Parameter]
    public bool ShowPaging { get; set; }

    /// <summary>
    /// Hides the toolbar while the list is empty and no filter is set, so an empty card shows no filters.
    /// </summary>
    [Parameter]
    public bool HideToolbarWhenEmpty { get; set; }

    [Parameter]
    public bool HideSorting { get; set; }

    [Parameter]
    public EventCallback<int> TotalChanged { get; set; }

    /// <summary>
    /// Prefixes the ids of the toolbar's inputs, so two lists on one page never share one.
    /// </summary>
    [Parameter]
    public string InputPrefix { get; set; } = "acts";

    /// <summary>
    /// The case's counterparty: an act with this contact shows it muted, an act with another one emphasised.
    /// </summary>
    [Parameter]
    public Guid? CaseContactId { get; set; }

    private IReadOnlyList<ActListItem> items = [];

    private ActSortKey sort;

    private ActDirection? direction;

    private ActStatusFilter status;

    private CaseStatusFilter caseStatus;

    private ActListRequest? seeded;

    private (Guid ActId, Guid FileId)? previewed;

    protected override int PageSize => this.Filter.Take;

    protected override string FailureText => "Seznam úkonů se nepodařilo načíst. Zkuste to za chvíli znovu.";

    private bool HasFilters => this.ShowSearch || this.ShowDates || this.ShowLabelFilter || this.ShowDirectionFilter || this.ShowStatusFilter
        || this.ShowCaseStatusFilter;

    private bool ToolbarShown => this.HasFilters && !(this.HideToolbarWhenEmpty && this.IsEmptyUnfiltered);

    private bool IsEmptyUnfiltered => !this.Loading && this.Failure is null && this.Total == 0 && !this.IsFiltered;

    private bool IsFiltered => this.Search is not null || this.direction != this.Filter.Direction || this.status != this.Filter.Status
        || this.caseStatus != this.Filter.CaseStatus || this.ActiveFilterCount > 0;

    protected override void OnInitialized()
    {
        this.sort = this.Filter.Sort;
        this.Direction = this.Filter.SortDirection;
    }

    // A host filter with another direction, status or case status, e.g. a new address, resets the toolbar to it.
    protected override Task OnParametersSetAsync()
    {
        if (this.seeded?.Direction != this.Filter.Direction)
            this.direction = this.Filter.Direction;

        if (this.seeded?.Status != this.Filter.Status)
            this.status = this.Filter.Status;

        if (this.seeded?.CaseStatus != this.Filter.CaseStatus)
            this.caseStatus = this.Filter.CaseStatus;

        this.seeded = this.Filter;

        return this.ReloadOnFilterChange(this.Filter, this.Filter.Search);
    }

    protected override async Task<int> LoadPage(CancellationToken token)
    {
        var request = this.Filter with
        {
            Search = this.Search,
            From = this.From,
            To = this.To,
            LabelIds = this.LabelIds,
            Direction = this.direction,
            Status = this.status,
            CaseStatus = this.caseStatus,
            Sort = this.sort,
            SortDirection = this.Direction,
            Skip = this.Skip,
        };

        var response = await this.ActsClient.ListActs(request, token);

        this.items = response.Items;

        await this.TotalChanged.InvokeAsync(response.TotalCount);

        return response.TotalCount;
    }

    private static string RowHref(ActListItem item)
    {
        return $"/acts/{item.ActId}";
    }

    private static ListSortDirection NaturalDirection(ActSortKey key)
    {
        return key is ActSortKey.Date or ActSortKey.Changed ? ListSortDirection.Descending : ListSortDirection.Ascending;
    }

    private Task OnSortChanged(string key)
    {
        return this.SortBy(Enum.Parse<ActSortKey>(key));
    }

    private Task SetDirection(ActDirection? value)
    {
        this.direction = value;

        return this.ReloadFirstPage();
    }

    private Task OnDirectionSelected(ChangeEventArgs args)
    {
        return this.SetDirection(Enum.TryParse<ActDirection>(args.Value as string, out var value) ? value : null);
    }

    private Task OnStatusSelected(ChangeEventArgs args)
    {
        this.status = Enum.Parse<ActStatusFilter>(args.Value as string ?? "");

        return this.ReloadFirstPage();
    }

    private Task OnCaseStatusChanged(ChangeEventArgs args)
    {
        this.caseStatus = (bool)(args.Value ?? false) ? CaseStatusFilter.Open : CaseStatusFilter.All;

        return this.ReloadFirstPage();
    }

    private Task SortBy(ActSortKey key)
    {
        if (key == this.sort)
        {
            this.TurnDirection();
        }
        else
        {
            this.sort = key;
            this.Direction = NaturalDirection(key);
        }

        return this.ReloadFirstPage();
    }

    private void OpenMainFile(Guid actId, Guid fileId)
    {
        this.previewed = (actId, fileId);
    }

    private void CloseMainFile()
    {
        this.previewed = null;
    }

    private string ContactClass(ActListItem item)
    {
        if (this.CaseContactId is null || item.ContactId is null)
            return "ec-cell-text";

        return item.ContactId == this.CaseContactId ? "ec-cell-text ec-cell-muted" : "ec-cell-text ec-cell-strong";
    }
}
