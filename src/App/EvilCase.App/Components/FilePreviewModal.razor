@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using EvilBrains.EvilCase.App.Navigation
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IDisposable
@inject IBrowserFiles BrowserFiles
@inject ILogger<FilePreviewModal> Logger
@inject IBrowserHistory History
@inject NavigationManager Navigation

@if (this.Current is { } file)
{
    var attachment = this.ShownAttachment;
    var shownName = attachment?.Name ?? file.FileName;
    // A signed document shows what it carries, by the name without the signature suffix or by the type its content shows.
    var stagedName = this.contentPreview?.SignedContentName ?? shownName;
    var preview = FileTypeDisplay.Preview(stagedName);
    var shownVersion = this.ShownVersionItem;

    <EcModal Title="@shownName" Large Maximizable Open="this.Open" OpenChanged="this.OpenChanged" OnCloseRequest="this.CloseRequest">
        <Heading>
            @if (attachment is not null)
            {
                var (_, ownerName, owner, position) = this.trail[^1];

                <div class="ec-preview-back">
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ArrowLeft" AriaLabel="Zpět na zprávu" OnClick="this.BackToMessage"><span class="ec-preview-action-label">Zpráva</span></EcButton>
                </div>
                <EcFileIcon FileName="@attachment.Name" />
                <div class="ec-preview-title">
                    <h2 class="ec-preview-name" data-tooltip-overflow>@attachment.Name</h2>
                    <span class="ec-preview-meta">@FileSizeDisplay.Text(attachment.Content.Length) <span class="ec-sep" aria-hidden="true">·</span> příloha zprávy @ownerName</span>
                </div>
                <div class="ec-preview-actions">
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="Stáhnout přílohu" OnClick="() => this.DownloadAttachment(attachment)"><span class="ec-preview-action-label">Stáhnout přílohu</span></EcButton>
                    @if (owner.Attachments.Count > 1)
                    {
                        <span class="ec-preview-divider" aria-hidden="true"></span>
                        <nav class="ec-preview-nav" aria-label="Přílohy">
                            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronLeft" AriaLabel="Předchozí příloha"
                                      OnClick="() => this.StepAttachment(-1)" />
                            <span class="ec-preview-position">příloha <strong>@(position + 1)</strong> z @owner.Attachments.Count</span>
                            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronRight" AriaLabel="Další příloha"
                                      OnClick="() => this.StepAttachment(1)" />
                        </nav>
                    }
                </div>
            }
            else if (this.compareStart is not null)
            {
                var pair = this.ComparedPair;

                <EcFileIcon FileName="@file.FileName" />
                <div class="ec-preview-title">
                    <h2 class="ec-preview-name" data-tooltip-overflow>@file.FileName</h2>
                    <span class="ec-preview-meta">@(pair is { } shownPair ? $"Porovnání verze {shownPair.Older} s verzí {shownPair.Newer}" : "Porovnání verzí")</span>
                </div>
                <div class="ec-preview-actions">
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Compare" AriaLabel="Zavřít porovnání" aria-pressed="true" OnClick="this.CloseCompare"><span class="ec-preview-action-label">Zavřít porovnání</span></EcButton>
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="@($"Stáhnout verzi {pair?.Newer ?? file.Version}")" OnClick="() => this.DownloadCompared(file)"><span class="ec-preview-action-label">Stáhnout</span></EcButton>
                    @this.FileSteps()
                </div>
                <div class="ec-preview-compact">
                    <EcMenu AriaLabel="Další akce s porovnáním" Title="@file.FileName" Items="this.CompareActions(file)" />
                </div>
            }
            else if (this.editing is not null)
            {
                <EcFileIcon FileName="@file.FileName" />
                <div class="ec-preview-title">
                    <h2 class="ec-preview-name" data-tooltip-overflow>@file.FileName</h2>
                    <span class="ec-preview-meta">
                        @if (this.dirty)
                        {
                            <span class="ec-preview-unsaved">Neuložené změny</span><span class="ec-preview-edit-version">@(" ")<span class="ec-sep" aria-hidden="true">·</span> upravujete verzi @file.Version</span>
                        }
                        else
                        {
                            @($"Upravujete verzi {file.Version}")
                        }
                    </span>
                </div>
                <div class="ec-preview-edit-actions">
                    <EcButton Variant="EcButtonVariant.Secondary" Disabled="@this.saving" OnClick="this.CancelEdit">Zrušit</EcButton>
                    <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Check" Disabled="@(!this.dirty || this.saving)" OnClick="this.Save">Uložit</EcButton>
                </div>
            }
            else
            {
                <EcFileIcon FileName="@file.FileName" />
                if (this.renaming)
                {
                    <FileRenameField @key="file.FileId" FileName="@file.FileName" Rename="(name, token) => this.Rename(file, name, token)"
                                     OnRenamed="this.Renamed" OnCancel="this.CancelRename" />
                }
                else
                {
                    <div class="ec-preview-title">
                        <div class="ec-preview-name-row">
                            <h2 class="ec-preview-name" data-tooltip-overflow>@file.FileName</h2>
                            @if (this.ChangeMain is not null)
                            {
                                <MainFileStar IsMain="file.IsMain" OnChange="main => this.MarkMain(file, main)" />
                            }
                            @if (this.OlderVersion is { } olderNumber)
                            {
                                <EcBadge Text="@($"verze {olderNumber}")" Tone="EcBadgeTone.FileVersion" />
                            }
                        </div>
                        <span class="ec-preview-meta">@FileSizeDisplay.Text(shownVersion?.SizeBytes ?? file.SizeBytes) <span class="ec-sep" aria-hidden="true">·</span> @(this.contentPreview?.SignedContentName is { } documentName ? $"podepsaný dokument {documentName}" : MomentDisplay.Text(shownVersion?.Created ?? file.Created))@if (this.Files.Count > 1)
                        {
                            <span class="ec-preview-meta-position">@(" ")<span class="ec-sep" aria-hidden="true">·</span> soubor @(this.Position + 1) z @this.Files.Count</span>
                        }</span>
                    </div>
                }
                <div class="ec-preview-actions">
                    @if (file.VersionCount > 1)
                    {
                        @* Not an EcButton: the focus returns to it, which needs its element reference. *@
                        <button type="button" class="ec-button ec-button-secondary ec-button-standard" @ref="this.versionsToggle"
                                aria-label="@(this.OlderVersion is not null ? $"Verze, {file.VersionCount}, zobrazena je starší verze" : $"Verze, {file.VersionCount}")" aria-pressed="@(this.OlderVersion is not null || this.versionsOpen ? "true" : "false")"
                                aria-disabled="@(this.OlderVersion is not null ? "true" : null)" data-tooltip="@(this.OlderVersion is not null ? "Zobrazena je starší verze" : null)"
                                @onclick="this.ToggleVersions">
                            <EcIcon Paths="@AppIcons.Clock" />
                            <span class="ec-preview-action-label">Verze<span class="ec-preview-versions-count">@file.VersionCount</span></span>
                        </button>
                    }
                    @if (file.VersionCount > 1 && attachment is null && FileTypeDisplay.Compares(file.FileName))
                    {
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Compare" AriaLabel="Porovnat" OnClick="() => this.StartCompare(file)"><span class="ec-preview-action-label">Porovnat</span></EcButton>
                    }
                    @this.DownloadButton(file, labelled: true)
                    <EcMenu AriaLabel="Další akce se souborem" Title="@file.FileName" Items="this.MoreActions(file, compact: false)" />
                    @this.FileSteps()
                </div>
                @* Below lg the preview's toolbar carries these; a preview without one, an image's included, keeps them here. *@
                <div class="ec-preview-compact">@this.CompactActions(file)</div>
                <div class="ec-visually-hidden"><InputFile @ref="this.versionInput" @key="this.versionRound" tabindex="-1" aria-label="Nová verze souboru" OnChange="args => this.VersionPicked(file, args)" /></div>
            }
        </Heading>
        <ChildContent>
            <CascadingValue Name="PreviewActions" Value="@(attachment is null && this.compareStart is null && this.editing is null && preview is not (FilePreviewKind.Image or FilePreviewKind.ConvertedImage) ? this.CompactActions(file) : null)">
                @if (this.saveFailure is not null)
                {
                    <div class="ec-alert ec-preview-alert" role="alert">
                        <EcIcon Paths="@AppIcons.AlertTriangle" /><p class="ec-alert-text">@this.saveFailure</p>
                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh" Disabled="@this.saving" OnClick="this.Save">Zkusit znovu</EcButton>
                    </div>
                }
                @if (this.compareStart is not null)
                {
                    var pair = this.ComparedPair;

                    <VersionCompare @key="file.FileId" File="file" Versions="@(pair is null ? null : this.versions)" VersionsFailed="this.versionsFailed"
                                    OnRetryVersions="() => this.RetryVersions(file)" Older="@(pair?.Older ?? 0)" Newer="@(pair?.Newer ?? 0)"
                                    OnPick="picked => this.comparePair = picked" LoadContent="this.LoadContent" OnDownload="number => this.DownloadVersion(file, number)"
                                    OnOpenFile="this.OpenFile" />
                }
                else if (this.editing is { } edited && preview != FilePreviewKind.Markdown)
                {
                    <TextEditor @ref="this.editor" Text="@edited.Text" FileName="@file.FileName" Locked="this.saving"
                                Language="@(preview == FilePreviewKind.Code ? FileTypeDisplay.Language(file.FileName) : (CodeLanguage?)null)"
                                Changes="this.Changes(file, edited)" OnDirtyChanged="this.EditorDirtyChanged" OnSave="this.Save" OnUnavailable="this.EditorUnavailable">
                        <Notes>
                            @this.SignatureNote(file)
                            @if (this.editsFormattedCode)
                            {
                                <ToolbarNote Text="Upravuje se originál souboru, ne jeho naformátovaná podoba." />
                            }
                        </Notes>
                    </TextEditor>
                }
                else
                {
                    @if (attachment is null && file.VersionCount > 1 && (this.OlderVersion is not null || this.versionsOpen))
                    {
                        var shown = this.OlderVersion ?? file.Version;
                        var shownItem = this.versions?.FirstOrDefault(version => version.Number == shown);
                        var shortTitle = $"Verze {shown} z {file.Version}" + (shownItem is null ? "" : $" · {MomentDisplay.Text(shownItem.Created)}");
                        var title = shortTitle + (shownItem is null ? "" : $" · {shownItem.UploaderEmail}");
                        <div class="@(this.OlderVersion is null ? "ec-preview-versions" : "ec-preview-versions ec-preview-versions-old")" role="group" aria-label="Verze souboru">
                            <span class="ec-preview-versions-label"><EcIcon Paths="@AppIcons.Clock" />Verze</span>
                            <EcPopover @ref="this.versionsPopover" AriaLabel="Výběr verze" PanelClass="ec-preview-versions-panel">
                                <Trigger>
                                    <span class="ec-preview-versions-trigger"><span class="ec-text-wide">@title</span><span class="ec-text-narrow">@shortTitle</span><EcIcon Paths="@AppIcons.ChevronDown" /></span>
                                </Trigger>
                                <ChildContent>
                                    @if (this.versions is null)
                                    {
                                        <p class="ec-preview-versions-error">Verze se nepodařilo načíst.</p>
                                    }
                                    else
                                    {
                                        <ul class="ec-preview-versions-list">
                                            @foreach (var version in this.versions)
                                            {
                                                var number = version.Number;

                                                <li>
                                                    <button type="button" class="ec-preview-versions-option" aria-current="@(number == shown ? "true" : null)"
                                                            @onclick="() => this.SelectVersion(file, number)">
                                                        <span class="ec-preview-versions-option-title">Verze @number@(number == file.Version ? " " : "")@if (number == file.Version) { <EcBadge Text="aktuální" Tone="EcBadgeTone.Current" /> }</span>
                                                        <span class="ec-preview-versions-option-meta">@MomentDisplay.Text(version.Created) · @version.UploaderEmail</span>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    <div class="ec-preview-versions-divider" role="separator"></div>
                                    <button type="button" class="ec-preview-versions-manage" @onclick="() => this.ManageVersions(file)">Spravovat verze</button>
                                </ChildContent>
                            </EcPopover>
                            @if (this.OlderVersion is not null)
                            {
                                <span class="ec-preview-versions-note">Starší verze. Stáhnout stáhne tuto verzi.</span>
                                <EcButton Variant="EcButtonVariant.Quiet" Size="EcButtonSize.Compact" OnClick="this.ShowCurrentVersion"><span class="ec-text-wide">Zobrazit aktuální verzi</span><span class="ec-text-narrow">Aktuální</span></EcButton>
                            }
                        </div>
                    }
                    @if (this.versionFailure is not null)
                    {
                        <div class="ec-alert ec-preview-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.versionFailure</div>
                    }
                    @if (this.contentPreview?.SignedContentName is not null)
                    {
                        <FileSigners @key="(file.FileId, this.OlderVersion)" FileId="file.FileId" FileName="@file.FileName" Version="this.OlderVersion" />
                    }
                    else if (this.editing is null && attachment is null && preview != FilePreviewKind.SignedDocument && this.OlderVersion is null && file.SignatureFileId is { } signatureFileId
                             && this.Files.FirstOrDefault(item => item.FileId == signatureFileId) is { } signature)
                    {
                        <FileSigners @key="(file.FileId, signatureFileId)" FileId="signatureFileId" FileName="@signature.FileName" SignedFileId="file.FileId" OnOpenFile="this.OpenFile" />
                    }
                }
                <FileContentPreview @key="this.shownKey" File="file" Version="this.OlderVersion" SizeBytes="@(shownVersion?.SizeBytes ?? file.SizeBytes)" LoadContent="this.LoadContent"
                                    Attachment="attachment" Content="this.heldContent" Covered="@(this.compareStart is not null || (this.editing is not null && preview != FilePreviewKind.Markdown))"
                                    Edit="@(this.editing is { } markdownEdited && preview == FilePreviewKind.Markdown
                                              ? new MarkdownEdit(this.saving, this.Changes(file, markdownEdited), this.SignatureNote(file),
                                                                 EventCallback.Factory.Create<bool>(this, this.EditorDirtyChanged), EventCallback.Factory.Create(this, this.Save),
                                                                 EventCallback.Factory.Create(this, this.EditorUnavailable), EventCallback.Factory.Create<string>(this, href => this.linkHref = href))
                                              : null)"
                                    MarkdownSource="this.markdownSource" MarkdownSourceChanged="source => this.markdownSource = source" OnChanged="this.ContentChanged"
                                    OnDownload="() => this.DownloadShown(file)" OnOpenAttachment="this.OpenAttachment" OnOpenFile="this.OpenFile" />
            </CascadingValue>
        </ChildContent>
    </EcModal>
    @if (this.editing is not null)
    {
        <NavigationLock OnBeforeInternalNavigation="this.ConfirmNavigation" ConfirmExternalNavigation="this.dirty" />
    }
    @if (this.afterDiscard is not null)
    {
        <DiscardChangesModal FileName="@file.FileName" OnDiscard="this.Discard" Open OpenChanged="this.KeepEditing" />
    }
    @if (this.linkHref is not null)
    {
        <MarkdownLinkModal Href="@this.linkHref" Open OpenChanged="() => this.linkHref = null" OnApply="this.ApplyLink" />
    }
}

@code {
    private const int MaxTextBytes = FileTypeDisplay.MaxTextBytes;

    [Parameter, EditorRequired]
    public required IReadOnlyList<FileListItem> Files { get; set; }

    [Parameter, EditorRequired]
    public required Guid FileId { get; set; }

    [Parameter]
    public EventCallback<Guid> FileIdChanged { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, int?, CancellationToken, Task<Stream>> LoadContent { get; set; }

    /// <summary>
    /// The version shown; null shows the current one.
    /// </summary>
    [Parameter]
    public int? Version { get; set; }

    [Parameter]
    public EventCallback<int?> VersionChanged { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task<IReadOnlyList<FileVersionItem>>> LoadVersions { get; set; }

    /// <summary>
    /// Uploads the picked file as a new version; answers the failure to show, or none, and the card's notice.
    /// </summary>
    [Parameter, EditorRequired]
    public required Func<FileListItem, IBrowserFile, Task<(string? Failure, string? Notice)>> UploadVersion { get; set; }

    [Parameter]
    public EventCallback<FileListItem> OnManageVersions { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, string, CancellationToken, Task> Rename { get; set; }

    [Parameter]
    public EventCallback<FileListItem> OnDownload { get; set; }

    [Parameter]
    public EventCallback OnRenamed { get; set; }

    /// <summary>
    /// Sets the file as the main file, or unsets it; answers the failure to show. Without it the header carries no star.
    /// </summary>
    [Parameter]
    public Func<FileListItem, bool, Task<string?>>? ChangeMain { get; set; }

    /// <summary>
    /// Asks to delete the file; without it the preview does not offer Smazat.
    /// </summary>
    [Parameter]
    public EventCallback<FileListItem> OnDelete { get; set; }

    /// <summary>
    /// Opens the editor once the file first shown has loaded, when it can be edited; read when the preview opens.
    /// </summary>
    [Parameter]
    public bool EditOnOpen { get; set; }

    /// <summary>
    /// Opens the compare of the version shown with the one before it; read when the preview opens.
    /// </summary>
    [Parameter]
    public bool CompareOnOpen { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    // The attachments opened, outermost first; empty shows the stored file.
    private readonly List<(byte[] Content, string MessageName, DataMessage Message, int Index)> trail = [];

    private Guid? loadedFileId;

    private int? loadedNumber;

    private IReadOnlyList<FileVersionItem>? versions;

    private bool versionsFailed;

    private (Guid, int, int)? versionsKey;

    // The file and the version the compare opened for, and whether it opened against the current version; null while
    // the preview does not compare.
    private (Guid FileId, int Number, bool WithCurrent)? compareStart;

    // The versions chosen in the compare; until then the pair it opened with.
    private (int Older, int Newer)? comparePair;

    private bool versionsOpen;

    private bool uploadingVersion;

    private string? versionFailure;

    private EcPopover? versionsPopover;

    private ElementReference versionsToggle;

    private InputFile? versionInput;

    private int versionRound;

    private bool focusVersionsToggle;

    // Zdrojový kód chosen; holds until the preview closes.
    private bool markdownSource;

    // The link window is open while set.
    private string? linkHref;

    // The preview of what is shown, once it read it; a new key shows it anew.
    private FileContentPreview? contentPreview;

    private int shownKey;

    // The stored data message read already, shown again without a load on the way back from its attachment.
    private byte[]? heldContent;

    private bool renaming;

    // The text in the editor as read; null while the preview only shows.
    private EditableText? editing;

    // Whether the editor's text differs from the one read.
    private bool dirty;

    private bool saving;

    private string? saveFailure;

    private TextEditor? editor;

    // Whether the read-only view showed the code formatted when the edit began.
    private bool editsFormattedCode;

    // Whether the editor shows its Změny, and the version they compare with; null compares with the version edited.
    private bool changesShown;

    private int? changesNumber;

    // The texts of the versions read for the Změny, by file, number and upload; null for a version not in UTF-8.
    private readonly Dictionary<(Guid FileId, int Number, DateTime Created), string?> changesTexts = [];

    // The last read of a version for the Změny failed.
    private bool changesFailed;

    private CancellationTokenSource? changesToken;

    // What a confirmed discard of unsaved changes goes on to do; set while the question shows.
    private Func<Task>? afterDiscard;

    // The editor is to open once the first file loads; the read under way carries it until it ends.
    private bool editOnLoad;

    private bool editOnShown;

    private FileListItem? Current => this.Files.FirstOrDefault(file => file.FileId == this.FileId);

    private int Position => Enumerable.Range(0, this.Files.Count).Single(index => this.Files[index].FileId == this.FileId);

    // The number of the version shown when it is not the current one.
    private int? OlderVersion => this.Version is { } number && this.Current is { } file && number != file.Version ? number : null;

    private FileVersionItem? ShownVersionItem => this.OlderVersion is { } number ? this.versions?.FirstOrDefault(version => version.Number == number) : null;

    // Until a pick, the version opened for against the current one when asked, else against the one before it; the
    // oldest against the current one. The current one is read each time, so a new version takes its place.
    private (int Older, int Newer)? ComparedPair
    {
        get
        {
            if (this.comparePair is { } picked)
                return picked;

            if (this.compareStart is not { } start || this.versions is not { } list || this.Current is not { } file)
                return null;

            if ((!start.WithCurrent || start.Number == file.Version) && list.FirstOrDefault(version => version.Number < start.Number) is { } previous)
                return (previous.Number, start.Number);

            return (start.Number, file.Version);
        }
    }

    private DataMessageAttachment? ShownAttachment => this.trail.Count == 0 ? null : this.trail[^1].Message.Attachments[this.trail[^1].Index];

    // Only the current version of a stored text or code file, read whole and valid UTF-8, is edited.
    private bool CanEdit
    {
        get
        {
            return this.contentPreview is { Editable: not null, Ready: true, SignedContentName: null } && this.trail.Count == 0 && this.OlderVersion is null
                && !this.uploadingVersion;
        }
    }

    // Only the editor guards the close.
    private EventCallback CloseRequest
    {
        get
        {
            return this.editing is null ? default : EventCallback.Factory.Create(this, this.RequestClose);
        }
    }

    protected override void OnInitialized()
    {
        this.editOnLoad = this.EditOnOpen;

        if (this.CompareOnOpen && this.Current is { } file)
            this.compareStart = (file.FileId, this.Version ?? file.Version, WithCurrent: false);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (this.Current is not { } file)
            return;

        await this.LoadVersionList(file);

        // A compared version no longer listed gives way to the pair the compare opens with, from the current version when
        // the one it opened for is gone; a file left with one version ends the compare.
        if (this.compareStart is { } opened && opened.FileId == file.FileId)
        {
            if (file.VersionCount < 2)
            {
                this.CloseCompare();
            }
            else if (this.versions is { } list)
            {
                if (!Listed(list, opened.Number))
                    this.compareStart = (file.FileId, file.Version, WithCurrent: false);

                if (this.comparePair is { } picked && !(Listed(list, picked.Older) && Listed(list, picked.Newer)))
                    this.comparePair = null;
            }
        }

        var number = this.OlderVersion ?? file.Version;

        if (file.FileId == this.loadedFileId && (number == this.loadedNumber || this.editing is not null))
            return;

        if (file.FileId != this.loadedFileId)
        {
            this.versionsOpen = false;
            this.versionFailure = null;
        }

        // Another file ends the compare.
        if (this.compareStart is { } start && start.FileId != file.FileId)
            this.CloseCompare();

        this.renaming = false;

        this.Reload(file);
    }

    private async Task LoadVersionList(FileListItem file)
    {
        var key = (file.FileId, file.Version, file.VersionCount);

        if (file.VersionCount < 2)
        {
            this.versions = null;
            this.versionsKey = null;

            return;
        }

        if (key == this.versionsKey)
            return;

        this.versionsKey = key;
        this.versionsFailed = false;

        try
        {
            this.versions = await this.LoadVersions(file, CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the versions of file {FileAssetId} failed", file.FileId);

            this.versions = null;
            this.versionsFailed = true;
        }
    }

    private async Task RetryVersions(FileListItem file)
    {
        this.versionsKey = null;

        await this.LoadVersionList(file);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!this.focusVersionsToggle || this.OlderVersion is not null)
            return;

        this.focusVersionsToggle = false;

        await this.versionsToggle.FocusAsync();
    }

    public void Dispose()
    {
        this.changesToken?.Cancel();
        this.changesToken?.Dispose();
    }

    // Shows anew what the trail and the held content give; an edit ends.
    private void Reset(byte[]? held = null)
    {
        this.shownKey++;
        this.contentPreview = null;
        this.heldContent = held;
        this.editing = null;
        this.dirty = false;
        this.saveFailure = null;
    }

    private void Reload(FileListItem file)
    {
        this.Reset();
        this.editOnShown = this.editOnLoad;
        this.editOnLoad = false;
        this.loadedFileId = file.FileId;
        this.loadedNumber = this.OlderVersion ?? file.Version;
        this.trail.Clear();
    }

    // A file that turned out not editable stays in the preview with its note.
    private async Task ContentChanged(FileContentPreview shown)
    {
        var edit = this.editOnShown;

        this.contentPreview = shown;
        this.editOnShown = false;

        if (edit && this.CanEdit)
            await this.StartEdit();
    }

    private void OpenAttachment((byte[] Content, string MessageName, DataMessage Message, int Index) opened)
    {
        this.renaming = false;
        this.trail.Add(opened);
        this.Reset();
    }

    private void StepAttachment(int direction)
    {
        var (content, messageName, message, index) = this.trail[^1];
        var count = message.Attachments.Count;
        var next = ((index + direction) % count + count) % count;

        this.trail[^1] = (content, messageName, message, next);
        this.Reset();
    }

    // The message's bytes were kept when it was opened, so it shows again without a load.
    private void BackToMessage()
    {
        var message = this.trail[^1].Content;

        this.trail.RemoveAt(this.trail.Count - 1);
        this.Reset(this.trail.Count == 0 ? message : null);
    }

    private async Task DownloadAttachment(DataMessageAttachment attachment)
    {
        await using var content = new MemoryStream(attachment.Content, writable: false);

        await this.BrowserFiles.DownloadContent(attachment.Name, content, CancellationToken.None);
    }

    private async Task DownloadShown(FileListItem file)
    {
        if (this.ShownAttachment is { } attachment)
            await this.DownloadAttachment(attachment);
        else if (this.contentPreview?.SignedContentName is not null)
            await this.contentPreview.DownloadSignedContent();
        else
            await this.DownloadStored(file);
    }

    // An older version is saved under the file's name by the same request the preview makes.
    private async Task DownloadStored(FileListItem file)
    {
        if (this.OlderVersion is { } number)
            await this.BrowserFiles.DownloadFile(file.FileId, number, file.FileName, CancellationToken.None);
        else
            await this.OnDownload.InvokeAsync(file);
    }

    private void ToggleVersions()
    {
        if (this.OlderVersion is null)
            this.versionsOpen = !this.versionsOpen;
    }

    // The bar holding the focused button goes away, so the focus moves to the toggle once the current version shows.
    private async Task ShowCurrentVersion()
    {
        this.versionsOpen = false;
        this.focusVersionsToggle = true;

        await this.VersionChanged.InvokeAsync(null);
    }

    private async Task SelectVersion(FileListItem file, int number)
    {
        await this.versionsPopover!.CloseToTrigger();

        this.versionsOpen = true;

        await this.VersionChanged.InvokeAsync(number == file.Version ? null : number);
    }

    private async Task ManageVersions(FileListItem file)
    {
        await this.versionsPopover!.CloseToTrigger();
        await this.OnManageVersions.InvokeAsync(file);
    }

    private async Task UploadNewVersion(FileListItem file, IBrowserFile picked)
    {
        this.uploadingVersion = true;
        this.versionFailure = null;

        this.versionFailure = (await this.UploadVersion(file, picked)).Failure;

        this.uploadingVersion = false;

        if (this.versionFailure is null)
            await this.VersionChanged.InvokeAsync(null);
    }

    private async Task VersionPicked(FileListItem file, InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0)
            return;

        // A fresh input, so the same file can be picked again.
        this.versionRound++;

        await this.UploadNewVersion(file, args.File);
    }

    // The version shown, or the document a signed file carries; below lg without its label.
    private RenderFragment DownloadButton(FileListItem file, bool labelled)
    {
        RenderFragment? label = labelled ? @<span class="ec-preview-action-label">Stáhnout</span> : null;

        return @<EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="@(this.contentPreview?.SignedContentName is null ? "Stáhnout" : "Stáhnout dokument")"
                          OnClick="() => this.DownloadShown(file)" ChildContent="label" />;
    }

    // Below lg: the steps without the position, the download and a menu with the header's other actions.
    private RenderFragment CompactActions(FileListItem file)
    {
        return @<text>
            @if (this.Files.Count > 1)
            {
                <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronLeft" AriaLabel="Předchozí soubor" OnClick="() => this.Step(-1)" />
                <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronRight" AriaLabel="Další soubor" OnClick="() => this.Step(1)" />
            }
            @this.DownloadButton(file, labelled: false)
            <EcMenu AriaLabel="Další akce se souborem" Title="@file.FileName" Items="this.MoreActions(file, compact: true)" />
        </text>;
    }

    // The file's menu: in the toolbar below lg with Verze and Porovnat, which the header carries as buttons above lg.
    private List<EcMenuItem> MoreActions(FileListItem file, bool compact)
    {
        var actions = new List<EcMenuItem>();

        if (this.CanEdit)
            actions.Add(new EcMenuItem { Text = "Upravit", Icon = AppIcons.Edit, OnSelect = EventCallback.Factory.Create(this, this.StartEdit) });

        if (!this.uploadingVersion)
            actions.Add(new EcMenuItem { Text = "Nahrát novou verzi", Icon = AppIcons.Upload, OnSelect = EventCallback.Factory.Create(this, this.PickVersion) });

        if (compact && file.VersionCount > 1 && this.OlderVersion is null)
            actions.Add(new EcMenuItem { Text = $"Verze ({file.VersionCount})", Icon = AppIcons.Clock, OnSelect = EventCallback.Factory.Create(this, this.ToggleVersions) });

        if (compact && file.VersionCount > 1 && FileTypeDisplay.ComparesByContent(file.FileName))
            actions.Add(new EcMenuItem { Text = "Porovnat", Icon = AppIcons.Compare, OnSelect = EventCallback.Factory.Create(this, () => this.StartCompare(file)) });

        actions.Add(new EcMenuItem { Text = "Přejmenovat", Icon = AppIcons.Pencil, OnSelect = EventCallback.Factory.Create(this, this.StartRename) });

        if (this.contentPreview?.SignedContentName is not null)
        {
            var extension = Path.GetExtension(file.FileName);

            actions.Add(new EcMenuItem { Text = $"Stáhnout {extension}", Icon = AppIcons.Download, OnSelect = EventCallback.Factory.Create(this, () => this.DownloadStored(file)) });
        }

        if (this.OnDelete.HasDelegate)
        {
            actions.Add(new EcMenuItem
            {
                Text = "Smazat",
                Icon = AppIcons.Trash,
                OnSelect = EventCallback.Factory.Create(this, () => this.OnDelete.InvokeAsync(file)),
                Danger = true,
                DividerBefore = true,
            });
        }

        return actions;
    }

    private async Task MarkMain(FileListItem file, bool main)
    {
        this.versionFailure = await this.ChangeMain!(file, main);
    }

    private List<EcMenuItem> CompareActions(FileListItem file)
    {
        var actions = new List<EcMenuItem>
        {
            new() { Text = "Zavřít porovnání", Icon = AppIcons.Compare, OnSelect = EventCallback.Factory.Create(this, this.CloseCompare) },
            new() { Text = $"Stáhnout verzi {this.ComparedPair?.Newer ?? file.Version}", Icon = AppIcons.Download, OnSelect = EventCallback.Factory.Create(this, () => this.DownloadCompared(file)) },
        };

        if (this.Files.Count > 1)
        {
            actions.Add(new EcMenuItem { Text = "Předchozí soubor", Icon = AppIcons.ChevronLeft, OnSelect = EventCallback.Factory.Create(this, () => this.Step(-1)), DividerBefore = true });
            actions.Add(new EcMenuItem { Text = "Další soubor", Icon = AppIcons.ChevronRight, OnSelect = EventCallback.Factory.Create(this, () => this.Step(1)) });
        }

        return actions;
    }

    private async Task PickVersion()
    {
        await this.BrowserFiles.PickFile(this.versionInput!.Element!.Value, CancellationToken.None);
    }

    // An older version compares with the current one, the current with the one before it.
    private void StartCompare(FileListItem file)
    {
        this.renaming = false;
        this.versionsOpen = false;
        this.versionFailure = null;
        this.compareStart = (file.FileId, this.OlderVersion ?? file.Version, WithCurrent: this.OlderVersion is not null);
        this.comparePair = null;
    }

    private void CloseCompare()
    {
        this.compareStart = null;
        this.comparePair = null;
    }

    // The newer version of the compare is saved under the file's name.
    private async Task DownloadCompared(FileListItem file)
    {
        await this.DownloadVersion(file, this.ComparedPair?.Newer ?? file.Version);
    }

    private async Task DownloadVersion(FileListItem file, int number)
    {
        if (number == file.Version)
            await this.OnDownload.InvokeAsync(file);
        else
            await this.BrowserFiles.DownloadFile(file.FileId, number, file.FileName, CancellationToken.None);
    }

    private static bool Listed(IReadOnlyList<FileVersionItem> versions, int number)
    {
        return versions.Any(version => version.Number == number);
    }

    private RenderFragment FileSteps()
    {
        return @<text>
            @if (this.Files.Count > 1)
            {
                <span class="ec-preview-divider" aria-hidden="true"></span>
                <nav class="ec-preview-nav" aria-label="Soubory">
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronLeft" AriaLabel="Předchozí soubor"
                              OnClick="() => this.Step(-1)" />
                    <span class="ec-preview-position">Soubor <strong>@(this.Position + 1)</strong> z @this.Files.Count</span>
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronRight" AriaLabel="Další soubor"
                              OnClick="() => this.Step(1)" />
                </nav>
            }
        </text>;
    }

    private async Task StartEdit()
    {
        this.renaming = false;
        this.versionsOpen = false;
        this.versionFailure = null;
        this.saveFailure = null;
        this.dirty = false;
        this.editsFormattedCode = this.contentPreview?.ShowsFormattedCode == true;
        this.editing = this.contentPreview?.Editable;
        this.changesShown = false;
        this.changesNumber = null;
        this.changesFailed = false;

        try
        {
            await this.History.TrackSteps();
        }
        catch (JSException exception)
        {
            this.Logger.LogInformation(exception, "The browser's history steps are not tracked");
        }
    }

    private void LeaveEdit()
    {
        this.changesToken?.Cancel();
        this.changesTexts.Clear();
        this.editing = null;
        this.dirty = false;
        this.saveFailure = null;
    }

    // The Změny of the edited text against the version edited or the one chosen; a version that cannot compare says why.
    private EditorChanges Changes(FileListItem file, EditableText edited)
    {
        // A chosen version no longer listed gives way to the version edited.
        var picked = this.changesNumber is { } chosen ? this.versions?.FirstOrDefault(version => version.Number == chosen) : null;
        var number = picked?.Number ?? this.loadedNumber ?? file.Version;
        var selected = picked ?? this.versions?.FirstOrDefault(version => version.Number == number);
        var original = picked is null ? edited.Text : null;
        RenderFragment? status = null;

        if (picked is not null)
        {
            if (picked.SizeBytes > MaxTextBytes)
                status = ChangesProblem($"Verzi {number} nelze porovnat: soubor je větší než {FileSizeDisplay.Text(MaxTextBytes)}");
            else if (this.changesTexts.TryGetValue((file.FileId, number, picked.Created), out var text))
                (original, status) = (text, text is null ? ChangesProblem($"Verzi {number} nelze porovnat: soubor není v kódování UTF-8") : null);
            else if (this.changesFailed)
                status = @<div class="ec-alert ec-preview-alert" role="alert">
                    <EcIcon Paths="@AppIcons.AlertTriangle" /><p class="ec-alert-text">Verzi @number se nepodařilo načíst. Zkuste to za chvíli znovu.</p>
                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh" OnClick="this.ReadChangesVersion">Zkusit znovu</EcButton>
                </div>;
        }

        // The label stands before the version; a file with one version has no other to choose.
        RenderFragment<string> version = label => @<text>
            @if (selected is not null)
            {
                <CompareVersionPicker Label="@label" Name="Porovnávaná verze" Versions="this.versions!" Selected="selected" CurrentNumber="file.Version"
                                      Allowed="_ => true" OnPick="this.PickChangesVersion" />
            }
            else
            {
                <span class="ec-editor-changes-version">@label verze @number</span>
            }
        </text>;

        return new EditorChanges(this.changesShown, number, original, version, status, EventCallback.Factory.Create<bool>(this, this.ShowChanges));
    }

    private async Task ShowChanges(bool shown)
    {
        this.changesShown = shown;

        if (shown)
            await this.ReadChangesVersion();
        else
            this.changesToken?.Cancel();
    }

    private async Task PickChangesVersion(int number)
    {
        this.changesNumber = number == this.loadedNumber ? null : number;
        this.changesFailed = false;

        await this.ReadChangesVersion();
    }

    // Reads the version the Změny compare with, unless it is the one edited, read already or over the limit.
    private async Task ReadChangesVersion()
    {
        if (this.Current is not { } file || this.changesNumber is not { } number
            || this.versions?.FirstOrDefault(version => version.Number == number) is not { } version
            || version.SizeBytes > MaxTextBytes || this.changesTexts.ContainsKey((file.FileId, number, version.Created)))
            return;

        this.changesToken?.Cancel();
        this.changesToken?.Dispose();

        var token = (this.changesToken = new CancellationTokenSource()).Token;

        this.changesFailed = false;

        try
        {
            await using var content = await this.LoadContent(file, number == file.Version ? null : number, token);
            var bytes = await FileContentPreview.ReadBytes(content, token);

            if (!token.IsCancellationRequested)
                this.changesTexts[(file.FileId, number, version.Created)] = EditableText.ParseOrDefault(bytes)?.Text;
        }
        catch (OperationCanceledException)
        {
            // Another version or the end of the edit took over.
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading version {Version} of file {FileId} for the changes failed", number, file.FileId);

            if (!token.IsCancellationRequested)
                this.changesFailed = true;
        }
    }

    private static RenderFragment ChangesProblem(string problem)
    {
        return @<div class="ec-warning ec-preview-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@problem</div>;
    }

    private void EditorDirtyChanged(bool changed)
    {
        this.dirty = changed;
    }

    // A version that came while the editor was open shows once it closes.
    private Task ShowCurrent()
    {
        if (this.editing is null && this.Current is { } file && file.FileId == this.loadedFileId && this.OlderVersion is null && file.Version != this.loadedNumber)
            this.Reload(file);

        return Task.CompletedTask;
    }

    private async Task EditorUnavailable()
    {
        this.LeaveEdit();
        this.versionFailure = "Úpravy se nepodařilo spustit. Zkuste to za chvíli znovu.";

        await this.ShowCurrent();
    }

    private async Task ApplyLink(string href)
    {
        this.linkHref = null;

        await this.contentPreview!.SetLink(href);
    }

    private async Task CancelEdit()
    {
        if (this.saving)
            return;

        if (this.dirty)
        {
            this.afterDiscard = this.ShowCurrent;
        }
        else
        {
            this.LeaveEdit();

            await this.ShowCurrent();
        }
    }

    // The X, a click outside or Escape while editing: unsaved changes are confirmed before the preview closes. A save
    // under way finishes first.
    private async Task RequestClose()
    {
        if (this.saving)
            return;

        if (this.dirty)
            this.afterDiscard = () => this.OpenChanged.InvokeAsync(false);
        else
            await this.OpenChanged.InvokeAsync(false);
    }

    // Covers links and the browser's Back and Forward; leaving the site is asked by the browser through
    // ConfirmExternalNavigation. A Back or Forward goes on after the discard as the same step through the history.
    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        var held = this.dirty;

        if (held)
            context.PreventNavigation();

        var target = context.TargetLocation;
        var distance = 0;

        if (!context.IsNavigationIntercepted)
        {
            try
            {
                distance = await this.History.TakeStep(target);
            }
            catch (JSException exception)
            {
                this.Logger.LogInformation(exception, "The browser's history step is not known");
            }
        }

        if (!held)
            return;

        this.afterDiscard = async () =>
        {
            if (distance == 0)
                this.Navigation.NavigateTo(target);
            else
                await this.History.Go(distance);
        };
    }

    private async Task Discard()
    {
        var next = this.afterDiscard!;

        this.afterDiscard = null;
        this.LeaveEdit();

        await next();
    }

    private void KeepEditing(bool open)
    {
        if (!open)
            this.afterDiscard = null;
    }

    // The text goes up as a new version by the same call as Nová verze; a success shows the current version.
    private async Task Save()
    {
        if (this.editing is not { } edited || !this.dirty || this.saving || this.Current is not { } file)
            return;

        this.saving = true;
        this.saveFailure = null;

        string? failure;

        try
        {
            var text = FileTypeDisplay.Preview(file.FileName) == FilePreviewKind.Markdown
                ? await this.contentPreview!.ReadMarkdown()
                : await this.editor!.ReadText();
            var content = edited.Encode(text);

            failure = (await this.UploadVersion(file, new EditedFile(file.FileName, content))).Failure;
        }
        catch (JSException exception)
        {
            this.Logger.LogWarning(exception, "Reading the edited text of file {FileAssetId} failed", file.FileId);

            failure = "Text se nepodařilo přečíst z editoru. Zkuste to znovu.";
        }
        finally
        {
            this.saving = false;
        }

        if (failure is not null)
        {
            this.saveFailure = failure;

            return;
        }

        this.LeaveEdit();

        await this.ShowCurrent();
        await this.VersionChanged.InvokeAsync(null);
    }

    // The warning that a new version invalidates the file's detached signature, in either editor.
    private RenderFragment SignatureNote(FileListItem file)
    {
        return @<text>
            @if (file.SignatureFileId is { } signatureId && this.Files.FirstOrDefault(item => item.FileId == signatureId) is { } signature)
            {
                <ToolbarNote Text="@($"Soubor má samostatný podpis {signature.FileName}. Nová verze ho zneplatní.")" Warning />
            }
        </text>;
    }

    private async Task Step(int direction)
    {
        var count = this.Files.Count;
        var next = this.Files[((this.Position + direction) % count + count) % count];

        await this.FileIdChanged.InvokeAsync(next.FileId);
    }

    private async Task OpenFile(Guid fileId)
    {
        await this.FileIdChanged.InvokeAsync(fileId);
    }

    private void StartRename()
    {
        this.renaming = true;
    }

    private void CancelRename()
    {
        this.renaming = false;
    }

    private async Task Renamed()
    {
        this.renaming = false;

        await this.OnRenamed.InvokeAsync();
    }
}
