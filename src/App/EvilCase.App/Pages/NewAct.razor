@page "/cases/{CaseId:guid}/act/new"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Labels
@using EvilBrains.EvilCase.Domain.Acts
@inject IActsClient ActsClient
@inject ICasesClient CasesClient
@inject NavigationManager Navigation
@inject ILogger<NewAct> Logger

<PageTitle>Nový úkon – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">Nový úkon</h2>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <EditForm Model="this.model" OnValidSubmit="this.SubmitAct">
            <DataAnnotationsValidator />

            <div class="ec-layout">
                <div class="ec-main">
                    <div>
                        <label class="visually-hidden" for="act-title">Název</label>
                        <input id="act-title" class="form-control ec-title-input" placeholder="Název úkonu" autofocus @bind="this.model.Title" />
                        <ValidationMessage For="() => this.model.Title" class="invalid-feedback d-block" />
                    </div>

                    @if (ActContactRules.DifferingCaseContact(this.model.Contact, this.caseContact) is { } differing)
                    {
                        <div class="alert alert-warning mb-0" role="alert">
                            <Icon CssClass="icon me-2" IconType="TablerIcons.AlertTriangle" />Kontakt úkonu se liší od kontaktu spisu (@differing.Name).
                        </div>
                    }

                    <div class="card">
                        <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.FileText" />Popis</h3></div>
                        <div class="card-body">
                            <label class="visually-hidden" for="act-description">Popis</label>
                            <InputTextArea id="act-description" class="form-control" rows="8" @bind-Value="this.model.Description" />
                            <ValidationMessage For="() => this.model.Description" class="invalid-feedback d-block" />
                        </div>
                    </div>
                </div>

                <aside class="ec-sidebar d-flex flex-column gap-3">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.ListDetails" />Údaje</h3></div>
                        <div class="card-body d-flex flex-column gap-3">
                            <div>
                                <span class="ec-field-label">Číslo jednací</span>
                                <div class="text-secondary">Přidělí se po založení.</div>
                            </div>
                            <div>
                                <label class="ec-field-label" for="act-date">Datum úkonu</label>
                                <InputDate id="act-date" class="form-control" @bind-Value="this.model.Date" />
                                <ValidationMessage For="() => this.model.Date" class="invalid-feedback d-block" />
                            </div>
                            <div>
                                <label class="ec-field-label" for="act-direction">Směr</label>
                                <InputSelect id="act-direction" class="form-select" @bind-Value="this.model.Direction" @bind-Value:after="this.PrefillContact">
                                    <option value="">— bez směru —</option>
                                    @foreach (var direction in Enum.GetValues<ActDirection>())
                                    {
                                        <option value="@direction">@ActDirectionDisplay.Text(direction)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => this.model.Direction" class="invalid-feedback d-block" />
                            </div>
                            <div>
                                <label class="ec-field-label" for="act-contact">Kontakt</label>
                                <ContactPicker InputId="act-contact" @bind-Selected="this.model.Contact" />
                                <ValidationMessage For="() => this.model.Contact" class="invalid-feedback d-block" />
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.Tag" />Štítky</h3></div>
                        <div class="card-body">
                            <label class="visually-hidden" for="act-labels">Štítky</label>
                            <LabelPicker InputId="act-labels" @bind-Selected="this.model.Labels" />
                        </div>
                    </div>
                </aside>

                <div class="ec-savebar">
                    <div class="ec-savebar-actions">
                        <a href="/cases/@this.CaseId" class="btn"><Icon CssClass="icon" IconType="TablerIcons.X" />Zrušit</a>
                        <button id="act-submit" type="submit" class="btn btn-primary" disabled="@this.busy">
                            @if (this.busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            else
                            {
                                <Icon CssClass="icon" IconType="TablerIcons.Plus" />
                            }
                            Založit úkon
                        </button>
                    </div>
                </div>

                @if (this.error is not null)
                {
                    <div class="ec-savebar-error">
                        <div class="alert alert-danger mb-0" role="alert"><Icon CssClass="icon me-2" IconType="TablerIcons.AlertTriangle" />@this.error</div>
                    </div>
                }
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    private readonly NewActModel model = new() { Date = DateOnly.FromDateTime(DateTime.Now) };

    private ContactListItem? caseContact;

    private string? error;

    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var @case = await this.CasesClient.GetCase(this.CaseId, CancellationToken.None);

            this.caseContact = @case.Contact;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Reading the case of the new act failed");
        }
    }

    private void PrefillContact()
    {
        this.model.Contact = ActContactRules.Prefilled(this.model.Direction, this.model.Contact, this.caseContact);
    }

    private async Task SubmitAct()
    {
        this.busy = true;
        this.error = null;

        try
        {
            var request = new CreateActRequest
            {
                Direction = this.model.Direction,
                Date = this.model.Date,
                Title = this.model.Title,
                Description = this.model.Description,
                ContactId = this.model.Contact?.ContactId,
                LabelIds = [.. this.model.Labels.Select(static label => label.LabelId)],
            };

            _ = await this.ActsClient.CreateAct(this.CaseId, request, CancellationToken.None);

            this.Navigation.NavigateTo($"/cases/{this.CaseId}");
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            this.error = exception.ResponseBody?.Contains(ContactProblems.UnknownContact, StringComparison.Ordinal) == true
                ? "Vybraný kontakt už neexistuje. Vyberte jiný."
                : "Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.error = "Spis už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Filing a new act failed");

            this.error = "Úkon se nepodařilo založit. Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
