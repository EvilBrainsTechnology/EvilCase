@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@inject IContactsClient ContactsClient

<ConfirmDeleteModal Delete="this.DeleteContact" GoneError="Kontakt už neexistuje." FailedError="Kontakt se nepodařilo smazat. Zkuste to za chvíli znovu." MapError="MapContactError" OnDeleted="this.OnDeleted">
    <p>Opravdu smazat kontakt <strong>@Contact.Name</strong>? Akci nelze vrátit zpět.</p>
</ConfirmDeleteModal>

@code {
    [Parameter, EditorRequired]
    public required ContactDetail Contact { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private Task DeleteContact(CancellationToken cancellationToken) =>
        this.ContactsClient.DeleteContact(this.Contact.ContactId, cancellationToken);

    private static string? MapContactError(ApiException exception) =>
        exception.StatusCode == HttpStatusCode.Conflict ? "Kontakt nelze smazat: figuruje ve spisu nebo úkonu." : null;
}
