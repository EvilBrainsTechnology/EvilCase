<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators are loaded by the compiler and must target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- An analyzer assembly loads without its project references, so the shared MVC facts are compiled in. -->
    <Compile Include="..\Shared\MvcFacts.cs" Link="Shared\MvcFacts.cs" />
  </ItemGroup>

</Project>
