@page "/contacts"
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@implements IDisposable
@inject IContactsClient ContactsClient
@inject ILogger<Contacts> Logger

<PageTitle>Kontakty – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">Kontakty</h2>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body border-bottom py-3">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <Icon CssClass="icon" IconType="AppIcons.Search" />
                    </span>
                    <input type="search" class="form-control" aria-label="Hledat v kontaktech"
                           placeholder="Hledat v názvu a ID datové schránky"
                           value="@this.search" @oninput="this.OnSearchInput" />
                </div>
            </div>

            @if (this.failure is not null)
            {
                <div class="empty">
                    <p class="empty-title">Kontakty se nepodařilo načíst</p>
                    <p class="empty-subtitle text-secondary">@this.failure</p>
                </div>
            }
            else if (this.items is null)
            {
                <div class="card-body text-center text-secondary">
                    <div class="spinner-border" role="status"></div>
                </div>
            }
            else if (this.items.Count == 0)
            {
                <div class="empty">
                    <p class="empty-title">Žádné kontakty</p>
                    <p class="empty-subtitle text-secondary">
                        @(string.IsNullOrWhiteSpace(this.search) ? "Zatím tu není žádný kontakt." : "Zkuste jiné hledání.")
                    </p>
                </div>
            }
            else
            {
                <div class="d-none d-lg-block">
                    <table class="table card-table table-vcenter">
                        <thead>
                            <tr>
                                <th>Název</th>
                                <th>Typ</th>
                                <th>ID datové schránky</th>
                                <th>Adresa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in this.items)
                            {
                                <tr>
                                    <td><a href="/contacts/@item.ContactId">@item.Name</a></td>
                                    <td class="text-nowrap">@ContactKindDisplay.Text(item.Kind)</td>
                                    <td>@item.DataBoxId</td>
                                    <td>@item.Address</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-body d-lg-none">
                    @foreach (var item in this.items)
                    {
                        <ContactListCard Contact="item" />
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly SearchDebouncer debouncer = new();

    private IReadOnlyList<ContactListItem>? items;
    private string search = "";
    private string? failure;

    protected override Task OnInitializedAsync()
    {
        return this.LoadContacts(debounce: false);
    }

    public void Dispose()
    {
        this.debouncer.Dispose();
    }

    private Task OnSearchInput(ChangeEventArgs args)
    {
        this.search = args.Value as string ?? "";

        return this.LoadContacts(debounce: true);
    }

    private async Task LoadContacts(bool debounce)
    {
        var token = await this.debouncer.Start(debounce);
        if (token is null)
            return;

        var request = new ContactListRequest
        {
            Search = string.IsNullOrWhiteSpace(this.search) ? null : this.search,
        };

        try
        {
            var response = await this.ContactsClient.ListContacts(request, token.Value);

            this.items = response.Items;
            this.failure = null;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request.
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the contact list failed");

            this.items = [];
            this.failure = "Seznam kontaktů se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }
}
