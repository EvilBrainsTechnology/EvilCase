@using System.Diagnostics
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using Microsoft.JSInterop
@inject IBrowserFiles BrowserFiles
@inject ILogger<FilesCard> Logger

@* The card is itself the drop zone (files.js). *@
<div class="@(this.Compact ? "ec-file-card ec-file-card-compact" : "ec-file-card")" id="@this.Id" @ref="this.card">
    <EcCard Title="@this.Title">
        <Header>
            @if (!this.Compact && this.State.Loaded && this.State.ListFailure is null)
            {
                <span class="ec-card-count">@this.State.Items.Count</span>
            }
            <div class="ec-card-header-actions">
                @if (!this.Compact)
                {
                    <span class="ec-file-drop-hint"><EcIcon Paths="@AppIcons.Hand" />Přetáhněte soubory sem nebo</span>
                }
                <label class="@(this.Compact ? "ec-button ec-button-secondary ec-button-compact ec-file-upload" : "ec-button ec-button-secondary ec-button-standard ec-file-upload")"
                       for="files-upload-input">
                    <EcIcon Paths="@AppIcons.Upload" /><span class="ec-file-upload-text">@this.UploadLabel</span>
                </label>
                @if (!this.Compact && this.State.Loaded && this.State.ListFailure is null && this.State.Items.Count > 0)
                {
                    <div class="ec-split-button">
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="Stáhnout vše"
                                  OnClick="() => this.DownloadArchive(this.ArchiveUrl)"><span class="ec-split-button-text">Stáhnout vše</span></EcButton>
                        <EcMenu AriaLabel="Další možnosti stažení" Icon="@AppIcons.ChevronDown" Items="this.ArchiveActions()" />
                    </div>
                }
            </div>
        </Header>
        <ChildContent>
            <div class="ec-card-stack">
                @* Keyed on the batch, so the same file can be picked again; a batch in flight keeps
                   its own input and the next drop goes to the first, fresh one. *@
                <div class="ec-visually-hidden">
                    <InputFile @key="this.uploadRound" id="files-upload-input" multiple OnChange="this.OnFilesSelected" />
                    @if (this.busyRound is { } busy)
                    {
                        <InputFile @key="busy" multiple OnChange="this.OnFilesSelected" />
                    }
                </div>

                @if (this.State.Notices.Count > 0)
                {
                    <div class="ec-file-notice" role="status">
                        @foreach (var notice in this.State.Notices)
                        {
                            <span>@notice</span>
                        }
                    </div>
                }

                @foreach (var failure in this.State.Failures)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@failure</div>
                }

                @if (this.uploadTotal > 0)
                {
                    <div class="ec-file-uploading">
                        <EcFileIcon FileName="@this.uploadName" Size="@this.IconSize" />
                        <div class="ec-file-main">
                            <span class="ec-file-name-static">@this.uploadName</span>
                            <progress class="ec-file-progress" aria-label="Nahrávání"></progress>
                            <span class="ec-file-meta">Nahrávám @this.uploadIndex z @this.uploadTotal</span>
                        </div>
                    </div>
                }

                @if (!this.State.Loaded)
                {
                    <p class="ec-card-state">Načítám…</p>
                }
                else if (this.State.ListFailure is not null)
                {
                    <div class="ec-card-error">
                        <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.State.ListFailure</div>
                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                                  OnClick="this.ReloadFiles">Zkusit znovu</EcButton>
                    </div>
                }
                else if (this.State.Items.Count == 0)
                {
                    <EcEmptyState Icon="@AppIcons.Paperclip" Text="Zatím tu nejsou žádné soubory."
                                  Hint="@($"Přetáhněte je kamkoli do panelu nebo použijte {this.UploadLabel}.")" />
                }
                else
                {
                    <div class="ec-file-list">
                        @foreach (var file in this.State.Items)
                        {
                            var renaming = this.renamingFileId == file.FileId;
                            var stored = this.State.Fresh.TryGetValue(file.FileId, out var outcome) ? outcome : (FileUploadOutcome?)null;

                            <div class="@(renaming ? "ec-file-row ec-file-row-renaming" : stored is null ? "ec-file-row" : "ec-file-row ec-file-row-fresh")" @key="file.FileId">
                                <EcFileIcon FileName="@file.FileName" Size="@this.IconSize" />
                                @if (renaming)
                                {
                                    <FileRenameField FileName="@file.FileName" Rename="(name, token) => this.RenameFile(file, name, token)"
                                                     OnRenamed="this.FileRenamed" OnCancel="this.CancelRename" />
                                }
                                else
                                {
                                    <div class="ec-file-main">
                                        <button type="button" class="ec-file-name" @ref="this.nameButtons[file.FileId]"
                                                data-tooltip="@(this.Compact ? null : "Otevřít náhled")" data-tooltip-overflow="@this.Compact"
                                                @onclick="() => this.Open(file)">@file.FileName</button>
                                        <span class="ec-file-meta">@if (stored is { } freshOutcome && this.Compact) { <EcBadge Text="@FreshText(freshOutcome)" Tone="EcBadgeTone.Fresh" /> }@if (file.VersionCount > 1 && this.Compact) { <span class="ec-file-version">verze @file.Version</span>@(" ")<span class="ec-sep" aria-hidden="true">·</span>@(" ") }@if (file.VersionCount > 1 && !this.Compact) { <EcBadge Text="@($"verze {file.Version}")" Tone="EcBadgeTone.FileVersion" /> }@if (stored is { } wideOutcome && !this.Compact) { <EcBadge Text="@FreshText(wideOutcome)" Tone="EcBadgeTone.Fresh" /> }@FileSizeDisplay.Text(file.SizeBytes) <span class="ec-sep" aria-hidden="true">·</span> <span class="ec-file-moment">@MomentDisplay.Text(file.Created)</span></span>
                                    </div>
                                    <div class="ec-file-actions">
                                        <MainFileStar IsMain="file.IsMain" FileName="@file.FileName" OnChange="main => this.ChangeMainFromRow(file, main)" />
                                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Download"
                                                  AriaLabel="@($"Stáhnout {file.FileName}")" data-tooltip="Stáhnout"
                                                  OnClick="() => this.Download(file)" />
                                        <span class="ec-file-menu-wide"><EcMenu AriaLabel="@($"Další akce se souborem {file.FileName}")" Items="this.FileActions(file, download: false)" /></span>
                                        @* Below lg the row has no download button; its menu opens with the download. *@
                                        <span class="ec-file-menu-narrow"><EcMenu AriaLabel="@($"Další akce se souborem {file.FileName}")" Title="@file.FileName" Items="this.FileActions(file, download: true)" /></span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </ChildContent>
    </EcCard>

    <div class="ec-file-drop-overlay" aria-hidden="true">
        <span class="ec-file-drop-badge"><EcIcon Paths="@AppIcons.Upload" Size="EcIconSize.Large" /></span>
        <span class="ec-file-drop-title">Pusťte soubory a nahrají se @this.UploadTarget</span>
        <span class="ec-file-drop-limits">Nejvýše @FileBatchUploader.MaxBatchFiles souborů, každý do @FileSizeDisplay.Text(FileLimits.MaxUploadBytes)</span>
    </div>
</div>

@* Outside the drop zone, so a drop never goes to it. *@
<div class="ec-visually-hidden"><InputFile @ref="this.versionInput" @key="this.versionRound" id="files-version-input" tabindex="-1" aria-label="Nová verze souboru" OnChange="this.OnVersionSelected" /></div>

@if (this.previewFileId is { } previewId)
{
    <FilePreviewModal Files="this.State.Items" FileId="previewId" FileIdChanged="this.PreviewFile"
                      Version="this.previewVersion" VersionChanged="this.PreviewVersion"
                      LoadContent="this.LoadContent" Rename="this.RenameFile"
                      LoadVersions="this.LoadFileVersions" UploadVersion="this.UploadVersion" OnManageVersions="this.ManageVersions"
                      OnDownload="this.Download" OnRenamed="this.FileRenamed" ChangeMain="this.ChangeMain" OnDelete="this.ConfirmDelete"
                      EditOnOpen="this.previewEdits" CompareOnOpen="this.previewCompares" Open OpenChanged="this.ClosePreview" />
}

@if (this.versionsFileId is { } versionsId && this.State.Items.FirstOrDefault(item => item.FileId == versionsId) is { } versionsFile)
{
    <FileVersionsModal File="versionsFile" LoadVersions="this.LoadFileVersions" DeleteVersion="this.DeleteFileVersion" UploadVersion="this.UploadVersion"
                       OnPreview="number => this.ShowVersion(versionsFile, number)" OnDownload="number => this.DownloadVersion(versionsFile, number)"
                       OnCompare="number => this.CompareVersion(versionsFile, number)"
                       OnDeleteFile="() => this.DeleteFromVersions(versionsFile)" OnChanged="this.ReloadFiles" Open OpenChanged="this.CloseVersions" />
}

@if (this.deleting is { } file)
{
    <FileDeleteConfirm File="file" Delete="this.DeleteFile" OpenChanged="this.CloseDelete" OnDone="this.FileDeleted" />
}

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    /// <summary>
    /// The list, its highlights, notices and errors; they outlive the card when it moves.
    /// </summary>
    [Parameter, EditorRequired]
    public required FilesCardState State { get; set; }

    [Parameter, EditorRequired]
    public required Func<IBrowserFile, CancellationToken, Task<FileUploadResult>> UploadFile { get; set; }

    /// <summary>
    /// The bytes the preview shows, of the numbered version or the current one.
    /// </summary>
    [Parameter, EditorRequired]
    public required Func<FileListItem, int?, CancellationToken, Task<Stream>> LoadContent { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, IBrowserFile, CancellationToken, Task<FileUploadResult>> UploadFileVersion { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task<IReadOnlyList<FileVersionItem>>> LoadFileVersions { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, int, CancellationToken, Task> DeleteFileVersion { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, string, CancellationToken, Task> RenameFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DeleteFile { get; set; }

    /// <summary>
    /// Sets the file as the main file of its case or act, or unsets it.
    /// </summary>
    [Parameter, EditorRequired]
    public required Func<FileListItem, bool, CancellationToken, Task> ChangeMainFile { get; set; }

    /// <summary>
    /// Lower case: it follows the file name and a colon.
    /// </summary>
    [Parameter, EditorRequired]
    public required string OwnerGoneError { get; set; }

    /// <summary>
    /// Follows "nahrají se": "k úkonu", "ke spisu".
    /// </summary>
    [Parameter, EditorRequired]
    public required string UploadTarget { get; set; }

    /// <summary>
    /// The archive of the card's files, current versions only (<see cref="FileUrl"/>).
    /// </summary>
    [Parameter, EditorRequired]
    public required string ArchiveUrl { get; set; }

    /// <summary>
    /// The 380 px side column: a short upload label and icon-only file actions.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>The target of a section anchor.</summary>
    [Parameter]
    public string? Id { get; set; }

    private readonly Dictionary<Guid, ElementReference> nameButtons = [];

    private Guid? previewFileId;

    private Guid? renamingFileId;

    private Guid? focusFileId;

    private FileListItem? deleting;

    private ElementReference card;

    private int? previewVersion;

    // The preview opened by Upravit: it opens the editor once the file loads.
    private bool previewEdits;

    // The preview opened by Porovnat s předchozí: it opens comparing.
    private bool previewCompares;

    private Guid? versionsFileId;

    private string UploadLabel => this.Compact ? "Nahrát" : "Nahrát soubory";

    private EcFileIconSize IconSize => this.Compact ? EcFileIconSize.Compact : EcFileIconSize.Standard;

    protected override async Task OnInitializedAsync()
    {
        await this.State.EnsureLoaded(this.Logger);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await this.BrowserFiles.AttachDropZone(this.card, CancellationToken.None);

        if (this.focusFileId is not { } fileId)
            return;

        this.focusFileId = null;

        if (this.nameButtons.TryGetValue(fileId, out var button))
            await button.FocusAsync();
    }

    private IReadOnlyList<EcMenuItem> FileActions(FileListItem file, bool download)
    {
        var actions = new List<EcMenuItem>();

        if (download)
            actions.Add(new EcMenuItem { Text = "Stáhnout", Icon = AppIcons.Download, OnSelect = EventCallback.Factory.Create(this, () => this.Download(file)) });

        if (FileTypeDisplay.Editable(file.FileName, file.SizeBytes))
            actions.Add(new EcMenuItem { Text = "Upravit", Icon = AppIcons.Edit, OnSelect = EventCallback.Factory.Create(this, () => this.Edit(file)) });

        return
        [
            .. actions,
            new EcMenuItem { Text = "Nahrát novou verzi", Icon = AppIcons.Upload, OnSelect = EventCallback.Factory.Create(this, () => this.PickVersion(file)) },
            new EcMenuItem { Text = $"Verze ({file.VersionCount})", Icon = AppIcons.Clock, OnSelect = EventCallback.Factory.Create(this, () => this.OpenVersions(file)) },
            new EcMenuItem { Text = "Přejmenovat", Icon = AppIcons.Pencil, OnSelect = EventCallback.Factory.Create(this, () => this.StartRename(file)) },
            new EcMenuItem { Text = "Smazat", Icon = AppIcons.Trash, OnSelect = EventCallback.Factory.Create(this, () => this.ConfirmDelete(file)), Danger = true, DividerBefore = true },
        ];
    }

    private IReadOnlyList<EcMenuItem> ArchiveActions()
    {
        return
        [
            new EcMenuItem
            {
                Text = "Stáhnout vše včetně verzí",
                Icon = AppIcons.Download,
                OnSelect = EventCallback.Factory.Create(this, () => this.DownloadArchive(FileUrl.WithAllVersions(this.ArchiveUrl))),
            },
        ];
    }

    private async Task DownloadArchive(string archiveUrl)
    {
        await this.BrowserFiles.DownloadArchive(archiveUrl, CancellationToken.None);
    }

    private async Task ReloadFiles()
    {
        await this.State.Reload(this.Logger);

        // A file removed elsewhere takes its open preview or rename with it.
        if (this.previewFileId is { } previewId && this.State.Items.All(file => file.FileId != previewId))
        {
            this.previewFileId = null;
            this.previewVersion = null;
        }

        if (this.renamingFileId is { } renamingId && this.State.Items.All(file => file.FileId != renamingId))
            this.renamingFileId = null;

        if (this.versionsFileId is { } versionsId && this.State.Items.All(file => file.FileId != versionsId))
            this.versionsFileId = null;
    }

    private string? Record(FileUploadResult result)
    {
        var file = result.File;

        switch (result.Outcome)
        {
            case FileUploadOutcome.NewFile:
                this.State.Fresh[file.FileId] = FileUploadOutcome.NewFile;

                return null;

            case FileUploadOutcome.NewVersion:
            {
                if (!this.State.Fresh.TryGetValue(file.FileId, out var known) || known != FileUploadOutcome.NewFile)
                    this.State.Fresh[file.FileId] = FileUploadOutcome.NewVersion;

                var added = $"{file.FileName}: nahráno jako verze {file.Version}.";

                this.State.Notices.Add(added);

                return added;
            }

            case FileUploadOutcome.Unchanged:
            {
                var same = $"{file.FileName}: obsah je stejný jako poslední verze, nová verze nevznikla.";

                this.State.Notices.Add(same);

                return same;
            }

            default:
                throw new UnreachableException();
        }
    }

    private static string FreshText(FileUploadOutcome outcome)
    {
        return outcome == FileUploadOutcome.NewFile ? "nový" : "nová verze";
    }

    private void Open(FileListItem file)
    {
        this.previewFileId = file.FileId;
        this.previewVersion = null;
        this.previewEdits = false;
        this.previewCompares = false;
    }

    private void Edit(FileListItem file)
    {
        this.previewFileId = file.FileId;
        this.previewVersion = null;
        this.previewEdits = true;
        this.previewCompares = false;
    }

    private void PreviewFile(Guid fileId)
    {
        this.previewFileId = fileId;
        this.previewVersion = null;
    }

    private void PreviewVersion(int? version)
    {
        this.previewVersion = version;
    }

    private void ClosePreview(bool open)
    {
        if (open)
            return;

        this.previewFileId = null;
        this.previewVersion = null;
    }

    private void OpenVersions(FileListItem file)
    {
        this.versionsFileId = file.FileId;
    }

    private void CloseVersions(bool open)
    {
        if (!open)
            this.versionsFileId = null;
    }

    private void ShowVersion(FileListItem file, int number)
    {
        this.versionsFileId = null;
        this.previewFileId = file.FileId;
        this.previewEdits = false;
        this.previewCompares = false;
        this.previewVersion = number == file.Version ? null : number;
    }

    private void CompareVersion(FileListItem file, int number)
    {
        this.ShowVersion(file, number);
        this.previewCompares = true;
    }

    private async Task DownloadVersion(FileListItem file, int number)
    {
        await this.BrowserFiles.DownloadFile(file.FileId, number == file.Version ? null : number, file.FileName, CancellationToken.None);
    }

    private void DeleteFromVersions(FileListItem file)
    {
        this.versionsFileId = null;
        this.deleting = file;
    }

    private void ManageVersions(FileListItem file)
    {
        this.previewFileId = null;
        this.previewVersion = null;
        this.versionsFileId = file.FileId;
    }

    private async Task Download(FileListItem file)
    {
        await this.BrowserFiles.DownloadFile(file.FileId, null, file.FileName, CancellationToken.None);
    }

    private void StartRename(FileListItem file)
    {
        this.renamingFileId = file.FileId;
    }

    // A finished rename hands the focus back to the row it replaced.
    private void CancelRename()
    {
        this.focusFileId = this.renamingFileId;
        this.renamingFileId = null;
    }

    private async Task FileRenamed()
    {
        this.focusFileId = this.renamingFileId;
        this.renamingFileId = null;

        await this.ReloadFiles();
    }

    private void ConfirmDelete(FileListItem file)
    {
        this.deleting = file;
    }

    private async Task ChangeMainFromRow(FileListItem file, bool main)
    {
        if (await this.ChangeMain(file, main) is { } failure && !this.State.Failures.Contains(failure))
            this.State.Failures.Add(failure);
    }

    // Called from the preview through a plain delegate, so it redraws the card itself.
    private async Task<string?> ChangeMain(FileListItem file, bool main)
    {
        string? failure = null;

        try
        {
            await this.ChangeMainFile(file, main, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.Logger.LogWarning(exception, "Changing the main file failed: the file is gone");

            failure = $"Soubor {file.FileName} už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Changing the main file failed");

            failure = "Hlavní soubor se nepodařilo změnit. Zkuste to za chvíli znovu.";
        }

        await this.ReloadFiles();

        this.StateHasChanged();

        return failure;
    }

    // A delete that found the file gone leaves the list stale; the reload drops the file and its preview.
    private async Task CloseDelete(bool open)
    {
        if (open)
            return;

        this.deleting = null;

        await this.ReloadFiles();
    }

    // The focus goes to the row that took the deleted one's place, or to the last row.
    private async Task FileDeleted()
    {
        var deletedId = this.deleting!.FileId;
        var position = this.State.Items
            .TakeWhile(file => file.FileId != deletedId)
            .Count();

        this.deleting = null;

        await this.ReloadFiles();

        var left = this.State.Items;

        if (left.Count > 0)
            this.focusFileId = left[Math.Min(position, left.Count - 1)].FileId;
    }
}
