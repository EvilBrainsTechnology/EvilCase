@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@inject IContactsClient ContactsClient
@inject ILogger<ContactField> Logger

<EcCombobox TItem="ContactListItem" InputId="@this.InputId" Placeholder="Hledat v názvu, schránce a adrese"
            SelectedLabel="Vybraný kontakt" EmptyText="@this.emptyText" ItemText="@(static contact => contact.Name)"
            Search="this.SearchContacts" CreateText="Nový kontakt" OnCreate="this.OpenCreate"
            Selected="this.Selected" SelectedChanged="this.SelectedChanged">
    <ItemTemplate>
        <span>@context.Name</span>
        <span class="ec-combobox-option-meta">@ContactKindDisplay.Text(context.Kind)</span>
    </ItemTemplate>
</EcCombobox>

@if (this.createName is not null)
{
    <ContactFormModal InitialName="@this.createName" Open OpenChanged="this.CloseCreate" OnCreated="this.ContactCreated" />
}

@code {
    private const int Matches = 8;

    private const string NoMatch = "Žádný kontakt neodpovídá. Založte nový.";

    [Parameter, EditorRequired]
    public required string InputId { get; set; }

    [Parameter]
    public ContactListItem? Selected { get; set; }

    [Parameter]
    public EventCallback<ContactListItem?> SelectedChanged { get; set; }

    private string? createName;

    private string emptyText = NoMatch;

    private async Task<IReadOnlyList<ContactListItem>> SearchContacts(string search, CancellationToken token)
    {
        try
        {
            var response = await this.ContactsClient.ListContacts(new ContactListRequest { Search = search, Take = Matches }, token);

            this.ShowEmptyText(NoMatch);

            return response.Items;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the contact matches failed");

            this.ShowEmptyText("Hledání kontaktů se nezdařilo. Zkuste to za chvíli znovu.");

            return [];
        }
    }

    // The combobox reads the text as a parameter, so it reaches the screen only through a render of this component.
    private void ShowEmptyText(string text)
    {
        if (string.Equals(this.emptyText, text, StringComparison.Ordinal))
            return;

        this.emptyText = text;

        this.StateHasChanged();
    }

    private void OpenCreate(string typed)
    {
        this.createName = typed;
    }

    private void CloseCreate(bool open)
    {
        if (!open)
            this.createName = null;
    }

    private async Task ContactCreated(ContactListItem created)
    {
        this.createName = null;

        await this.SelectedChanged.InvokeAsync(created);
    }
}
