dotnet_diagnostic.MA0031.severity = error      # Optimize Enumerable.Count() usage
dotnet_diagnostic.MA0032.severity = none       # Use an overload with a CancellationToken argument, even when no token is available in scope (disabled by default)
dotnet_diagnostic.MA0033.severity = error      # Do not tag instance fields with ThreadStaticAttribute
dotnet_diagnostic.MA0035.severity = error      # Do not use dangerous threading methods
