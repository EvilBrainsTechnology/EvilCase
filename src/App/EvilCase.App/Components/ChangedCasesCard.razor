@using EvilBrains.EvilCase.Api.Contract.Cases
@inject NavigationManager Navigation

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><Icon CssClass="icon me-2" IconType="AppIcons.Folders" />Naposledy změněné spisy</h3>
        <div class="card-actions">
            <a href="/cases">Všechny spisy</a>
        </div>
    </div>

    <div class="d-none d-lg-block">
        <table class="table card-table table-vcenter table-hover">
            <thead>
                <tr>
                    <th>Změněno</th>
                    <th>Datum</th>
                    <th>Spis</th>
                    <th>Stav</th>
                    <th>Spisová značka</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in this.Items)
                {
                    <tr class="table-row-link" @onclick="@(() => this.Navigation.NavigateTo($"/cases/{item.CaseId}"))">
                        <td class="text-nowrap">@MomentDisplay.Text(item.Changed)</td>
                        <td class="text-nowrap">@DateDisplay.Text(item.Date)</td>
                        <td class="font-weight-medium">@item.Title</td>
                        <td class="text-nowrap">
                            <Status BackgroundColor="CaseStatusDisplay.Color(item.Status)" Lite="true">@CaseStatusDisplay.Text(item.Status)</Status>
                        </td>
                        <td class="text-nowrap">@item.CaseNumber</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-body d-lg-none">
        @foreach (var item in this.Items)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <div class="text-secondary">@item.CaseNumber</div>
                    <div class="font-weight-medium"><a href="@($"/cases/{item.CaseId}")">@item.Title</a></div>
                    <div>
                        <Status BackgroundColor="CaseStatusDisplay.Color(item.Status)" Lite="true">@CaseStatusDisplay.Text(item.Status)</Status>
                    </div>
                    <div class="text-secondary">@DateDisplay.Text(item.Date)</div>
                    <div class="text-secondary">Změněno @MomentDisplay.Text(item.Changed)</div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<CaseListItem> Items { get; set; }
}
