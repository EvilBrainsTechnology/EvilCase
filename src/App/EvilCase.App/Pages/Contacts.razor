@page "/contacts"
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@implements IDisposable
@inject IContactsClient ContactsClient
@inject ILogger<Contacts> Logger

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">Kontakty</h2>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body border-bottom py-3">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <Icon CssClass="icon" IconType="AppIcons.Search" />
                    </span>
                    <input type="search" class="form-control" aria-label="Hledat v kontaktech"
                           placeholder="Hledat v názvu a ID datové schránky"
                           value="@this.search" @oninput="this.OnSearchInput" />
                </div>
            </div>

            @if (this.failure is not null)
            {
                <div class="empty">
                    <p class="empty-title">Kontakty se nepodařilo načíst</p>
                    <p class="empty-subtitle text-secondary">@this.failure</p>
                </div>
            }
            else if (this.items is null)
            {
                <div class="card-body text-center text-secondary">
                    <div class="spinner-border" role="status"></div>
                </div>
            }
            else if (this.items.Count == 0)
            {
                <div class="empty">
                    <p class="empty-title">Žádné kontakty</p>
                    <p class="empty-subtitle text-secondary">
                        @(string.IsNullOrWhiteSpace(this.search) ? "Zatím tu není žádný kontakt." : "Zkuste jiné hledání.")
                    </p>
                </div>
            }
            else
            {
                <div class="d-none d-lg-block">
                    @* QuickTable sorts by its first column, so that has to be the one the API ordered by. *@
                    <QuickTable Items="this.items.AsQueryable()" Class="card-table table-vcenter">
                        <TemplateColumn Title="Název" Context="item" SortBy="@(GridSort<ContactListItem>.ByAscending(contact => contact.Name))">
                            <a href="/contacts/@item.Id">@item.Name</a>
                        </TemplateColumn>
                        <TemplateColumn Title="Typ" Context="item" Class="text-nowrap">
                            @ContactKindDisplay.Text(item.Kind)
                        </TemplateColumn>
                        <PropertyColumn Property="@(item => item.DataBoxId)" Title="Datová schránka" />
                        <PropertyColumn Property="@(item => item.Address)" Title="Adresa" />
                    </QuickTable>
                </div>

                <div class="card-body d-lg-none">
                    @foreach (var item in this.items)
                    {
                        <ContactListCard Contact="item" />
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly SearchPipeline pipeline;

    private IReadOnlyList<ContactListItem>? items;
    private string search = "";
    private string? failure;

    public Contacts()
    {
        this.pipeline = new SearchPipeline(this.Load, this.Failed);
    }

    public void Dispose()
    {
        this.pipeline.Dispose();
    }

    protected override void OnInitialized()
    {
        this.pipeline.Start(debounce: false);
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        this.search = args.Value as string ?? "";

        this.pipeline.Start(debounce: true);
    }

    private async Task Load(CancellationToken token)
    {
        var request = new ContactListRequest
        {
            Search = string.IsNullOrWhiteSpace(this.search) ? null : this.search,
        };

        var response = await this.ContactsClient.ListContacts(request, token);

        await this.InvokeAsync(() =>
        {
            this.items = response.Items;
            this.failure = null;
            this.StateHasChanged();
        });
    }

    private Task Failed(Exception exception)
    {
        var level = exception is ApiException or HttpRequestException ? LogLevel.Warning : LogLevel.Error;
        this.Logger.Log(level, exception, "Loading the contact list failed");

        return this.InvokeAsync(() =>
        {
            this.items = [];
            this.failure = "Seznam kontaktů se nepodařilo načíst. Zkuste to za chvíli znovu.";
            this.StateHasChanged();
        });
    }
}
