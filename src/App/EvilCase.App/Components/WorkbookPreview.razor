@* A workbook: the table of the sheet chosen and the tabs of all its sheets. The widths, heights, colours and borders the
   workbook gives its cells are its content and come as style attributes. *@
@if (this.Sheets.Count == 0)
{
    <p class="ec-preview-message">Sešit neobsahuje žádné listy.</p>
}
else
{
    var sheet = this.Sheets[this.activeSheet];

    <div class="ec-preview-sheet-view">
        @if (sheet.RowCount > sheet.RowsRead)
        {
            <p class="ec-preview-note">Zobrazuje se jen prvních @NumberDisplay.Text(sheet.RowsRead) řádků z @NumberDisplay.Text(sheet.RowCount).</p>
        }
        <div class="ec-preview-sheet" role="document" tabindex="0" aria-label="Obsah listu @sheet.Name">
            <table class="ec-preview-sheet-table">
                <colgroup>
                    <col class="ec-preview-sheet-gutter" />
                    @foreach (var column in sheet.Columns)
                    {
                        <col style="@($"width:{column.Width}px")" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col"></th>
                        @foreach (var column in sheet.Columns)
                        {
                            <th scope="col">@ColumnName(column.Index)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in sheet.Rows)
                    {
                        <tr style="@(row.Height is { } height ? $"height:{height}px" : null)">
                            <th scope="row">@(row.Index + 1)</th>
                            @foreach (var cell in row.Cells)
                            {
                                if (cell is not null)
                                {
                                    var style = sheet.Styles[cell.Style];

                                    <td class="@(style.ClassName.Length > 0 ? style.ClassName : null)" style="@style.Css"
                                        colspan="@(cell.ColumnSpan > 1 ? cell.ColumnSpan : null)" rowspan="@(cell.RowSpan > 1 ? cell.RowSpan : null)">@cell.Text</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ec-preview-sheet-tabs" role="tablist" aria-label="Listy sešitu">
            @for (var index = 0; index < this.Sheets.Count; index++)
            {
                var sheetIndex = index;

                <button type="button" role="tab" class="ec-preview-sheet-tab" aria-selected="@(sheetIndex == this.activeSheet ? "true" : "false")"
                        @onclick="() => this.activeSheet = sheetIndex">@this.Sheets[sheetIndex].Name</button>
            }
        </div>
    </div>
}

@code {
    private int activeSheet;

    [Parameter, EditorRequired]
    public required IReadOnlyList<SheetPreview> Sheets { get; set; }

    private static string ColumnName(int index)
    {
        var name = "";

        for (var number = index + 1; number > 0; number = (number - 1) / 26)
            name = (char)('A' + (number - 1) % 26) + name;

        return name;
    }
}
