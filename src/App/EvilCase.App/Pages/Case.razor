@page "/cases/{CaseId:guid}"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Files
@using EvilBrains.EvilCase.Api.Contract.Labels
@inject ICasesClient CasesClient
@inject ICaseLabelsClient CaseLabelsClient
@inject ICaseCommentsClient CaseCommentsClient
@inject ICaseFilesClient CaseFilesClient
@inject IFileTransferClient FileTransfer
@inject IFileDownloader Downloader
@inject NavigationManager Navigation
@inject ILogger<Case> Logger

<PageTitle>@(this.caseDetail is null ? "Spis" : this.caseDetail.CaseNumber) – EvilCase</PageTitle>

<div class="ec-page">
    @if (this.notFound)
    {
        <EcCard><p class="ec-state">Spis nenalezen.</p></EcCard>
    }
    else if (this.failure is not null)
    {
        <EcCard>
            <div class="ec-card-error">
                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.failure</div>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                          OnClick="this.LoadCase">Zkusit znovu</EcButton>
            </div>
        </EcCard>
    }
    else if (this.caseDetail is null)
    {
        <EcCard><p class="ec-state">Načítám…</p></EcCard>
    }
    else
    {
        <EcCard>
            <div class="ec-detail">
                <EcPageHeader Title="@this.caseDetail.Title" Breadcrumbs="this.Crumbs">
                    <Status>
                        <EcBadge Text="@CaseStatusDisplay.Text(this.caseDetail.Status)" Tone="CaseStatusDisplay.Tone(this.caseDetail.Status)" />
                    </Status>
                    <Actions>
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" OnClick="this.EditCase">Upravit spis</EcButton>
                        <EcButton Variant="EcButtonVariant.Danger" Icon="@AppIcons.Trash" OnClick="this.StartDeleting">Smazat spis</EcButton>
                    </Actions>
                </EcPageHeader>

                <p class="ec-detail-text">@(string.IsNullOrWhiteSpace(this.caseDetail.Description) ? "—" : this.caseDetail.Description)</p>

                <div class="ec-detail-facts">
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Datum spisu</span>
                        <span class="ec-detail-fact-value">@DateDisplay.Text(this.caseDetail.Date)</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Externí spisová značka</span>
                        <span class="ec-detail-fact-mono">@(string.IsNullOrWhiteSpace(this.caseDetail.ExternalCaseNumber) ? "—" : this.caseDetail.ExternalCaseNumber)</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Protistrana</span>
                        @if (this.caseDetail.Contact is { } contact)
                        {
                            <a class="ec-detail-fact-link" href="@($"/contacts/{contact.ContactId}")">@contact.Name</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Nadřízený spis</span>
                        @if (this.caseDetail.ParentCase is { } parent)
                        {
                            <a class="ec-detail-fact-link" href="@($"/cases/{parent.CaseId}")">@parent.Title</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-labels">
                        <span class="ec-detail-fact-name">Štítky</span>
                        <div class="ec-detail-fact-row">
                            @if (!this.picking)
                            {
                                if (this.caseDetail.Labels.Count > 0)
                                {
                                    foreach (var label in this.caseDetail.Labels)
                                    {
                                        <span class="@($"ec-chip ec-chip-{LabelColorDisplay.Css(label.Color)}")">
                                            <span class="ec-chip-dot" aria-hidden="true"></span>@label.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="ec-detail-fact-value">—</span>
                                }
                            }
                            <EcButton Variant="EcButtonVariant.Ghost" Size="EcButtonSize.Compact"
                                      Icon="@(this.picking ? AppIcons.X : AppIcons.Plus)"
                                      AriaLabel="@(this.picking ? "Zavřít výběr štítků" : "Přidat štítek")"
                                      OnClick="this.ToggleLabelPicker" />
                        </div>
                        @if (this.picking)
                        {
                            <div class="ec-label-picker">
                                <LabelField InputId="case-labels" Selected="this.caseDetail.Labels" SelectedChanged="this.SaveLabels" />
                                @if (this.labelsError is not null)
                                {
                                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.labelsError</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </EcCard>

        <div class="ec-detail-layout">
            <div class="ec-detail-main">
                <ActList @key="(nameof(ActList), this.CaseId)"
                         Columns="ActColumns"
                         Filter="this.ActFilter"
                         Title="Úkony"
                         ShowSearch="true"
                         ShowDates="true"
                         ShowLabelFilter="true"
                         ShowDirectionFilter="true"
                         ShowPaging="true"
                         EmptyText="Zatím tu není žádný úkon.">
                    <Actions>
                        <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Compact" Icon="@AppIcons.Plus"
                                  Href="@($"/cases/{this.CaseId}/act/new")">Nový úkon</EcButton>
                    </Actions>
                    <EmptyAction>
                        <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus"
                                  Href="@($"/cases/{this.CaseId}/act/new")">Založit úkon</EcButton>
                    </EmptyAction>
                </ActList>
            </div>

            <aside class="ec-detail-aside">
                <CaseChildrenCard ParentCaseId="this.CaseId" />

                <FilesCard @key="(nameof(FilesCard), this.CaseId)"
                           Title="Soubory spisu"
                           OwnerGoneError="spis už neexistuje."
                           LoadFiles="this.LoadFiles"
                           UploadFile="this.UploadFile"
                           DownloadFile="this.DownloadFile"
                           DeleteFile="this.DeleteFile" />

                <CommentsCard @key="(nameof(CommentsCard), this.CaseId)"
                              Title="Komentáře spisu"
                              Placeholder="Poznámka ke spisu…"
                              LoadComments="this.LoadComments"
                              AddComment="this.AddComment"
                              SaveComment="this.SaveComment"
                              DeleteComment="this.DeleteComment" />
            </aside>
        </div>
    }
</div>

@if (this.deleting && this.caseDetail is not null)
{
    <CaseDeleteModal Case="this.caseDetail" Open OpenChanged="this.CloseDelete" OnDeleted="this.CaseDeleted" />
}

@code {
    private const int ActItems = 20;

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Date,
        ActColumn.Act,
        ActColumn.Direction,
        ActColumn.Contact,
        ActColumn.Labels,
        ActColumn.ActNumber,
    ];

    [Parameter]
    public Guid CaseId { get; set; }

    private CaseDetail? caseDetail;

    private bool notFound;

    private string? failure;

    private string? labelsError;

    private bool picking;

    private bool deleting;

    private ActListRequest ActFilter => new() { CaseId = this.CaseId, Take = ActItems };

    private IReadOnlyList<EcCrumb> Crumbs => this.caseDetail is null
        ? [new EcCrumb("Spisy", "/cases")]
        : [new EcCrumb("Spisy", "/cases"), new EcCrumb(this.caseDetail.CaseNumber, null)];

    protected override Task OnParametersSetAsync()
    {
        return this.LoadCase();
    }

    private async Task LoadCase()
    {
        this.caseDetail = null;
        this.notFound = false;
        this.failure = null;
        this.labelsError = null;
        this.picking = false;

        try
        {
            this.caseDetail = await this.CasesClient.GetCase(this.CaseId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the case detail failed");

            this.failure = "Spis se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void ToggleLabelPicker()
    {
        this.picking = !this.picking;
        this.labelsError = null;
    }

    private async Task SaveLabels(IReadOnlyList<LabelItem> labels)
    {
        this.labelsError = null;

        try
        {
            var request = new LabelAssignmentRequest { LabelIds = [.. labels.Select(static label => label.LabelId)] };

            await this.CaseLabelsClient.SetCaseLabels(this.CaseId, request, CancellationToken.None);

            this.caseDetail = await this.CasesClient.GetCase(this.CaseId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.labelsError = "Spis už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the case labels failed");

            this.labelsError = "Štítky se nepodařilo uložit. Zkuste to za chvíli znovu.";
        }
    }

    private void EditCase()
    {
        this.Navigation.NavigateTo($"/cases/{this.CaseId}/edit");
    }

    private void StartDeleting()
    {
        this.deleting = true;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = false;
    }

    private void CaseDeleted()
    {
        this.deleting = false;

        this.Navigation.NavigateTo("/cases");
    }

    private async Task<IReadOnlyList<FileListItem>> LoadFiles(CancellationToken token)
    {
        return (await this.CaseFilesClient.ListCaseFiles(this.CaseId, token)).Items;
    }

    private Task UploadFile(IBrowserFile file, CancellationToken token)
    {
        return this.FileTransfer.UploadCaseFile(this.CaseId, file, token);
    }

    private async Task DownloadFile(FileListItem file, CancellationToken token)
    {
        var content = await this.FileTransfer.DownloadFileContent(file.FileId, token);
        await this.Downloader.SaveFile(file.FileName, content, token);
    }

    private Task DeleteFile(FileListItem file, CancellationToken token)
    {
        return this.CaseFilesClient.DeleteCaseFile(this.CaseId, file.FileId, token);
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.CaseCommentsClient.ListCaseComments(this.CaseId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.CaseCommentsClient.AddCaseComment(this.CaseId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.CaseCommentsClient.EditCaseComment(this.CaseId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.CaseCommentsClient.DeleteCaseComment(this.CaseId, commentId, token);
    }
}
