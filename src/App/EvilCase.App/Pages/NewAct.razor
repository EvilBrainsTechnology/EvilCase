@page "/acts/new"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Labels
@using EvilBrains.EvilCase.Domain.Acts
@inject IActsClient ActsClient
@inject ICasesClient CasesClient
@inject NavigationManager Navigation
@inject ILogger<NewAct> Logger

<PageTitle>Nový úkon – EvilCase</PageTitle>

<div class="ec-page">
    <EcPageHeader Title="Nový úkon" Breadcrumbs="this.Crumbs" />

    @if (this.notFound)
    {
        <NotFoundCard Text="Spis nenalezen." BackHref="/cases" BackText="Zpět na spisy" />
    }
    else if (this.failure is not null)
    {
        <EcCard><p class="ec-state">@this.failure</p></EcCard>
    }
    else if (this.Loading)
    {
        <EcCard><p class="ec-state">Načítám…</p></EcCard>
    }
    else
    {
        <div class="ec-form-layout">
            <CascadingValue Value="this.editContext">
                <DataAnnotationsValidator />
                <EcCard>
                    <ChildContent>
                        <div class="ec-form">
                            @if (this.CaseId is null)
                            {
                                <EcField Label="Spis" Required ControlId="act-case">
                                    <ChildContent>
                                        <CaseField InputId="act-case" Selected="this.pickedCase" SelectedChanged="this.OnCasePicked" />
                                    </ChildContent>
                                    <Error>
                                        @if (this.caseError is not null)
                                        {
                                            <div class="validation-message">@this.caseError</div>
                                        }
                                    </Error>
                                </EcField>
                            }

                            <EcField Label="Název úkonu" Required ControlId="act-title" Hint="Nejvýše 256 znaků">
                                <ChildContent>
                                    <InputText id="act-title" class="ec-input" autofocus @bind-Value="this.model.Title" />
                                </ChildContent>
                                <Error><ValidationMessage For="() => this.model.Title" /></Error>
                            </EcField>

                            <div class="ec-form-row">
                                <EcField Label="Datum úkonu" Required ControlId="act-date">
                                    <ChildContent>
                                        <InputDate id="act-date" class="ec-input" @bind-Value="this.model.Date" />
                                    </ChildContent>
                                    <Error><ValidationMessage For="() => this.model.Date" /></Error>
                                </EcField>
                            </div>

                            <EcField Label="Štítky" ControlId="act-labels">
                                <ChildContent>
                                    <LabelField InputId="act-labels" Selected="this.model.Labels" SelectedChanged="this.OnLabelsChanged" />
                                </ChildContent>
                            </EcField>

                            <div class="ec-form-group">
                                <div class="ec-form-group-head">
                                    <h2 class="ec-form-group-title">Směr a&nbsp;kontakt</h2>
                                    <span class="ec-form-group-hint">Vyplňte obojí, nebo nic</span>
                                </div>
                                <div class="ec-form-group-row">
                                    <EcField Label="Směr" Hint="Klik na vybraný směr ho zruší.">
                                        <ChildContent>
                                            <DirectionField InputId="act-direction" Selected="this.model.Direction" SelectedChanged="this.OnDirectionChanged" />
                                        </ChildContent>
                                        <Error><ValidationMessage For="() => this.model.Direction" /></Error>
                                    </EcField>
                                    <EcField Label="Kontakt protistrany" ControlId="act-contact">
                                        <ChildContent>
                                            <ContactField InputId="act-contact" Selected="this.model.Contact" SelectedChanged="this.OnContactChanged" />
                                        </ChildContent>
                                        <Error><ValidationMessage For="() => this.model.Contact" /></Error>
                                    </EcField>
                                </div>
                                @if (ActContactRules.DifferingCaseContact(this.model.Contact, this.caseDetail?.Contact) is { } differing)
                                {
                                    <div class="ec-warning" role="alert">
                                        <EcIcon Paths="@AppIcons.AlertTriangle" Size="EcIconSize.Large" />
                                        <p class="ec-warning-text">Spis má kontakt <strong>@differing.Name</strong>. Uložení to nebrání.</p>
                                    </div>
                                }
                            </div>

                            <EcField Label="Popis" ControlId="act-description" Hint="Nejvýše 4000 znaků">
                                <ChildContent>
                                    <InputTextArea id="act-description" class="ec-textarea" rows="5" @bind-Value="this.model.Description" />
                                </ChildContent>
                                <Error><ValidationMessage For="() => this.model.Description" /></Error>
                            </EcField>

                            @if (this.error is not null)
                            {
                                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
                            }
                        </div>
                    </ChildContent>
                    <Footer>
                        <span class="ec-form-note">Číslo jednací přidělí aplikace při uložení.</span>
                        <div class="ec-form-actions">
                            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Form" Icon="@AppIcons.X" OnClick="this.Cancel">Zrušit</EcButton>
                            <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Form" Icon="@AppIcons.Check" Disabled="@this.busy" OnClick="this.SubmitAct">Založit úkon</EcButton>
                        </div>
                    </Footer>
                </EcCard>
            </CascadingValue>

            <aside class="ec-form-aside">
                @if (this.caseDetail is not null)
                {
                    <EcCard Title="Spis">
                        <a class="ec-case-link" href="/cases/@this.caseDetail.CaseId">
                            <span class="ec-case-link-title">@CzechTypography.Text(this.caseDetail.Title)</span>
                            <span class="ec-case-link-number">@this.caseDetail.CaseNumber</span>
                        </a>
                        <p class="ec-card-text">Úkon vzniká pod tímto spisem. Přesunout ho jinam nejde.</p>
                    </EcCard>
                }
                <EcCard Title="Co přijde po uložení">
                    <p class="ec-card-text">Otevře se detail spisu se založeným úkonem v&nbsp;seznamu. Dokumenty a&nbsp;komentáře k&nbsp;úkonu přidáte na jeho detailu.</p>
                </EcCard>
            </aside>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "case")]
    public Guid? CaseId { get; set; }

    private readonly NewActModel model = new() { Date = DateOnly.FromDateTime(DateTime.Now) };

    private EditContext editContext = null!;

    private CaseDetail? caseDetail;

    private CaseListItem? pickedCase;

    private string? caseError;

    private bool notFound;

    private string? failure;

    private string? error;

    private bool busy;

    private bool Loading => this.CaseId is not null && this.caseDetail is null;

    private IReadOnlyList<EcCrumb> Crumbs => this.caseDetail is null
        ? [new EcCrumb("Spisy", "/cases"), new EcCrumb("Nový úkon", null)]
        : [new EcCrumb("Spisy", "/cases"), new EcCrumb(this.caseDetail.Title, $"/cases/{this.caseDetail.CaseId}"), new EcCrumb("Nový úkon", null)];

    protected override void OnInitialized()
    {
        this.editContext = new EditContext(this.model);
    }

    protected override Task OnParametersSetAsync()
    {
        return this.LoadCase();
    }

    private async Task LoadCase()
    {
        this.caseDetail = null;
        this.pickedCase = null;
        this.caseError = null;
        this.notFound = false;
        this.failure = null;
        this.error = null;

        if (this.CaseId is not { } caseId)
            return;

        try
        {
            this.caseDetail = await this.CasesClient.GetCase(caseId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the case of the new act failed");

            this.failure = "Spis se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task OnCasePicked(CaseListItem? picked)
    {
        this.pickedCase = picked;
        this.caseDetail = null;
        this.caseError = null;
        this.error = null;

        if (picked is null)
            return;

        try
        {
            this.caseDetail = await this.CasesClient.GetCase(picked.CaseId, CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the picked case of the new act failed");

            this.pickedCase = null;
            this.error = "Spis se nepodařilo načíst. Vyberte ho znovu.";
        }
    }

    private void OnDirectionChanged(ActDirection? direction)
    {
        this.model.Direction = direction;
        this.model.Contact = ActContactRules.Prefilled(this.model.Direction, this.model.Contact, this.caseDetail?.Contact);
    }

    private void OnContactChanged(ContactListItem? contact)
    {
        this.model.Contact = contact;
    }

    private void OnLabelsChanged(IReadOnlyList<LabelItem> labels)
    {
        this.model.Labels = labels;
    }

    private void Cancel()
    {
        this.Navigation.NavigateTo(this.CaseId is { } caseId ? $"/cases/{caseId}" : "/cases");
    }

    private async Task SubmitAct()
    {
        var valid = this.editContext.Validate();

        if (this.caseDetail is null)
        {
            this.caseError = "Vyberte spis";
            valid = false;
        }

        if (!valid)
            return;

        this.busy = true;
        this.error = null;

        try
        {
            var request = new CreateActRequest
            {
                CaseId = this.caseDetail!.CaseId,
                Direction = this.model.Direction,
                Date = this.model.Date,
                Title = this.model.Title,
                Description = this.model.Description,
                ContactId = this.model.Contact?.ContactId,
                LabelIds = [.. this.model.Labels.Select(static label => label.LabelId)],
            };

            _ = await this.ActsClient.CreateAct(request, CancellationToken.None);

            this.Navigation.NavigateTo($"/cases/{request.CaseId}");
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            this.error = exception.ResponseBody?.Contains(ContactProblems.UnknownContact, StringComparison.Ordinal) == true
                ? "Vybraný kontakt už neexistuje. Vyberte jiný."
                : "Zkontrolujte zadané údaje a\u00A0zkuste to znovu.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.error = "Spis už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Filing a new act failed");

            this.error = "Úkon se nepodařilo založit. Zkontrolujte zadané údaje a\u00A0zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
