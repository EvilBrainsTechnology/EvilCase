@page "/"
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Lists
@using EvilBrains.EvilCase.Domain.Cases
@inject ICasesClient CasesClient
@inject ILogger<Home> Logger

<PageTitle>Přehled – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">Přehled</h2>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        @if (this.failure is not null)
        {
            <div class="empty">
                <div class="empty-icon"><Icon IconType="TablerIcons.AlertTriangle" /></div>
                <p class="empty-title">Přehled se nepodařilo načíst</p>
                <p class="empty-subtitle text-secondary">@this.failure</p>
            </div>
        }
        else if (this.view is null)
        {
            <div class="text-center text-secondary">
                <div class="spinner-border" role="status"></div>
            </div>
        }
        else if (this.view.IsEmpty)
        {
            <div class="empty">
                <div class="empty-icon"><Icon IconType="TablerIcons.Folders" /></div>
                <p class="empty-title">Zatím tu není žádný spis</p>
                <p class="empty-subtitle text-secondary">Založte první spis a přehled se naplní.</p>
                <div class="empty-action">
                    <a href="/cases/new" class="btn btn-primary"><Icon CssClass="icon" IconType="TablerIcons.Plus" />Založit první spis</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-deck row-cards">
                <div class="col-12 col-lg-4">
                    <StatCard Value="this.view.Counts.Active" Label="@CaseStatusDisplay.Text(CaseStatus.Active)"
                              Glyph="TablerIcons.Folders" Color="CaseStatusDisplay.Color(CaseStatus.Active)" />
                </div>
                <div class="col-12 col-lg-4">
                    <StatCard Value="this.view.Counts.WaitingOnAuthority" Label="@CaseStatusDisplay.Text(CaseStatus.WaitingOnAuthority)"
                              Glyph="TablerIcons.Clock" Color="CaseStatusDisplay.Color(CaseStatus.WaitingOnAuthority)" />
                </div>
                <div class="col-12 col-lg-4">
                    <StatCard Value="this.view.Counts.Closed" Label="@CaseStatusDisplay.Text(CaseStatus.Closed)"
                              Glyph="TablerIcons.FileText" Color="CaseStatusDisplay.Color(CaseStatus.Closed)" />
                </div>
            </div>

            <div class="mt-3">
                <CaseList Columns="CaseColumns" Filter="CaseTile" Title="Naposledy změněné spisy">
                    <Actions>
                        <a href="/cases">Všechny spisy</a>
                    </Actions>
                    <EmptyAction>
                        <a href="/cases/new" class="btn btn-primary"><Icon CssClass="icon" IconType="TablerIcons.Plus" />Založit spis</a>
                    </EmptyAction>
                </CaseList>
            </div>

            <div class="mt-3">
                <ActList Columns="ActColumns" Filter="ActTile" Title="Naposledy změněné úkony"
                         EmptyText="Zatím tu není žádný úkon." />
            </div>
        }

    </div>
</div>

@code {
    private const int TileItems = 5;

    private static readonly CaseColumn[] CaseColumns =
    [
        CaseColumn.Changed,
        CaseColumn.Date,
        CaseColumn.Case,
        CaseColumn.Status,
        CaseColumn.Labels,
        CaseColumn.CaseNumber,
    ];

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Changed,
        ActColumn.Date,
        ActColumn.Case,
        ActColumn.Act,
        ActColumn.Direction,
        ActColumn.Labels,
        ActColumn.ActNumber,
    ];

    private static readonly CaseListRequest CaseTile = new()
    {
        Status = CaseStatusFilter.All,
        Sort = CaseSortKey.Changed,
        Take = TileItems,
    };

    private static readonly ActListRequest ActTile = new()
    {
        Sort = ActSortKey.Changed,
        SortDirection = ListSortDirection.Descending,
        Take = TileItems,
    };

    private DashboardView? view;

    private string? failure;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            this.view = new DashboardView { Counts = await this.CasesClient.CountCases(CancellationToken.None) };
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the dashboard failed");

            this.failure = "Přehled se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }
}
