@using EvilBrains.EvilCase.Api.Contract.Cases

<div class="card mb-2">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="min-w-0">
                <div class="text-secondary">@Case.CaseNumber</div>
                <div class="font-weight-medium"><a href="@($"/cases/{Case.CaseId}")">@Case.Title</a></div>
            </div>
            @* Without this the flex row breaks a two-word status across three lines. *@
            <div class="flex-shrink-0 text-nowrap">
                <Status BackgroundColor="CaseStatusDisplay.Color(Case.Status)" Lite="true">@CaseStatusDisplay.Text(Case.Status)</Status>
            </div>
        </div>

        <div class="text-secondary mt-2">@DateDisplay.Text(Case.Date)</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required CaseListItem Case { get; set; }
}
