@using EvilBrains.EvilCase.Api.Contract.Numbers

<ConfirmDeleteModal Delete="this.DeleteNumber" GoneError="@this.Text.DeleteGoneError" FailedError="@this.Text.DeleteFailedError" OnDeleted="this.OnDeleted">
    <p>@this.Text.DeleteQuestion <strong>@this.Number.Value</strong>? Akci nelze vrátit zpět.</p>
</ConfirmDeleteModal>

@code {
    [Parameter, EditorRequired]
    public required ExternalNumberText Text { get; set; }

    [Parameter, EditorRequired]
    public required ExternalNumberItem Number { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task> DeleteNumber { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }
}
