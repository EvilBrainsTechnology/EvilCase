@page "/contacts/{ContactId:guid}"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Lists
@using EvilBrains.EvilCase.Domain.Contacts
@using TabBlazor.Services
@inject IContactsClient ContactsClient
@inject IModalService ModalService
@inject NavigationManager Navigation
@inject ILogger<Contact> Logger

<PageTitle>@(this.contact is null ? "Kontakt" : this.contact.Name) – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center ec-detail-header">
            <div class="col">
                <div class="page-pretitle"><a href="/contacts">Kontakty</a></div>
                <h2 class="page-title">
                    @(this.contact?.Name)
                    @if (this.contact is not null)
                    {
                        <span class="ms-2"><span class="badge bg-secondary-lt">@ContactKindDisplay.Text(this.contact.Kind)</span></span>
                    }
                </h2>
            </div>
            @if (this.contact is not null)
            {
                <div class="col-auto ms-auto d-print-none">
                    <button type="button" class="btn btn-primary" @onclick="this.Edit"><Icon CssClass="icon" IconType="TablerIcons.Pencil" />Upravit</button>
                    <button type="button" class="btn btn-danger ms-2" @onclick="this.DeleteContact"><Icon CssClass="icon" IconType="TablerIcons.Trash" />Smazat</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <LoadStateView NotFound="this.notFound" NotFoundTitle="Kontakt nenalezen" Failure="@this.failure" FailureTitle="Kontakt se nepodařilo načíst" Loaded="this.contact is not null">
            <div class="ec-layout">
                <div class="ec-main">
                    <CaseList Columns="CaseColumns"
                              Filter="this.CaseFilter"
                              Title="Spisy"
                              ShowSorting="true"
                              ShowPaging="true"
                              EmptySubtitle="Kontakt nefiguruje v žádném spisu." />

                    <ActList Columns="ActColumns"
                             Filter="this.ActFilter"
                             Title="Úkony"
                             ShowSorting="true"
                             ShowPaging="true"
                             EmptySubtitle="Kontakt nefiguruje v žádném úkonu." />
                </div>

                <aside class="ec-sidebar d-flex flex-column gap-3">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.ListDetails" />Údaje</h3></div>
                        <div class="card-body d-flex flex-column gap-3">
                            <div>
                                <div class="ec-field-label">Typ</div>
                                <div>@ContactKindDisplay.Text(this.contact!.Kind)</div>
                            </div>
                            <div>
                                <div class="ec-field-label">ID datové schránky</div>
                                <div class="ec-mono">@(this.contact.DataBoxId ?? "—")</div>
                            </div>
                            <div>
                                <div class="ec-field-label">Adresa</div>
                                <div>
                                    @if (string.IsNullOrWhiteSpace(this.contact.Address))
                                    {
                                        @:—
                                    }
                                    else
                                    {
                                        <div class="address-block">@this.contact.Address</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </LoadStateView>
    </div>
</div>

@code {
    private const int OccurrenceItems = 20;

    private static readonly CaseColumn[] CaseColumns =
    [
        CaseColumn.Date,
        CaseColumn.Case,
        CaseColumn.Status,
        CaseColumn.CaseNumber,
    ];

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Date,
        ActColumn.Case,
        ActColumn.Act,
        ActColumn.Direction,
        ActColumn.ActNumber,
        ActColumn.ExternalNumber,
    ];

    [Parameter]
    public Guid ContactId { get; set; }

    private ContactDetail? contact;

    private bool notFound;

    private string? failure;

    private CaseListRequest CaseFilter => new()
    {
        ContactId = this.ContactId,
        Status = CaseStatusFilter.All,
        Scope = CaseListScope.All,
        Take = OccurrenceItems,
    };

    // The occurrences of a contact read from the newest date (SDD-011).
    private ActListRequest ActFilter => new()
    {
        ContactId = this.ContactId,
        SortDirection = ListSortDirection.Descending,
        Take = OccurrenceItems,
    };

    protected override Task OnParametersSetAsync()
    {
        return this.LoadContact();
    }

    private async Task LoadContact()
    {
        this.contact = null;
        this.notFound = false;
        this.failure = null;

        try
        {
            this.contact = await this.ContactsClient.GetContact(this.ContactId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the contact detail failed");

            this.failure = "Kontakt se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task Edit()
    {
        if (this.contact is null)
            return;

        await this.ModalService.ShowAsync(
            "Upravit kontakt",
            new RenderComponent<ContactFormModal>()
                .Set(component => component.Contact, this.contact)
                .Set(component => component.OnSaved, EventCallback.Factory.Create(this, this.LoadContact)),
            FullscreenBelowLarge());
    }

    private async Task DeleteContact()
    {
        if (this.contact is null)
            return;

        await this.ModalService.ShowAsync(
            "Smazat kontakt",
            new RenderComponent<ContactDeleteModal>()
                .Set(component => component.Contact, this.contact)
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, () => this.Navigation.NavigateTo("/contacts"))),
            FullscreenBelowLarge());
    }

    private static ModalOptions FullscreenBelowLarge()
    {
        return new() { Fullscreen = ModalFullscreen.BelowLarge };
    }
}
