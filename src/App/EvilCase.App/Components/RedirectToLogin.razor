@inject NavigationManager Navigation

@code {
    public const string ReturnUrlParameter = "returnUrl";

    private const string LoginPath = "login";

    protected override void OnInitialized()
    {
        var target = this.Navigation.ToBaseRelativePath(this.Navigation.Uri);

        // Replaces the entry rather than adding one: without it the back button walks into the page
        // that just bounced the user and straight back here.
        this.Navigation.NavigateTo(
            target.Length == 0 ? LoginPath : $"{LoginPath}?{ReturnUrlParameter}={Uri.EscapeDataString("/" + target)}",
            replace: true);
    }
}
