@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@inject IActsClient ActsClient
@inject ILogger<ActDeleteModal> Logger

<EcModal Title="Smazat úkon" Open="this.Open" OpenChanged="this.OpenChanged">
    <ChildContent>
        <p class="ec-confirm-text">
            Opravdu smazat úkon <strong>@this.Act.ActNumber</strong> — @this.Act.Title? S úkonem zaniknou
            i jeho komentáře a soubory. Akci nelze vrátit zpět.
        </p>
        @if (this.error is not null)
        {
            <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
        }
    </ChildContent>
    <Footer>
        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Form" Icon="@AppIcons.X" OnClick="this.Cancel">Zrušit</EcButton>
        <EcButton Variant="EcButtonVariant.Danger" Size="EcButtonSize.Form" Icon="@AppIcons.Trash"
                  Disabled="@this.busy" OnClick="this.DeleteAct">Smazat úkon</EcButton>
    </Footer>
</EcModal>

@code {
    [Parameter, EditorRequired]
    public required ActDetail Act { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private string? error;

    private bool busy;

    private async Task Cancel()
    {
        await this.OpenChanged.InvokeAsync(false);
    }

    private async Task DeleteAct()
    {
        this.busy = true;
        this.error = null;

        try
        {
            await this.ActsClient.DeleteAct(this.Act.CaseId, this.Act.ActId, CancellationToken.None);

            await this.OnDeleted.InvokeAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.error = "Úkon už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Deleting the act failed");

            this.error = "Úkon se nepodařilo smazat. Zkuste to za chvíli znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
