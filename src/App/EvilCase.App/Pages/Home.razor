@page "/"
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract
@inject IEchoClient EchoClient
@inject IAuthClient AuthClient;

<h1>EvilCase</h1>

<input @bind="message" placeholder="Type a message" />
<button @onclick="SendGetAsync">Send GET</button>
<button @onclick="SendPostAsync">Send POST</button>

@if (response is not null)
{
    <p>@response</p>
}

@code {
    private string message = string.Empty;
    private string? response;

    private async Task SendGetAsync()
    {
        var result = await EchoClient.EchoGet(new EchoRequest { Message = message });
        response = result.Message;
    }

    private async Task SendPostAsync()
    {
        var result = await EchoClient.EchoPost(new EchoRequest { Message = message });
        response = result.Message;
    }
}
