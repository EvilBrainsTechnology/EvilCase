@using System.Diagnostics
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Lists
@inherits FilteredListComponent<CaseListRequest>
@inject ICasesClient CasesClient

@{
    var columns = new List<EcColumn<CaseListItem>>();

    foreach (var column in this.Columns)
    {
        columns.Add(column switch
        {
            CaseColumn.Changed => new EcColumn<CaseListItem>
            {
                Header = "Změněno",
                Width = "var(--ec-list-col-moment)",
                SortKey = nameof(CaseSortKey.Changed),
                CellClass = "ec-cell-num",
                Cell = item =>@<span title="@MomentDisplay.Text(item.Changed)">@MomentDisplay.Relative(item.Changed, DateTime.Now)</span>,
            },
            CaseColumn.Date => new EcColumn<CaseListItem>
            {
                Header = "Datum spisu",
                Width = "var(--ec-list-col-date)",
                SortKey = nameof(CaseSortKey.Date),
                CellClass = "ec-cell-num",
                Cell = item =>@<text>@DateDisplay.Text(item.Date)</text>,
            },
            CaseColumn.Case => new EcColumn<CaseListItem>
            {
                Header = "Spis",
                Width = "minmax(0, 1fr)",
                SortKey = nameof(CaseSortKey.Title),
                Primary = true,
                Cell = item =>@<text>
                    <span class="ec-cell-text" title="@item.Title">@item.Title</span>
                    <LabelChips Labels="item.Labels" />
                </text>,
            },
            CaseColumn.Status => new EcColumn<CaseListItem>
            {
                Header = "Stav",
                Width = "var(--ec-list-col-status)",
                Cell = item =>@<EcBadge Tone="CaseStatusDisplay.Tone(item.Status)" Text="@CaseStatusDisplay.Text(item.Status)" ShowDot="true" />,
            },
            CaseColumn.CaseNumber => new EcColumn<CaseListItem>
            {
                Header = "Spisová značka",
                Width = "var(--ec-list-col-number)",
                SortKey = nameof(CaseSortKey.CaseNumber),
                CellClass = "ec-cell-mono ec-cell-stack",
                Cell = item =>@<text>
                    <span class="ec-cell-text">@item.CaseNumber</span>
                    @if (!string.IsNullOrEmpty(item.ExternalCaseNumber))
                    {
                        <span class="ec-cell-text ec-cell-sub">@item.ExternalCaseNumber</span>
                    }
                </text>,
            },
            CaseColumn.ExternalNumber => new EcColumn<CaseListItem>
            {
                Header = "Externí spisová značka",
                Width = "var(--ec-list-col-number)",
                CellClass = "ec-cell-mono",
                Cell = item =>@<text>@item.ExternalCaseNumber</text>,
            },
            _ => throw new UnreachableException(),
        });
    }
}

<EcTable TItem="CaseListItem"
         Title="@this.Title" Actions="this.Actions"
         ShowToolbar="this.ToolbarShown"
         Columns="columns" Items="this.items" RowHref="RowHref"
         SortKey="@this.sort.ToString()"
         SortDescending="@(this.Direction == ListSortDirection.Descending)"
         SortChanged="this.OnSortChanged"
         Loading="this.Loading" Failure="@this.Failure" Retry="this.Reload"
         Skip="this.Skip" Take="this.Filter.Take" Total="this.Total"
         ShowPaging="this.ShowPaging" Previous="this.ToPreviousPage" Next="this.ToNextPage">
    <Toolbar>
        @if (this.ShowSearch)
        {
            <label class="ec-search" for="@($"{this.InputPrefix}-search")">
                <EcIcon Paths="@AppIcons.Search" Size="EcIconSize.Small" />
                <input id="@($"{this.InputPrefix}-search")" type="search" class="ec-search-input" aria-label="Hledat ve spisech"
                       placeholder="Hledat v názvu a popisu" value="@this.SearchText" @oninput="this.OnSearchInput" />
            </label>
        }

        @if (this.ShowStatusFilter)
        {
            <label class="ec-visually-hidden" for="@($"{this.InputPrefix}-status")">Stav</label>
            <select id="@($"{this.InputPrefix}-status")" class="ec-select" @onchange="this.OnStatusSelected">
                @foreach (var value in StatusFilters)
                {
                    <option value="@value" selected="@(value == this.status)">@CaseStatusDisplay.FilterText(value)</option>
                }
            </select>
        }

        @if (this.ShowStatusSwitch)
        {
            <div class="ec-segmented ec-segmented-compact" role="group" aria-label="Stav spisu">
                @foreach (var value in StatusSwitch)
                {
                    <button id="@($"{this.InputPrefix}-status-{value}")" type="button" class="ec-segment"
                            aria-pressed="@(this.status == value ? "true" : "false")" @onclick="() => this.SetStatus(value)">@CaseStatusDisplay.SwitchText(value)</button>
                }
            </div>
        }

        @if (this.ShowDates || this.ShowLabelFilter)
        {
            <ListFilters InputPrefix="@this.InputPrefix" ShowDates="this.ShowDates" ShowLabelFilter="this.ShowLabelFilter"
                         FromLabel="Datum spisu od" ToLabel="do"
                         From="this.From" To="this.To" SelectedLabels="this.SelectedLabels" ActiveCount="this.ActiveFilterCount"
                         FromChanged="this.OnFromInput" ToChanged="this.OnToInput" LabelsChanged="this.OnLabelsChanged"
                         Cleared="this.ClearFilters" />
        }

        @if (this.ShowScopeFilter)
        {
            <label class="ec-check" for="@($"{this.InputPrefix}-scope")">
                <input id="@($"{this.InputPrefix}-scope")" type="checkbox" class="ec-check-box"
                       checked="@(this.scope == CaseListScope.RootOnly)" @onchange="this.OnScopeChanged" />
                Jen rodičovské spisy
            </label>
        }
    </Toolbar>
    <Empty>
        <EcEmptyState Icon="@AppIcons.Folders" Text="@(this.IsFiltered ? FilteredEmptyText : this.EmptyText)" Action="this.EmptyAction" />
    </Empty>
</EcTable>

@code {
    private const string FilteredEmptyText = "Filtru neodpovídá žádný spis.";

    // The select's order (Otevřené, Všechny stavy, Aktivní, Čeká na úřad, Uzavřený), not the enum's.
    private static readonly CaseStatusFilter[] StatusFilters =
    [
        CaseStatusFilter.Open,
        CaseStatusFilter.All,
        CaseStatusFilter.Active,
        CaseStatusFilter.WaitingOnAuthority,
        CaseStatusFilter.Closed,
    ];

    // The switch's order (Otevřené, Aktivní, Čeká na úřad, Uzavřené, Vše), not the enum's.
    private static readonly CaseStatusFilter[] StatusSwitch =
    [
        CaseStatusFilter.Open,
        CaseStatusFilter.Active,
        CaseStatusFilter.WaitingOnAuthority,
        CaseStatusFilter.Closed,
        CaseStatusFilter.All,
    ];

    [Parameter, EditorRequired]
    public required IReadOnlyList<CaseColumn> Columns { get; set; }

    [Parameter, EditorRequired]
    public required CaseListRequest Filter { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = FilteredEmptyText;

    [Parameter]
    public RenderFragment? EmptyAction { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public bool ShowDates { get; set; }

    [Parameter]
    public bool ShowLabelFilter { get; set; }

    [Parameter]
    public bool ShowStatusFilter { get; set; }

    [Parameter]
    public bool ShowStatusSwitch { get; set; }

    [Parameter]
    public bool ShowScopeFilter { get; set; }

    [Parameter]
    public bool ShowPaging { get; set; }

    /// <summary>
    /// Hides the toolbar while the list is empty and no filter is set, so an empty card shows no filters.
    /// </summary>
    [Parameter]
    public bool HideToolbarWhenEmpty { get; set; }

    [Parameter]
    public EventCallback<int> TotalChanged { get; set; }

    /// <summary>
    /// Prefixes the ids of the toolbar's inputs, so two lists on one page never share one.
    /// </summary>
    [Parameter]
    public string InputPrefix { get; set; } = "cases";

    private IReadOnlyList<CaseListItem> items = [];

    private CaseSortKey sort;

    private CaseStatusFilter status;

    private CaseListScope scope;

    private CaseListRequest? seeded;

    protected override int PageSize => this.Filter.Take;

    protected override string FailureText => "Seznam spisů se nepodařilo načíst. Zkuste to za chvíli znovu.";

    private bool HasFilters => this.ShowSearch || this.ShowDates || this.ShowLabelFilter || this.ShowStatusFilter || this.ShowStatusSwitch || this.ShowScopeFilter;

    private bool ToolbarShown => this.HasFilters && !(this.HideToolbarWhenEmpty && this.IsEmptyUnfiltered);

    private bool IsEmptyUnfiltered => !this.Loading && this.Failure is null && this.Total == 0 && !this.IsFiltered;

    private bool IsFiltered => this.Search is not null || this.status != this.Filter.Status || this.scope != this.Filter.Scope
        || this.ActiveFilterCount > 0;

    protected override void OnInitialized()
    {
        this.sort = this.Filter.Sort;
        this.Direction = this.Filter.SortDirection;
    }

    // A host filter with another status or scope, e.g. a new address, resets the toolbar to it.
    protected override Task OnParametersSetAsync()
    {
        if (this.seeded?.Status != this.Filter.Status)
            this.status = this.Filter.Status;

        if (this.seeded?.Scope != this.Filter.Scope)
            this.scope = this.Filter.Scope;

        this.seeded = this.Filter;

        return this.ReloadOnFilterChange(this.Filter, this.Filter.Search);
    }

    protected override async Task<int> LoadPage(CancellationToken token)
    {
        var request = this.Filter with
        {
            Search = this.Search,
            From = this.From,
            To = this.To,
            LabelIds = this.LabelIds,
            Status = this.status,
            Scope = this.scope,
            Sort = this.sort,
            SortDirection = this.Direction,
            Skip = this.Skip,
        };

        var response = await this.CasesClient.ListCases(request, token);

        this.items = response.Items;

        await this.TotalChanged.InvokeAsync(response.TotalCount);

        return response.TotalCount;
    }

    private Task OnStatusSelected(ChangeEventArgs args)
    {
        this.status = Enum.Parse<CaseStatusFilter>(args.Value as string ?? "");

        return this.ReloadFirstPage();
    }

    private Task SetStatus(CaseStatusFilter value)
    {
        this.status = value;

        return this.ReloadFirstPage();
    }

    private Task OnScopeChanged(ChangeEventArgs args)
    {
        this.scope = (bool)(args.Value ?? false) ? CaseListScope.RootOnly : CaseListScope.All;

        return this.ReloadFirstPage();
    }

    private Task OnSortChanged(string key)
    {
        return this.SortBy(Enum.Parse<CaseSortKey>(key));
    }

    private Task SortBy(CaseSortKey key)
    {
        if (key == this.sort)
        {
            this.TurnDirection();
        }
        else
        {
            this.sort = key;
            this.Direction = NaturalDirection(key);
        }

        return this.ReloadFirstPage();
    }

    private static string RowHref(CaseListItem item)
    {
        return $"/cases/{item.CaseId}";
    }

    private static ListSortDirection NaturalDirection(CaseSortKey key)
    {
        return key is CaseSortKey.Date or CaseSortKey.Changed ? ListSortDirection.Descending : ListSortDirection.Ascending;
    }
}
