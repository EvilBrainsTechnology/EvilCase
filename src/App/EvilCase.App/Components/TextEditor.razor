@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ITextEditors Editors
@inject ILogger<TextEditor> Logger

@* The source editor of a text file, or its read-only view with the zoom and the search of a preview; Notes stand on the
   toolbar before the search. *@
<div class="ec-preview-view">
    @if (this.ReadOnly)
    {
        <PreviewToolbar @ref="this.toolbar" Ready="this.ready" Formats="this.Formats" Formatted="this.formatted" CanFormat="this.canFormat"
                        OnFormat="this.ToggleFormat" Modes="this.Modes" Notes="this.Notes" OnZoom="this.Zoom" OnSearch="this.Search" />
    }
    else
    {
        <div class="ec-preview-toolbar ec-text-editor-toolbar" role="toolbar" aria-label="Úpravy" inert="@this.Locked">
            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ArrowBackUp" AriaLabel="Zpět"
                      Disabled="@(!this.canUndo)" OnClick="this.Undo" />
            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ArrowForwardUp" AriaLabel="Znovu"
                      Disabled="@(!this.canRedo)" OnClick="this.Redo" />
            @if (this.Modes is not null)
            {
                <span class="ec-preview-toolbar-separator" aria-hidden="true"></span>
                @this.Modes
            }
            @if (this.Changes is { } changes)
            {
                <span class="ec-preview-toolbar-separator" aria-hidden="true"></span>
                <div class="ec-editor-changes" role="group" aria-label="Změny">
                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.PlusMinus" aria-pressed="@(changes.Shown ? "true" : "false")"
                              AriaLabel="Změny" OnClick="() => changes.OnShow.InvokeAsync(!changes.Shown)"><span class="ec-preview-toolbar-label">Změny</span></EcButton>
                    @if (changes.Shown)
                    {
                        @changes.Version("proti")
                        <CompareChanges View="@(this.shownOriginal is null ? null : this.compared)" IconsOnly OnStep="this.StepChange" />
                    }
                </div>
            }
            @if (this.Notes is not null)
            {
                <div class="ec-toolbar-notes">@this.Notes</div>
            }
            <ToolbarSearch @ref="this.search" Label="Hledat v textu" OnSearch="this.SearchEdit" OnEscape="this.FocusText" />
        </div>
        @if (this.Changes is { Shown: true, Status: { } status })
        {
            @status
        }
    }
    <div class="ec-preview-stage ec-text-editor-stage" inert="@this.Locked">
        <div @ref="this.host" class="ec-text-editor"></div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource cancel = new();

    private ElementReference host;

    private DotNetObjectReference<TextEditor>? self;

    private PreviewToolbar? toolbar;

    private ToolbarSearch? search;

    private bool ready;

    // Whether the view shows the formatted text, and whether its text formatted.
    private bool formatted;

    private bool canFormat;

    private bool opened;

    private bool canUndo;

    private bool canRedo;

    private bool dirty;

    // The editor has opened and takes the changes to show.
    private bool editorOpen;

    private bool showingChanges;

    // The text the editor shows its changes against; null while it shows none.
    private string? shownOriginal;

    private CompareView compared = new(Formatted: false, Formattable: false, Added: 0, Removed: 0, Changes: 0);

    /// <summary>
    /// The text as read, without its byte order mark.
    /// </summary>
    [Parameter, EditorRequired]
    public required string Text { get; set; }

    /// <summary>
    /// The language the text is highlighted in; null for plain text.
    /// </summary>
    [Parameter]
    public CodeLanguage? Language { get; set; }

    [Parameter, EditorRequired]
    public required string FileName { get; set; }

    [Parameter]
    public RenderFragment? Notes { get; set; }

    /// <summary>
    /// The Změny on the editor's toolbar; null leaves them out. The read-only view has none.
    /// </summary>
    [Parameter]
    public EditorChanges? Changes { get; set; }

    /// <summary>
    /// Shows the text without taking input, with the zoom and the search of a preview and no Zpět, Znovu or Ctrl+S. Fixed
    /// for the editor's life.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// The view switch on the toolbar: after Zpět and Znovu, or after the zoom in the read-only view.
    /// </summary>
    [Parameter]
    public RenderFragment? Modes { get; set; }

    /// <summary>
    /// Whether the read-only view formats the text in its Language, opens formatted when it formats and offers the switch
    /// to the original on its toolbar.
    /// </summary>
    [Parameter]
    public bool Formats { get; set; }

    /// <summary>
    /// The text is only the start of the file: it is not formatted and the switch stays disabled.
    /// </summary>
    [Parameter]
    public bool Partial { get; set; }

    /// <summary>
    /// Raised with how the text formatted once a read-only view that <see cref="Formats"/> shows.
    /// </summary>
    [Parameter]
    public EventCallback<CodeView> OnFormatted { get; set; }

    /// <summary>
    /// Takes no input while set, so nothing is typed into a text being saved.
    /// </summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary>
    /// Raised with whether the text differs from the one given.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnDirtyChanged { get; set; }

    /// <summary>
    /// Raised on Ctrl+S or Cmd+S.
    /// </summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>
    /// Raised when the editor's script did not start.
    /// </summary>
    [Parameter]
    public EventCallback OnUnavailable { get; set; }

    // The text the editor is to show its changes against; null for none.
    private string? ChangesOriginal => this.Changes is { Shown: true, Original: var original } ? original : null;

    /// <summary>
    /// Whether the read-only view shows its text formatted.
    /// </summary>
    public bool ShowsFormatted => this.formatted;

    /// <summary>
    /// The edited text, its lines joined with "\n".
    /// </summary>
    public async Task<string> ReadText()
    {
        return await this.Editors.ReadEditorText(this.host);
    }

    [JSInvokable]
    public async Task NotifyChanged(bool dirty, bool canUndo, bool canRedo)
    {
        this.canUndo = canUndo;
        this.canRedo = canRedo;

        if (dirty != this.dirty)
        {
            this.dirty = dirty;

            await this.OnDirtyChanged.InvokeAsync(dirty);
        }

        this.StateHasChanged();
    }

    [JSInvokable]
    public void NotifyMatches(int current, int total)
    {
        this.search?.MatchesChanged(current, total, pending: false);
    }

    /// <summary>
    /// Ctrl+F or Cmd+F in the text.
    /// </summary>
    [JSInvokable]
    public async Task NotifyFind()
    {
        if (this.search is not null)
            await this.search.Focus();
    }

    [JSInvokable]
    public void NotifyCompared(int added, int removed, int changes)
    {
        this.compared = new CompareView(Formatted: false, Formattable: false, Added: added, Removed: removed, Changes: changes);
        this.StateHasChanged();
    }

    [JSInvokable]
    public async Task NotifySave()
    {
        await this.OnSave.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await this.cancel.CancelAsync();

        if (this.opened)
        {
            try
            {
                await this.Editors.CloseEditor(this.host);
            }
            catch (JSException exception)
            {
                this.Logger.LogInformation(exception, "The text editor was already gone");
            }
        }

        this.self?.Dispose();
        this.cancel.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await this.ShowChanges();

            return;
        }

        var label = $"Obsah souboru {this.FileName}";

        // Set first: a close while the view formats stops the formatting.
        this.opened = true;

        try
        {
            if (this.ReadOnly)
            {
                var shown = await this.Editors.OpenViewer(this.host, this.Text, this.Language, this.Formats && !this.Partial, label, this.toolbar!.View);

                if (!this.cancel.IsCancellationRequested)
                {
                    (this.formatted, this.canFormat, this.ready) = (shown.Formatted, shown.Formatted, true);

                    if (this.Formats)
                        await this.OnFormatted.InvokeAsync(shown);

                    this.StateHasChanged();
                }
            }
            else
            {
                this.self = DotNetObjectReference.Create(this);

                // Tab types a tab into text. Into code it types the indentation of the first indented line, at most eight
                // spaces; without one two spaces in YAML, which takes no tabs, and a tab elsewhere.
                var indentUnit = this.Language is CodeLanguage.Yaml ? "  " : "\t";

                if (this.Language is not null)
                {
                    foreach (var line in this.Text.AsSpan().EnumerateLines())
                    {
                        if (line.IndexOfAnyExcept(' ', '\t') > 0)
                        {
                            indentUnit = line[0] == '\t' ? "\t" : new string(' ', Math.Min(line.IndexOfAnyExcept(' '), 8));

                            break;
                        }
                    }
                }

                await this.Editors.OpenEditor(this.host, this.Text, this.Language, indentUnit, label, this.self);

                if (!this.cancel.IsCancellationRequested)
                {
                    this.editorOpen = true;
                    await this.ShowChanges();
                }
            }

            // Closed while it opened.
            if (this.cancel.IsCancellationRequested)
                await this.Editors.CloseEditor(this.host);
        }
        catch (JSException exception)
        {
            this.Logger.LogWarning(exception, "The text editor did not start");

            if (!this.cancel.IsCancellationRequested)
                await this.OnUnavailable.InvokeAsync();
        }
    }

    // Brings the changes the editor shows in line with Changes, one call at a time.
    private async Task ShowChanges()
    {
        if (!this.editorOpen || this.showingChanges)
            return;

        this.showingChanges = true;

        try
        {
            while (!this.cancel.IsCancellationRequested && !string.Equals(this.ChangesOriginal, this.shownOriginal, StringComparison.Ordinal))
            {
                var original = this.ChangesOriginal;

                this.compared = await this.Editors.ShowEditorChanges(this.host, original);
                this.shownOriginal = original;
                this.StateHasChanged();
            }
        }
        catch (JSException exception)
        {
            this.Logger.LogWarning(exception, "Showing the changes in the text editor failed");

            // The text stays editable without its changes; the next render does not try again.
            this.shownOriginal = this.ChangesOriginal;
        }
        finally
        {
            this.showingChanges = false;
        }
    }

    private async Task StepChange(bool previous)
    {
        await this.Editors.StepEditorChange(this.host, previous);
    }

    private async Task ToggleFormat()
    {
        this.formatted = !this.formatted;

        await this.Editors.ShowFormatted(this.host, this.formatted);
    }

    private async Task Zoom(PreviewZoom zoom)
    {
        await this.Editors.ZoomViewer(this.host, zoom);
    }

    private async Task Search(PreviewSearch search)
    {
        await this.Editors.FindInViewer(this.host, search.Query, search.Find);
    }

    private async Task SearchEdit(PreviewSearch search)
    {
        await this.Editors.FindInEditor(this.host, search.Query, search.Find);
    }

    private async Task FocusText()
    {
        await this.Editors.FocusEditor(this.host);
    }

    private async Task Undo()
    {
        await this.Editors.UndoEdit(this.host);
    }

    private async Task Redo()
    {
        await this.Editors.RedoEdit(this.host);
    }
}
