@inject IAuthSession Session
@inject NavigationManager Navigation

<AuthorizeView Context="authenticationState">
    <div class="ec-usermenu">
        <button type="button" class="ec-avatar" aria-haspopup="menu" aria-expanded="@(this.open ? "true" : "false")"
                aria-label="@($"Uživatelské menu – {authenticationState.User.Identity?.Name}")"
                @onclick="this.Toggle">
            @AuthorInitialsDisplay.Text(authenticationState.User.Identity?.Name ?? "")
        </button>

        @if (this.open)
        {
            @* Closes the menu on a click anywhere else; no Bootstrap JavaScript runs. *@
            <div class="ec-menu-backdrop" @onclick="this.Close"></div>

            <div class="ec-menu" role="menu">
                <span class="ec-menu-user">@authenticationState.User.Identity?.Name</span>
                <ThemeSwitch />
                <button type="button" class="ec-menu-item" role="menuitem" @onclick="() => this.SignOut(everywhere: false)">
                    <EcIcon Paths="@AppIcons.Logout" />Odhlásit se
                </button>
                <button type="button" class="ec-menu-item" role="menuitem" @onclick="() => this.SignOut(everywhere: true)">
                    <EcIcon Paths="@AppIcons.Logout" />Odhlásit všechna zařízení
                </button>
            </div>
        }
    </div>
</AuthorizeView>

@code {
    private bool open;

    private void Toggle()
    {
        this.open = !this.open;
    }

    private void Close()
    {
        this.open = false;
    }

    private async Task SignOut(bool everywhere)
    {
        this.open = false;

        await this.Session.SignOut(everywhere, CancellationToken.None);

        // The layout bounces to the sign-in page on the state change anyway; going there explicitly
        // keeps the page they were on out of the returnUrl.
        this.Navigation.NavigateTo("login", replace: true);
    }
}
