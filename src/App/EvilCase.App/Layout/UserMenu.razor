@inject IAuthSession Session
@inject NavigationManager Navigation

<AuthorizeView Context="authenticationState">
    <EcMenu AriaLabel="@($"Uživatelské menu – {authenticationState.User.Identity?.Name}")"
            Title="@authenticationState.User.Identity?.Name" Items="this.Items">
        <Trigger>
            <span class="ec-avatar">@AuthorInitialsDisplay.Text(authenticationState.User.Identity?.Name ?? "")</span>
        </Trigger>
    </EcMenu>
</AuthorizeView>

@code {
    private EcMenuItem[] Items =>
    [
        new EcMenuItem { Text = "Odhlásit se", Icon = AppIcons.Logout, OnSelect = EventCallback.Factory.Create(this, () => this.SignOut(everywhere: false)) },
        new EcMenuItem { Text = "Odhlásit všechna zařízení", Icon = AppIcons.Logout, OnSelect = EventCallback.Factory.Create(this, () => this.SignOut(everywhere: true)) },
    ];

    private async Task SignOut(bool everywhere)
    {
        await this.Session.SignOut(everywhere, CancellationToken.None);

        // The layout bounces to the sign-in page on the state change anyway; going there explicitly
        // keeps the page they were on out of the returnUrl.
        this.Navigation.NavigateTo("login", replace: true);
    }
}
