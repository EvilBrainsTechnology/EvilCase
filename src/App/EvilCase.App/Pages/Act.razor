@page "/acts/{ActId:guid}"
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Files
@using EvilBrains.EvilCase.Api.Contract.Labels
@inherits DetailPage<ActDetail>
@inject IActsClient ActsClient
@inject IActLabelsClient ActLabelsClient
@inject IActCommentsClient ActCommentsClient
@inject IActFilesClient ActFilesClient

<PageTitle>@(this.Detail is null ? "Úkon" : this.Detail.ActNumber) – EvilCase</PageTitle>

<div class="ec-page">
    <span class="ec-visually-hidden" role="status">@this.Announcement</span>

    @if (this.Detail is null)
    {
        <DetailStatus NotFound="this.NotFound" NotFoundText="Úkon nenalezen." BackHref="/acts" BackText="Zpět na úkony" Failure="@this.Failure" Retry="this.Load" />
    }
    else
    {
        <EcCard>
            <div class="ec-detail">
                <EcPageHeader Title="@this.Detail.Title" Breadcrumbs="this.Crumbs">
                    <CrumbsEnd>
                        <nav class="ec-act-pager" aria-label="Úkony spisu">
                            @if (this.Previous is { } previous)
                            {
                                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ChevronLeft"
                                          Href="@ActRoutes.Detail(previous.ActId)" AriaLabel="@($"Předchozí úkon: {previous.Title}")" />
                            }
                            else
                            {
                                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ChevronLeft"
                                          AriaLabel="Předchozí úkon" Disabled />
                            }
                            <span class="ec-act-pager-text">Úkon <span class="ec-act-pager-position">@this.Detail.ActPosition</span> z @this.Detail.CaseActCount</span>
                            @if (this.Next is { } next)
                            {
                                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ChevronRight"
                                          Href="@ActRoutes.Detail(next.ActId)" AriaLabel="@($"Další úkon: {next.Title}")" />
                            }
                            else
                            {
                                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.ChevronRight"
                                          AriaLabel="Další úkon" Disabled />
                            }
                        </nav>
                    </CrumbsEnd>
                    <Status>
                        @if (this.Detail.Direction is { } direction)
                        {
                            <EcBadge Text="@ActDirectionDisplay.Text(direction)" Tone="ActDirectionDisplay.Tone(direction)" Icon="@ActDirectionDisplay.Icon(direction)" />
                        }
                    </Status>
                    <Actions>
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" OnClick="this.EditAct">Upravit úkon</EcButton>
                        <EcMenu AriaLabel="Další akce s úkonem" Items="this.ActActions" />
                    </Actions>
                </EcPageHeader>

                @if (!string.IsNullOrWhiteSpace(this.Detail.Description))
                {
                    <p class="ec-detail-text">@this.Detail.Description</p>
                }

                <div class="ec-detail-facts">
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Datum úkonu</span>
                        <span class="ec-detail-fact-value">@DateDisplay.Text(this.Detail.Date)</span>
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-copyable">
                        <span class="ec-detail-fact-name">Číslo jednací</span>
                        <span class="ec-detail-fact-copy">
                            <span class="ec-detail-fact-mono">@this.Detail.ActNumber</span>
                            <CopyButton Value="@this.Detail.ActNumber" AriaLabel="Zkopírovat číslo jednací" />
                        </span>
                    </div>
                    @if (string.IsNullOrWhiteSpace(this.Detail.ExternalActNumber))
                    {
                        <div class="ec-detail-fact">
                            <span class="ec-detail-fact-name">Externí číslo jednací</span>
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        </div>
                    }
                    else
                    {
                        <div class="ec-detail-fact ec-detail-fact-copyable">
                            <span class="ec-detail-fact-name">Externí číslo jednací</span>
                            <span class="ec-detail-fact-copy">
                                <span class="ec-detail-fact-mono">@this.Detail.ExternalActNumber</span>
                                <CopyButton Value="@this.Detail.ExternalActNumber" AriaLabel="Zkopírovat externí číslo jednací" />
                            </span>
                        </div>
                    }
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-head">
                            <span class="ec-detail-fact-name">@ActDirectionDisplay.ContactLabel(this.Detail.Direction)</span>
                            @if (ActContactRules.DifferingCaseContact(this.Detail.Contact, this.Detail.CaseContact) is { } differing)
                            {
                                <span class="ec-detail-fact-warning" aria-hidden="true" title="Spis vede protistranu @differing.Name"><EcIcon Paths="@AppIcons.AlertTriangle" Size="EcIconSize.Small" />Jiný než ve spisu</span>
                                <span class="ec-visually-hidden">Spis vede protistranu @differing.Name</span>
                            }
                        </span>
                        @if (this.Detail.Contact is { } contact)
                        {
                            <a class="ec-detail-fact-link" href="@($"/contacts/{contact.ContactId}")">@contact.Name</a>
                        }
                        else
                        {
                            <span class="ec-detail-fact-value ec-cell-empty">—</span>
                        }
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-labels">
                        <span class="ec-detail-fact-name">Štítky<kbd class="ec-kbd" aria-hidden="true">L</kbd></span>
                        <LabelField Inline InputId="act-labels" Selected="this.Detail.Labels" SelectedChanged="this.SaveLabels" />
                        @if (this.LabelsError is not null)
                        {
                            <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.LabelsError</div>
                        }
                    </div>
                </div>
            </div>
        </EcCard>

        <div class="ec-detail-layout">
            <div class="ec-detail-main">
                <FilesCard @key="(nameof(FilesCard), this.ActId)"
                           Title="Soubory úkonu"
                           OwnerGoneError="úkon už neexistuje."
                           LoadFiles="this.LoadFiles"
                           UploadFile="this.UploadFile"
                           LoadContent="this.LoadFileContent"
                           RenameFile="this.RenameFile"
                           DeleteFile="this.DeleteFile"
                           UploadTarget="k úkonu" />

                <CommentsCard @key="(nameof(CommentsCard), this.ActId)"
                              Title="Komentáře úkonu"
                              Placeholder="Poznámka k tomuto úkonu…"
                              LoadComments="this.LoadComments"
                              AddComment="this.AddComment"
                              SaveComment="this.SaveComment"
                              DeleteComment="this.DeleteComment" />
            </div>

            <aside class="ec-detail-aside">
                <EcCard Title="Spis">
                    <a class="ec-case-link" href="@($"/cases/{this.Detail.CaseId}")">
                        <span class="ec-case-link-title">@this.Detail.CaseTitle</span>
                        <span class="ec-case-link-number">@this.Detail.CaseNumber</span>
                    </a>
                    <p class="ec-case-meta">
                        <span class="@($"ec-status-dot {CaseStatusDisplay.Dot(this.Detail.CaseStatus)}")" aria-hidden="true"></span>
                        @CaseStatusDisplay.Text(this.Detail.CaseStatus) <span class="ec-sep" aria-hidden="true">·</span> @ActCountDisplay.Text(this.Detail.CaseActCount)
                    </p>
                    <div class="ec-case-contact">
                        <span class="ec-case-contact-label">Protistrana spisu</span>
                        @if (this.Detail.CaseContact is { } caseContact)
                        {
                            <a href="@($"/contacts/{caseContact.ContactId}")">@caseContact.Name</a>
                        }
                        else
                        {
                            <span class="ec-cell-empty">—</span>
                        }
                    </div>
                </EcCard>

                <EcCard Title="Průběh spisu">
                    <ChildContent>
                        <ol class="ec-timeline">
                            @foreach (var item in this.Detail.CaseTimeline)
                            {
                                var dot = item.IsCurrent
                                    ? "ec-timeline-dot ec-timeline-dot-current"
                                    : item.Direction is { } dotDirection ? $"ec-timeline-dot ec-timeline-dot-{ActDirectionDisplay.Css(dotDirection)}" : "ec-timeline-dot";

                                <li class="ec-timeline-entry">
                                    <a class="@(item.IsCurrent ? "ec-timeline-item ec-timeline-item-current" : "ec-timeline-item")"
                                       href="@ActRoutes.Detail(item.ActId)" aria-current="@(item.IsCurrent ? "page" : null)">
                                        <span class="ec-timeline-rail" aria-hidden="true">
                                            <span class="@dot"></span>
                                            <span class="ec-timeline-line"></span>
                                        </span>
                                        <span class="ec-timeline-main">
                                            <span class="ec-timeline-meta">
                                                @DateDisplay.Text(item.Date)
                                                @if (item.Direction is { } itemDirection)
                                                {
                                                    <span class="ec-sep" aria-hidden="true">·</span>
                                                    <span class="@($"ec-timeline-direction ec-timeline-direction-{ActDirectionDisplay.Css(itemDirection)}")"><EcIcon Paths="@ActDirectionDisplay.Icon(itemDirection)" Size="EcIconSize.Small" />@ActDirectionDisplay.Text(itemDirection)</span>
                                                }
                                            </span>
                                            <span class="ec-timeline-title">@item.Title</span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ol>
                    </ChildContent>
                    <Footer>
                        <a class="ec-timeline-all" href="@($"/cases/{this.Detail.CaseId}")">@ActCountDisplay.AllText(this.Detail.CaseActCount)<EcIcon Paths="@AppIcons.ChevronRight" Size="EcIconSize.Small" /></a>
                    </Footer>
                </EcCard>
            </aside>
        </div>
    }
</div>

@if (this.deleting && this.Detail is not null)
{
    <ActDeleteModal Act="this.Detail" Open OpenChanged="this.CloseDelete" OnDeleted="this.ActDeleted" />
}

@code {
    [Parameter]
    public Guid ActId { get; set; }

    private bool deleting;

    protected override string LoadFailedText => "Úkon se nepodařilo načíst. Zkuste to za chvíli znovu.";

    protected override string GoneText => "Úkon už neexistuje.";

    protected override string LinkCopiedText => "Odkaz na úkon zkopírován.";

    protected override string LinkPath => ActRoutes.Detail(this.ActId);

    private IReadOnlyList<EcCrumb> Crumbs => this.Detail is null
        ? [new EcCrumb("Spisy", "/cases")]
        : [
            new EcCrumb("Spisy", "/cases"),
            new EcCrumb(this.Detail.CaseTitle, $"/cases/{this.Detail.CaseId}"),
            new EcCrumb(this.Detail.Title, null),
        ];

    private IReadOnlyList<EcMenuItem> ActActions
    {
        get
        {
            return
            [
                new EcMenuItem { Text = "Nový úkon ve spisu", Icon = AppIcons.Plus, OnSelect = EventCallback.Factory.Create(this, this.OpenNewAct) },
                new EcMenuItem { Text = "Zkopírovat odkaz na úkon", Icon = AppIcons.Link, OnSelect = EventCallback.Factory.Create(this, this.CopyLink) },
                new EcMenuItem { Text = "Smazat úkon…", Icon = AppIcons.Trash, OnSelect = EventCallback.Factory.Create(this, this.StartDeleting), Danger = true, DividerBefore = true },
            ];
        }
    }

    private ActTimelineItem? Previous => this.Neighbour(-1);

    private ActTimelineItem? Next => this.Neighbour(1);

    protected override Task<ActDetail> Fetch()
    {
        return this.ActsClient.GetAct(this.ActId, CancellationToken.None);
    }

    protected override Task StoreLabels(ActDetail detail, LabelAssignmentRequest request)
    {
        return this.ActLabelsClient.SetActLabels(detail.ActId, request, CancellationToken.None);
    }

    protected override ActDetail WithLabels(ActDetail detail, IReadOnlyList<LabelItem> labels)
    {
        return detail with { Labels = labels };
    }

    private void EditAct()
    {
        this.Navigation.NavigateTo(ActRoutes.Edit(this.ActId));
    }

    private void OpenNewAct()
    {
        this.Navigation.NavigateTo(ActRoutes.New(this.Detail?.CaseId));
    }

    private ActTimelineItem? Neighbour(int step)
    {
        IReadOnlyList<ActTimelineItem> timeline = this.Detail?.CaseTimeline ?? [];

        var current = timeline
            .TakeWhile(static item => !item.IsCurrent)
            .Count();
        var neighbour = current + step;

        return current < timeline.Count && neighbour >= 0 && neighbour < timeline.Count ? timeline[neighbour] : null;
    }

    private void StartDeleting()
    {
        this.deleting = true;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = false;
    }

    private void ActDeleted()
    {
        this.deleting = false;

        this.Navigation.NavigateTo(this.Detail is { } deleted ? $"/cases/{deleted.CaseId}" : "/cases");
    }

    private async Task<IReadOnlyList<FileListItem>> LoadFiles(CancellationToken token)
    {
        return (await this.ActFilesClient.ListActFiles(this.ActId, token)).Items;
    }

    private Task UploadFile(IBrowserFile file, CancellationToken token)
    {
        return this.FileTransfer.UploadActFile(this.ActId, file, token);
    }

    private Task RenameFile(FileListItem file, string fileName, CancellationToken token)
    {
        return this.ActFilesClient.RenameActFile(this.ActId, file.FileId, new FileRenameRequest { FileName = fileName }, token);
    }

    private Task DeleteFile(FileListItem file, CancellationToken token)
    {
        return this.ActFilesClient.DeleteActFile(this.ActId, file.FileId, token);
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.ActCommentsClient.ListActComments(this.ActId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.AddActComment(this.ActId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.EditActComment(this.ActId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.ActCommentsClient.DeleteActComment(this.ActId, commentId, token);
    }
}
