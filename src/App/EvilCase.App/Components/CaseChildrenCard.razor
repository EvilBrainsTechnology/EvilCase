@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@inject ICasesClient CasesClient
@inject ILogger<CaseChildrenCard> Logger

<EcCard Title="Podřízené spisy">
    <Header>
        @if (this.children is not null)
        {
            <span class="ec-card-count">@this.children.Count</span>
        }
        <div class="ec-card-header-actions">
            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Plus"
                      AriaLabel="Založit podřízený spis" Href="@($"/cases/new?parent={this.ParentCaseId}")" />
        </div>
    </Header>
    <ChildContent>
        @if (this.failure is not null)
        {
            <div class="ec-card-error">
                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.failure</div>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                          OnClick="this.LoadChildren">Zkusit znovu</EcButton>
            </div>
        }
        else if (this.children is null)
        {
            <p class="ec-card-state">Načítám…</p>
        }
        else if (this.children.Count == 0)
        {
            <EcEmptyState Icon="@AppIcons.Folders" Text="Zatím tu není žádný podřízený spis." />
        }
        else
        {
            <div class="ec-child-list">
                @foreach (var item in this.children)
                {
                    <a class="ec-child-row" href="@($"/cases/{item.CaseId}")">
                        <span class="ec-child-date">@DateDisplay.Text(item.Date)</span>
                        <span class="ec-child-main">
                            <span class="ec-child-title">@item.Title</span>
                            <span class="ec-child-status">
                                <span class="@($"ec-status-dot {CaseStatusDisplay.Dot(item.Status)}")" aria-hidden="true"></span>@CaseStatusDisplay.Text(item.Status)
                            </span>
                        </span>
                    </a>
                }
            </div>
        }
    </ChildContent>
</EcCard>

@code {
    /// <summary>
    /// The sidebar summary lists every child of one case; the tenant holds no case with more.
    /// </summary>
    private const int ChildLimit = 100;

    [Parameter, EditorRequired]
    public required Guid ParentCaseId { get; set; }

    private IReadOnlyList<CaseListItem>? children;

    private string? failure;

    private Guid loaded;

    protected override Task OnParametersSetAsync()
    {
        if (this.loaded == this.ParentCaseId)
            return Task.CompletedTask;

        this.loaded = this.ParentCaseId;

        return this.LoadChildren();
    }

    private async Task LoadChildren()
    {
        this.children = null;
        this.failure = null;

        var request = new CaseListRequest
        {
            ParentCaseId = this.ParentCaseId,
            Status = CaseStatusFilter.All,
            Take = ChildLimit,
        };

        try
        {
            var response = await this.CasesClient.ListCases(request, CancellationToken.None);

            this.children = response.Items;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the child cases failed");

            this.failure = "Podřízené spisy se nepodařilo načíst.";
        }
    }
}
