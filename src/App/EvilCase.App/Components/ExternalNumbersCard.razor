@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Numbers
@using TabBlazor.Services
@inject IModalService ModalService
@inject ILogger<ExternalNumbersCard> Logger

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@this.Text.Heading</h3>
    </div>

    @if (this.Items.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">@this.Text.EmptyTitle</p>
        </div>
    }
    else
    {
        @* Table on desktop, cards on mobile: two renderings switched by CSS only. *@
        <div class="d-none d-lg-block">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th>@this.Text.ValueColumn</th>
                        <th>Přidělil</th>
                        @if (this.Editable)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in this.Items)
                    {
                        <tr>
                            <td>@item.Value</td>
                            <td><a href="/contacts/@item.AssignedByContactId">@item.AssignedByContactName</a></td>
                            @if (this.Editable)
                            {
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => this.ConfirmDelete(item)">Smazat</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-body d-lg-none">
            @foreach (var item in this.Items)
            {
                <div class="mb-3 border-bottom pb-2">
                    <div class="fw-bold">@item.Value</div>
                    <div><a href="/contacts/@item.AssignedByContactId">@item.AssignedByContactName</a></div>
                    @if (this.Editable)
                    {
                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => this.ConfirmDelete(item)">Smazat</button>
                    }
                </div>
            }
        </div>
    }

    @if (this.Editable)
    {
        <div class="card-body border-top">
            <EditForm Model="this.model" OnValidSubmit="this.SubmitNumber">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="external-number-value">@this.Text.ValueColumn</label>
                    <InputText id="external-number-value" class="form-control" @bind-Value="this.model.Value" />
                    <ValidationMessage For="() => this.model.Value" class="invalid-feedback d-block" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="external-number-contact">Přidělil</label>
                    <ContactPicker InputId="external-number-contact" @bind-Selected="this.model.AssignedBy" />
                    <ValidationMessage For="() => this.model.AssignedBy" class="invalid-feedback d-block" />
                </div>

                @if (this.error is not null)
                {
                    <div class="alert alert-danger" role="alert">@this.error</div>
                }

                <button id="external-number-add" type="submit" class="btn btn-primary" disabled="@this.busy">
                    @if (this.busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Přidat
                </button>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required ExternalNumberText Text { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<ExternalNumberItem> Items { get; set; }

    /// <summary>
    /// Adds and removals show only where the owner is being edited (SDD-009, SDD-010); the two
    /// callbacks come with them.
    /// </summary>
    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public Func<ExternalNumberRequest, CancellationToken, Task>? AddNumber { get; set; }

    [Parameter]
    public Func<Guid, CancellationToken, Task>? DeleteNumber { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ExternalNumberModel model = new();

    private string? error;

    private bool busy;

    private async Task SubmitNumber()
    {
        if (this.AddNumber is not { } add)
            return;

        this.busy = true;
        this.error = null;

        try
        {
            await add(
                new ExternalNumberRequest { Value = this.model.Value, AssignedByContactId = this.model.AssignedBy!.ContactId },
                CancellationToken.None);

            this.model = new();

            await this.OnChanged.InvokeAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            this.error = exception.ResponseBody?.Contains(ExternalNumberProblems.Taken, StringComparison.Ordinal) == true
                ? this.Text.AddTakenError
                : "Vybraný kontakt už neexistuje.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.error = this.Text.AddOwnerGoneError;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Adding the external number failed");

            this.error = this.Text.AddFailedError;
        }
        finally
        {
            this.busy = false;
        }
    }

    private async Task ConfirmDelete(ExternalNumberItem number)
    {
        if (this.DeleteNumber is not { } delete)
            return;

        await this.ModalService.ShowAsync(
            this.Text.DeleteTitle,
            new RenderComponent<ExternalNumberDeleteModal>()
                .Set(component => component.Text, this.Text)
                .Set(component => component.Number, number)
                .Set(component => component.DeleteNumber, (CancellationToken token) => delete(number.ExternalNumberId, token))
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, () => this.OnChanged.InvokeAsync())),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
