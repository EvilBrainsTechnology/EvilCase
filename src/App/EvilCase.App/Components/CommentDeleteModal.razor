@using System.Net
@using EvilBrains.ApiClient

<ConfirmDeleteModal Delete="this.DeleteComment" GoneError="Komentář už neexistuje." FailedError="Komentář se nepodařilo smazat. Zkuste to za chvíli znovu." MapError="MapCommentError" OnDeleted="this.OnDeleted">
    <p>Opravdu smazat komentář? Akci nelze vrátit zpět.</p>
    <blockquote class="comment-body text-secondary">@this.Body</blockquote>
</ConfirmDeleteModal>

@code {
    [Parameter, EditorRequired]
    public required string Body { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task> DeleteComment { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private static string? MapCommentError(ApiException exception) =>
        exception.StatusCode == HttpStatusCode.Forbidden ? "Komentář smí smazat jen jeho autor." : null;
}
