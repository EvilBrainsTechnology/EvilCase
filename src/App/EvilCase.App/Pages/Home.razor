@page "/"
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Lists
@using EvilBrains.EvilCase.Domain.Cases
@inject ICasesClient CasesClient
@inject ILogger<Home> Logger

<PageTitle>Přehled – EvilCase</PageTitle>

<div class="ec-page">
    <EcPageHeader Title="Přehled">
        <Actions>
            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" Href="/cases/new">Nový spis</EcButton>
        </Actions>
    </EcPageHeader>

    @if (this.view is { IsEmpty: true })
    {
        <EcCard>
            <EcEmptyState Icon="@AppIcons.Folders" Text="Zatím tu není žádný spis.">
                <Action>
                    <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" Href="/cases/new">Založit první spis</EcButton>
                </Action>
            </EcEmptyState>
        </EcCard>
    }
    else
    {
        @if (this.failure is not null)
        {
            <EcCard>
                <div class="ec-card-error">
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.failure</div>
                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                              OnClick="this.LoadCounts">Zkusit znovu</EcButton>
                </div>
            </EcCard>
        }
        else
        {
            <div class="ec-tiles" aria-busy="@(this.view is null ? "true" : "false")">
                <CaseCountTile Status="CaseStatus.Active" Count="this.view?.Counts.Active" />
                <CaseCountTile Status="CaseStatus.WaitingOnAuthority" Count="this.view?.Counts.WaitingOnAuthority" />
                <CaseCountTile Status="CaseStatus.Closed" Count="this.view?.Counts.Closed" />
            </div>
        }

        <CaseList Columns="CaseColumns" Filter="CaseTile" Title="Naposledy změněné spisy"
                  EmptyText="Zatím tu není žádný spis.">
            <Actions>
                <EcButton Variant="EcButtonVariant.Ghost" Size="EcButtonSize.Compact" IconEnd="@AppIcons.ChevronRight"
                          Href="/cases">Všechny spisy</EcButton>
            </Actions>
            <EmptyAction>
                <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" Href="/cases/new">Založit spis</EcButton>
            </EmptyAction>
        </CaseList>

        <ActList Columns="ActColumns" DateHeader="Datum úkonu" Filter="ActTile" Title="Naposledy změněné úkony"
                 EmptyText="Zatím tu není žádný úkon." />
    }
</div>

@code {
    private const int TileItems = 5;

    private static readonly CaseColumn[] CaseColumns =
    [
        CaseColumn.Changed,
        CaseColumn.Date,
        CaseColumn.Case,
        CaseColumn.Status,
        CaseColumn.Labels,
        CaseColumn.CaseNumber,
    ];

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Changed,
        ActColumn.Date,
        ActColumn.Case,
        ActColumn.Act,
        ActColumn.Direction,
        ActColumn.ActNumber,
    ];

    private static readonly CaseListRequest CaseTile = new()
    {
        Status = CaseStatusFilter.All,
        Sort = CaseSortKey.Changed,
        Take = TileItems,
    };

    private static readonly ActListRequest ActTile = new()
    {
        Sort = ActSortKey.Changed,
        SortDirection = ListSortDirection.Descending,
        Take = TileItems,
    };

    private DashboardView? view;

    private string? failure;

    protected override Task OnInitializedAsync()
    {
        return this.LoadCounts();
    }

    private async Task LoadCounts()
    {
        this.view = null;
        this.failure = null;

        try
        {
            this.view = new DashboardView { Counts = await this.CasesClient.CountCases(CancellationToken.None) };
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the dashboard counts failed");

            this.failure = "Počty spisů se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }
}
