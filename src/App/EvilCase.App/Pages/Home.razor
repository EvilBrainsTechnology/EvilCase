@page "/"

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">Přehled</h2>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        <div class="row row-deck row-cards">
            <div class="col-6 col-lg-3">
                <StatCard Value="128" Label="Aktivních spisů" Glyph="AppIcons.Folders" Color="TablerColor.Blue" />
            </div>
            <div class="col-6 col-lg-3">
                <StatCard Value="7" Label="Lhůt do 7 dnů" Glyph="AppIcons.Clock" Color="TablerColor.Yellow" />
            </div>
            <div class="col-6 col-lg-3">
                <StatCard Value="2" Label="Po termínu" Glyph="AppIcons.AlertTriangle" Color="TablerColor.Red" />
            </div>
            <div class="col-6 col-lg-3">
                <StatCard Value="34" Label="Dokumentů tento měsíc" Glyph="AppIcons.FileText" Color="TablerColor.Green" />
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Poslední spisy</h3>
            </div>

            @* Table on desktop, cards on mobile: two renderings switched by CSS only. *@
            <div class="d-none d-lg-block">
                @* QuickTable always takes its default sort from the first column, so that column drives the order. *@
                <QuickTable Items="Cases" Class="card-table table-vcenter">
                    <TemplateColumn Title="Aktualizováno" SortBy="@(GridSort<CaseSummary>.ByAscending(c => c.UpdatedOn))"
                                    IsDefaultSort="SortDirection.Descending" Context="caseSummary">
                        @caseSummary.UpdatedOnText
                    </TemplateColumn>
                    <PropertyColumn Property="@(c => c.Number)" Title="Značka" />
                    <PropertyColumn Property="@(c => c.Title)" Title="Předmět" />
                    <PropertyColumn Property="@(c => c.Client)" Title="Klient" />
                    <TemplateColumn Title="Stav" Context="caseSummary">
                        <Status BackgroundColor="caseSummary.StatusColor" Lite="true">@caseSummary.StatusText</Status>
                    </TemplateColumn>
                </QuickTable>
            </div>

            <div class="card-body d-lg-none">
                @foreach (var caseSummary in SampleData.RecentCases)
                {
                    <CaseCard Case="caseSummary" />
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Nadcházející lhůty</h3>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var deadline in SampleData.UpcomingDeadlines)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="min-w-0">
                                <div class="font-weight-medium text-truncate">@deadline.Title</div>
                                <div class="text-secondary text-truncate">@deadline.CaseNumber &middot; @deadline.DueOnText</div>
                            </div>
                            <Badge BackgroundColor="deadline.DaysLeftColor">@deadline.DaysLeftText</Badge>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@code {
    private static IQueryable<CaseSummary> Cases => SampleData.RecentCases.AsQueryable();
}
