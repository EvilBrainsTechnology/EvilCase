@inherits LayoutComponentBase

@* The application's default deny. Anything laid out by MainLayout is behind this, so a new page is
   protected without doing anything; escaping it means deliberately choosing another layout, the way
   the sign-in page does. *@
<AuthorizeView>
    <Authorized>
        <div class="ec-shell">
            <TopBar />

            <main class="ec-shell-body">
                @Body
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
    <Authorizing>
        <LoadingPage />
    </Authorizing>
</AuthorizeView>
