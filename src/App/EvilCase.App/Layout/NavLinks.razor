@implements IDisposable
@inject NavigationManager Navigation
@inject IOffcanvasService OffcanvasService

@* Shared by the desktop menu row and the mobile offcanvas. *@
<ul class="navbar-nav">
    <li class="nav-item @ActiveClass("/")">
        <a class="nav-link" href="/" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.LayoutDashboard" /></span>
            <span class="nav-link-title">Přehled</span>
        </a>
    </li>

    <li class="nav-item @ActiveClass("/cases")">
        <a class="nav-link" href="/cases" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.Folders" /></span>
            <span class="nav-link-title">Spisy</span>
        </a>
    </li>

    <li class="nav-item @ActiveClass("/deadlines")">
        <a class="nav-link" href="/deadlines" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.Clock" /></span>
            <span class="nav-link-title">Lhůty</span>
        </a>
    </li>

    <li class="nav-item @ActiveClass("/settings")">
        <a class="nav-link" href="/settings" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.Settings" /></span>
            <span class="nav-link-title">Nastavení</span>
        </a>
    </li>

    <li class="nav-item @ActiveClass("/echo")">
        <a class="nav-link" href="/echo" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.ArrowsExchange" /></span>
            <span class="nav-link-title">Echo</span>
        </a>
    </li>
</ul>

@code {
    @* Tabler draws the active indicator on the list item, which Blazor's NavLink cannot reach. *@
    private string ActiveClass(string href) =>
        string.Equals(CurrentPath, href, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private string CurrentPath => "/" + this.Navigation.ToBaseRelativePath(this.Navigation.Uri).Split('?')[0].TrimEnd('/');

    protected override void OnInitialized() => this.Navigation.LocationChanged += this.OnLocationChanged;

    public void Dispose() => this.Navigation.LocationChanged -= this.OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => this.StateHasChanged();

    private void Close() => this.OffcanvasService.Close();
}
