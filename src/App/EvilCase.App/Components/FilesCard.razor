@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using Microsoft.JSInterop
@using TabBlazor.Services
@implements IAsyncDisposable
@inject IModalService ModalService
@inject IJSRuntime JSRuntime
@inject ILogger<FilesCard> Logger

@* The card is itself the drop target (SDD-016 §5): the hidden InputFile below receives a card-wide
   drop through file-drop.js and uploads it the same way a picked file uploads. *@
<div class="card ec-dropcard @(this.dragOver ? "is-dragover" : "")" @ref="this.cardRef">
    <div class="card-header">
        <h3 class="card-title">
            <Icon CssClass="icon me-2" IconType="AppIcons.Paperclip" />Soubory
            @if (!this.loading && this.listFailure is null)
            {
                <span class="badge bg-secondary-lt ms-2">@this.items.Count</span>
            }
        </h3>
        <div class="card-actions">
            <button id="files-upload" type="button" class="btn btn-primary" @onclick="this.OpenUploadModal">
                <Icon CssClass="icon" IconType="AppIcons.Upload" />Nahrát
            </button>
        </div>
    </div>

    <div class="visually-hidden" @ref="this.dropInputWrapper">
        <InputFile multiple OnChange="this.OnDropFilesSelected" aria-label="Přetáhnout soubory" />
    </div>

    @foreach (var failure in this.dropFailures)
    {
        <div class="card-body pb-0">
            <div class="alert alert-danger mb-0" role="alert"><Icon CssClass="icon me-2" IconType="AppIcons.AlertTriangle" />@failure</div>
        </div>
    }

    @if (this.dropUploadTotal > 0)
    {
        <div class="card-body pb-0 text-secondary">Nahrávám @this.dropUploadIndex / @this.dropUploadTotal: @this.dropUploadName</div>
    }

    @if (this.error is not null)
    {
        <div class="card-body pb-0">
            <div class="alert alert-danger mb-0" role="alert"><Icon CssClass="icon me-2" IconType="AppIcons.AlertTriangle" />@this.error</div>
        </div>
    }

    @if (this.loading)
    {
        <div class="card-body text-center text-secondary">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (this.listFailure is not null)
    {
        <div class="empty">
            <div class="empty-icon"><Icon IconType="AppIcons.AlertTriangle" /></div>
            <p class="empty-title">Soubory se nepodařilo načíst</p>
            <p class="empty-subtitle text-secondary">@this.listFailure</p>
        </div>
    }
    else if (this.items.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><Icon IconType="AppIcons.Paperclip" /></div>
            <p class="empty-title">Žádné soubory</p>
            <p class="empty-subtitle text-secondary">Přetáhněte soubory sem, nebo je nahrajte tlačítkem Nahrát.</p>
        </div>
    }
    else
    {
        @foreach (var file in this.items)
        {
            <div class="ec-filerow">
                <a class="ec-filerow-link" href="#" aria-label="@($"Stáhnout {file.FileName}")" @onclick="() => this.Download(file)" @onclick:preventDefault>
                    <span class="ec-filerow-icon" aria-hidden="true">@FileExtensionDisplay.Text(file.FileName)</span>
                    <span class="ec-min-w-0 flex-fill">
                        <span class="d-block text-truncate">@file.FileName</span>
                        <span class="ec-filerow-meta ec-num">@FileSizeDisplay.Text(file.SizeBytes) · @MomentDisplay.Text(file.Created)</span>
                    </span>
                </a>
                <button type="button" class="btn btn-sm btn-danger" aria-label="@($"Smazat {file.FileName}")" disabled="@(this.downloadingFileId == file.FileId)" @onclick="() => this.ConfirmDelete(file)">
                    <Icon IconType="AppIcons.Trash" />
                </button>
            </div>
        }
    }

    @if (this.dragOver)
    {
        <div class="ec-dropveil">
            <div class="ec-droppill">
                <Icon CssClass="icon" IconType="AppIcons.Upload" />
                <div>
                    <div>Pustit soubory sem</div>
                    <div class="ec-filerow-meta">Nejvýše @(FileSizeDisplay.Text(FileLimits.MaxUploadBytes)) na soubor.</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int MaxBatchFiles = 100;

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task<IReadOnlyList<FileListItem>>> LoadFiles { get; set; }

    [Parameter, EditorRequired]
    public required Func<IBrowserFile, CancellationToken, Task> UploadFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DownloadFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DeleteFile { get; set; }

    /// <summary>
    /// Lower case: it follows the file name and a colon.
    /// </summary>
    [Parameter, EditorRequired]
    public required string OwnerGoneError { get; set; }

    private readonly List<string> dropFailures = [];

    private ElementReference cardRef;

    private ElementReference dropInputWrapper;

    private IJSObjectReference? dropModule;

    private IJSObjectReference? dropBinding;

    private DotNetObjectReference<FilesCard>? dropRef;

    private IReadOnlyList<FileListItem> items = [];

    private bool dragOver;

    private bool loading = true;

    private int dropUploadIndex;

    private int dropUploadTotal;

    private string dropUploadName = "";

    private Guid? downloadingFileId;

    private string? listFailure;

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await this.ReloadFiles();
        this.loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // A navigation away while this is in flight aborts the JS interop call; the card-wide
        // drop is then simply unavailable, never a broken page.
        try
        {
            var module = await this.JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/file-drop.js");
            if (module is null)
                return;

            var dotNetRef = DotNetObjectReference.Create(this);

            this.dropModule = module;
            this.dropRef = dotNetRef;
            this.dropBinding = await module.InvokeAsync<IJSObjectReference>("bindCardDrop", this.cardRef, this.dropInputWrapper, dotNetRef);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            this.Logger.LogWarning(exception, "Binding the card-wide file drop failed");
        }
    }

    [JSInvokable]
    public void SetDragOver(bool value)
    {
        this.dragOver = value;
        this.StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (this.dropBinding is not null)
        {
            await this.dropBinding.InvokeVoidAsync("dispose");
            await this.dropBinding.DisposeAsync();
        }

        if (this.dropModule is not null)
        {
            await this.dropModule.DisposeAsync();
        }

        this.dropRef?.Dispose();
    }

    private async Task ReloadFiles()
    {
        this.listFailure = null;

        try
        {
            this.items = await this.LoadFiles(CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the files failed");

            this.items = [];
            this.listFailure = "Soubory se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private Task OpenUploadModal()
    {
        return this.ModalService.ShowAsync(
            "Nahrát soubory",
            new RenderComponent<FileUploadModal>()
                .Set(component => component.UploadFile, this.UploadFile)
                .Set(component => component.OwnerGoneError, this.OwnerGoneError)
                .Set(component => component.OnUploaded, EventCallback.Factory.Create(this, this.ReloadFiles)),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }

    private async Task OnDropFilesSelected(InputFileChangeEventArgs args)
    {
        this.dropFailures.Clear();
        this.dragOver = false;
        this.dropUploadIndex = 0;

        if (args.FileCount > MaxBatchFiles)
        {
            this.dropFailures.Add($"Najednou lze nahrát nejvýše {MaxBatchFiles} souborů.");

            return;
        }

        this.dropUploadTotal = args.FileCount;

        foreach (var file in args.GetMultipleFiles(MaxBatchFiles))
        {
            this.dropUploadIndex++;
            this.dropUploadName = file.Name;
            this.StateHasChanged();

            if (file.Size > FileLimits.MaxUploadBytes)
            {
                this.dropFailures.Add($"{file.Name}: soubor je větší než {FileSizeDisplay.Text(FileLimits.MaxUploadBytes)}.");
                continue;
            }

            try
            {
                await this.UploadFile(file, CancellationToken.None);
            }
            catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.RequestEntityTooLarge)
            {
                this.Logger.LogWarning(exception, "Uploading a dropped file failed: too large");

                this.dropFailures.Add($"{file.Name}: soubor je větší než {FileSizeDisplay.Text(FileLimits.MaxUploadBytes)}.");
            }
            catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
            {
                this.Logger.LogWarning(exception, "Uploading a dropped file failed: the owner is gone");

                this.dropFailures.Add($"{file.Name}: {this.OwnerGoneError}");
            }
            catch (Exception exception) when (exception is ApiException or HttpRequestException or IOException or JSException)
            {
                this.Logger.LogWarning(exception, "Uploading a dropped file failed");

                this.dropFailures.Add($"{file.Name}: nahrání se nezdařilo.");
            }
        }

        this.dropUploadTotal = 0;

        await this.ReloadFiles();
    }

    private async Task Download(FileListItem file)
    {
        this.downloadingFileId = file.FileId;
        this.error = null;

        try
        {
            await this.DownloadFile(file, CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException or JSException)
        {
            this.Logger.LogWarning(exception, "Downloading file {FileId} failed", file.FileId);

            this.error = "Soubor se nepodařilo stáhnout. Zkuste to za chvíli znovu.";
        }
        finally
        {
            this.downloadingFileId = null;
        }
    }

    private async Task ConfirmDelete(FileListItem file)
    {
        await this.ModalService.ShowAsync(
            "Smazat soubor",
            new RenderComponent<FileDeleteModal>()
                .Set(component => component.FileName, file.FileName)
                .Set(component => component.DeleteFile, (CancellationToken token) => this.DeleteFile(file, token))
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, this.ReloadFiles)),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
