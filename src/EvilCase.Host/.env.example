# Local secrets for EvilCase.Api. Copy to .env and fill in the values (.env is never committed).
# The file is read in Development only and its entries become environment variables, so keys use the
# environment variable separator: A__B maps to the configuration key A:B. An environment variable that
# is already set wins over the file. Quote a value to keep leading or trailing spaces.

EvilBrains__EvilCase__ConnectionString=Host=localhost;Port=5432;Database=evilcase;Username=postgres;Password=postgres
EvilBrains__EvilCase__Auth__Jwt__Key=

# Optional: Seq API key for the Development Serilog sink.
Serilog__WriteTo__1__Args__apiKey=
