@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.App.Models
@inject ICasesClient CasesClient
@inject ILogger<CaseChildrenCard> Logger

@* The sidebar's Hierarchie section: parent case link, then the child list as compact full-width rows. *@
<div class="ec-field-label mb-2 d-flex align-items-center gap-2">
    Podřízené spisy
    @if (this.children is not null)
    {
        <span class="badge bg-secondary-lt">@this.children.Count</span>
    }
</div>

@if (this.failure is not null)
{
    <div class="text-secondary small mb-2">@this.failure</div>
}
else if (this.children is null)
{
    <div class="text-secondary small mb-2">Načítám…</div>
}
else if (this.children.Count == 0)
{
    <div class="text-secondary small mb-2">Žádné podřízené spisy.</div>
}
else
{
    @foreach (var item in this.children)
    {
        <a class="ec-comprow" href="@($"/cases/{item.CaseId}")">
            <span class="ec-min-w-0 flex-fill">
                <span class="d-block ec-comprow-title">@item.Title</span>
                <span class="ec-comprow-meta">
                    <span class="ec-num">@DateDisplay.Text(item.Date)</span> ·
                    <Status BackgroundColor="CaseStatusDisplay.Color(item.Status)" Lite="true">@CaseStatusDisplay.Text(item.Status)</Status>
                </span>
            </span>
        </a>
    }
}

<a href="@($"/cases/new?parent={this.ParentCaseId}")" class="btn btn-outline-secondary w-100 mt-2"><Icon CssClass="icon" IconType="TablerIcons.Plus" />Nový podřízený spis</a>

@code {
    /// <summary>
    /// The sidebar summary lists every child of one case; the tenant holds no case with more.
    /// </summary>
    private const int ChildLimit = 100;

    [Parameter, EditorRequired]
    public required Guid ParentCaseId { get; set; }

    private IReadOnlyList<CaseListItem>? children;

    private string? failure;

    private Guid loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (this.loaded == this.ParentCaseId)
            return;

        this.loaded = this.ParentCaseId;

        var request = new CaseListRequest
        {
            ParentCaseId = this.ParentCaseId,
            Status = CaseStatusFilter.All,
            Take = ChildLimit,
        };

        try
        {
            var response = await this.CasesClient.ListCases(request, CancellationToken.None);

            this.children = response.Items;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the child cases failed");

            this.failure = "Podřízené spisy se nepodařilo načíst.";
        }
    }
}
