@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using TabBlazor.Services
@implements IDisposable
@inject IContactsClient ContactsClient
@inject IModalService ModalService
@inject ILogger<ContactPicker> Logger

@if (this.Selected is { } selected)
{
    <div class="input-group">
        <input id="@this.InputId" class="form-control" value="@selected.Name" readonly aria-label="Vybraný kontakt" />
        <button type="button" class="btn" @onclick="this.ClearSelection"><Icon CssClass="icon" IconType="TablerIcons.ArrowsExchange" />Změnit</button>
    </div>
}
else
{
    <div class="ec-picker">
        <div class="input-group">
            <input id="@this.InputId" type="search" class="form-control" placeholder="Hledat v názvu a ID datové schránky"
                   aria-label="Hledat kontakt" value="@this.search" @oninput="this.OnSearchInput" @onkeydown="this.OnKeyDown" />
            <button type="button" id="@($"{this.InputId}-new")" class="btn" @onclick="this.CreateContact"><Icon CssClass="icon" IconType="TablerIcons.Plus" />Nový kontakt</button>
        </div>

        @if (!this.closed && this.matches.Count > 0)
        {
            <div class="dropdown-menu show ec-picker-menu">
                @foreach (var match in this.matches)
                {
                    <button type="button" class="dropdown-item" @onclick="() => this.Select(match)">
                        @match.Name
                        <span class="text-secondary ms-2">@ContactKindDisplay.Text(match.Kind)</span>
                        @if (!string.IsNullOrWhiteSpace(match.DataBoxId))
                        {
                            <span class="text-secondary ms-2">@match.DataBoxId</span>
                        }
                    </button>
                }
            </div>
        }
    </div>

    @if (this.searchFailure is not null)
    {
        <div class="form-hint">@this.searchFailure</div>
    }
    else if (!this.closed && this.matches.Count == 0 && this.searched)
    {
        <div class="form-hint">Žádný kontakt neodpovídá. Založte nový.</div>
    }
}

@code {
    // The suggester offers at most eight matches (SDD-011).
    private const int Matches = 8;

    [Parameter, EditorRequired]
    public required string InputId { get; set; }

    [Parameter]
    public ContactListItem? Selected { get; set; }

    [Parameter]
    public EventCallback<ContactListItem?> SelectedChanged { get; set; }

    private readonly SearchDebouncer debouncer = new();

    private IReadOnlyList<ContactListItem> matches = [];

    private string search = "";

    private bool searched;

    private bool closed;

    private string? searchFailure;

    public void Dispose()
    {
        this.debouncer.Dispose();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            this.closed = true;
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        this.search = args.Value as string ?? "";
        this.closed = false;

        var token = await this.debouncer.Start(debounce: true);
        if (token is null)
            return;

        this.searchFailure = null;

        if (string.IsNullOrWhiteSpace(this.search))
        {
            this.matches = [];
            this.searched = false;
            return;
        }

        try
        {
            var response = await this.ContactsClient.ListContacts(new ContactListRequest { Search = this.search, Take = Matches }, token.Value);

            this.matches = response.Items;
            this.searched = true;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request.
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the contact matches failed");

            this.matches = [];
            this.searched = true;
            this.searchFailure = "Hledání kontaktů se nezdařilo. Zkuste to za chvíli znovu.";
        }
    }

    private async Task Select(ContactListItem contact)
    {
        this.matches = [];
        this.search = "";
        this.searched = false;

        await this.SelectedChanged.InvokeAsync(contact);
    }

    private async Task ClearSelection()
    {
        await this.SelectedChanged.InvokeAsync(null);
    }

    private async Task CreateContact()
    {
        await this.ModalService.ShowAsync(
            "Nový kontakt",
            new RenderComponent<ContactFormModal>()
                .Set(component => component.OnCreated, EventCallback.Factory.Create<ContactListItem>(this, this.Select)),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
