@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Domain.Contacts
@inject IContactsClient ContactsClient
@inject ILogger<ContactFormModal> Logger

<EcModal Title="@this.Title" Open="this.Open" OpenChanged="this.OpenChanged">
    <ChildContent>
        <CascadingValue Value="this.editContext">
            <DataAnnotationsValidator />
            <div class="ec-form">
                <EcField Label="Název" Required ControlId="@($"{this.idPrefix}-name")">
                    <ChildContent>
                        <InputText id="@($"{this.idPrefix}-name")" class="ec-input" @bind-Value="this.model.Name" />
                    </ChildContent>
                    <Error><ValidationMessage For="() => this.model.Name" /></Error>
                </EcField>

                <EcField Label="Typ" Required ControlId="@($"{this.idPrefix}-kind")">
                    <ChildContent>
                        <InputSelect id="@($"{this.idPrefix}-kind")" class="ec-select" @bind-Value="this.model.Kind">
                            @foreach (var kind in Enum.GetValues<ContactKind>())
                            {
                                <option value="@kind">@ContactKindDisplay.Text(kind)</option>
                            }
                        </InputSelect>
                    </ChildContent>
                    <Error><ValidationMessage For="() => this.model.Kind" /></Error>
                </EcField>

                <EcField Label="ID datové schránky" ControlId="@($"{this.idPrefix}-databox")">
                    <ChildContent>
                        <InputText id="@($"{this.idPrefix}-databox")" class="ec-input ec-input-mono" @bind-Value="this.model.DataBoxId" />
                    </ChildContent>
                    <Error><ValidationMessage For="() => this.model.DataBoxId" /></Error>
                </EcField>

                <EcField Label="Adresa" ControlId="@($"{this.idPrefix}-address")">
                    <ChildContent>
                        <InputTextArea id="@($"{this.idPrefix}-address")" class="ec-textarea" rows="4" @bind-Value="this.model.Address" />
                    </ChildContent>
                    <Error><ValidationMessage For="() => this.model.Address" /></Error>
                </EcField>

                @if (this.error is not null)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
                }
            </div>
        </CascadingValue>
    </ChildContent>
    <Footer>
        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Form" Icon="@AppIcons.X" OnClick="this.Cancel">Zrušit</EcButton>
        <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Form" Icon="@AppIcons.Check"
                  Disabled="@this.busy" OnClick="this.SaveContact">@this.SaveText</EcButton>
    </Footer>
</EcModal>

@code {
    [Parameter]
    public ContactDetail? Contact { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback<ContactListItem> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private readonly ContactEditModel model = new();

    private EditContext editContext = null!;

    private string? error;

    private bool busy;

    private string idPrefix => this.Contact is null ? "contact-create" : "contact-edit";

    private string Title => this.Contact is null ? "Nový kontakt" : "Upravit kontakt";

    private string SaveText => this.Contact is null ? "Založit kontakt" : "Uložit";

    protected override void OnInitialized()
    {
        if (this.Contact is { } contact)
        {
            this.model.Name = contact.Name;
            this.model.Kind = contact.Kind;
            this.model.DataBoxId = contact.DataBoxId;
            this.model.Address = contact.Address;
        }

        this.editContext = new EditContext(this.model);
    }

    private async Task Cancel()
    {
        await this.OpenChanged.InvokeAsync(false);
    }

    private async Task SaveContact()
    {
        if (!this.editContext.Validate())
            return;

        this.busy = true;
        this.error = null;

        try
        {
            var request = new ContactEditRequest
            {
                Name = this.model.Name,
                Kind = this.model.Kind,
                DataBoxId = this.model.DataBoxId,
                Address = this.model.Address,
            };

            if (this.Contact is { } contact)
            {
                await this.ContactsClient.EditContact(contact.ContactId, request, CancellationToken.None);

                await this.OnSaved.InvokeAsync();
            }
            else
            {
                var created = await this.ContactsClient.CreateContact(request, CancellationToken.None);

                await this.OnCreated.InvokeAsync(created);
            }
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the contact failed");

            this.error = this.Contact is null
                ? "Kontakt se nepodařilo založit. Zkontrolujte zadané údaje a zkuste to znovu."
                : "Kontakt se nepodařilo uložit. Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
