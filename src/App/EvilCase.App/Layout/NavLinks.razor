@implements IDisposable
@inject NavigationManager Navigation

@foreach (var item in Items)
{
    <a class="ec-nav-link" href="@item.Href"
       aria-current="@(this.IsCurrent(item.Href) ? "page" : null)" @onclick="this.OnNavigate">
        <EcIcon Paths="@item.Icon" Size="EcIconSize.Large" />
        <span>@item.Text</span>
    </a>
}

@code {
    private static readonly (string Href, string Text, string Icon)[] Items =
    [
        ("/", "Přehled", AppIcons.LayoutDashboard),
        ("/cases", "Spisy", AppIcons.Folders),
        ("/contacts", "Kontakty", AppIcons.Users),
        ("/settings", "Nastavení", AppIcons.Settings),
    ];

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool IsCurrent(string href)
    {
        return string.Equals(this.CurrentPath, href, StringComparison.OrdinalIgnoreCase)
            || this.CurrentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentPath => "/" + this.Navigation.ToBaseRelativePath(this.Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    protected override void OnInitialized()
    {
        this.Navigation.LocationChanged += this.OnLocationChanged;
    }

    public void Dispose()
    {
        this.Navigation.LocationChanged -= this.OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        this.StateHasChanged();
    }
}
