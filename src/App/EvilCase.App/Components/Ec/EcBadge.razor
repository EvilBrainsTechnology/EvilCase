@using System.Diagnostics

<span class="@this.CssClass">
    @if (this.ShowDot)
    {
        <span class="ec-badge-dot" aria-hidden="true"></span>
    }
    @if (this.Icon.Length > 0)
    {
        <EcIcon Paths="@this.Icon" Size="EcIconSize.Small" />
    }
    @this.Text
</span>

@code {
    [Parameter, EditorRequired]
    public required string Text { get; set; }

    [Parameter, EditorRequired]
    public required EcBadgeTone Tone { get; set; }

    /// <summary>
    /// A dot in the tone's colour before the text; a case status carries one.
    /// </summary>
    [Parameter]
    public bool ShowDot { get; set; }

    /// <summary>
    /// An icon before the text; an act direction carries its arrow.
    /// </summary>
    [Parameter]
    public string Icon { get; set; } = "";

    private string CssClass
    {
        get
        {
            var tone = this.Tone switch
            {
                EcBadgeTone.Active => "ec-badge-active",
                EcBadgeTone.Waiting => "ec-badge-waiting",
                EcBadgeTone.Closed => "ec-badge-closed",
                EcBadgeTone.Incoming => "ec-badge-incoming",
                EcBadgeTone.Outgoing => "ec-badge-outgoing",
                EcBadgeTone.Authority => "ec-badge-authority",
                EcBadgeTone.Official => "ec-badge-official",
                EcBadgeTone.Person => "ec-badge-person",
                EcBadgeTone.Danger => "ec-badge-danger",
                EcBadgeTone.Signature => "ec-badge-signature",
                EcBadgeTone.FileVersion => "ec-badge-file-version",
                EcBadgeTone.Fresh => "ec-badge-fresh",
                EcBadgeTone.Current => "ec-badge-current",
                _ => throw new UnreachableException(),
            };

            return $"ec-badge {tone}";
        }
    }
}
