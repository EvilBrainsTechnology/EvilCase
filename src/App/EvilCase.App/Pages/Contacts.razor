@page "/contacts"
@inherits ListPage
@using EvilBrains.EvilCase.Api.Contract.Contacts

<PageTitle>Kontakty – EvilCase</PageTitle>

<div class="ec-page">
    <EcPageHeader Title="Kontakty">
        <Status>
            @if (this.loaded)
            {
                <span class="ec-page-note">@RecordCountDisplay.Text(this.total)</span>
            }
        </Status>
        <Actions>
            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.UserPlus" OnClick="this.CreateContact" id="contact-new">Nový kontakt</EcButton>
        </Actions>
    </EcPageHeader>

    <ContactList @key="this.ListKey" @ref="this.list"
                 Columns="Columns" Filter="Filter"
                 ShowSearch="true" ShowKindFilter="true" ShowPaging="true"
                 TotalChanged="this.OnTotalChanged"
                 EmptyText="Zkuste jiné hledání.">
        <EmptyAction>
            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.UserPlus" OnClick="this.CreateContact">Založit kontakt</EcButton>
        </EmptyAction>
    </ContactList>
</div>

@if (this.formOpen)
{
    <ContactFormModal Open OpenChanged="this.CloseForm" OnCreated="this.ContactCreated" />
}

@code {
    private const int PageItems = 20;

    private static readonly ContactColumn[] Columns =
    [
        ContactColumn.Name,
        ContactColumn.Kind,
        ContactColumn.DataBoxId,
        ContactColumn.Address,
    ];

    [Parameter]
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private ContactList? list;

    // A record, so a render that hands over the same values reloads nothing.
    private ContactListRequest Filter => new()
    {
        Search = string.IsNullOrWhiteSpace(this.Query) ? null : this.Query,
        Take = PageItems,
    };

    private bool formOpen;

    private bool loaded;

    private int total;

    private void CreateContact()
    {
        this.formOpen = true;
    }

    private void CloseForm(bool open)
    {
        if (!open)
            this.formOpen = false;
    }

    private async Task ContactCreated(ContactListItem contact)
    {
        this.formOpen = false;

        await this.list!.Reload();
    }

    private void OnTotalChanged(int count)
    {
        this.loaded = true;
        this.total = count;
    }
}
