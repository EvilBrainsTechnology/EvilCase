@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Labels
@inject ILabelsClient LabelsClient
@inject ILogger<LabelPicker> Logger

@if (this.Selected.Count > 0)
{
    <div class="badges-list mb-2">
        @foreach (var label in this.Selected)
        {
            <span class="badge bg-@(LabelColorDisplay.Css(label.Color))-lt">
                @label.Name
                <button type="button" class="btn-close btn-close-sm ms-2" aria-label="@($"Odebrat štítek {label.Name}")" @onclick="() => this.Remove(label)"></button>
            </span>
        }
    </div>
}

<div class="ec-picker">
    <input id="@this.InputId" type="search" class="form-control" placeholder="Hledat štítek"
           aria-label="Hledat štítek" value="@this.search" @oninput="this.OnSearchInput" @onkeydown="this.OnKeyDown" @onfocus="this.Open" />

    @if (!this.closed && this.Matches is { Count: > 0 } matches)
    {
        <div class="dropdown-menu show ec-picker-menu">
            @foreach (var match in matches)
            {
                <button type="button" class="dropdown-item" @onclick="() => this.Add(match)">
                    <span class="status-dot bg-@LabelColorDisplay.Css(match.Color) me-2"></span>@match.Name
                </button>
            }
        </div>
    }
</div>

@if (this.failure is not null)
{
    <div class="form-hint">@this.failure</div>
}
else if (!this.closed && this.Matches.Count == 0)
{
    @if (this.available.Count == 0)
    {
        <div class="form-hint">Zatím není žádný štítek. Založte ho v <a href="/settings">nastavení</a>.</div>
    }
    else
    {
        <div class="form-hint">Žádný další štítek neodpovídá.</div>
    }
}

@code {
    [Parameter, EditorRequired]
    public required string InputId { get; set; }

    [Parameter]
    public IReadOnlyList<LabelItem> Selected { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<LabelItem>> SelectedChanged { get; set; }

    private IReadOnlyList<LabelItem> available = [];

    private string search = "";

    // The menu opens on focus: the picker sits in a list toolbar too, where an open menu would
    // cover the list.
    private bool closed = true;

    private string? failure;

    /// <summary>
    /// The tenant holds few labels, so the whole set is read once and narrowed in the browser.
    /// </summary>
    private IReadOnlyList<LabelItem> Matches =>
    [
        .. this.available
            .Where(label => !this.Selected.Any(selected => selected.LabelId == label.LabelId))
            .Where(label => string.IsNullOrWhiteSpace(this.search) || label.Name.Contains(this.search.Trim(), StringComparison.OrdinalIgnoreCase))
            .Take(8),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await this.LabelsClient.ListLabels(CancellationToken.None);

            this.available = response.Items;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the labels failed");

            this.failure = "Štítky se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        this.search = args.Value as string ?? "";
        this.closed = false;
    }

    private void Open()
    {
        this.closed = false;
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            this.closed = true;
    }

    private async Task Add(LabelItem label)
    {
        this.search = "";

        await this.SelectedChanged.InvokeAsync([.. this.Selected, label]);
    }

    private async Task Remove(LabelItem label)
    {
        await this.SelectedChanged.InvokeAsync([.. this.Selected.Where(selected => selected.LabelId != label.LabelId)]);
    }
}
