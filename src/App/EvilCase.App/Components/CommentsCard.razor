@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Comments
@inject ILogger<CommentsCard> Logger

<EcCard Title="@this.Title">
    <Header>
        @if (!this.loading && this.listFailure is null)
        {
            <span class="ec-card-count">@this.items.Count</span>
        }
    </Header>
    <ChildContent>
        <div class="ec-card-stack">
            @if (this.loading)
            {
                <p class="ec-card-state">Načítám…</p>
            }
            else if (this.listFailure is not null)
            {
                <div class="ec-card-error">
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.listFailure</div>
                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                              OnClick="this.ReloadComments">Zkusit znovu</EcButton>
                </div>
            }
            else if (this.items.Count == 0)
            {
                <EcEmptyState Icon="@AppIcons.Message" Text="Zatím tu nejsou žádné komentáře." />
            }
            else
            {
                <div class="ec-comment-list">
                    @foreach (var item in this.items)
                    {
                        <div class="ec-comment">
                            <span class="ec-comment-avatar" aria-hidden="true">@AuthorInitialsDisplay.Text(item.AuthorEmail)</span>
                            <div class="ec-comment-main">
                                <span class="ec-comment-meta">
                                    <span class="ec-comment-author">@item.AuthorEmail</span> · @MomentDisplay.Text(item.Created)@(item.Updated is null ? "" : $" · upraveno {MomentDisplay.Text(item.Updated.Value)}")
                                </span>

                                @if (this.editingCommentId == item.CommentId)
                                {
                                    <CascadingValue Value="this.editCommentContext">
                                        <DataAnnotationsValidator />
                                        <div id="comment-edit" class="ec-comment-form">
                                            <label class="ec-visually-hidden" for="comment-edit-body">Upravit komentář</label>
                                            <InputTextArea id="comment-edit-body" class="ec-textarea" rows="4" @bind-Value="this.editModel.Body" />
                                            <div class="ec-field-error"><ValidationMessage For="() => this.editModel.Body" /></div>
                                            @if (this.editError is not null)
                                            {
                                                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.editError</div>
                                            }
                                            <div class="ec-comment-form-actions">
                                                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.X"
                                                          OnClick="this.CancelEditing">Zrušit</EcButton>
                                                <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Compact" Icon="@AppIcons.Check"
                                                          Disabled="@this.busy" OnClick="this.SaveEditedComment">Uložit</EcButton>
                                            </div>
                                        </div>
                                    </CascadingValue>
                                }
                                else
                                {
                                    <p class="ec-comment-text">@item.Body</p>

                                    @if (item.IsAuthor)
                                    {
                                        <div class="ec-comment-actions">
                                            <EcButton Variant="EcButtonVariant.Ghost" Size="EcButtonSize.Compact" Icon="@AppIcons.Pencil"
                                                      OnClick="() => this.StartEditing(item)">Upravit</EcButton>
                                            <EcButton Variant="EcButtonVariant.Danger" Size="EcButtonSize.Compact" Icon="@AppIcons.Trash"
                                                      OnClick="() => this.ConfirmDelete(item)">Smazat</EcButton>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <CascadingValue Value="this.newCommentContext">
                <DataAnnotationsValidator />
                <div id="comment-new" class="ec-comment-form">
                    <label class="ec-visually-hidden" for="comment-new-body">Nový komentář</label>
                    <InputTextArea id="comment-new-body" class="ec-textarea" rows="3" placeholder="@this.Placeholder"
                                   @bind-Value="this.newModel.Body" />
                    <div class="ec-field-error"><ValidationMessage For="() => this.newModel.Body" /></div>
                    @if (this.addError is not null)
                    {
                        <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.addError</div>
                    }
                    <div class="ec-comment-form-actions">
                        <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Standard" Icon="@AppIcons.Message"
                                  Disabled="@this.busy" OnClick="this.AddNewComment">Přidat komentář</EcButton>
                    </div>
                </div>
            </CascadingValue>
        </div>
    </ChildContent>
</EcCard>

@if (this.deletingComment is { } comment)
{
    <CommentDeleteModal Body="@comment.Body" Delete="token => this.DeleteComment(comment.CommentId, token)"
                        Open OpenChanged="this.CloseDelete" OnDeleted="this.CommentDeleted" />
}

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Placeholder { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task<IReadOnlyList<CommentItem>>> LoadComments { get; set; }

    [Parameter, EditorRequired]
    public required Func<CommentEditRequest, CancellationToken, Task> AddComment { get; set; }

    [Parameter, EditorRequired]
    public required Func<Guid, CommentEditRequest, CancellationToken, Task> SaveComment { get; set; }

    [Parameter, EditorRequired]
    public required Func<Guid, CancellationToken, Task> DeleteComment { get; set; }

    private readonly CommentEditModel newModel = new();

    private readonly CommentEditModel editModel = new();

    private EditContext newCommentContext = null!;

    private EditContext editCommentContext = null!;

    private IReadOnlyList<CommentItem> items = [];

    private Guid? editingCommentId;

    private bool loading = true;

    private bool busy;

    private string? listFailure;

    private string? addError;

    private string? editError;

    private CommentItem? deletingComment;

    protected override async Task OnInitializedAsync()
    {
        this.newCommentContext = new EditContext(this.newModel);
        this.editCommentContext = new EditContext(this.editModel);

        await this.ReloadComments();
        this.loading = false;
    }

    private async Task ReloadComments()
    {
        this.listFailure = null;

        try
        {
            this.items = await this.LoadComments(CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the comments failed");

            this.items = [];
            this.listFailure = "Komentáře se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task AddNewComment()
    {
        if (!this.newCommentContext.Validate())
            return;

        this.busy = true;
        this.addError = null;

        try
        {
            await this.AddComment(new CommentEditRequest { Body = this.newModel.Body }, CancellationToken.None);

            this.newModel.Body = "";
            this.newCommentContext.MarkAsUnmodified();

            await this.ReloadComments();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.addError = "Komentář se nepodařilo přidat, záznam už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Adding the comment failed");

            this.addError = "Komentář se nepodařilo přidat. Zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }

    private void StartEditing(CommentItem comment)
    {
        this.editingCommentId = comment.CommentId;
        this.editModel.Body = comment.Body;
        this.editCommentContext.MarkAsUnmodified();
        this.editError = null;
    }

    private void CancelEditing()
    {
        this.editingCommentId = null;
        this.editError = null;
    }

    private async Task SaveEditedComment()
    {
        if (this.editingCommentId is not { } commentId)
            return;

        if (!this.editCommentContext.Validate())
            return;

        this.busy = true;
        this.editError = null;

        try
        {
            await this.SaveComment(commentId, new CommentEditRequest { Body = this.editModel.Body }, CancellationToken.None);

            this.editingCommentId = null;

            await this.ReloadComments();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            this.editError = "Komentář smí upravit jen jeho autor.";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.editError = "Komentář už neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Saving the comment failed");

            this.editError = "Komentář se nepodařilo uložit. Zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }

    private void ConfirmDelete(CommentItem comment)
    {
        this.deletingComment = comment;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deletingComment = null;
    }

    private async Task CommentDeleted()
    {
        this.deletingComment = null;

        await this.ReloadComments();
    }
}
