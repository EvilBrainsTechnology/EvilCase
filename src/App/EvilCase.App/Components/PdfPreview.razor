@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IFilePreviews Previews
@inject ILogger<PdfPreview> Logger

@* The toolbar stays above the one scrolling region; PDF.js owns everything inside the host element. *@
<div class="ec-preview-view">
    <PreviewToolbar @ref="this.toolbar" Label="Ovládání náhledu PDF" Ready="this.Ready" Paged Pages="this.pages" Fits
                    OnZoom="this.Zoom" OnGoToPage="this.GoToPage" OnSearch="this.Search" />
    <div class="ec-preview-pdf-frame">
        <div @ref="this.host" class="ec-preview-pdf" role="document" tabindex="0" aria-label="Obsah souboru @this.FileName"></div>
        @if (!this.Ready)
        {
            <p class="ec-preview-message ec-preview-pdf-loading">Načítám…</p>
        }
    </div>
</div>

@code {
    private readonly CancellationTokenSource cancel = new();

    private PreviewToolbar? toolbar;

    private ElementReference host;

    private bool rendering;

    private int pages;

    /// <summary>
    /// The content address the library requests the PDF from; unused when <see cref="Content"/> is given.
    /// </summary>
    [Parameter]
    public string Url { get; set; } = "";

    /// <summary>
    /// The bytes of a PDF held in memory, an attachment of a data message; the library reads them instead of
    /// requesting <see cref="Url"/>.
    /// </summary>
    [Parameter]
    public byte[]? Content { get; set; }

    [Parameter, EditorRequired]
    public required string FileName { get; set; }

    /// <summary>
    /// Raised when the library cannot open or draw the file, a password-protected one included.
    /// </summary>
    [Parameter]
    public EventCallback OnUnreadable { get; set; }

    private bool Ready => this.pages > 0;

    public async ValueTask DisposeAsync()
    {
        await this.cancel.CancelAsync();

        if (this.rendering)
        {
            try
            {
                await this.Previews.DisposePdf(this.host);
            }
            catch (JSException exception)
            {
                this.Logger.LogInformation(exception, "The PDF preview was already gone");
            }
        }

        this.cancel.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token = this.cancel.Token;

        this.rendering = true;

        try
        {
            int count;

            if (this.Content is { } content)
            {
                await using var stream = new MemoryStream(content, writable: false);

                count = await this.Previews.RenderPdf(this.host, stream, this.toolbar!.View, token);
            }
            else
                count = await this.Previews.RenderPdf(this.host, this.Url, this.toolbar!.View, token);

            if (!token.IsCancellationRequested)
            {
                this.pages = count;
                this.StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // The preview closed or moved on to another file.
        }
        catch (JSException exception)
        {
            this.Logger.LogInformation(exception, "The library could not draw the PDF for the preview");

            if (!token.IsCancellationRequested)
                await this.OnUnreadable.InvokeAsync();
        }
    }

    private async Task Zoom(PreviewZoom zoom)
    {
        await this.Previews.ZoomPdf(this.host, zoom);
    }

    private async Task GoToPage(int page)
    {
        await this.Previews.GoToPdfPage(this.host, page);
    }

    private async Task Search(PreviewSearch search)
    {
        await this.Previews.FindInPdf(this.host, search.Query, search.Find);
    }
}
