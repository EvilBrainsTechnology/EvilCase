<button type="@(this.Submit ? "submit" : "button")" class="@this.CssClass" disabled="@this.Disabled"
        aria-label="@this.AriaLabel" @onclick="this.OnClick">
    @if (this.Icon.Length > 0)
    {
        <EcIcon Paths="@this.Icon" />
    }
    @this.ChildContent
</button>

@code {
    [Parameter, EditorRequired]
    public required EcButtonVariant Variant { get; set; }

    [Parameter]
    public EcButtonSize Size { get; set; } = EcButtonSize.Standard;

    [Parameter]
    public string Icon { get; set; } = "";

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Submit { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string CssClass
    {
        get
        {
            var variant = this.Variant switch
            {
                EcButtonVariant.Primary => "ec-button-primary",
                EcButtonVariant.Secondary => "ec-button-secondary",
                EcButtonVariant.Ghost => "ec-button-ghost",
                EcButtonVariant.Danger => "ec-button-danger",
                _ => throw new InvalidOperationException($"unknown EcButtonVariant {this.Variant}"),
            };

            var size = this.Size switch
            {
                EcButtonSize.Compact => "ec-button-compact",
                EcButtonSize.Standard => "ec-button-standard",
                EcButtonSize.Form => "ec-button-form",
                _ => throw new InvalidOperationException($"unknown EcButtonSize {this.Size}"),
            };

            return this.ChildContent is null ? $"ec-button {variant} {size} ec-button-icon" : $"ec-button {variant} {size}";
        }
    }

    protected override void OnParametersSet()
    {
        if (this.ChildContent is null && string.IsNullOrWhiteSpace(this.AriaLabel))
            throw new InvalidOperationException("a button with no text needs an aria-label");
    }
}
