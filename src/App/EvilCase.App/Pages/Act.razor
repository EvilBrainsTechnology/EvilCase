@page "/cases/{CaseId:guid}/act/{ActId:guid}"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Files
@using TabBlazor.Services
@inject IActsClient ActsClient
@inject IActCommentsClient ActCommentsClient
@inject IActFilesClient ActFilesClient
@inject IFileTransferClient FileTransfer
@inject IFileDownloader Downloader
@inject IModalService ModalService
@inject NavigationManager Navigation
@inject ILogger<Act> Logger

<PageTitle>@(this.act is null ? "Úkon" : this.act.ActNumber) – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">
                    @if (this.act is not null)
                    {
                        <a href="@($"/cases/{this.act.CaseId}")">@this.act.CaseNumber</a>
                    }
                    else
                    {
                        @:Spis
                    }
                </div>
                <h2 class="page-title">
                    @(this.act?.Title)
                    @if (this.act is { Direction: not null })
                    {
                        <span class="ms-2">
                            <Status BackgroundColor="ActDirectionDisplay.Color(this.act.Direction)" Lite="true">@ActDirectionDisplay.Text(this.act.Direction)</Status>
                        </span>
                    }
                </h2>
            </div>
            @if (this.act is not null)
            {
                <div class="col-auto ms-auto d-print-none">
                    <a id="act-edit" href="@($"/cases/{this.act.CaseId}/act/{this.act.ActId}/edit")" class="btn btn-primary"><Icon CssClass="icon" IconType="AppIcons.Pencil" />Upravit</a>
                    <button id="act-delete" type="button" class="btn btn-danger ms-2" @onclick="this.DeleteAct"><Icon CssClass="icon" IconType="AppIcons.Trash" />Smazat</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <LoadStateView NotFound="this.notFound" NotFoundTitle="Úkon nenalezen" Failure="@this.failure" FailureTitle="Úkon se nepodařilo načíst" Loaded="this.act is not null">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title"><Icon CssClass="icon me-2" IconType="AppIcons.ListDetails" />Údaje</h3>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">Číslo jednací</div>
                            <div class="datagrid-content">@this.act!.ActNumber</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Externí číslo jednací</div>
                            <div class="datagrid-content">@(string.IsNullOrWhiteSpace(this.act.ExternalActNumber) ? "—" : this.act.ExternalActNumber)</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Směr</div>
                            <div class="datagrid-content">@ActDirectionDisplay.Text(this.act.Direction)</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Datum</div>
                            <div class="datagrid-content">@DateDisplay.Text(this.act.Date)</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Kontakt</div>
                            <div class="datagrid-content">
                                @if (this.act.Contact is { } contact)
                                {
                                    <a href="/contacts/@contact.ContactId">@contact.Name</a>
                                }
                                else
                                {
                                    @:—
                                }
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Popis</div>
                            <div class="datagrid-content">@(string.IsNullOrWhiteSpace(this.act.Description) ? "—" : this.act.Description)</div>
                        </div>
                    </div>

                    @if (ActContactRules.DifferingCaseContact(this.act.Contact, this.act.CaseContact) is { } differing)
                    {
                        <div class="alert alert-warning mt-3 mb-0" role="alert">
                            <Icon CssClass="icon me-2" IconType="AppIcons.AlertTriangle" />Kontakt úkonu se liší od kontaktu spisu (@differing.Name).
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <CommentsCard @key="this.ActId"
                              LoadComments="this.LoadComments"
                              AddComment="this.AddComment"
                              SaveComment="this.SaveComment"
                              DeleteComment="this.DeleteComment" />
            </div>

            <div class="mt-3">
                <FilesCard @key="this.ActId"
                           OwnerGoneError="úkon už neexistuje."
                           LoadFiles="this.LoadFiles"
                           UploadFile="this.UploadFile"
                           DownloadFile="this.DownloadFile"
                           DeleteFile="this.DeleteFile" />
            </div>
        </LoadStateView>
    </div>
</div>

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    [Parameter]
    public Guid ActId { get; set; }

    private ActDetail? act;

    private bool notFound;

    private string? failure;

    protected override Task OnParametersSetAsync()
    {
        return this.LoadAct();
    }

    private async Task LoadAct()
    {
        this.act = null;
        this.notFound = false;
        this.failure = null;

        try
        {
            this.act = await this.ActsClient.GetAct(this.CaseId, this.ActId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the act detail failed");

            this.failure = "Úkon se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task<IReadOnlyList<FileListItem>> LoadFiles(CancellationToken token)
    {
        return (await this.ActFilesClient.ListActFiles(this.CaseId, this.ActId, token)).Items;
    }

    private Task UploadFile(IBrowserFile file, CancellationToken token)
    {
        return this.FileTransfer.UploadActFile(this.CaseId, this.ActId, file, token);
    }

    private async Task DownloadFile(FileListItem file, CancellationToken token)
    {
        var content = await this.FileTransfer.DownloadFileContent(file.FileId, token);
        await this.Downloader.SaveFile(file.FileName, content, token);
    }

    private Task DeleteFile(FileListItem file, CancellationToken token)
    {
        return this.ActFilesClient.DeleteActFile(this.CaseId, this.ActId, file.FileId, token);
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.ActCommentsClient.ListActComments(this.CaseId, this.ActId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.AddActComment(this.CaseId, this.ActId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.EditActComment(this.CaseId, this.ActId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.ActCommentsClient.DeleteActComment(this.CaseId, this.ActId, commentId, token);
    }

    private async Task DeleteAct()
    {
        if (this.act is null)
            return;

        await this.ModalService.ShowAsync(
            "Smazat úkon",
            new RenderComponent<ActDeleteModal>()
                .Set(component => component.Act, this.act)
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, () => this.Navigation.NavigateTo($"/cases/{this.CaseId}"))),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
