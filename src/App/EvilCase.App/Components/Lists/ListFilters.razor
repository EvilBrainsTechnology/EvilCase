@using EvilBrains.EvilCase.Api.Contract.Labels

<EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Filter"
          AriaLabel="@(this.ActiveCount > 0 ? $"Filtry {this.ActiveCount}" : "Filtry")"
          aria-expanded="@(this.open ? "true" : "false")" aria-controls="@($"{this.InputPrefix}-filters")"
          OnClick="this.Toggle">
    <span class="ec-text-wide">Filtry</span>
    @if (this.ActiveCount > 0)
    {
        <span class="ec-filter-count">@this.ActiveCount</span>
    }
</EcButton>

@if (this.open)
{
    @* Below lg the panel is a sheet at the bottom edge with its own title, the switches of the toolbar and a close. *@
    <div class="ec-filter-backdrop" @onclick="this.Close"></div>
    <div id="@($"{this.InputPrefix}-filters")" class="ec-filter-panel">
        <h2 class="ec-filter-sheet-title">Filtry</h2>
        @if (this.ShowDates)
        {
            <div class="ec-filter-field">
                <label class="ec-filter-name" for="@($"{this.InputPrefix}-from")">@this.FromLabel</label>
                <input id="@($"{this.InputPrefix}-from")" type="date" class="ec-input ec-filter-date"
                       value="@this.From?.ToString("yyyy-MM-dd")" @onchange="args => this.FromChanged.InvokeAsync(args)" />
            </div>
            <div class="ec-filter-field">
                <label class="ec-filter-name" for="@($"{this.InputPrefix}-to")">@this.ToLabel</label>
                <input id="@($"{this.InputPrefix}-to")" type="date" class="ec-input ec-filter-date"
                       value="@this.To?.ToString("yyyy-MM-dd")" @onchange="args => this.ToChanged.InvokeAsync(args)" />
            </div>
        }
        @if (this.ShowLabelFilter)
        {
            <div class="ec-filter-field ec-filter-field-grow">
                <label class="ec-filter-name" for="@($"{this.InputPrefix}-labels")">Štítek</label>
                <LabelField AllowCreate="false" InputId="@($"{this.InputPrefix}-labels")" Selected="this.SelectedLabels" SelectedChanged="this.LabelsChanged" />
            </div>
        }
        @if (this.ChildContent is not null)
        {
            <div class="ec-filter-sheet-switches">@this.ChildContent</div>
        }
        @if (this.ActiveCount > 0)
        {
            <button type="button" class="ec-filter-clear" @onclick="() => this.Cleared.InvokeAsync()">Zrušit filtry</button>
        }
        <div class="ec-filter-sheet-footer">
            <EcButton Variant="EcButtonVariant.Primary" OnClick="this.Close">@this.ShowText</EcButton>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Prefixes the ids of the panel and its inputs, as the list's toolbar does.
    /// </summary>
    [Parameter, EditorRequired]
    public required string InputPrefix { get; set; }

    [Parameter]
    public bool ShowDates { get; set; }

    [Parameter]
    public bool ShowLabelFilter { get; set; }

    [Parameter]
    public string FromLabel { get; set; } = "Od";

    [Parameter]
    public string ToLabel { get; set; } = "Do";

    [Parameter]
    public DateOnly? From { get; set; }

    [Parameter]
    public DateOnly? To { get; set; }

    [Parameter]
    public IReadOnlyList<LabelItem> SelectedLabels { get; set; } = [];

    /// <summary>
    /// The count on the button; no badge at zero.
    /// </summary>
    [Parameter]
    public int ActiveCount { get; set; }

    /// <summary>
    /// The close of the sheet below lg, naming what the filters leave, e.g. „Zobrazit 7 spisů".
    /// </summary>
    [Parameter, EditorRequired]
    public required string ShowText { get; set; }

    /// <summary>
    /// The toolbar's switches, repeated in the sheet below lg, where the toolbar does not show them.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> FromChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> ToChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<LabelItem>> LabelsChanged { get; set; }

    [Parameter]
    public EventCallback Cleared { get; set; }

    private bool open;

    private void Toggle()
    {
        this.open = !this.open;
    }

    private void Close()
    {
        this.open = false;
    }
}
