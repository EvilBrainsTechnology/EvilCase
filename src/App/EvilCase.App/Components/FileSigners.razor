@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Files
@inject IFileSignersClient SignersClient
@inject ILogger<FileSigners> Logger
@implements IDisposable

@if (this.Detached)
{
    <div class="ec-preview-stage ec-preview-stage-text">
        <article class="ec-preview-email ec-preview-signature" role="document" tabindex="0" aria-label="Podpis @this.FileName">
            <div class="ec-preview-signature-head">
                <EcBadge Text="Samostatný podpis" Tone="EcBadgeTone.Signature" />
                <h3 class="ec-preview-signature-title">Podpis souboru @FileTypeDisplay.SignedContentName(this.FileName)</h3>
            </div>
            @if (this.signedFile is { } signed)
            {
                <section class="ec-preview-signature-file-section" aria-label="Podepsaný soubor">
                    <h4 class="ec-preview-signature-count">Podepsaný soubor</h4>
                    <button type="button" class="ec-preview-signature-file" @onclick="() => this.OnOpenFile.InvokeAsync(signed.FileId)">
                        <EcFileIcon FileName="@signed.FileName" />
                        <span class="ec-preview-signature-file-name">@signed.FileName</span>
                        <span class="ec-preview-signature-file-size">@FileSizeDisplay.Text(signed.SizeBytes)</span>
                        <span class="ec-preview-signature-file-open">Otevřít<EcIcon Paths="@AppIcons.ChevronRight" /></span>
                    </button>
                </section>
            }
            else if (this.signedFileProblem is { } pairing)
            {
                <section class="ec-preview-signature-file-section" aria-label="Podepsaný soubor">
                    <h4 class="ec-preview-signature-count">Podepsaný soubor</h4>
                    <p class="ec-preview-signers-status">@FileSignerDisplay.SignedFileProblem(pairing, this.FileName)</p>
                </section>
            }
            <section class="ec-preview-signature-signers" aria-label="Podpisy">
                @if (this.loading)
                {
                    <p class="ec-preview-signers-status">Načítám podpisy…</p>
                }
                else if (this.problem is { } readProblem)
                {
                    <p class="ec-preview-signers-status">@FileSignerDisplay.Problem(readProblem)</p>
                }
                else if (this.signers is null)
                {
                    <div class="ec-preview-signers-status">
                        <span>Podpisy se nepodařilo načíst.</span>
                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh" OnClick="this.Load">Zkusit znovu</EcButton>
                    </div>
                }
                else
                {
                    <h4 class="ec-preview-signature-count">Podpisy (@this.signers.Count)</h4>
                    @if (this.signers.Count == 0)
                    {
                        <p class="ec-preview-signers-status">Soubor nenese žádný podpis.</p>
                    }
                    else
                    {
                        <ul class="ec-preview-signature-list">
                            @foreach (var signer in this.signers)
                            {
                                <li class="ec-preview-signature-signer">
                                    <div class="ec-preview-signature-signer-head">
                                        <FileSignerBadge State="signer.State" Verifying="this.verifying" />
                                        <span class="ec-preview-signature-name">@FileSignerDisplay.Name(signer)</span>
                                    </div>
                                    <dl class="ec-preview-signature-details">
                                        <dt>Druh</dt>
                                        <dd>@FileSignerDisplay.Kind(signer.Kind)</dd>
                                        <dt>Certifikát</dt>
                                        <dd>@FileSignerDisplay.Certificate(signer)</dd>
                                        @if (signer.Timestamped is { } timestamped)
                                        {
                                            <dt>Časové razítko</dt>
                                            <dd>@MomentDisplay.Text(timestamped)</dd>
                                        }
                                        else if (signer.SigningTime is { } signingTime)
                                        {
                                            <dt>Čas podpisu</dt>
                                            <dd>@MomentDisplay.Text(signingTime) <span class="ec-preview-signature-note">· bez časového razítka, uvádí ho podepisující</span></dd>
                                        }
                                        else
                                        {
                                            <dt>Čas podpisu</dt>
                                            <dd>neuveden <span class="ec-preview-signature-note">· bez časového razítka</span></dd>
                                        }
                                        @if (signer is { State: FileSignatureState.Valid, RevocationChecked: { } checkedAt })
                                        {
                                            <dt>Odvolání</dt>
                                            <dd>neodvolán, ověřeno @MomentDisplay.Text(checkedAt)</dd>
                                        }
                                    </dl>
                                    @if (!this.verifying && signer.State is not FileSignatureState.Valid)
                                    {
                                        <div class="ec-preview-signature-problem">
                                            @if (signer is { State: FileSignatureState.Invalid, Problem: { } invalid })
                                            {
                                                <p class="ec-signature-reason">@FileSignerDisplay.ProblemTitle(invalid, this.FileName, signer)</p>
                                            }
                                            else
                                            {
                                                <p class="ec-signature-title">
                                                    @(signer.Problem is { } problem
                                                        ? FileSignerDisplay.ProblemTitle(problem, this.FileName, signer)
                                                        : "Výsledek ověření podpisu se nepodařilo načíst.")
                                                </p>
                                                @if (signer.Problem is { } noted && FileSignerDisplay.ProblemNote(noted, this.FileName) is { } note)
                                                {
                                                    <p class="ec-signature-note">@note</p>
                                                }
                                                @if (signer.Problem is null or FileSignerProblem.RevocationUnknown)
                                                {
                                                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh" OnClick="this.Verify">Zkusit znovu</EcButton>
                                                }
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            </section>
        </article>
    </div>
}
else if (this.SignedFileId is null || this.LoadFailed || (this.signers is not null && this.signedFile?.FileId == this.SignedFileId))
{
    <section class="ec-preview-signers" aria-label="Podpisy">
        @if (this.SignedFileId is not null)
        {
            <div class="ec-preview-signers-source">
                <span>Podepsáno samostatným podpisem</span>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.FileTypeSignature" OnClick="() => this.OnOpenFile.InvokeAsync(this.FileId)">@this.FileName</EcButton>
            </div>
        }
        @if (this.loading)
        {
            <p class="ec-preview-signers-status">Načítám podpisy…</p>
        }
        else if (this.problem is { } readProblem)
        {
            <p class="ec-preview-signers-status">@FileSignerDisplay.Problem(readProblem)</p>
        }
        else if (this.signers is null)
        {
            <div class="ec-preview-signers-status">
                <span>Podpisy se nepodařilo načíst.</span>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh" OnClick="this.Load">Zkusit znovu</EcButton>
            </div>
        }
        else if (this.signers.Count == 0)
        {
            <p class="ec-preview-signers-status">Soubor nenese žádný podpis.</p>
        }
        else
        {
            <ul class="ec-preview-signers-list">
                @foreach (var signer in this.signers)
                {
                    <li class="ec-preview-signer">
                        <FileSignerVerdict Signer="signer" Verifying="this.verifying" SignatureFileName="@this.FileName" OnRetry="this.Verify" />
                        <span class="ec-preview-signer-name">@FileSignerDisplay.Name(signer)</span>
                        <span class="ec-preview-signer-summary">@FileSignerDisplay.Summary(signer)</span>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private readonly CancellationTokenSource disposed = new();

    private IReadOnlyList<FileSigner>? signers;

    private FileSignersProblem? problem;

    private bool loading = true;

    private FileListItem? signedFile;

    private DetachedSignatureProblem? signedFileProblem;

    private bool verifying;

    /// <summary>
    /// The stored signed file whose signers the server reads.
    /// </summary>
    [Parameter, EditorRequired]
    public required Guid FileId { get; set; }

    [Parameter, EditorRequired]
    public required string FileName { get; set; }

    /// <summary>
    /// The version of the stored file; null is the current one.
    /// </summary>
    [Parameter]
    public int? Version { get; set; }

    /// <summary>
    /// Shows the signature card in the stage instead of the strip above the document.
    /// </summary>
    [Parameter]
    public bool Detached { get; set; }

    /// <summary>
    /// For the strip above a file this detached signature signs: that file; the strip shows where the server pairs them or
    /// the signers fail to load.
    /// </summary>
    [Parameter]
    public Guid? SignedFileId { get; set; }

    /// <summary>
    /// Shows another stored file of the same list in the preview.
    /// </summary>
    [Parameter]
    public EventCallback<Guid> OnOpenFile { get; set; }

    private bool LoadFailed => !this.loading && this.problem is null && this.signers is null;

    protected override async Task OnInitializedAsync()
    {
        await this.Load();
    }

    public void Dispose()
    {
        if (this.disposed.IsCancellationRequested)
            return;

        this.disposed.Cancel();
        this.disposed.Dispose();
    }

    private async Task Load()
    {
        this.loading = true;
        this.signers = null;
        this.problem = null;
        this.signedFile = null;
        this.signedFileProblem = null;
        this.verifying = false;

        try
        {
            this.Show(await this.SignersClient.ListFileSigners(this.FileId, version: this.Version, this.disposed.Token));
        }
        catch (OperationCanceledException) when (this.disposed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the signers of file {FileAssetId} failed", this.FileId);
        }

        this.loading = false;
        this.verifying = this.signers is { Count: > 0 } && (this.SignedFileId is null || this.signedFile?.FileId == this.SignedFileId);

        if (this.verifying)
        {
            this.StateHasChanged();
            await this.Verify();
        }
    }

    private async Task Verify()
    {
        this.verifying = true;

        try
        {
            this.Show(await this.SignersClient.VerifyFileSigners(this.FileId, version: this.Version, this.disposed.Token));
        }
        catch (OperationCanceledException) when (this.disposed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Verifying the signers of file {FileAssetId} failed", this.FileId);
        }

        this.verifying = false;
    }

    private void Show(FileSignersResponse response)
    {
        if (response.Problem is { } readProblem)
            (this.problem, this.signers) = (readProblem, null);
        else
            this.signers = response.Signers;

        this.signedFile = response.SignedFile;
        this.signedFileProblem = response.SignedFileProblem;
    }
}
