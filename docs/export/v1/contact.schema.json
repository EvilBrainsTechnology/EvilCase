{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvilCase export v1, a contact in Kontakty",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "contactId", "kind", "name", "dataBoxId", "address", "created", "updated", "path"],
  "properties": {
    "type": { "enum": ["contact"] },
    "contactId": { "$ref": "common.schema.json#/definitions/id" },
    "kind": { "enum": ["Authority", "Official", "Person"] },
    "name": { "type": "string" },
    "dataBoxId": { "$ref": "common.schema.json#/definitions/optionalText" },
    "address": { "$ref": "common.schema.json#/definitions/optionalText" },
    "created": { "$ref": "common.schema.json#/definitions/moment" },
    "updated": { "$ref": "common.schema.json#/definitions/optionalMoment" },
    "path": { "description": "The contact's document in the archive.", "type": "string" }
  }
}
