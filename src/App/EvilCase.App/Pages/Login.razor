@page "/login"
@using System.Diagnostics
@layout LoginLayout
@inject IAuthSession Session
@inject NavigationManager Navigation

<PageTitle>Přihlášení – EvilCase</PageTitle>

<div class="ec-login">
    <aside class="ec-login-panel">
        <div class="ec-brand">
            <span class="ec-brand-mark"><EcIcon Paths="@AppIcons.Scale" /></span>
            EvilCase
        </div>
        <div class="ec-login-claim">
            <h1 class="ec-login-claim-title">Spis, který v každém okamžiku odpoví, co se stalo a co v něm je.</h1>
            <p class="ec-login-claim-text">Správní a soudní řízení na jednom místě: spisy a podřízené spisy, úkony se směrem a kontaktem, dokumenty, komentáře.</p>
        </div>
        <div class="ec-login-facts">
            <span>Česky · datum d. M. yyyy</span>
            <span>Samostatná instalace</span>
        </div>
    </aside>

    <div class="ec-login-side">
        <EditForm class="ec-login-form" Model="this.model" OnValidSubmit="this.SignIn">
            <DataAnnotationsValidator />

            <div class="ec-login-heading">
                <h2 class="ec-login-title">Přihlášení</h2>
                <p class="ec-login-subtitle">Účty zakládá správce, registrace není otevřená.</p>
            </div>

            <EcField Label="E-mail" ControlId="login-email">
                <ChildContent>
                    <InputText id="login-email" class="ec-input" type="email" inputmode="email"
                               autocomplete="username" autofocus placeholder="jmeno@example.cz"
                               @bind-Value="this.model.Email" />
                </ChildContent>
                <Error><ValidationMessage For="() => this.model.Email" /></Error>
            </EcField>

            <EcField Label="Heslo" ControlId="login-password">
                <ChildContent>
                    <InputText id="login-password" class="ec-input" type="password"
                               autocomplete="current-password" placeholder="••••••••"
                               @bind-Value="this.model.Password" />
                </ChildContent>
                <Error><ValidationMessage For="() => this.model.Password" /></Error>
            </EcField>

            @if (this.error is not null)
            {
                <div class="ec-alert" role="alert">
                    <EcIcon Paths="@AppIcons.AlertTriangle" Size="EcIconSize.Large" />
                    <p class="ec-alert-text">@this.error</p>
                </div>
            }

            <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Form" Icon="@AppIcons.Login"
                      Submit Disabled="@this.busy">Přihlásit se</EcButton>

            <p class="ec-login-note">Po přihlášení vás aplikace vrátí tam, odkud jste přišel.</p>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = RedirectToLogin.ReturnUrlParameter)]
    public string? ReturnUrl { get; set; }

    private readonly SignInModel model = new();

    private string? error;

    private bool busy;

    private async Task SignIn()
    {
        this.busy = true;
        this.error = null;

        try
        {
            var outcome = await this.Session.SignIn(this.model.Email, this.model.Password, CancellationToken.None);

            if (outcome == SignInOutcome.Success)
            {
                this.Navigation.NavigateTo(this.SafeReturnUrl(), replace: true);

                return;
            }

            this.error = Describe(outcome);
        }
        finally
        {
            this.busy = false;
        }
    }

    private static string Describe(SignInOutcome outcome)
    {
        return outcome switch
        {
            SignInOutcome.InvalidCredentials => "Nesprávný e-mail nebo heslo.",
            SignInOutcome.LockedOut => "Účet je dočasně zablokován po několika neúspěšných pokusech. Zkuste to za chvíli znovu.",
            SignInOutcome.TooManyAttempts => "Příliš mnoho pokusů o přihlášení. Zkuste to za chvíli znovu.",
            SignInOutcome.Unreachable => "Server je nedostupný. Zkontrolujte připojení a zkuste to znovu.",
            _ => throw new UnreachableException(),
        };
    }

    // A single leading slash and no second one: "//evil.example" is a protocol-relative absolute URL.
    private string SafeReturnUrl()
    {
        return this.ReturnUrl is { } target && target.StartsWith('/') && !target.StartsWith("//", StringComparison.Ordinal)
            ? target
            : "/";
    }
}
