<header class="ec-page-header">
    @if (this.Parent is { } parent)
    {
        @* Below lg one link back to the parent stands in for the crumbs. *@
        <a class="ec-page-back" href="@parent.Href" title="@parent.Text"><EcIcon Paths="@AppIcons.ChevronLeft" /><span class="ec-page-back-text">@parent.Text</span></a>
    }
    @if (this.Breadcrumbs.Count > 0)
    {
        <nav class="ec-crumbs" aria-label="Drobečková navigace">
            @for (var index = 0; index < this.Breadcrumbs.Count; index++)
            {
                var crumb = this.Breadcrumbs[index];

                if (index > 0)
                {
                    <span class="ec-crumb-separator" aria-hidden="true">/</span>
                }

                if (crumb.Href is null)
                {
                    <span class="ec-crumb" aria-current="page" title="@crumb.Text">@crumb.Text</span>
                }
                else
                {
                    <a class="ec-crumb" href="@crumb.Href" title="@crumb.Text">@crumb.Text</a>
                }
            }
        </nav>
    }
    <div class="ec-page-header-row">
        <h1 class="ec-page-title">@this.Title</h1>
        @this.Status
        @if (this.Actions is not null)
        {
            <div class="ec-page-actions">@this.Actions</div>
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public IReadOnlyList<EcCrumb> Breadcrumbs { get; set; } = [];

    [Parameter]
    public RenderFragment? Status { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private EcCrumb? Parent => this.Breadcrumbs.LastOrDefault(static crumb => crumb.Href is not null);
}
