{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Seq" ],
        "MinimumLevel": {
            "Override": {
                "EvilBrains": "Debug"
            }
        },
        "WriteTo": {
            "1": {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "https://seq.vdolek.cz",
                    "apiKey": null
                }
            }
        },
        "Properties": {
            "Environment": "Development"
        }
    },

    "AllowedHosts": "*"
}
