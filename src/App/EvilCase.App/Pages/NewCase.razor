@page "/cases/new"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Labels
@inject ICasesClient CasesClient
@inject NavigationManager Navigation
@inject ILogger<NewCase> Logger

<PageTitle>@this.Heading – EvilCase</PageTitle>

<div class="ec-page">
    <EcPageHeader Title="@this.Heading" Breadcrumbs="this.Crumbs" />

    @if (this.parentNotFound)
    {
        <EcCard><p class="ec-state">Nadřízený spis nenalezen.</p></EcCard>
    }
    else if (this.failure is not null)
    {
        <EcCard><p class="ec-state">@this.failure</p></EcCard>
    }
    else
    {
        <div class="ec-form-layout">
            <CascadingValue Value="this.editContext">
                <DataAnnotationsValidator />
                <EcCard>
                    <ChildContent>
                        <div class="ec-form">
                            <EcField Label="Název spisu" Required ControlId="case-title" Hint="Nejvýše 256 znaků">
                                <ChildContent>
                                    <InputText id="case-title" class="ec-input" autofocus @bind-Value="this.model.Title" />
                                </ChildContent>
                                <Error><ValidationMessage For="() => this.model.Title" /></Error>
                            </EcField>

                            <div class="ec-form-row">
                                <EcField Label="Datum spisu" Required ControlId="case-date">
                                    <ChildContent>
                                        <InputDate id="case-date" class="ec-input" @bind-Value="this.model.Date" />
                                    </ChildContent>
                                    <Error><ValidationMessage For="() => this.model.Date" /></Error>
                                </EcField>
                            </div>

                            <EcField Label="Štítky" ControlId="case-labels">
                                <ChildContent>
                                    <LabelField InputId="case-labels" Selected="this.model.Labels" SelectedChanged="this.OnLabelsChanged" />
                                </ChildContent>
                            </EcField>

                            <EcField Label="Kontakt protistrany" ControlId="case-contact">
                                <ChildContent>
                                    <ContactField InputId="case-contact" Selected="this.model.Contact" SelectedChanged="this.OnContactChanged" />
                                </ChildContent>
                            </EcField>

                            <EcField Label="Popis" ControlId="case-description" Hint="Nejvýše 4000 znaků. Popis se ukazuje hned pod názvem spisu.">
                                <ChildContent>
                                    <InputTextArea id="case-description" class="ec-textarea" rows="6" @bind-Value="this.model.Description" />
                                </ChildContent>
                                <Error><ValidationMessage For="() => this.model.Description" /></Error>
                            </EcField>

                            @if (this.error is not null)
                            {
                                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
                            }
                        </div>
                    </ChildContent>
                    <Footer>
                        <span class="ec-form-note">Spisovou značku přidělí aplikace při uložení.</span>
                        <div class="ec-form-actions">
                            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Form" Icon="@AppIcons.X" OnClick="this.Cancel">Zrušit</EcButton>
                            <EcButton Variant="EcButtonVariant.Primary" Size="EcButtonSize.Form" Icon="@AppIcons.Check" Disabled="@this.busy" OnClick="this.SubmitCase">Založit spis</EcButton>
                        </div>
                    </Footer>
                </EcCard>
            </CascadingValue>

            <aside class="ec-form-aside">
                @if (this.parentCase is not null)
                {
                    <EcCard Title="Nadřízený spis">
                        <a class="ec-parent-link" href="/cases/@this.parentCase.CaseId">
                            <span>@this.parentCase.Title</span>
                            <span class="ec-parent-number">@this.parentCase.CaseNumber</span>
                        </a>
                        <p class="ec-card-text">Zakládáte podřízený spis. Přiřadit ho jinam jde až v editaci spisu.</p>
                    </EcCard>
                }
                <EcCard Title="Co přijde po uložení">
                    <p class="ec-card-text">Spis se otevře na svém detailu, kde rovnou přidáte první úkon a jeho dokumenty. Soubory a komentáře spisu jsou v pravém sloupci detailu.</p>
                </EcCard>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentCaseId { get; set; }

    private readonly NewCaseModel model = new() { Date = DateOnly.FromDateTime(DateTime.Now) };

    private EditContext editContext = null!;

    private CaseDetail? parentCase;

    private bool parentNotFound;

    private string? failure;

    private string? error;

    private bool busy;

    private string Heading => this.ParentCaseId is null ? "Nový spis" : "Nový podřízený spis";

    private IReadOnlyList<EcCrumb> Crumbs => [new EcCrumb("Spisy", "/cases"), new EcCrumb(this.Heading, null)];

    protected override void OnInitialized()
    {
        this.editContext = new EditContext(this.model);
    }

    protected override async Task OnParametersSetAsync()
    {
        this.parentCase = null;
        this.parentNotFound = false;
        this.failure = null;

        if (this.ParentCaseId is not { } parentCaseId)
            return;

        try
        {
            this.parentCase = await this.CasesClient.GetCase(parentCaseId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.parentNotFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the parent case failed");

            this.failure = "Nadřízený spis se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void OnLabelsChanged(IReadOnlyList<LabelItem> labels)
    {
        this.model.Labels = labels;
    }

    private void OnContactChanged(ContactListItem? contact)
    {
        this.model.Contact = contact;
    }

    private void Cancel()
    {
        this.Navigation.NavigateTo(this.ParentCaseId is { } parentId ? $"/cases/{parentId}" : "/cases");
    }

    private async Task SubmitCase()
    {
        if (!this.editContext.Validate())
            return;

        this.busy = true;
        this.error = null;

        try
        {
            var request = new CreateCaseRequest
            {
                ParentCaseId = this.ParentCaseId,
                Date = this.model.Date,
                Title = this.model.Title,
                Description = this.model.Description,
                ContactId = this.model.Contact?.ContactId,
                LabelIds = [.. this.model.Labels.Select(static label => label.LabelId)],
            };

            _ = await this.CasesClient.CreateCase(request, CancellationToken.None);

            this.Navigation.NavigateTo(this.ParentCaseId is { } parent ? $"/cases/{parent}" : "/cases");
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            this.error = "Nadřízený spis neexistuje.";
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Filing a new case failed");

            this.error = "Spis se nepodařilo založit. Zkontrolujte zadané údaje a zkuste to znovu.";
        }
        finally
        {
            this.busy = false;
        }
    }
}
