@page "/cases/{CaseId:guid}/act/{ActId:guid}"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Comments
@using EvilBrains.EvilCase.Api.Contract.Files
@using EvilBrains.EvilCase.Api.Contract.Labels
@using TabBlazor.Services
@inject IActsClient ActsClient
@inject IActLabelsClient ActLabelsClient
@inject IActCommentsClient ActCommentsClient
@inject IActFilesClient ActFilesClient
@inject IFileTransferClient FileTransfer
@inject IFileDownloader Downloader
@inject IModalService ModalService
@inject NavigationManager Navigation
@inject ILogger<Act> Logger

<PageTitle>@(this.act is null ? "Úkon" : this.act.ActNumber) – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center ec-detail-header">
            <div class="col">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/cases">Spisy</a></li>
                        @if (this.act is not null)
                        {
                            <li class="breadcrumb-item"><a href="@($"/cases/{this.act!.CaseId}")">@this.act!.CaseTitle</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@this.act!.Title</li>
                        }
                    </ol>
                </nav>

                @if (this.act is not null)
                {
                    <h2 class="page-title">
                        @this.act!.Title
                        @if (this.act!.Direction is not null)
                        {
                            <span class="ms-2">
                                <Status BackgroundColor="ActDirectionDisplay.Color(this.act!.Direction)" Lite="true">@ActDirectionDisplay.Text(this.act!.Direction)</Status>
                            </span>
                        }
                    </h2>
                }
            </div>
            @if (this.act is not null)
            {
                <div class="col-auto ms-auto d-print-none">
                    <a id="act-edit" href="@($"/cases/{this.act!.CaseId}/act/{this.act!.ActId}/edit")" class="btn btn-primary"><Icon CssClass="icon" IconType="TablerIcons.Pencil" />Upravit</a>
                    <button id="act-delete" type="button" class="btn btn-danger ms-2" @onclick="this.DeleteAct"><Icon CssClass="icon" IconType="TablerIcons.Trash" />Smazat</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <LoadStateView NotFound="this.notFound" NotFoundTitle="Úkon nenalezen" Failure="@this.failure" FailureTitle="Úkon se nepodařilo načíst" Loaded="this.act is not null">
                <div class="ec-layout">
                    <div class="ec-main">
                        @{
                            var differing = ActContactRules.DifferingCaseContact(this.act!.Contact, this.act!.CaseContact);
                        }
                        @if (differing is not null)
                        {
                            <div class="alert alert-warning mb-0" role="alert">
                                <Icon CssClass="icon me-2" IconType="TablerIcons.AlertTriangle" />Kontakt úkonu se liší od kontaktu spisu (@differing.Name).
                            </div>
                        }

                        <div class="card">
                            <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.FileText" />Popis</h3></div>
                            <div class="card-body">
                                <p class="comment-body mb-0">@(string.IsNullOrWhiteSpace(this.act!.Description) ? "—" : this.act!.Description)</p>
                            </div>
                        </div>

                        <FilesCard @key="(nameof(FilesCard), this.ActId)"
                                   Title="Soubory úkonu"
                                   OwnerGoneError="úkon už neexistuje."
                                   LoadFiles="this.LoadFiles"
                                   UploadFile="this.UploadFile"
                                   DownloadFile="this.DownloadFile"
                                   DeleteFile="this.DeleteFile" />

                        <CommentsCard @key="(nameof(CommentsCard), this.ActId)"
                                      Title="Komentáře úkonu"
                                      Placeholder="Poznámka k tomuto úkonu…"
                                      LoadComments="this.LoadComments"
                                      AddComment="this.AddComment"
                                      SaveComment="this.SaveComment"
                                      DeleteComment="this.DeleteComment" />
                    </div>

                    <aside class="ec-sidebar d-flex flex-column gap-3">
                        <div class="card">
                            <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.ListDetails" />Údaje</h3></div>
                            <div class="card-body d-flex flex-column gap-3">
                                <div>
                                    <div class="ec-field-label">Číslo jednací</div>
                                    <div class="ec-mono fw-bold">@this.act!.ActNumber</div>
                                </div>
                                <div>
                                    <div class="ec-field-label">Externí číslo jednací</div>
                                    <div class="ec-mono">@(string.IsNullOrWhiteSpace(this.act!.ExternalActNumber) ? "—" : this.act!.ExternalActNumber)</div>
                                </div>
                                <div>
                                    <div class="ec-field-label">Datum úkonu</div>
                                    <div class="ec-num">@DateDisplay.Text(this.act!.Date)</div>
                                </div>
                                <div>
                                    <div class="ec-field-label">Směr</div>
                                    <div>
                                        @if (this.act!.Direction is not null)
                                        {
                                            <Status BackgroundColor="ActDirectionDisplay.Color(this.act!.Direction)" Lite="true">@ActDirectionDisplay.Text(this.act!.Direction)</Status>
                                        }
                                        else
                                        {
                                            @:—
                                        }
                                    </div>
                                </div>
                                <div>
                                    <div class="ec-field-label">Kontakt</div>
                                    <div>
                                        @if (this.act!.Contact is { } contact)
                                        {
                                            <a href="/contacts/@contact.ContactId">@contact.Name</a>
                                        }
                                        else
                                        {
                                            @:—
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <LabelsCard InputId="act-labels"
                                    Labels="this.act!.Labels"
                                    SaveLabels="this.SaveLabels"
                                    OwnerGoneError="Úkon už neexistuje." />

                        <div class="card">
                            <div class="card-header"><h3 class="card-title"><Icon CssClass="icon me-2" IconType="TablerIcons.Folders" />Spis</h3></div>
                            <div class="card-body">
                                <a class="ec-comprow" href="@($"/cases/{this.act!.CaseId}")">
                                    <span class="ec-min-w-0 flex-fill">
                                        <span class="d-block ec-comprow-title">@this.act!.CaseTitle</span>
                                        <span class="ec-comprow-meta">
                                            <span class="ec-num">@DateDisplay.Text(this.act!.CaseDate)</span> ·
                                            <Status BackgroundColor="CaseStatusDisplay.Color(this.act!.CaseStatus)" Lite="true">@CaseStatusDisplay.Text(this.act!.CaseStatus)</Status>
                                        </span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>
        </LoadStateView>
    </div>
</div>

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    [Parameter]
    public Guid ActId { get; set; }

    private bool notFound;

    private string? failure;

    private ActDetail? act;

    protected override Task OnParametersSetAsync()
    {
        return this.LoadAct();
    }

    private async Task LoadAct()
    {
        this.notFound = false;
        this.failure = null;
        this.act = null;

        try
        {
            this.act = await this.ActsClient.GetAct(this.CaseId, this.ActId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the act detail failed");

            this.failure = "Úkon se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task SaveLabels(IReadOnlyList<Guid> labelIds, CancellationToken token)
    {
        await this.ActLabelsClient.SetActLabels(this.CaseId, this.ActId, new LabelAssignmentRequest { LabelIds = labelIds }, token);

        try
        {
            this.act = await this.ActsClient.GetAct(this.CaseId, this.ActId, token);

            this.StateHasChanged();
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Reloading the act after a label change failed");
        }
    }

    private async Task<IReadOnlyList<FileListItem>> LoadFiles(CancellationToken token)
    {
        return (await this.ActFilesClient.ListActFiles(this.CaseId, this.ActId, token)).Items;
    }

    private Task UploadFile(IBrowserFile file, CancellationToken token)
    {
        return this.FileTransfer.UploadActFile(this.CaseId, this.ActId, file, token);
    }

    private async Task DownloadFile(FileListItem file, CancellationToken token)
    {
        var content = await this.FileTransfer.DownloadFileContent(file.FileId, token);
        await this.Downloader.SaveFile(file.FileName, content, token);
    }

    private Task DeleteFile(FileListItem file, CancellationToken token)
    {
        return this.ActFilesClient.DeleteActFile(this.CaseId, this.ActId, file.FileId, token);
    }

    private async Task<IReadOnlyList<CommentItem>> LoadComments(CancellationToken token)
    {
        var response = await this.ActCommentsClient.ListActComments(this.CaseId, this.ActId, token);
        return response.Items;
    }

    private Task AddComment(CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.AddActComment(this.CaseId, this.ActId, request, token);
    }

    private Task SaveComment(Guid commentId, CommentEditRequest request, CancellationToken token)
    {
        return this.ActCommentsClient.EditActComment(this.CaseId, this.ActId, commentId, request, token);
    }

    private Task DeleteComment(Guid commentId, CancellationToken token)
    {
        return this.ActCommentsClient.DeleteActComment(this.CaseId, this.ActId, commentId, token);
    }

    private async Task DeleteAct()
    {
        if (this.act is null)
            return;

        await this.ModalService.ShowAsync(
            "Smazat úkon",
            new RenderComponent<ActDeleteModal>()
                .Set(component => component.Act, this.act)
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, () => this.Navigation.NavigateTo($"/cases/{this.CaseId}"))),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
