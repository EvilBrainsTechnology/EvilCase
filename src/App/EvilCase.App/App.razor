@* The router only cares about page-level [Authorize]. What makes the application closed by default is
   MainLayout: everything laid out by it is behind an AuthorizeView, so a new page cannot forget. *@
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized Context="authenticationState">
                    @if (authenticationState.User.Identity?.IsAuthenticated == true)
                    {
                        <p class="p-4">K této stránce nemáte oprávnění.</p>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <LoadingPage />
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <p>Stránka nenalezena.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
