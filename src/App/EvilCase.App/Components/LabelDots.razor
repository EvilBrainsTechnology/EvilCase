@using EvilBrains.EvilCase.Api.Contract.Labels

@* The name lives in the tooltip; the reflowed narrow row carries it in text (SDD-019). *@
@if (this.Labels.Count > 0)
{
    <span class="label-dots">
        @foreach (var label in this.Labels)
        {
            <span class="ec-dot ec-dot-@LabelColorDisplay.Css(label.Color)" role="img" title="@label.Name" aria-label="@label.Name"></span>
        }
    </span>
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<LabelItem> Labels { get; set; }
}
