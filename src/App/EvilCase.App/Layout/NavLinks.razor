@implements IDisposable
@inject NavigationManager Navigation
@inject IOffcanvasService OffcanvasService

<ul class="navbar-nav">
    <li class="nav-item @ActiveClass("/")">
        <a class="nav-link" href="/" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.LayoutDashboard" /></span>
            <span class="nav-link-title">Přehled</span>
        </a>
    </li>

    <li class="nav-item @ActiveClass("/cases")">
        <a class="nav-link" href="/cases" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.Folders" /></span>
            <span class="nav-link-title">Spisy</span>
        </a>
    </li>

    <li class="nav-item @ActiveClass("/contacts")">
        <a class="nav-link" href="/contacts" @onclick="Close">
            <span class="nav-link-icon"><Icon CssClass="icon" IconType="AppIcons.Users" /></span>
            <span class="nav-link-title">Kontakty</span>
        </a>
    </li>
</ul>

@code {
    @* Tabler draws the active indicator on the list item, which Blazor's NavLink cannot reach. *@
    private string ActiveClass(string href)
    {
        return string.Equals(this.CurrentPath, href, StringComparison.OrdinalIgnoreCase)
            || this.CurrentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
    }

    private string CurrentPath => "/" + this.Navigation.ToBaseRelativePath(this.Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    protected override void OnInitialized()
    {
        this.Navigation.LocationChanged += this.OnLocationChanged;
    }

    public void Dispose()
    {
        this.Navigation.LocationChanged -= this.OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        this.StateHasChanged();
    }

    private void Close()
    {
        this.OffcanvasService.Close();
    }
}
