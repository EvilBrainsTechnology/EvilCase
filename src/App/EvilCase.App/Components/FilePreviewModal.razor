@using System.Diagnostics
@using System.Globalization
@using System.Text
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IAuthSession Session
@inject IBlobUrls BlobUrls
@inject IFilePreviews Previews
@inject IFileDownloader Downloader
@inject ILogger<FilePreviewModal> Logger

@if (this.Current is { } file)
{
    var attachment = this.ShownAttachment;
    var shownName = attachment?.Name ?? file.FileName;
    // A signed document shows what it carries, by the name without the signature suffix or by the type its content shows.
    var stagedName = this.signedContentName ?? shownName;
    var preview = FileTypeDisplay.Preview(stagedName);
    var shownVersion = this.ShownVersionItem;

    <EcModal Title="@shownName" Large Open="this.Open" OpenChanged="this.OpenChanged">
        <Heading>
            @if (attachment is not null)
            {
                var (_, owner, ownerName, position) = this.trail[^1];

                <div class="ec-preview-back">
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ArrowLeft" AriaLabel="Zpět na zprávu" OnClick="this.BackToMessage"><span class="ec-preview-action-label">Zpráva</span></EcButton>
                </div>
                <EcFileIcon FileName="@attachment.Name" />
                <div class="ec-preview-title">
                    <h2 class="ec-preview-name" title="@attachment.Name">@attachment.Name</h2>
                    <span class="ec-preview-meta">@FileSizeDisplay.Text(attachment.Content.Length) <span class="ec-sep" aria-hidden="true">·</span> příloha zprávy @ownerName</span>
                </div>
                <div class="ec-preview-actions">
                    @if (owner.Attachments.Count > 1)
                    {
                        <nav class="ec-preview-nav" aria-label="Přílohy">
                            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronLeft" AriaLabel="Předchozí příloha"
                                      OnClick="() => this.StepAttachment(-1)" />
                            <span class="ec-preview-position">příloha <strong>@(position + 1)</strong> z @owner.Attachments.Count</span>
                            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronRight" AriaLabel="Další příloha"
                                      OnClick="() => this.StepAttachment(1)" />
                        </nav>
                        <span class="ec-preview-divider" aria-hidden="true"></span>
                    }
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="Stáhnout přílohu" OnClick="() => this.DownloadAttachment(attachment)"><span class="ec-preview-action-label">Stáhnout přílohu</span></EcButton>
                </div>
            }
            else
            {
                <EcFileIcon FileName="@file.FileName" />
                if (this.renaming)
                {
                    <FileRenameField @key="file.FileId" FileName="@file.FileName" Rename="(name, token) => this.Rename(file, name, token)"
                                     OnRenamed="this.Renamed" OnCancel="this.CancelRename" />
                }
                else
                {
                    <div class="ec-preview-title">
                        <h2 class="ec-preview-name" title="@file.FileName">@file.FileName</h2>
                        <span class="ec-preview-meta">@FileSizeDisplay.Text(shownVersion?.SizeBytes ?? file.SizeBytes) <span class="ec-sep" aria-hidden="true">·</span> @(this.signedContentName is { } documentName ? $"podepsaný dokument {documentName}" : MomentDisplay.Text(shownVersion?.Created ?? file.Created))</span>
                    </div>
                }
                <div class="ec-preview-actions">
                    @if (this.Files.Count > 1)
                    {
                        <nav class="ec-preview-nav" aria-label="Soubory">
                            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronLeft" AriaLabel="Předchozí soubor"
                                      OnClick="() => this.Step(-1)" />
                            <span class="ec-preview-position">Soubor <strong>@(this.Position + 1)</strong> z @this.Files.Count</span>
                            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.ChevronRight" AriaLabel="Další soubor"
                                      OnClick="() => this.Step(1)" />
                        </nav>
                        <span class="ec-preview-divider" aria-hidden="true"></span>
                    }
                    @if (file.VersionCount > 1)
                    {
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Clock" AriaLabel="@($"Verze, {file.VersionCount}")"
                                  aria-pressed="@(this.OlderVersion is not null || this.versionsOpen ? "true" : "false")" OnClick="this.ToggleVersions">
                            <span class="ec-preview-action-label">Verze<span class="ec-preview-versions-count">@file.VersionCount</span></span>
                        </EcButton>
                    }
                    <FileVersionPicker Text="Nová verze" Disabled="this.uploadingVersion" OnPicked="picked => this.UploadNewVersion(file, picked)" />
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" AriaLabel="Přejmenovat" OnClick="this.StartRename"><span class="ec-preview-action-label">Přejmenovat</span></EcButton>
                    @if (this.signedContentName is not null)
                    {
                        var extension = Path.GetExtension(file.FileName);

                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="Stáhnout dokument" OnClick="this.DownloadSignedContent"><span class="ec-preview-action-label">Stáhnout dokument</span></EcButton>
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="@($"Stáhnout {extension}")" OnClick="() => this.DownloadStored(file)"><span class="ec-preview-action-label">Stáhnout @extension</span></EcButton>
                    }
                    else
                    {
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Download" AriaLabel="Stáhnout" OnClick="() => this.DownloadStored(file)"><span class="ec-preview-action-label">Stáhnout</span></EcButton>
                    }
                </div>
            }
        </Heading>
        <ChildContent>
            @if (attachment is null && file.VersionCount > 1 && (this.OlderVersion is not null || this.versionsOpen))
            {
                var shown = this.OlderVersion ?? file.Version;
                var shownItem = this.versions?.FirstOrDefault(version => version.Number == shown);
                var title = $"Verze {shown} z {file.Version}" + (shownItem is null ? "" : $" · {MomentDisplay.Text(shownItem.Created)} · {shownItem.UploaderEmail}");

                <div class="@(this.OlderVersion is null ? "ec-preview-versions" : "ec-preview-versions ec-preview-versions-old")" role="group" aria-label="Verze souboru">
                    <span class="ec-preview-versions-label"><EcIcon Paths="@AppIcons.Clock" />Verze</span>
                    <EcPopover @ref="this.versionsPopover" AriaLabel="Výběr verze" PanelClass="ec-preview-versions-panel">
                        <Trigger><span class="ec-preview-versions-trigger">@title<EcIcon Paths="@AppIcons.ChevronDown" /></span></Trigger>
                        <ChildContent>
                            @if (this.versions is null)
                            {
                                <p class="ec-preview-versions-error">Verze se nepodařilo načíst.</p>
                            }
                            else
                            {
                                <ul class="ec-preview-versions-list">
                                    @foreach (var version in this.versions)
                                    {
                                        var number = version.Number;

                                        <li>
                                            <button type="button" class="ec-preview-versions-option" aria-current="@(number == shown ? "true" : null)"
                                                    @onclick="() => this.SelectVersion(file, number)">
                                                <span class="ec-preview-versions-option-title">Verze @number@(number == file.Version ? " " : "")@if (number == file.Version) { <EcBadge Text="aktuální" Tone="EcBadgeTone.Current" /> }</span>
                                                <span class="ec-preview-versions-option-meta">@MomentDisplay.Text(version.Created) · @version.UploaderEmail</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="ec-preview-versions-divider" role="separator"></div>
                            <button type="button" class="ec-preview-versions-manage" @onclick="() => this.ManageVersions(file)">Spravovat verze…</button>
                        </ChildContent>
                    </EcPopover>
                    @if (this.OlderVersion is not null)
                    {
                        <span class="ec-preview-versions-note">Starší verze. Stáhnout stáhne tuto verzi.</span>
                        <EcButton Variant="EcButtonVariant.Quiet" Size="EcButtonSize.Compact" OnClick="this.ShowCurrentVersion">Zobrazit aktuální verzi</EcButton>
                    }
                </div>
            }
            @if (this.versionFailure is not null)
            {
                <div class="ec-alert ec-preview-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.versionFailure</div>
            }
            @if (this.versionNotice is not null)
            {
                <div class="ec-file-notice ec-preview-alert" role="status">@this.versionNotice</div>
            }
            @if (this.signedContentName is not null)
            {
                <FileSigners @key="(file.FileId, this.OlderVersion)" FileId="file.FileId" FileName="@file.FileName" Version="this.OlderVersion" />
            }
            else if (attachment is null && preview != FilePreviewKind.SignedDocument && this.OlderVersion is null && file.SignatureFileId is { } signatureFileId
                     && this.Files.FirstOrDefault(item => item.FileId == signatureFileId) is { } signature)
            {
                <FileSigners @key="(file.FileId, signatureFileId)" FileId="signatureFileId" FileName="@signature.FileName" SignedFileId="file.FileId" OnOpenFile="this.OpenFile" />
            }
            @if (preview == FilePreviewKind.None || this.unsupported)
            {
                <div class="ec-preview-message">
                    <EcFileIcon FileName="@stagedName" Size="EcFileIconSize.Large" />
                    <p class="ec-preview-message-title">Náhled tohoto typu souboru není k dispozici</p>
                    <p class="ec-preview-message-text">Soubor si stáhněte a otevřete v aplikaci, která ho umí zobrazit.</p>
                    <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Download" OnClick="() => this.DownloadShown(file)">Stáhnout soubor</EcButton>
                </div>
            }
            else if (this.failed)
            {
                <div class="ec-preview-message">
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />Soubor se nepodařilo načíst. Zkuste to za chvíli znovu.</div>
                    <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Refresh" OnClick="() => this.Reload(file)">Zkusit znovu</EcButton>
                </div>
            }
            else if (this.loading)
            {
                <p class="ec-preview-message">Načítám…</p>
            }
            else if (preview == FilePreviewKind.Text)
            {
                <ReflowPreview @key="this.shownKey">
                    @if (this.truncated)
                    {
                        <p class="ec-preview-note">Soubor je delší, zobrazuje se jen jeho začátek.</p>
                    }
                    <div class="ec-preview-text" role="document" tabindex="0" aria-label="Obsah souboru @stagedName">
                        @for (var index = 0; index < this.lines.Count; index++)
                        {
                            <div class="ec-preview-line">
                                <span class="ec-preview-line-number" aria-hidden="true">@(index + 1)</span>
                                <span class="ec-preview-line-text">@this.lines[index]</span>
                            </div>
                        }
                    </div>
                </ReflowPreview>
            }
            else if (preview == FilePreviewKind.Code)
            {
                <CodePreview @key="this.shownKey" Text="@this.code" Truncated="this.truncated" FileName="@stagedName" OnUnreadable="this.Unreadable" />
            }
            else if (preview == FilePreviewKind.Markdown)
            {
                <ReflowPreview @key="this.shownKey">
                    @if (this.truncated)
                    {
                        <p class="ec-preview-note">Soubor je delší, zobrazuje se jen jeho začátek.</p>
                    }
                    <article class="ec-preview-markdown" role="document" tabindex="0" aria-label="Obsah souboru @stagedName">@((MarkupString)this.markdownHtml)</article>
                </ReflowPreview>
            }
            else if (preview == FilePreviewKind.Document)
            {
                <DocumentPreview @key="this.shownKey" Content="this.document!" FileName="@stagedName" OnUnreadable="this.Unreadable" />
            }
            else if (preview == FilePreviewKind.Workbook)
            {
                if (this.workbook.Count == 0)
                {
                    <p class="ec-preview-message">Sešit neobsahuje žádné listy.</p>
                }
                else
                {
                    var sheet = this.workbook[this.activeSheet];

                    <div class="ec-preview-sheet-view">
                        @if (sheet.RowCount > sheet.Rows.Count)
                        {
                            <p class="ec-preview-note">Zobrazuje se jen prvních @Count(sheet.Rows.Count) řádků z @Count(sheet.RowCount).</p>
                        }
                        <div class="ec-preview-sheet" role="document" tabindex="0" aria-label="Obsah listu @sheet.Name">
                            <table class="ec-preview-sheet-table">
                                <thead>
                                    <tr>
                                        <th scope="col"></th>
                                        @for (var column = 0; column < sheet.ColumnCount; column++)
                                        {
                                            <th scope="col">@ColumnName(column)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var row = 0; row < sheet.Rows.Count; row++)
                                    {
                                        <tr>
                                            <th scope="row">@(row + 1)</th>
                                            @foreach (var cell in sheet.Rows[row])
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="ec-preview-sheet-tabs" role="tablist" aria-label="Listy sešitu">
                            @for (var index = 0; index < this.workbook.Count; index++)
                            {
                                var sheetIndex = index;

                                <button type="button" role="tab" class="ec-preview-sheet-tab" aria-selected="@(sheetIndex == this.activeSheet ? "true" : "false")"
                                        @onclick="() => this.activeSheet = sheetIndex">@this.workbook[sheetIndex].Name</button>
                            }
                        </div>
                    </div>
                }
            }
            else if (preview == FilePreviewKind.Email)
            {
                var message = this.email!;

                <ReflowPreview @key="this.shownKey">
                    <article class="ec-preview-email" role="document" tabindex="0" aria-label="Obsah zprávy @stagedName">
                        <dl class="ec-preview-email-headers">
                            <dt>Od</dt>
                            <dd>@Or(message.From)</dd>
                            <dt>Komu</dt>
                            <dd>@Or(string.Join(", ", message.To))</dd>
                            @if (message.Cc.Count > 0)
                            {
                                <dt>Kopie</dt>
                                <dd>@string.Join(", ", message.Cc)</dd>
                            }
                            <dt>Předmět</dt>
                            <dd>@Or(message.Subject)</dd>
                            <dt>Datum</dt>
                            <dd>@Moment(message.Date)</dd>
                        </dl>
                        @if (message.Truncated)
                        {
                            <p class="ec-preview-note">Zpráva je delší, zobrazuje se jen její začátek.</p>
                        }
                        <div class="ec-preview-email-body">@message.Body</div>
                        @if (message.Attachments.Count > 0)
                        {
                            <section class="ec-preview-email-attachments" aria-label="Přílohy">
                                <h3 class="ec-preview-email-attachments-title">Přílohy (@message.Attachments.Count)</h3>
                                <ul class="ec-preview-email-attachment-list">
                                    @foreach (var attachment in message.Attachments)
                                    {
                                        <li class="ec-preview-email-attachment">
                                            <EcIcon Paths="@AppIcons.Paperclip" />
                                            <span class="ec-preview-email-attachment-name">@attachment.Name</span>
                                            <span class="ec-preview-email-attachment-size">@FileSizeDisplay.Text(attachment.Size)</span>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    </article>
                </ReflowPreview>
            }
            else if (preview == FilePreviewKind.DataMessage)
            {
                <DataMessagePreview @key="this.shownKey" Content="this.dataMessage!" FileName="@stagedName" FileId="@(attachment is null ? file.FileId : null)" Version="@(attachment is null ? this.OlderVersion : null)"
                                    OnOpenAttachment="opened => this.OpenAttachment(stagedName, opened.Message, opened.Index)" OnUnreadable="this.Unreadable" />
            }
            else if (preview == FilePreviewKind.SignedDocument)
            {
                <FileSigners @key="(file.FileId, this.OlderVersion)" FileId="file.FileId" FileName="@file.FileName" Version="this.OlderVersion" Detached OnOpenFile="this.OpenFile" />
            }
            else if (preview == FilePreviewKind.Pdf)
            {
                <PdfPreview @key="this.shownKey" Url="@(this.url ?? "")" Content="this.pdf" FileName="@stagedName" OnUnreadable="this.Unreadable" />
            }
            else if (preview == FilePreviewKind.Image || preview == FilePreviewKind.ConvertedImage)
            {
                <div class="ec-preview-stage">
                    <img @key="this.shownKey" class="ec-preview-image" src="@this.url" alt="@stagedName" @onerror="this.Unreadable" />
                </div>
            }
            else if (preview == FilePreviewKind.Audio)
            {
                <div class="ec-preview-stage">
                    <audio @key="this.shownKey" class="ec-preview-audio" src="@this.url" controls @onerror="this.Unreadable"></audio>
                </div>
            }
            else
            {
                <div class="ec-preview-stage">
                    <video @key="this.shownKey" class="ec-preview-video" src="@this.url" controls @onerror="this.Unreadable"></video>
                </div>
            }
        </ChildContent>
    </EcModal>
}

@code {
    private const int MaxTextBytes = 1024 * 1024;

    private const int MaxTextLines = 5000;

    private const int MaxSheetRows = 1000;

    private static readonly NumberFormatInfo CzechNumbers = NumberFormatInfo.ReadOnly(new NumberFormatInfo { NumberGroupSeparator = "\u00A0" });

    [Parameter, EditorRequired]
    public required IReadOnlyList<FileListItem> Files { get; set; }

    [Parameter, EditorRequired]
    public required Guid FileId { get; set; }

    [Parameter]
    public EventCallback<Guid> FileIdChanged { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, int?, CancellationToken, Task<Stream>> LoadContent { get; set; }

    /// <summary>
    /// The version shown; null shows the current one.
    /// </summary>
    [Parameter]
    public int? Version { get; set; }

    [Parameter]
    public EventCallback<int?> VersionChanged { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task<IReadOnlyList<FileVersionItem>>> LoadVersions { get; set; }

    /// <summary>
    /// Uploads the picked file as a new version; answers the failure or the notice to show.
    /// </summary>
    [Parameter, EditorRequired]
    public required Func<FileListItem, IBrowserFile, Task<(string? Failure, string? Notice)>> UploadVersion { get; set; }

    [Parameter]
    public EventCallback<FileListItem> OnManageVersions { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, string, CancellationToken, Task> Rename { get; set; }

    [Parameter]
    public EventCallback<FileListItem> OnDownload { get; set; }

    [Parameter]
    public EventCallback OnRenamed { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    // The attachments opened, outermost first; empty shows the stored file.
    private readonly List<(byte[] Content, DataMessage Message, string MessageName, int Index)> trail = [];

    private CancellationTokenSource? loadToken;

    private Guid? loadedFileId;

    private int? loadedNumber;

    private IReadOnlyList<FileVersionItem>? versions;

    private (Guid, int, int)? versionsKey;

    private bool versionsOpen;

    private bool uploadingVersion;

    private string? versionFailure;

    private string? versionNotice;

    private EcPopover? versionsPopover;

    private string? url;

    private bool urlIsBlob;

    private string markdownHtml = "";

    private IReadOnlyList<SheetPreview> workbook = [];

    private int activeSheet;

    private EmailPreview? email;

    private byte[]? document;

    private byte[]? pdf;

    private byte[]? dataMessage;

    // The document a stored signed file carries and the name it is shown and saved under; null for any other file.
    private byte[]? signedContent;

    private string? signedContentName;

    private int shownKey;

    private IReadOnlyList<string> lines = [];

    private string code = "";

    private bool truncated;

    private bool loading;

    private bool failed;

    private bool unsupported;

    private bool renaming;

    private FileListItem? Current => this.Files.FirstOrDefault(file => file.FileId == this.FileId);

    private int Position => Enumerable.Range(0, this.Files.Count).Single(index => this.Files[index].FileId == this.FileId);

    // The number of the version shown when it is not the current one.
    private int? OlderVersion => this.Version is { } number && this.Current is { } file && number != file.Version ? number : null;

    private FileVersionItem? ShownVersionItem => this.OlderVersion is { } number ? this.versions?.FirstOrDefault(version => version.Number == number) : null;

    private DataMessageAttachment? ShownAttachment => this.trail.Count == 0 ? null : this.trail[^1].Message.Attachments[this.trail[^1].Index];

    protected override async Task OnParametersSetAsync()
    {
        if (this.Current is not { } file)
            return;

        await this.LoadVersionList(file);

        var number = this.OlderVersion ?? file.Version;

        if (file.FileId == this.loadedFileId && number == this.loadedNumber)
            return;

        if (file.FileId != this.loadedFileId)
        {
            this.versionsOpen = false;
            this.versionFailure = null;
            this.versionNotice = null;
        }

        this.renaming = false;

        await this.Reload(file);
    }

    private async Task LoadVersionList(FileListItem file)
    {
        var key = (file.FileId, file.Version, file.VersionCount);

        if (file.VersionCount < 2)
        {
            this.versions = null;
            this.versionsKey = null;

            return;
        }

        if (key == this.versionsKey)
            return;

        this.versionsKey = key;

        try
        {
            this.versions = await this.LoadVersions(file, CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the versions of file {FileAssetId} failed", file.FileId);

            this.versions = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        this.loadToken?.Cancel();

        await this.ReleaseUrl();
    }

    // Cancels what is loading and clears what is shown, so a stale load never overwrites a newer one.
    private CancellationToken Reset()
    {
        this.loadToken?.Cancel();
        this.shownKey++;
        this.loading = true;
        this.failed = false;
        this.unsupported = false;
        this.lines = [];
        this.code = "";
        this.truncated = false;
        this.markdownHtml = "";
        this.workbook = [];
        this.activeSheet = 0;
        this.email = null;
        this.document = null;
        this.pdf = null;
        this.dataMessage = null;
        this.signedContent = null;
        this.signedContentName = null;

        return (this.loadToken = new CancellationTokenSource()).Token;
    }

    private async Task Reload(FileListItem file)
    {
        var token = this.Reset();

        this.loadedFileId = file.FileId;
        this.loadedNumber = this.OlderVersion ?? file.Version;
        this.trail.Clear();

        await this.ReleaseUrl();

        var preview = FileTypeDisplay.Preview(file.FileName);

        if (preview == FilePreviewKind.None)
        {
            this.loading = false;

            return;
        }

        var size = this.ShownVersionItem?.SizeBytes ?? file.SizeBytes;

        if ((preview == FilePreviewKind.DataMessage && size > DataMessageZfo.MaxBytes)
            || (preview == FilePreviewKind.SignedDocument && size > FileLimits.MaxSignedFileBytes))
        {
            this.loading = false;
            this.unsupported = true;

            return;
        }

        try
        {
            // The browser requests what it shows natively itself, and the PDF library requests a PDF; the rest is
            // read here as bytes.
            if (preview == FilePreviewKind.Pdf || InlineFileTypes.MediaType(file.FileName) is not null)
            {
                await this.Session.EnsureFresh(token);

                if (!token.IsCancellationRequested)
                {
                    this.loading = false;
                    this.url = FileUrl.Content(file.FileId, this.OlderVersion);

                    // The browser keeps requesting ranges while the file is shown; the next file or the close ends it.
                    _ = this.Session.KeepFresh(token);
                }

                return;
            }

            await using var content = await this.LoadContent(file, this.OlderVersion, token);

            await this.Load(file.FileName, preview, content, token);

            if (!token.IsCancellationRequested)
                this.loading = false;
        }
        catch (OperationCanceledException)
        {
            // A later file took over.
        }
        catch (JSException exception) when (UsesLibrary(preview))
        {
            this.Logger.LogInformation(exception, "The library could not read file {FileId} for the preview", file.FileId);

            if (!token.IsCancellationRequested)
            {
                this.loading = false;
                this.unsupported = true;
            }
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException or JSException)
        {
            this.Logger.LogWarning(exception, "Loading file {FileId} for the preview failed", file.FileId);

            if (!token.IsCancellationRequested)
            {
                this.loading = false;
                this.failed = true;
            }
        }
    }

    // Each branch writes nothing once a later file took over, so a stale load never overwrites a newer one.
    private async Task Load(string fileName, FilePreviewKind preview, Stream content, CancellationToken token)
    {
        switch (preview)
        {
            case FilePreviewKind.Text:
            {
                var (text, cut) = await ReadText(content, token);

                if (!token.IsCancellationRequested)
                    (this.lines, this.truncated) = SplitLines(text, cut);

                break;
            }

            case FilePreviewKind.Code:
            {
                var (text, cut) = await ReadText(content, token);

                if (!token.IsCancellationRequested)
                    (this.code, this.truncated) = (text, cut);

                break;
            }

            case FilePreviewKind.Markdown:
            {
                var (text, cut) = await ReadText(content, token);

                if (!token.IsCancellationRequested)
                    (this.markdownHtml, this.truncated) = (MarkdownHtml.Render(text), cut);

                break;
            }

            // Only SVG is a picture read as bytes: it is shown as an image blob, never as the stored type.
            case FilePreviewKind.Image:
                await this.ShowUrl(await this.BlobUrls.CreateBlobUrl("image/svg+xml", content, token), token);

                break;

            case FilePreviewKind.ConvertedImage:
                await this.ShowUrl(await this.Previews.CreatePngUrl(content, token), token);

                break;

            case FilePreviewKind.Document:
            {
                using var bytes = new MemoryStream();

                await content.CopyToAsync(bytes, token);

                if (!token.IsCancellationRequested)
                    this.document = bytes.ToArray();

                break;
            }

            case FilePreviewKind.Workbook:
            {
                var sheets = await this.Previews.ReadWorkbook(content, MaxSheetRows, token);

                if (!token.IsCancellationRequested)
                    this.workbook = sheets;

                break;
            }

            case FilePreviewKind.Email:
            {
                var message = await this.Previews.ReadEmail(fileName, content, token);

                if (!token.IsCancellationRequested)
                    this.email = message;

                break;
            }

            // A stored PDF is requested by the library itself; only an attachment held in memory comes here.
            case FilePreviewKind.Pdf:
            {
                using var bytes = new MemoryStream();

                await content.CopyToAsync(bytes, token);

                if (!token.IsCancellationRequested)
                    this.pdf = bytes.ToArray();

                break;
            }

            case FilePreviewKind.DataMessage:
            {
                using var bytes = new MemoryStream();

                await content.CopyToAsync(bytes, token);

                if (!token.IsCancellationRequested)
                    this.dataMessage = bytes.ToArray();

                break;
            }

            case FilePreviewKind.SignedDocument:
            {
                using var bytes = new MemoryStream();

                await content.CopyToAsync(bytes, token);

                if (token.IsCancellationRequested)
                    break;

                var signed = SignedData.ParseOrDefault(bytes.ToArray());

                if (signed is null)
                {
                    this.unsupported = true;

                    break;
                }

                // A detached signature carries no document; the stage shows its signers instead.
                if (signed.Content is not { } document)
                    break;

                var documentName = FileTypeDisplay.SignedContentName(fileName);

                // A name without a known extension takes the one of the type its content shows.
                if (!FileTypeDisplay.HasKnownExtension(documentName)
                    && await this.DetectExtension(document, token) is { } detected && FileTypeDisplay.IsKnownExtension(detected))
                    documentName = $"{documentName}.{detected}";

                if (token.IsCancellationRequested)
                    break;

                (this.signedContent, this.signedContentName) = (document, documentName);

                var documentPreview = FileTypeDisplay.Preview(documentName);

                await using var documentContent = new MemoryStream(document, writable: false);

                // A signature or data message inside the signature would need a stored file of its own.
                if (documentPreview is FilePreviewKind.SignedDocument or FilePreviewKind.DataMessage)
                    this.unsupported = true;
                else if (InlineFileTypes.MediaType(documentName) is { } mediaType)
                    await this.ShowUrl(await this.BlobUrls.CreateBlobUrl(mediaType, documentContent, token), token);
                else if (documentPreview != FilePreviewKind.None)
                    await this.Load(documentName, documentPreview, documentContent, token);

                break;
            }

            case FilePreviewKind.None:
            case FilePreviewKind.Audio:
            case FilePreviewKind.Video:
                throw new UnreachableException();

            default:
                throw new UnreachableException();
        }
    }

    // A library that fails leaves the type undetected.
    private async Task<string?> DetectExtension(byte[] content, CancellationToken token)
    {
        await using var stream = new MemoryStream(content, writable: false);

        try
        {
            return await this.Previews.DetectExtension(stream, token);
        }
        catch (JSException exception)
        {
            this.Logger.LogInformation(exception, "The library could not detect the type of a signed document");

            return null;
        }
    }

    private async Task ShowUrl(string created, CancellationToken token)
    {
        if (token.IsCancellationRequested)
            await this.BlobUrls.RevokeBlobUrl(created);
        else
            (this.url, this.urlIsBlob) = (created, true);
    }

    private async Task ShowAttachment(DataMessageAttachment attachment)
    {
        var token = this.Reset();

        await this.ReleaseUrl();

        var preview = FileTypeDisplay.Preview(attachment.Name);

        if (preview == FilePreviewKind.None)
        {
            this.loading = false;

            return;
        }

        // A signed file inside a data message has no stored file whose signers the server reads.
        if (preview == FilePreviewKind.SignedDocument)
        {
            this.loading = false;
            this.unsupported = true;

            return;
        }

        try
        {
            await using var content = new MemoryStream(attachment.Content, writable: false);

            // What the browser shows natively is a blob of the type the extension gives.
            if (InlineFileTypes.MediaType(attachment.Name) is { } mediaType)
                await this.ShowUrl(await this.BlobUrls.CreateBlobUrl(mediaType, content, token), token);
            else
                await this.Load(attachment.Name, preview, content, token);

            if (!token.IsCancellationRequested)
                this.loading = false;
        }
        catch (OperationCanceledException)
        {
            // A later attachment or file took over.
        }
        catch (JSException exception)
        {
            this.Logger.LogInformation(exception, "The library could not read an attachment of a data message for the preview");

            if (!token.IsCancellationRequested)
            {
                this.loading = false;
                this.unsupported = true;
            }
        }
    }

    private async Task OpenAttachment(string messageName, DataMessage message, int index)
    {
        this.renaming = false;
        this.trail.Add((this.dataMessage!, message, messageName, index));

        await this.ShowAttachment(message.Attachments[index]);
    }

    private async Task StepAttachment(int direction)
    {
        var (content, message, messageName, index) = this.trail[^1];
        var count = message.Attachments.Count;
        var next = ((index + direction) % count + count) % count;

        this.trail[^1] = (content, message, messageName, next);

        await this.ShowAttachment(message.Attachments[next]);
    }

    // The message's bytes were kept when it was opened, so it shows again without a load.
    private async Task BackToMessage()
    {
        var message = this.trail[^1].Content;

        this.trail.RemoveAt(this.trail.Count - 1);
        _ = this.Reset();

        await this.ReleaseUrl();

        this.dataMessage = message;
        this.loading = false;
    }

    private async Task DownloadAttachment(DataMessageAttachment attachment)
    {
        await using var content = new MemoryStream(attachment.Content, writable: false);

        await this.Downloader.DownloadContent(attachment.Name, content, CancellationToken.None);
    }

    private async Task DownloadShown(FileListItem file)
    {
        if (this.ShownAttachment is { } attachment)
            await this.DownloadAttachment(attachment);
        else if (this.signedContent is not null)
            await this.DownloadSignedContent();
        else
            await this.DownloadStored(file);
    }

    // An older version is saved under the file's name by the same request the preview makes.
    private async Task DownloadStored(FileListItem file)
    {
        if (this.OlderVersion is { } number)
            await this.Downloader.DownloadFile(file.FileId, number, file.FileName, CancellationToken.None);
        else
            await this.OnDownload.InvokeAsync(file);
    }

    private async Task ToggleVersions()
    {
        if (this.OlderVersion is null)
            this.versionsOpen = !this.versionsOpen;
        else
            await this.ShowCurrentVersion();
    }

    private async Task ShowCurrentVersion()
    {
        this.versionsOpen = false;

        await this.VersionChanged.InvokeAsync(null);
    }

    private async Task SelectVersion(FileListItem file, int number)
    {
        await this.versionsPopover!.CloseToTrigger();

        this.versionsOpen = true;

        await this.VersionChanged.InvokeAsync(number == file.Version ? null : number);
    }

    private async Task ManageVersions(FileListItem file)
    {
        await this.versionsPopover!.CloseToTrigger();
        await this.OnManageVersions.InvokeAsync(file);
    }

    private async Task UploadNewVersion(FileListItem file, IBrowserFile picked)
    {
        this.uploadingVersion = true;
        this.versionFailure = null;
        this.versionNotice = null;

        (this.versionFailure, this.versionNotice) = await this.UploadVersion(file, picked);

        this.uploadingVersion = false;

        if (this.versionFailure is null)
            await this.VersionChanged.InvokeAsync(null);
    }

    private async Task DownloadSignedContent()
    {
        await using var content = new MemoryStream(this.signedContent!, writable: false);

        await this.Downloader.DownloadContent(this.signedContentName!, content, CancellationToken.None);
    }

    private void Unreadable()
    {
        this.unsupported = true;
    }

    private static string Moment(DateTimeOffset? moment)
    {
        return moment is { } value ? MomentDisplay.Text(value.UtcDateTime) : "—";
    }

    // A signed document's content is read by the library of its own type.
    private static bool UsesLibrary(FilePreviewKind preview)
    {
        return preview is FilePreviewKind.ConvertedImage or FilePreviewKind.Document or FilePreviewKind.Workbook or FilePreviewKind.Email
            or FilePreviewKind.SignedDocument;
    }

    private static string Count(int count)
    {
        return string.Create(CzechNumbers, $"{count:N0}");
    }

    private static string ColumnName(int index)
    {
        var name = "";

        for (var number = index + 1; number > 0; number = (number - 1) / 26)
            name = (char)('A' + (number - 1) % 26) + name;

        return name;
    }

    private static string Or(string text)
    {
        return text.Length == 0 ? "—" : text;
    }

    private async Task ReleaseUrl()
    {
        if (this.url is null)
            return;

        var released = this.url;
        this.url = null;

        if (this.urlIsBlob)
            await this.BlobUrls.RevokeBlobUrl(released);

        this.urlIsBlob = false;
    }

    private async Task Step(int direction)
    {
        var count = this.Files.Count;
        var next = this.Files[((this.Position + direction) % count + count) % count];

        await this.FileIdChanged.InvokeAsync(next.FileId);
    }

    private async Task OpenFile(Guid fileId)
    {
        await this.FileIdChanged.InvokeAsync(fileId);
    }

    private void StartRename()
    {
        this.renaming = true;
    }

    private void CancelRename()
    {
        this.renaming = false;
    }

    private async Task Renamed()
    {
        this.renaming = false;

        await this.OnRenamed.InvokeAsync();
    }

    // Only the start of a long file is read; the cut may split a character, which shows as one replacement mark.
    private static async Task<(string Text, bool Truncated)> ReadText(Stream content, CancellationToken token)
    {
        var buffer = new byte[MaxTextBytes + 1];
        var read = 0;

        while (read < buffer.Length)
        {
            var count = await content.ReadAsync(buffer.AsMemory(read), token);

            if (count == 0)
                break;

            read += count;
        }

        return (Encoding.UTF8.GetString(buffer, 0, Math.Min(read, MaxTextBytes)).TrimStart('\uFEFF'), read > MaxTextBytes);
    }

    private static (IReadOnlyList<string> Lines, bool Truncated) SplitLines(string text, bool truncated)
    {
        var all = text.Split('\n').Select(static line => line.TrimEnd('\r')).ToList();

        if (all.Count > 1 && all[^1].Length == 0)
            all.RemoveAt(all.Count - 1);

        if (all.Count > MaxTextLines)
        {
            all = all.Take(MaxTextLines).ToList();
            truncated = true;
        }

        return (all, truncated);
    }
}
