@* Filled on the main file, empty on the others; a click sets or unsets the mark. *@
<button type="button" class="@(this.IsMain ? "ec-button ec-button-icon ec-main-star ec-main-star-on" : "ec-button ec-button-icon ec-main-star")"
        aria-label="@this.Label" title="@this.Text" @onclick="() => this.OnChange.InvokeAsync(!this.IsMain)">
    <EcIcon Paths="@AppIcons.Star" />
</button>

@code {
    [Parameter, EditorRequired]
    public bool IsMain { get; set; }

    /// <summary>
    /// Names the file in the accessible name, where several stars stand side by side.
    /// </summary>
    [Parameter]
    public string? FileName { get; set; }

    /// <summary>
    /// Receives the requested mark: true sets the file as main, false unsets it.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnChange { get; set; }

    private string Text => this.IsMain ? "Zrušit hlavní soubor" : "Nastavit jako hlavní soubor";

    private string Label => this.FileName switch
    {
        null => this.Text,
        { } name when this.IsMain => $"Zrušit hlavní soubor {name}",
        { } name => $"Nastavit {name} jako hlavní soubor",
    };
}
