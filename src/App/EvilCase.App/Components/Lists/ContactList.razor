@using System.Diagnostics
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Lists
@using EvilBrains.EvilCase.Domain.Contacts
@inherits ListComponent<ContactListRequest>
@inject IContactsClient ContactsClient

@{
    var columns = new List<EcColumn<ContactListItem>>();

    foreach (var column in this.Columns)
    {
        columns.Add(column switch
        {
            ContactColumn.Name => new EcColumn<ContactListItem>
            {
                Header = "Kontakt",
                Width = "minmax(0, 1fr)",
                SortKey = nameof(ContactSortKey.Name),
                Primary = true,
                Cell = item =>@<span class="ec-contact-name">
                    <span class="@($"ec-contact-monogram ec-contact-monogram-{ContactKindDisplay.Css(item.Kind)}")">@ContactMonogram.Text(item.Name)</span>
                    <span class="ec-contact-name-text">@item.Name</span>
                </span>,
            },
            ContactColumn.Kind => new EcColumn<ContactListItem>
            {
                Header = "Typ",
                Width = "var(--ec-list-col-kind)",
                Cell = item =>@<EcBadge Tone="ContactKindDisplay.Tone(item.Kind)" Text="@ContactKindDisplay.Text(item.Kind)" />,
            },
            ContactColumn.DataBoxId => new EcColumn<ContactListItem>
            {
                Header = "ID datové schránky",
                Width = "var(--ec-list-col-databox)",
                CellClass = "ec-cell-mono",
                Cell = item =>@<text>@(string.IsNullOrWhiteSpace(item.DataBoxId) ? "—" : item.DataBoxId)</text>,
            },
            ContactColumn.Address => new EcColumn<ContactListItem>
            {
                Header = "Adresa",
                Width = "minmax(0, 1fr)",
                Cell = item =>@<span class="ec-cell-text">@(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)</span>,
            },
            _ => throw new UnreachableException(),
        });
    }
}

<EcTable TItem="ContactListItem"
         Title="@this.Title" Actions="this.Actions"
         ShowToolbar="this.HasFilters"
         Columns="columns" Items="this.items" RowHref="RowHref"
         SortKey="@this.sort.ToString()"
         SortDescending="@(this.Direction == ListSortDirection.Descending)"
         SortChanged="this.OnSortChanged"
         Loading="this.Loading" Failure="@this.Failure" Retry="this.Reload"
         Skip="this.Skip" Take="this.Filter.Take" Total="this.Total"
         ShowPaging="this.ShowPaging" Previous="this.ToPreviousPage" Next="this.ToNextPage">
    <Toolbar>
        @if (this.ShowSearch)
        {
            <label class="ec-search" for="@($"{this.InputPrefix}-search")">
                <EcIcon Paths="@AppIcons.Search" Size="EcIconSize.Small" />
                <input id="@($"{this.InputPrefix}-search")" type="search" class="ec-search-input" aria-label="Hledat v kontaktech"
                       placeholder="Hledat v názvu a ID datové schránky" value="@this.SearchText" @oninput="this.OnSearchInput" />
            </label>
        }

        @if (this.ShowKindFilter)
        {
            <div class="ec-segmented" role="group" aria-label="Typ kontaktu">
                @foreach (var value in KindFilters)
                {
                    <button type="button" class="ec-segment" aria-pressed="@(this.kind == value ? "true" : "false")"
                            @onclick="() => this.SetKind(value)">@KindText(value)</button>
                }
            </div>
        }
    </Toolbar>
    <Empty>
        <EcEmptyState Icon="@AppIcons.Users" Text="@this.EmptyText" Action="this.EmptyAction" />
    </Empty>
</EcTable>

@code {
    private static readonly ContactKind?[] KindFilters = [null, ContactKind.Authority, ContactKind.Official, ContactKind.Person];

    [Parameter, EditorRequired]
    public required IReadOnlyList<ContactColumn> Columns { get; set; }

    [Parameter, EditorRequired]
    public required ContactListRequest Filter { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Filtru neodpovídá žádný kontakt.";

    [Parameter]
    public RenderFragment? EmptyAction { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public bool ShowKindFilter { get; set; }

    [Parameter]
    public bool ShowPaging { get; set; }

    [Parameter]
    public EventCallback<int> TotalChanged { get; set; }

    /// <summary>
    /// Prefixes the ids of the toolbar's inputs, so two lists on one page never share one.
    /// </summary>
    [Parameter]
    public string InputPrefix { get; set; } = "contacts";

    private IReadOnlyList<ContactListItem> items = [];

    private ContactSortKey sort;

    private ContactKind? kind;

    protected override int PageSize => this.Filter.Take;

    protected override string FailureText => "Seznam kontaktů se nepodařilo načíst. Zkuste to za chvíli znovu.";

    private bool HasFilters => this.ShowSearch || this.ShowKindFilter;

    protected override void OnInitialized()
    {
        this.sort = this.Filter.Sort;
        this.kind = this.Filter.Kind;
        this.Direction = this.Filter.SortDirection;
    }

    protected override Task OnParametersSetAsync()
    {
        return this.ReloadOnFilterChange(this.Filter, this.Filter.Search);
    }

    protected override async Task<int> LoadPage(CancellationToken token)
    {
        var request = this.Filter with
        {
            Search = this.Search,
            Kind = this.kind,
            Sort = this.sort,
            SortDirection = this.Direction,
            Skip = this.Skip,
        };

        var response = await this.ContactsClient.ListContacts(request, token);

        this.items = response.Items;

        await this.TotalChanged.InvokeAsync(response.TotalCount);

        return response.TotalCount;
    }

    private static string KindText(ContactKind? value)
    {
        return value is null ? "Vše" : ContactKindDisplay.Text(value.Value);
    }

    private static string RowHref(ContactListItem item)
    {
        return $"/contacts/{item.ContactId}";
    }

    private Task OnSortChanged(string key)
    {
        return this.SortBy(Enum.Parse<ContactSortKey>(key));
    }

    private Task SetKind(ContactKind? value)
    {
        this.kind = value;

        return this.ReloadFirstPage();
    }

    private Task SortBy(ContactSortKey key)
    {
        if (key == this.sort)
        {
            this.TurnDirection();
        }
        else
        {
            this.sort = key;
            this.Direction = key == ContactSortKey.Changed ? ListSortDirection.Descending : ListSortDirection.Ascending;
        }

        return this.ReloadFirstPage();
    }
}
