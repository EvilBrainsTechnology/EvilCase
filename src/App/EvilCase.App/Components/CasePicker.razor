@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@implements IDisposable
@inject ICasesClient CasesClient
@inject ILogger<CasePicker> Logger

@if (this.Selected is { } selected)
{
    <div class="input-group">
        <input id="@this.InputId" class="form-control" value="@($"{selected.CaseNumber} — {selected.Title}")" readonly aria-label="Vybraný nadřízený spis" />
        <button type="button" id="@($"{this.InputId}-clear")" class="btn" @onclick="this.ClearSelection"><Icon CssClass="icon" IconType="AppIcons.ArrowsExchange" />Změnit</button>
    </div>
}
else
{
    <div class="ec-picker">
        <input id="@this.InputId" type="search" class="form-control" placeholder="Hledat ve spisové značce a názvu"
               aria-label="Hledat nadřízený spis" value="@this.search" @oninput="this.OnSearchInput" @onkeydown="this.OnKeyDown" />

        @if (!this.closed && this.matches.Count > 0)
        {
            <div class="dropdown-menu show ec-picker-menu">
                @foreach (var match in this.matches)
                {
                    <button type="button" class="dropdown-item" @onclick="() => this.Select(match)">
                        <span class="ec-mono">@match.CaseNumber</span>
                        <span class="ms-2">@match.Title</span>
                    </button>
                }
            </div>
        }
    </div>

    @if (this.searchFailure is not null)
    {
        <div class="form-hint">@this.searchFailure</div>
    }
    else if (!this.closed && this.matches.Count == 0 && this.searched)
    {
        <div class="form-hint">Žádný spis neodpovídá.</div>
    }
    else
    {
        <div class="form-hint">Bez nadřízeného spisu.</div>
    }
}

@code {
    // The suggester offers at most eight matches, as the contact one does (SDD-011).
    private const int Matches = 8;

    [Parameter, EditorRequired]
    public required string InputId { get; set; }

    /// <summary>
    /// The case the picker never offers as its own parent.
    /// </summary>
    [Parameter, EditorRequired]
    public required Guid ExcludedCaseId { get; set; }

    [Parameter]
    public CaseListItem? Selected { get; set; }

    [Parameter]
    public EventCallback<CaseListItem?> SelectedChanged { get; set; }

    private readonly SearchDebouncer debouncer = new();

    private IReadOnlyList<CaseListItem> matches = [];

    private string search = "";

    private bool searched;

    private bool closed;

    private string? searchFailure;

    public void Dispose()
    {
        this.debouncer.Dispose();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            this.closed = true;
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        this.search = args.Value as string ?? "";
        this.closed = false;

        var token = await this.debouncer.Start(debounce: true);
        if (token is null)
            return;

        this.searchFailure = null;

        if (string.IsNullOrWhiteSpace(this.search))
        {
            this.matches = [];
            this.searched = false;
            return;
        }

        try
        {
            // Every case of the tenant, subordinate ones included: a case hangs under any of them.
            var request = new CaseListRequest
            {
                Search = this.search,
                Status = CaseStatusFilter.All,
                Scope = CaseListScope.All,
                Take = Matches,
            };

            var response = await this.CasesClient.ListCases(request, token.Value);

            this.matches = [.. response.Items.Where(item => item.CaseId != this.ExcludedCaseId)];
            this.searched = true;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer search.
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the parent case matches failed");

            this.matches = [];
            this.searched = true;
            this.searchFailure = "Hledání spisů se nezdařilo. Zkuste to za chvíli znovu.";
        }
    }

    private async Task Select(CaseListItem @case)
    {
        this.matches = [];
        this.search = "";
        this.searched = false;

        await this.SelectedChanged.InvokeAsync(@case);
    }

    private async Task ClearSelection()
    {
        await this.SelectedChanged.InvokeAsync(null);
    }
}
