@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.App.Models
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@* The sidebar's Hierarchie section: parent case link, then the child list as compact full-width rows. *@
<div class="ec-field-label mb-2 d-flex align-items-center gap-2">
    Podřízené spisy
    <span class="badge bg-secondary-lt">@Items.Count</span>
</div>

@if (Items.Count == 0)
{
    <div class="text-secondary small mb-2">Žádné podřízené spisy.</div>
}
else
{
    @foreach (var item in Items)
    {
        <a class="ec-comprow" href="@($"/cases/{item.CaseId}")">
            <span class="ec-min-w-0 flex-fill">
                <span class="d-block ec-comprow-title">@item.Title</span>
                <span class="ec-comprow-meta">
                    <span class="ec-num">@DateDisplay.Text(item.Date)</span> ·
                    <Status BackgroundColor="CaseStatusDisplay.Color(item.Status)" Lite="true">@CaseStatusDisplay.Text(item.Status)</Status>
                </span>
            </span>
        </a>
    }
}

<a href="@($"/cases/new?parent={ParentCaseId}")" class="btn btn-outline-secondary w-100 mt-2" @onclick="this.GoToNewChildCase" @onclick:preventDefault="this.ConfirmNavigation">
    <Icon CssClass="icon" IconType="AppIcons.Plus" />Nový podřízený spis
</a>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<CaseListItem> Items { get; set; }

    [Parameter, EditorRequired]
    public required Guid ParentCaseId { get; set; }

    /// <summary>
    /// True while the case's edit form holds unsaved changes: Nový podřízený spis confirms
    /// before it navigates away and discards them.
    /// </summary>
    [Parameter]
    public bool ConfirmNavigation { get; set; }

    private async Task GoToNewChildCase()
    {
        if (this.ConfirmNavigation && !await UnsavedChangesGuard.ConfirmLeave(this.JSRuntime))
            return;

        this.Navigation.NavigateTo($"/cases/new?parent={this.ParentCaseId}");
    }
}
