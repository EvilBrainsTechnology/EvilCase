@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@inject IActsClient ActsClient

<ConfirmDeleteModal Delete="this.DeleteAct" GoneError="Úkon už neexistuje." FailedError="Úkon se nepodařilo smazat. Zkuste to za chvíli znovu." OnDeleted="this.OnDeleted">
    <p>Opravdu smazat úkon <strong>@Act.ActNumber</strong> — @Act.Title? Akci nelze vrátit zpět.</p>

    <p class="text-secondary">S úkonem zaniknou jeho komentáře, externí čísla jednací a soubory.</p>
</ConfirmDeleteModal>

@code {
    [Parameter, EditorRequired]
    public required ActDetail Act { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private Task DeleteAct(CancellationToken cancellationToken) =>
        this.ActsClient.DeleteAct(this.Act.CaseId, this.Act.ActId, cancellationToken);
}
