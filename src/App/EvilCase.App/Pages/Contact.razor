@page "/contacts/{ContactId:guid}"
@using System.Net
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Acts
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using EvilBrains.EvilCase.Api.Contract.Lists
@inject IContactsClient ContactsClient
@inject NavigationManager Navigation
@inject ILogger<Contact> Logger

<PageTitle>@(this.contact is null ? "Kontakt" : this.contact.Name) – EvilCase</PageTitle>

<div class="ec-page">
    @if (this.notFound)
    {
        <EcCard><p class="ec-state">Kontakt nenalezen.</p></EcCard>
    }
    else if (this.failure is not null)
    {
        <EcCard>
            <div class="ec-card-error">
                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.failure</div>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                          OnClick="this.LoadContact">Zkusit znovu</EcButton>
            </div>
        </EcCard>
    }
    else if (this.contact is null)
    {
        <EcCard><p class="ec-state">Načítám…</p></EcCard>
    }
    else
    {
        <EcCard>
            <div class="ec-detail">
                <nav class="ec-crumbs" aria-label="Drobečková navigace">
                    <a class="ec-crumb" href="/contacts">Kontakty</a>
                    <span class="ec-crumb-separator" aria-hidden="true">/</span>
                    <span class="ec-crumb" aria-current="page">Detail kontaktu</span>
                </nav>

                <div class="ec-contact-header">
                    <span class="@($"ec-contact-monogram ec-contact-monogram-lg ec-contact-monogram-{ContactKindDisplay.Css(this.contact.Kind)}")">
                        @ContactMonogram.Text(this.contact.Name)
                    </span>
                    <div class="ec-contact-header-name">
                        <h1 class="ec-page-title">@this.contact.Name</h1>
                        <EcBadge Tone="ContactKindDisplay.Tone(this.contact.Kind)" Text="@ContactKindDisplay.Text(this.contact.Kind)" />
                    </div>
                    <div class="ec-page-actions">
                        <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Pencil" id="contact-edit" OnClick="this.StartEditing">Upravit kontakt</EcButton>
                        <EcButton Variant="EcButtonVariant.Danger" Icon="@AppIcons.Trash" id="contact-delete" OnClick="this.StartDeleting">Smazat kontakt</EcButton>
                    </div>
                </div>

                <div class="ec-detail-facts">
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">ID datové schránky</span>
                        <span class="ec-detail-fact-mono">@(string.IsNullOrWhiteSpace(this.contact.DataBoxId) ? "—" : this.contact.DataBoxId)</span>
                    </div>
                    <div class="ec-detail-fact ec-detail-fact-grow">
                        <span class="ec-detail-fact-name">Adresa</span>
                        <span class="ec-detail-fact-value">@(string.IsNullOrWhiteSpace(this.contact.Address) ? "—" : this.contact.Address)</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Spisy</span>
                        <span class="ec-detail-fact-value">@this.caseTotal</span>
                    </div>
                    <div class="ec-detail-fact">
                        <span class="ec-detail-fact-name">Úkony</span>
                        <span class="ec-detail-fact-value">@this.actTotal</span>
                    </div>
                </div>
            </div>
        </EcCard>

        <div class="ec-contact-occurrences">
            <CaseList @key="(nameof(CaseList), this.ContactId)"
                      Columns="CaseColumns"
                      Filter="this.CaseFilter"
                      Title="Spisy s tímto kontaktem"
                      ShowPaging="true"
                      EmptyText="Kontakt nefiguruje v žádném spisu."
                      TotalChanged="value => this.caseTotal = value" />

            <ActList @key="(nameof(ActList), this.ContactId)"
                     Columns="ActColumns"
                     Filter="this.ActFilter"
                     Title="Úkony s tímto kontaktem"
                     DateHeader="Datum úkonu"
                     ShowPaging="true"
                     EmptyText="Kontakt nefiguruje v žádném úkonu."
                     TotalChanged="value => this.actTotal = value" />
        </div>
    }
</div>

@if (this.editing && this.contact is not null)
{
    <ContactFormModal Contact="this.contact" Open OpenChanged="this.CloseEdit" OnSaved="this.ContactSaved" />
}

@if (this.deleting && this.contact is not null)
{
    <ContactDeleteModal Contact="this.contact" Open OpenChanged="this.CloseDelete" OnDeleted="this.ContactDeleted" />
}

@code {
    private const int OccurrenceItems = 20;

    private static readonly CaseColumn[] CaseColumns =
    [
        CaseColumn.Date,
        CaseColumn.Case,
        CaseColumn.Status,
    ];

    private static readonly ActColumn[] ActColumns =
    [
        ActColumn.Date,
        ActColumn.Act,
        ActColumn.Direction,
    ];

    [Parameter]
    public Guid ContactId { get; set; }

    private ContactDetail? contact;

    private bool notFound;

    private string? failure;

    private bool editing;

    private bool deleting;

    private int caseTotal;

    private int actTotal;

    private CaseListRequest CaseFilter => new()
    {
        ContactId = this.ContactId,
        Status = CaseStatusFilter.All,
        Scope = CaseListScope.All,
        Take = OccurrenceItems,
    };

    // The occurrences of a contact read from the newest date (SDD-011).
    private ActListRequest ActFilter => new()
    {
        ContactId = this.ContactId,
        SortDirection = ListSortDirection.Descending,
        Take = OccurrenceItems,
    };

    protected override Task OnParametersSetAsync()
    {
        return this.LoadContact();
    }

    private async Task LoadContact()
    {
        this.contact = null;
        this.notFound = false;
        this.failure = null;

        try
        {
            this.contact = await this.ContactsClient.GetContact(this.ContactId, CancellationToken.None);
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            this.notFound = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the contact detail failed");

            this.failure = "Kontakt se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void StartEditing()
    {
        this.editing = true;
    }

    private void CloseEdit(bool open)
    {
        if (!open)
            this.editing = false;
    }

    private async Task ContactSaved()
    {
        this.editing = false;

        await this.LoadContact();
    }

    private void StartDeleting()
    {
        this.deleting = true;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = false;
    }

    private void ContactDeleted()
    {
        this.deleting = false;

        this.Navigation.NavigateTo("/contacts");
    }
}
