@using EvilBrains.EvilCase.Api.Contract.Labels

@* The name lives in the tooltip; the reflowed narrow row, where no tooltip opens, carries it in text (SDD-019). *@
@if (this.Labels.Count > 0)
{
    <span class="label-dots">
        @foreach (var label in this.Labels)
        {
            <span class="ec-label-mark" title="@label.Name">
                <span class="ec-dot ec-dot-@LabelColorDisplay.Css(label.Color)" role="img" aria-label="@label.Name"></span>
                <span class="ec-label-name" aria-hidden="true">@label.Name</span>
            </span>
        }
    </span>
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<LabelItem> Labels { get; set; }
}
