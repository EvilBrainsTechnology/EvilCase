@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using Microsoft.JSInterop
@using Toolbelt.Blazor.FileDropZone
@inject ILogger<FilesCard> Logger

@* The card is itself the drop zone (SDD-012): FileDropZone hands a card-wide drop to the input
   the upload button opens, so a dropped and a picked file take one path. *@
<FileDropZone class="@(this.Compact ? "ec-file-card ec-file-card-compact" : "ec-file-card")">
    <EcCard Title="@this.Title">
        <Header>
            @if (!this.loading && this.listFailure is null)
            {
                <span class="ec-card-count">@this.items.Count</span>
            }
            <div class="ec-card-header-actions">
                <span class="ec-file-drop-hint"><EcIcon Paths="@AppIcons.Hand" />@(this.Compact ? "Přetáhněte sem nebo" : "Přetáhněte soubory sem nebo")</span>
                <label class="@(this.Compact ? "ec-button ec-button-secondary ec-button-compact ec-file-upload" : "ec-button ec-button-secondary ec-button-standard ec-file-upload")"
                       for="files-upload-input">
                    <EcIcon Paths="@AppIcons.Upload" /><span>@("Nahrát")@if (!this.Compact)
                    {
                        <span class="ec-file-upload-more"> soubory</span>
                    }</span>
                </label>
            </div>
        </Header>
        <ChildContent>
            <div class="ec-card-stack">
                @* Keyed on the batch: a browser raises no change event for a file already in the
                   input, so a fresh element is what lets the same file be picked again. *@
                <div class="ec-visually-hidden">
                    <InputFile @key="this.uploadRound" id="files-upload-input" multiple OnChange="this.OnFilesSelected" />
                </div>

                @foreach (var failure in this.failures)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@failure</div>
                }

                @if (this.uploadTotal > 0)
                {
                    <div class="ec-file-uploading">
                        <EcFileIcon FileName="@this.uploadName" Size="@this.IconSize" />
                        <div class="ec-file-main">
                            <span class="ec-file-name-static">@this.uploadName</span>
                            <progress class="ec-file-progress" aria-label="Nahrávání"></progress>
                            <span class="ec-file-meta">Nahrávám @this.uploadIndex z&nbsp;@this.uploadTotal</span>
                        </div>
                    </div>
                }

                @if (this.error is not null)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
                }

                @if (this.loading)
                {
                    <p class="ec-card-state">Načítám…</p>
                }
                else if (this.listFailure is not null)
                {
                    <div class="ec-card-error">
                        <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.listFailure</div>
                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                                  OnClick="this.ReloadFiles">Zkusit znovu</EcButton>
                    </div>
                }
                else if (this.items.Count == 0)
                {
                    <EcEmptyState Icon="@AppIcons.Paperclip" Text="Zatím tu nejsou žádné soubory."
                                  Hint="@($"Přetáhněte je kamkoli do panelu nebo použijte {this.UploadLabel}.")" />
                }
                else
                {
                    <div class="ec-file-list">
                        @foreach (var file in this.items)
                        {
                            var busy = this.downloadingFileId == file.FileId;

                            var renaming = this.renamingFileId == file.FileId;

                            <div class="@(renaming ? "ec-file-row ec-file-row-renaming" : "ec-file-row")" @key="file.FileId">
                                <EcFileIcon FileName="@file.FileName" Size="@this.IconSize" />
                                @if (renaming)
                                {
                                    <FileRenameField FileName="@file.FileName" Rename="(name, token) => this.RenameFile(file, name, token)"
                                                     OnRenamed="this.FileRenamed" OnCancel="this.CancelRename" />
                                }
                                else
                                {
                                    <div class="ec-file-main">
                                        <button type="button" class="ec-file-name" @ref="this.nameButtons[file.FileId]"
                                                title="@(this.Compact ? file.FileName : this.OpenTitle(file))"
                                                disabled="@busy" @onclick="() => this.Open(file)">@file.FileName</button>
                                        <span class="ec-file-meta">@FileSizeDisplay.Text(file.SizeBytes)<span class="ec-sep" aria-hidden="true">·</span><span class="ec-file-moment">@MomentDisplay.Text(file.Created)</span></span>
                                    </div>
                                    <div class="ec-file-actions">
                                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Download"
                                                  AriaLabel="@($"Stáhnout {file.FileName}")" title="Stáhnout" Disabled="@busy"
                                                  OnClick="() => this.Download(file)" />
                                        <EcMenu AriaLabel="@($"Další akce se souborem {file.FileName}")" Items="this.FileActions(file)" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </ChildContent>
    </EcCard>

    <div class="ec-file-drop-overlay" aria-hidden="true">
        <span class="ec-file-drop-badge"><EcIcon Paths="@AppIcons.Upload" Size="EcIconSize.Large" /></span>
        <span class="ec-file-drop-title">@CzechTypography.Text($"Pusťte soubory a nahrají se {this.UploadTarget}")</span>
        <span class="ec-file-drop-limits">Nejvýše @FileBatchUploader.MaxBatchFiles&nbsp;souborů, každý do @FileSizeDisplay.Text(FileLimits.MaxUploadBytes)</span>
    </div>
</FileDropZone>

@if (this.previewFileId is { } previewId)
{
    <FilePreviewModal Files="this.items" FileId="previewId" FileIdChanged="this.PreviewFile"
                      LoadContent="this.LoadContent" Rename="this.RenameFile"
                      OnDownload="this.Download" OnRenamed="this.FileRenamed"
                      Open OpenChanged="this.ClosePreview" />
}

@if (this.deleting is { } file)
{
    <FileDeleteModal FileName="@file.FileName" Delete="token => this.DeleteFile(file, token)"
                     Open OpenChanged="this.CloseDelete" OnDeleted="this.FileDeleted" />
}

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task<IReadOnlyList<FileListItem>>> LoadFiles { get; set; }

    [Parameter, EditorRequired]
    public required Func<IBrowserFile, CancellationToken, Task> UploadFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DownloadFile { get; set; }

    /// <summary>
    /// The bytes the preview shows.
    /// </summary>
    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task<Stream>> LoadContent { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, string, CancellationToken, Task> RenameFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DeleteFile { get; set; }

    /// <summary>
    /// Lower case: it follows the file name and a colon.
    /// </summary>
    [Parameter, EditorRequired]
    public required string OwnerGoneError { get; set; }

    /// <summary>
    /// Follows "nahrají se": "k úkonu", "k spisu".
    /// </summary>
    [Parameter, EditorRequired]
    public required string UploadTarget { get; set; }

    /// <summary>
    /// The 380 px side column: a short upload label and icon-only file actions.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    private readonly List<string> failures = [];

    private readonly Dictionary<Guid, ElementReference> nameButtons = [];

    private IReadOnlyList<FileListItem> items = [];

    private bool loading = true;

    private int uploadIndex;

    private int uploadTotal;

    private string uploadName = "";

    private int uploadRound;

    private Guid? downloadingFileId;

    private Guid? previewFileId;

    private Guid? renamingFileId;

    private Guid? focusFileId;

    private string? listFailure;

    private string? error;

    private FileListItem? deleting;

    private string UploadLabel => this.Compact ? "Nahrát" : "Nahrát soubory";

    private EcFileIconSize IconSize => this.Compact ? EcFileIconSize.Compact : EcFileIconSize.Standard;

    protected override async Task OnInitializedAsync()
    {
        await this.ReloadFiles();
        this.loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this.focusFileId is not { } fileId)
            return;

        this.focusFileId = null;

        if (this.nameButtons.TryGetValue(fileId, out var button))
            await button.FocusAsync();
    }

    private IReadOnlyList<EcMenuItem> FileActions(FileListItem file)
    {
        return
        [
            new EcMenuItem { Text = "Přejmenovat", Icon = AppIcons.Pencil, OnSelect = EventCallback.Factory.Create(this, () => this.StartRename(file)) },
            new EcMenuItem { Text = "Smazat…", Icon = AppIcons.Trash, OnSelect = EventCallback.Factory.Create(this, () => this.ConfirmDelete(file)), Danger = true, DividerBefore = true },
        ];
    }

    private string OpenTitle(FileListItem file)
    {
        return FileTypeDisplay.Preview(file.FileName) == FilePreviewKind.None ? "Stáhnout" : "Otevřít náhled";
    }

    private async Task ReloadFiles()
    {
        this.listFailure = null;

        try
        {
            this.items = await this.LoadFiles(CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the files failed");

            this.items = [];
            this.listFailure = "Soubory se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }

        // A file removed elsewhere takes its open preview or rename with it.
        if (this.previewFileId is { } previewId && this.items.All(file => file.FileId != previewId))
            this.previewFileId = null;

        if (this.renamingFileId is { } renamingId && this.items.All(file => file.FileId != renamingId))
            this.renamingFileId = null;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs args)
    {
        this.failures.Clear();
        this.uploadIndex = 0;
        this.uploadTotal = args.FileCount;

        await FileBatchUploader.Run(
            args,
            this.UploadFile,
            this.OwnerGoneError,
            this.failures,
            (index, name) =>
            {
                this.uploadIndex = index;
                this.uploadName = name;
                this.StateHasChanged();
            },
            this.Logger);

        this.uploadTotal = 0;
        this.uploadRound++;

        await this.ReloadFiles();
    }

    private async Task Open(FileListItem file)
    {
        if (FileTypeDisplay.Preview(file.FileName) == FilePreviewKind.None)
            await this.Download(file);
        else
            this.previewFileId = file.FileId;
    }

    private void PreviewFile(Guid fileId)
    {
        this.previewFileId = fileId;
    }

    private void ClosePreview(bool open)
    {
        if (!open)
            this.previewFileId = null;
    }

    private async Task Download(FileListItem file)
    {
        this.downloadingFileId = file.FileId;
        this.error = null;

        try
        {
            await this.DownloadFile(file, CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException or JSException)
        {
            this.Logger.LogWarning(exception, "Downloading file {FileId} failed", file.FileId);

            this.error = "Soubor se nepodařilo stáhnout. Zkuste to za chvíli znovu.";
        }
        finally
        {
            this.downloadingFileId = null;
        }
    }

    private void StartRename(FileListItem file)
    {
        this.renamingFileId = file.FileId;
    }

    // A finished rename hands the focus back to the row it replaced.
    private void CancelRename()
    {
        this.focusFileId = this.renamingFileId;
        this.renamingFileId = null;
    }

    private async Task FileRenamed()
    {
        this.focusFileId = this.renamingFileId;
        this.renamingFileId = null;

        await this.ReloadFiles();
    }

    private void ConfirmDelete(FileListItem file)
    {
        this.deleting = file;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = null;
    }

    private async Task FileDeleted()
    {
        this.deleting = null;

        await this.ReloadFiles();
    }
}
