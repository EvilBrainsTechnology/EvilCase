@inject NavigationManager Navigation

<nav class="ec-settings-nav" aria-label="Sekce nastavení">
    @foreach (var item in Items)
    {
        <a class="ec-settings-nav-item" href="@item.Href" aria-current="@(this.IsCurrent(item.Href) ? "page" : null)">
            <EcIcon Paths="@item.Icon" />
            <span>@item.Text</span>
        </a>
    }
</nav>

@code {
    private static readonly (string Href, string Text, string Icon)[] Items =
    [
        ("/settings", "Štítky", AppIcons.Tag),
        ("/settings/export", "Export", AppIcons.ArrowBarToDown),
    ];

    private bool IsCurrent(string href)
    {
        var path = "/" + this.Navigation.ToBaseRelativePath(this.Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
    }
}
