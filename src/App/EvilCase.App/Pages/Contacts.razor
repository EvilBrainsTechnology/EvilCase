@page "/contacts"
@using EvilBrains.EvilCase.Api.Contract.Contacts
@using TabBlazor.Services
@inject IModalService ModalService

<PageTitle>Kontakty – EvilCase</PageTitle>

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Kontakty</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <button id="contact-new" type="button" class="btn btn-primary" @onclick="this.CreateContact"><Icon CssClass="icon" IconType="AppIcons.Plus" />Nový kontakt</button>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <ContactList @ref="this.list"
                     Columns="Columns"
                     Filter="Filter"
                     ShowSearch="true"
                     ShowKindFilter="true"
                     ShowSorting="true"
                     ShowPaging="true"
                     EmptySubtitle="Zkuste jiné hledání.">
            <EmptyAction>
                <button type="button" class="btn btn-primary" @onclick="this.CreateContact"><Icon CssClass="icon" IconType="AppIcons.Plus" />Založit kontakt</button>
            </EmptyAction>
        </ContactList>
    </div>
</div>

@code {
    private const int PageItems = 20;

    private static readonly ContactColumn[] Columns =
    [
        ContactColumn.Name,
        ContactColumn.Kind,
        ContactColumn.DataBoxId,
        ContactColumn.Address,
    ];

    private static readonly ContactListRequest Filter = new() { Take = PageItems };

    private ContactList? list;

    private async Task CreateContact()
    {
        await this.ModalService.ShowAsync(
            "Nový kontakt",
            new RenderComponent<ContactFormModal>()
                .Set(component => component.OnCreated, EventCallback.Factory.Create<ContactListItem>(this, _ => this.list!.Reload())),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
