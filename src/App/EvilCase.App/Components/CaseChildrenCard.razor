@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Cases
@using EvilBrains.EvilCase.Domain.Cases
@inject ICasesClient CasesClient
@inject ILogger<CaseChildrenCard> Logger

<EcCard Id="@this.Id" Title="Podřízené spisy">
    <Header>
        @if (this.children is not null)
        {
            <span class="ec-card-count">@this.children.Count</span>
        }
        <div class="ec-card-header-actions">
            <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Plus"
                      AriaLabel="Založit podřízený spis" Href="@($"/cases/new?parent={this.ParentCaseId}")" />
        </div>
    </Header>
    <ChildContent>
        @if (this.failure is not null)
        {
            <div class="ec-card-error">
                <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.failure</div>
                <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                          OnClick="this.LoadChildren">Zkusit znovu</EcButton>
            </div>
        }
        else if (this.children is null)
        {
            <p class="ec-card-state">Načítám…</p>
        }
        else if (this.children.Count == 0)
        {
            <EcEmptyState Icon="@AppIcons.Folders" Text="Zatím tu není žádný podřízený spis." />
        }
        else
        {
            var closedCount = this.children.Count(static item => item.Status == CaseStatus.Closed);
            var shown = this.children.Where(item => this.showClosed || item.Status != CaseStatus.Closed).ToList();
            var capped = !this.expanded && shown.Count > MobileRows;

            <div class="ec-child-card">
                <span class="ec-child-counts"><MetaLine Parts="@CountParts(this.children.Count - closedCount, closedCount)" /></span>
                @* Below lg the list shows three rows until the button below lets out the rest. *@
                <div id="case-children" class="@(capped ? "ec-child-list ec-child-list-capped" : "ec-child-list")">
                    @foreach (var item in shown)
                    {
                        <a class="ec-child-row" href="@($"/cases/{item.CaseId}")">
                            <span class="ec-child-title" data-tooltip-overflow>@item.Title</span>
                            <span class="ec-child-status">
                                <span class="@($"ec-status-dot {CaseStatusDisplay.Dot(item.Status)}")" aria-hidden="true"></span>@CaseStatusDisplay.Text(item.Status) <span class="ec-sep" aria-hidden="true">·</span> @DateDisplay.Text(item.Date)
                            </span>
                            @if (item.MainFile is { } main)
                            {
                                @* Inside the row's link: the click opens the preview and never follows the row. *@
                                <button type="button" class="ec-main-file" aria-label="@main.FileName" data-tooltip="@main.FileName"
                                        @onclick="() => this.OpenMainFile(item.CaseId, main.FileId)" @onclick:preventDefault @onclick:stopPropagation>
                                    <EcFileIcon FileName="@main.FileName" Size="EcFileIconSize.Compact" />
                                </button>
                            }
                        </a>
                    }
                </div>
                @if (capped)
                {
                    <button type="button" class="ec-child-all" aria-controls="case-children" @onclick="this.Expand">
                        @AllText(shown.Count)<EcIcon Paths="@AppIcons.ChevronRight" Size="EcIconSize.Small" />
                    </button>
                }
                @if (closedCount > 0)
                {
                    <button type="button" class="ec-child-toggle" aria-expanded="@(this.showClosed ? "true" : "false")"
                            aria-controls="case-children" @onclick="this.ToggleClosed">@(this.showClosed ? "Skrýt uzavřené" : $"Zobrazit i uzavřené ({closedCount})")</button>
                }
            </div>
        }
    </ChildContent>
</EcCard>

@if (this.previewed is { } previewed)
{
    <MainFilePreview @key="previewed" Owner="FileOwnerKind.Case" OwnerId="previewed.CaseId" FileId="previewed.FileId" OnChanged="this.ReloadChildren" OnClosed="this.CloseMainFile" />
}

@code {
    // "6 otevřených · 9 uzavřených".
    private static string[] CountParts(int openCount, int closedCount)
    {
        return [Plural.Text(openCount, "otevřený", "otevřené", "otevřených"), Plural.Text(closedCount, "uzavřený", "uzavřené", "uzavřených")];
    }

    // "Všechny 4 podřízené spisy", "Všech 16 podřízených spisů".
    private static string AllText(int count)
    {
        return count < 5 ? $"Všechny {count} podřízené spisy" : $"Všech {count} podřízených spisů";
    }

    private const int MobileRows = 3;

    /// <summary>
    /// The sidebar summary lists every child of one case; the tenant holds no case with more.
    /// </summary>
    private const int ChildLimit = 100;

    [Parameter, EditorRequired]
    public required Guid ParentCaseId { get; set; }

    /// <summary>The target of a section anchor.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>The count of child cases, raised after each successful load.</summary>
    [Parameter]
    public EventCallback<int> CountChanged { get; set; }

    private IReadOnlyList<CaseListItem>? children;

    private string? failure;

    private bool showClosed;

    private bool expanded;

    private Guid loaded;

    private (Guid CaseId, Guid FileId)? previewed;

    protected override Task OnParametersSetAsync()
    {
        if (this.loaded == this.ParentCaseId)
            return Task.CompletedTask;

        this.loaded = this.ParentCaseId;

        return this.LoadChildren();
    }

    private void ToggleClosed()
    {
        this.showClosed = !this.showClosed;
    }

    private void Expand()
    {
        this.expanded = true;
    }

    private void OpenMainFile(Guid caseId, Guid fileId)
    {
        this.previewed = (caseId, fileId);
    }

    private void CloseMainFile()
    {
        this.previewed = null;
    }

    private async Task LoadChildren()
    {
        this.children = null;

        await this.ReloadChildren();
    }

    // Keeps the rows shown while the list is read again.
    private async Task ReloadChildren()
    {
        this.failure = null;

        var request = new CaseListRequest
        {
            ParentCaseId = this.ParentCaseId,
            Status = CaseStatusFilter.All,
            Take = ChildLimit,
        };

        try
        {
            var response = await this.CasesClient.ListCases(request, CancellationToken.None);

            this.children = response.Items;

            await this.CountChanged.InvokeAsync(this.children.Count);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the child cases failed");

            this.failure = "Podřízené spisy se nepodařilo načíst.";
        }
    }
}
