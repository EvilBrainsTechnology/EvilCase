{
    "EvilBrains": {
        "EvilCase": {
            "ConnectionString": null,

            "Auth": {
                "Jwt": {
                    "Issuer": "https://auth.evilbrains.com",
                    "Audience": "EvilCase",
                    "TokenExpiration": "12:00:00",
                    "Key": null
                }
            }
        }
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "EvilBrains": "Information",
                "Serilog": "Information",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "EvilCase",
            "Environment": "null"
        }
    }
}
