@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using Microsoft.JSInterop
@using TabBlazor.Services
@using Toolbelt.Blazor.FileDropZone
@inject IModalService ModalService
@inject ILogger<FilesCard> Logger

@* The card is itself the drop zone (SDD-012): FileDropZone hands a card-wide drop to the input
   the upload button opens, so a dropped and a picked file take one path. *@
<FileDropZone class="ec-file-card">
    <EcCard Title="@this.Title">
        <Header>
            @if (!this.loading && this.listFailure is null)
            {
                <span class="ec-card-count">@this.items.Count</span>
            }
            <div class="ec-card-header-actions">
                <label class="ec-file-upload" for="files-upload-input">
                    <EcIcon Paths="@AppIcons.Upload" />Nahrát soubory
                </label>
            </div>
        </Header>
        <ChildContent>
            <div class="ec-card-stack">
                @* Keyed on the batch: a browser raises no change event for a file already in the
                   input, so a fresh element is what lets the same file be picked again. *@
                <div class="ec-visually-hidden">
                    <InputFile @key="this.uploadRound" id="files-upload-input" multiple OnChange="this.OnFilesSelected" />
                </div>

                @foreach (var failure in this.failures)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@failure</div>
                }

                @if (this.uploadTotal > 0)
                {
                    <p class="ec-card-state">Nahrávám @this.uploadIndex / @this.uploadTotal: @this.uploadName</p>
                }

                @if (this.error is not null)
                {
                    <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.error</div>
                }

                @if (this.loading)
                {
                    <p class="ec-card-state">Načítám…</p>
                }
                else if (this.listFailure is not null)
                {
                    <div class="ec-card-error">
                        <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.listFailure</div>
                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                                  OnClick="this.ReloadFiles">Zkusit znovu</EcButton>
                    </div>
                }
                else if (this.items.Count == 0)
                {
                    <EcEmptyState Icon="@AppIcons.Paperclip" Text="Zatím tu nejsou žádné soubory." />
                }
                else
                {
                    <div class="ec-file-list">
                        @foreach (var file in this.items)
                        {
                            <div class="ec-file-row">
                                <button type="button" class="ec-file-open" aria-label="@($"Stáhnout {file.FileName}")"
                                        disabled="@(this.downloadingFileId == file.FileId)" @onclick="() => this.Download(file)">
                                    <EcFileChip FileName="@file.FileName" />
                                    <span class="ec-file-name">@file.FileName</span>
                                    <span class="ec-file-meta">@FileSizeDisplay.Text(file.SizeBytes) · @MomentDisplay.Text(file.Created)</span>
                                    <EcIcon Paths="@AppIcons.Download" />
                                </button>
                                <EcButton Variant="EcButtonVariant.Danger" Size="EcButtonSize.Compact" Icon="@AppIcons.Trash"
                                          AriaLabel="@($"Smazat {file.FileName}")" OnClick="() => this.ConfirmDelete(file)" />
                            </div>
                        }
                    </div>
                }

                <p class="ec-file-drop">Přetáhněte soubory sem, nebo je vyberte tlačítkem výše</p>
            </div>
        </ChildContent>
    </EcCard>
</FileDropZone>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required Func<CancellationToken, Task<IReadOnlyList<FileListItem>>> LoadFiles { get; set; }

    [Parameter, EditorRequired]
    public required Func<IBrowserFile, CancellationToken, Task> UploadFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DownloadFile { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, CancellationToken, Task> DeleteFile { get; set; }

    /// <summary>
    /// Lower case: it follows the file name and a colon.
    /// </summary>
    [Parameter, EditorRequired]
    public required string OwnerGoneError { get; set; }

    private readonly List<string> failures = [];

    private IReadOnlyList<FileListItem> items = [];

    private bool loading = true;

    private int uploadIndex;

    private int uploadTotal;

    private string uploadName = "";

    private int uploadRound;

    private Guid? downloadingFileId;

    private string? listFailure;

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await this.ReloadFiles();
        this.loading = false;
    }

    private async Task ReloadFiles()
    {
        this.listFailure = null;

        try
        {
            this.items = await this.LoadFiles(CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the files failed");

            this.items = [];
            this.listFailure = "Soubory se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs args)
    {
        this.failures.Clear();
        this.uploadIndex = 0;
        this.uploadTotal = args.FileCount;

        await FileBatchUploader.Run(
            args,
            this.UploadFile,
            this.OwnerGoneError,
            this.failures,
            (index, name) =>
            {
                this.uploadIndex = index;
                this.uploadName = name;
                this.StateHasChanged();
            },
            this.Logger);

        this.uploadTotal = 0;
        this.uploadRound++;

        await this.ReloadFiles();
    }

    private async Task Download(FileListItem file)
    {
        this.downloadingFileId = file.FileId;
        this.error = null;

        try
        {
            await this.DownloadFile(file, CancellationToken.None);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException or JSException)
        {
            this.Logger.LogWarning(exception, "Downloading file {FileId} failed", file.FileId);

            this.error = "Soubor se nepodařilo stáhnout. Zkuste to za chvíli znovu.";
        }
        finally
        {
            this.downloadingFileId = null;
        }
    }

    private async Task ConfirmDelete(FileListItem file)
    {
        await this.ModalService.ShowAsync(
            "Smazat soubor",
            new RenderComponent<FileDeleteModal>()
                .Set(component => component.FileName, file.FileName)
                .Set(component => component.DeleteFile, (CancellationToken token) => this.DeleteFile(file, token))
                .Set(component => component.OnDeleted, EventCallback.Factory.Create(this, this.ReloadFiles)),
            new ModalOptions { Fullscreen = ModalFullscreen.BelowLarge });
    }
}
