@inject IAuthSession Session
@inject NavigationManager Navigation

<AuthorizeView Context="authenticationState">
    <div class="nav-item dropdown user-menu">
        <button type="button" class="nav-link d-flex lh-1 p-0 px-2 user-menu-toggle"
                aria-label="Otevřít uživatelské menu" aria-expanded="@this.open" @onclick="Toggle">
            <Icon IconType="AppIcons.User" Size="24" />
            <span class="d-none d-xl-block ps-2">@authenticationState.User.Identity?.Name</span>
        </button>

        @if (this.open)
        {
            @* Closes the menu on a click anywhere else. Tabler's own dropdown does this from Bootstrap's
               JavaScript, which does not survive the Blazor renderer. *@
            <div class="dropdown-backdrop" @onclick="Close"></div>

            <div class="dropdown-menu dropdown-menu-end show">
                <span class="dropdown-header text-truncate d-xl-none">@authenticationState.User.Identity?.Name</span>
                <button type="button" class="dropdown-item" @onclick="() => SignOut(everywhere: false)">Odhlásit se</button>
                <button type="button" class="dropdown-item" @onclick="() => SignOut(everywhere: true)">Odhlásit všechna zařízení</button>
            </div>
        }
    </div>
</AuthorizeView>

@code {
    private bool open;

    private void Toggle()
    {
        this.open = !this.open;
    }

    private void Close()
    {
        this.open = false;
    }

    private async Task SignOut(bool everywhere)
    {
        this.open = false;

        await this.Session.SignOut(everywhere, CancellationToken.None);

        // The layout bounces to the sign-in page on the state change anyway; going there explicitly
        // keeps the page they were on out of the returnUrl.
        this.Navigation.NavigateTo("login", replace: true);
    }
}
