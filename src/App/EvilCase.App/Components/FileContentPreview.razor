@using System.Diagnostics
@using System.Text
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Contract.Files
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IAuthSession Session
@inject IBrowserFiles BrowserFiles
@inject IFilePreviews Previews
@inject ILogger<FileContentPreview> Logger

@* The preview of one version of a stored file, or of an attachment of a data message: it reads the content once and
   shows it by its type. A signed document shows what it carries. *@
@if (!this.Covered)
{
    var name = this.signedContentName ?? this.Name;
    var preview = FileTypeDisplay.Preview(name);

    if (preview == FilePreviewKind.None || this.unsupported)
    {
        <div class="ec-preview-message">
            <EcFileIcon FileName="@name" Size="EcFileIconSize.Large" />
            <p class="ec-preview-message-title">Náhled tohoto typu souboru není k dispozici</p>
            <p class="ec-preview-message-text">Soubor si stáhněte a otevřete v aplikaci, která ho umí zobrazit.</p>
            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Download" OnClick="this.OnDownload">Stáhnout soubor</EcButton>
        </div>
    }
    else if (this.failed)
    {
        <div class="ec-preview-message">
            <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />Soubor se nepodařilo načíst. Zkuste to za chvíli znovu.</div>
            <EcButton Variant="EcButtonVariant.Secondary" Icon="@AppIcons.Refresh" OnClick="this.Show">Zkusit znovu</EcButton>
        </div>
    }
    else if (this.loading)
    {
        <p class="ec-preview-message">Načítám…</p>
    }
    else if (preview is FilePreviewKind.Text or FilePreviewKind.Code)
    {
        var language = preview == FilePreviewKind.Code ? FileTypeDisplay.Language(name) : (CodeLanguage?)null;

        <TextEditor @ref="this.viewer" Text="@this.text" Language="language" FileName="@name" ReadOnly Formats="language is not null"
                    Partial="this.truncated" OnFormatted="view => this.codeView = view" OnUnavailable="this.Unreadable">
            <Notes>
                @if (this.NotUtf8)
                {
                    <ToolbarNote Text="@NotUtf8Note" />
                }
                @if (this.truncated)
                {
                    <ToolbarNote Text="@(language is null ? "Soubor je delší, zobrazuje se jen jeho začátek." : "Soubor je delší, zobrazuje se jen jeho začátek a nejde naformátovat.")" />
                }
                else if (language is { } shownLanguage && this.codeView is { Formatted: false, Invalid: true })
                {
                    <ToolbarNote Text="@($"Soubor není platný {LanguageName(shownLanguage)}, proto se ukazuje jen originál.")" />
                }
                else if (this.codeView is { Formatted: false })
                {
                    <ToolbarNote Text="Soubor se nepodařilo naformátovat, ukazuje se originál." />
                }
            </Notes>
        </TextEditor>
    }
    else if (preview == FilePreviewKind.Markdown)
    {
        <MarkdownView @ref="this.markdownView" Text="@this.markdown" FileName="@name"
                      Editing="this.Edit is not null" Locked="this.Edit?.Locked ?? false" Changes="this.Edit?.Changes"
                      Source="this.markdownSource" SourceChanged="this.SwitchMarkdownSource"
                      OnDirtyChanged="this.Edit?.OnDirtyChanged ?? default" OnSave="this.Edit?.OnSave ?? default" OnUnavailable="this.MarkdownUnavailable"
                      OnLinkRequest="this.Edit?.OnLinkRequest ?? default">
            <Notes>
                @if (this.Edit is { } edit)
                {
                    @edit.Notes
                }
                else
                {
                    @if (this.truncated)
                    {
                        <ToolbarNote Text="Soubor je delší, zobrazuje se jen jeho začátek." />
                    }
                    @if (this.NotUtf8)
                    {
                        <ToolbarNote Text="@NotUtf8Note" />
                    }
                }
            </Notes>
        </MarkdownView>
    }
    else if (preview == FilePreviewKind.Document)
    {
        <DocumentPreview Content="this.document!" FileName="@name" OnUnreadable="this.Unreadable" />
    }
    else if (preview == FilePreviewKind.Workbook)
    {
        <WorkbookPreview Sheets="this.workbook" />
    }
    else if (preview == FilePreviewKind.Email)
    {
        <MailPreview Message="this.email!" FileName="@name" />
    }
    else if (preview == FilePreviewKind.DataMessage)
    {
        <DataMessagePreview Content="this.dataMessage!" FileName="@name" FileId="@(this.Attachment is null ? this.File.FileId : null)"
                            Version="@(this.Attachment is null ? this.Version : null)" OnOpenAttachment="@(this.OnOpenAttachment.HasDelegate ? EventCallback.Factory.Create<(DataMessage Message, int Index)>(this, this.OpenAttachment) : default)" OnUnreadable="this.Unreadable" />
    }
    else if (preview == FilePreviewKind.SignedDocument)
    {
        <FileSigners FileId="this.File.FileId" FileName="@this.File.FileName" Version="this.Version" Detached OnOpenFile="this.OnOpenFile" />
    }
    else if (preview == FilePreviewKind.Pdf)
    {
        <PdfPreview Url="@(this.url ?? "")" Content="this.pdf" FileName="@name" OnUnreadable="this.Unreadable" />
    }
    else if (preview == FilePreviewKind.Image || preview == FilePreviewKind.ConvertedImage)
    {
        <ImagePreview Url="@(this.url ?? "")" FileName="@name" OnUnreadable="this.Unreadable" />
    }
    else if (preview == FilePreviewKind.Audio)
    {
        <div class="ec-preview-stage">
            <audio class="ec-preview-audio" src="@this.url" controls @onerror="this.Unreadable"></audio>
        </div>
    }
    else
    {
        <div class="ec-preview-stage">
            <video class="ec-preview-video" src="@this.url" controls @onerror="this.Unreadable"></video>
        </div>
    }
}

@code {
    private const string NotUtf8Note = "Soubor není v kódování UTF-8, proto ho nejde upravit.";

    private string? url;

    private bool urlIsBlob;

    private string markdown = "";

    private bool markdownSource;

    private MarkdownView? markdownView;

    private IReadOnlyList<SheetPreview> workbook = [];

    private EmailPreview? email;

    private byte[]? document;

    private byte[]? pdf;

    private byte[]? dataMessage;

    // The document a signed file carries and the name it is shown and saved under; null for any other file.
    private byte[]? signedContent;

    private string? signedContentName;

    // The text or code shown, its start when it was cut.
    private string text = "";

    // How the code shown formatted; null for a text and until the code shows.
    private CodeView? codeView;

    private bool truncated;

    private bool loading = true;

    private bool failed;

    private bool unsupported;

    // The shown text or code as the editor takes it; null when it was not read whole or is not valid UTF-8.
    private EditableText? editable;

    // Whether the text or code was read whole and is not valid UTF-8.
    private bool notUtf8;

    private TextEditor? viewer;

    [Parameter, EditorRequired]
    public required FileListItem File { get; set; }

    /// <summary>
    /// The version shown; null shows the current one.
    /// </summary>
    [Parameter]
    public int? Version { get; set; }

    [Parameter, EditorRequired]
    public required long SizeBytes { get; set; }

    [Parameter, EditorRequired]
    public required Func<FileListItem, int?, CancellationToken, Task<Stream>> LoadContent { get; set; }

    /// <summary>
    /// The attachment of a data message shown instead of the stored file.
    /// </summary>
    [Parameter]
    public DataMessageAttachment? Attachment { get; set; }

    /// <summary>
    /// The content of the stored version read already, which shows without a load.
    /// </summary>
    [Parameter]
    public byte[]? Content { get; set; }

    /// <summary>
    /// Whether the preview is a side of a compare, which notes nothing about editing.
    /// </summary>
    [Parameter]
    public bool Compared { get; set; }

    /// <summary>
    /// Whether something else stands in the preview's place; it keeps what it read.
    /// </summary>
    [Parameter]
    public bool Covered { get; set; }

    /// <summary>
    /// The edit of a Markdown file, in place of its preview; null shows it only.
    /// </summary>
    [Parameter]
    public MarkdownEdit? Edit { get; set; }

    /// <summary>
    /// Whether the preview of a Markdown file starts with its source; read when the preview opens.
    /// </summary>
    [Parameter]
    public bool MarkdownSource { get; set; }

    [Parameter]
    public EventCallback<bool> MarkdownSourceChanged { get; set; }

    /// <summary>
    /// Raised when a read ends or the content turns out unreadable, with the preview itself.
    /// </summary>
    [Parameter]
    public EventCallback<FileContentPreview> OnChanged { get; set; }

    [Parameter]
    public EventCallback OnDownload { get; set; }

    /// <summary>
    /// Raised with the message shown, read and parsed, and the index of the attachment to preview; without it the
    /// attachments do not open.
    /// </summary>
    [Parameter]
    public EventCallback<(byte[] Content, string MessageName, DataMessage Message, int Index)> OnOpenAttachment { get; set; }

    [Parameter]
    public EventCallback<Guid> OnOpenFile { get; set; }

    /// <summary>
    /// The name of the document a signed file carries; null for any other file.
    /// </summary>
    public string? SignedContentName => this.signedContentName;

    /// <summary>
    /// The text or code read whole and valid UTF-8, as the editor takes it.
    /// </summary>
    internal EditableText? Editable => this.editable;

    /// <summary>
    /// Whether the content was read and shows.
    /// </summary>
    public bool Ready => !this.loading && !this.failed && !this.unsupported;

    public bool ShowsFormattedCode => this.viewer?.ShowsFormatted == true;

    private string Name => this.Attachment?.Name ?? this.File.FileName;

    private bool NotUtf8 => this.notUtf8 && this.Attachment is null && this.signedContentName is null && this.Version is null && !this.Compared;

    protected override void OnInitialized()
    {
        this.markdownSource = this.MarkdownSource;
    }

    protected override async Task OnInitializedAsync()
    {
        await this.Show();
    }

    public async ValueTask DisposeAsync()
    {
        this.loadToken?.Cancel();

        await this.ReleaseUrl();
    }

    public async Task<string> ReadMarkdown()
    {
        return await this.markdownView!.ReadText();
    }

    public async Task SetLink(string href)
    {
        await this.markdownView!.SetLink(href);
    }

    public async Task DownloadSignedContent()
    {
        await using var content = new MemoryStream(this.signedContent!, writable: false);

        await this.BrowserFiles.DownloadContent(this.signedContentName!, content, CancellationToken.None);
    }

    private async Task OpenAttachment((DataMessage Message, int Index) opened)
    {
        await this.OnOpenAttachment.InvokeAsync((this.dataMessage!, this.Name, opened.Message, opened.Index));
    }

    private async Task SwitchMarkdownSource(bool source)
    {
        this.markdownSource = source;

        await this.MarkdownSourceChanged.InvokeAsync(source);
    }

    // The formatted or source view of a Markdown file did not start: the edit ends and says so, a preview offers the download.
    private async Task MarkdownUnavailable()
    {
        if (this.Edit is { } edit)
            await edit.OnUnavailable.InvokeAsync();
        else
            await this.Unreadable();
    }

    private async Task Unreadable()
    {
        this.unsupported = true;

        await this.OnChanged.InvokeAsync(this);
    }

    private static string LanguageName(CodeLanguage language)
    {
        return language switch
        {
            CodeLanguage.Json => "JSON",
            CodeLanguage.Xml => "XML",
            CodeLanguage.Yaml => "YAML",
            CodeLanguage.Html => "HTML",
            CodeLanguage.Markdown => "Markdown",
            _ => throw new UnreachableException(),
        };
    }
}
