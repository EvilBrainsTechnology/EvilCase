@page "/settings"
@using EvilBrains.ApiClient
@using EvilBrains.EvilCase.Api.Client
@using EvilBrains.EvilCase.Api.Contract.Labels
@inject ILabelsClient LabelsClient
@inject ILogger<Settings> Logger

<PageTitle>Nastavení – EvilCase</PageTitle>

<div class="ec-page">
    <EcPageHeader Title="Nastavení" />

    <div class="ec-settings-layout">
        <nav class="ec-settings-nav" aria-label="Sekce nastavení">
            <a class="ec-settings-nav-item" href="/settings" aria-current="page">Štítky</a>
        </nav>

        <EcCard>
            <Header>
                <div class="ec-card-heading">
                    <h2 class="ec-card-title">Štítky</h2>
                    <span class="ec-card-subtitle">Jeden číselník pro spisy i úkony</span>
                </div>
                <div class="ec-card-header-actions">
                    <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" OnClick="this.StartCreating">Nový štítek</EcButton>
                </div>
            </Header>
            <ChildContent>
                @if (this.loading)
                {
                    <p class="ec-card-state">Načítám…</p>
                }
                else if (this.listFailure is not null)
                {
                    <div class="ec-card-error">
                        <div class="ec-alert" role="alert"><EcIcon Paths="@AppIcons.AlertTriangle" />@this.listFailure</div>
                        <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Refresh"
                                  OnClick="this.ReloadLabels">Zkusit znovu</EcButton>
                    </div>
                }
                else if (this.items.Count == 0)
                {
                    <EcEmptyState Icon="@AppIcons.Tag" Text="Zatím tu není žádný štítek.">
                        <Action>
                            <EcButton Variant="EcButtonVariant.Primary" Icon="@AppIcons.Plus" OnClick="this.StartCreating">Založit štítek</EcButton>
                        </Action>
                    </EcEmptyState>
                }
                else
                {
                    <div class="ec-settings-head" aria-hidden="true">
                        <span>Štítek</span>
                        <span>Barva</span>
                        <span></span>
                    </div>
                    <div class="ec-settings-list">
                        @foreach (var item in this.items)
                        {
                            <div class="ec-settings-row">
                                <span class="@($"ec-chip ec-chip-{LabelColorDisplay.Css(item.Color)}")">
                                    <span class="ec-chip-dot" aria-hidden="true"></span>@item.Name
                                </span>
                                <span class="ec-settings-row-color">@LabelColorDisplay.Text(item.Color)</span>
                                <span class="ec-settings-row-actions">
                                    <EcButton Variant="EcButtonVariant.Secondary" Size="EcButtonSize.Compact" Icon="@AppIcons.Pencil"
                                              OnClick="() => this.StartEditing(item)">Upravit</EcButton>
                                    <EcButton Variant="EcButtonVariant.Danger" Size="EcButtonSize.Compact" Icon="@AppIcons.Trash"
                                              AriaLabel="@($"Smazat štítek {item.Name}")" OnClick="() => this.StartDeleting(item)" />
                                </span>
                            </div>
                        }
                    </div>
                }
            </ChildContent>
            <Footer>
                Smazání štítku ho sejme ze všech spisů a úkonů, které ho nesou.
            </Footer>
        </EcCard>
    </div>
</div>

@if (this.formOpen)
{
    <LabelFormModal Label="this.editing" Open OpenChanged="this.CloseForm" OnSaved="this.LabelSaved" />
}

@if (this.deleting is not null)
{
    <LabelDeleteModal Label="this.deleting" Open OpenChanged="this.CloseDelete" OnDeleted="this.LabelDeleted" />
}

@code {
    private IReadOnlyList<LabelItem> items = [];

    private LabelItem? editing;

    private LabelItem? deleting;

    private bool formOpen;

    private bool loading = true;

    private string? listFailure;

    protected override async Task OnInitializedAsync()
    {
        await this.ReloadLabels();
        this.loading = false;
    }

    private async Task ReloadLabels()
    {
        this.listFailure = null;

        try
        {
            var response = await this.LabelsClient.ListLabels(CancellationToken.None);

            this.items = response.Items;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            this.Logger.LogWarning(exception, "Loading the label list failed");

            this.items = [];
            this.listFailure = "Seznam štítků se nepodařilo načíst. Zkuste to za chvíli znovu.";
        }
    }

    private void StartCreating()
    {
        this.editing = null;
        this.formOpen = true;
    }

    private void StartEditing(LabelItem label)
    {
        this.editing = label;
        this.formOpen = true;
    }

    private void StartDeleting(LabelItem label)
    {
        this.deleting = label;
    }

    private void CloseForm(bool open)
    {
        if (open)
            return;

        this.formOpen = false;
        this.editing = null;
    }

    private void CloseDelete(bool open)
    {
        if (!open)
            this.deleting = null;
    }

    private async Task LabelSaved()
    {
        this.formOpen = false;
        this.editing = null;

        await this.ReloadLabels();
    }

    private async Task LabelDeleted()
    {
        this.deleting = null;

        await this.ReloadLabels();
    }
}
